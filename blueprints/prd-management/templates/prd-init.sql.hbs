-- {{app_name}} — PRD-management schema (blueprint: {{blueprint_id}})
-- Hierarchy depth: {{hierarchy_depth}}
-- AI review enabled: {{ai_review_enabled}}
-- Billing model: {{billing_model}}

CREATE SCHEMA IF NOT EXISTS prd;

CREATE TABLE IF NOT EXISTS prd.project (
  project_id    UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  tenant_id     UUID NOT NULL,
  name          TEXT NOT NULL,
  description   TEXT NOT NULL DEFAULT '',
  created_at    TIMESTAMPTZ NOT NULL DEFAULT now()
);
CREATE INDEX IF NOT EXISTS project_tenant_idx ON prd.project (tenant_id);

CREATE TABLE IF NOT EXISTS prd.epic (
  epic_id       UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  project_id    UUID NOT NULL REFERENCES prd.project(project_id) ON DELETE CASCADE,
  title         TEXT NOT NULL,
  description   TEXT NOT NULL DEFAULT '',
  status        TEXT NOT NULL DEFAULT 'draft'
                  CHECK (status IN ('draft','active','shipped','cancelled')),
  created_at    TIMESTAMPTZ NOT NULL DEFAULT now()
);

CREATE TABLE IF NOT EXISTS prd.feature (
  feature_id           UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  epic_id              UUID NOT NULL REFERENCES prd.epic(epic_id) ON DELETE CASCADE,
  title                TEXT NOT NULL,
  rationale            TEXT NOT NULL DEFAULT '',
  acceptance_criteria  TEXT[] NOT NULL DEFAULT '{}',
  status               TEXT NOT NULL DEFAULT 'draft'
                         CHECK (status IN ('draft','in-progress','ready-for-review','approved','shipped')),
  created_at           TIMESTAMPTZ NOT NULL DEFAULT now()
);
CREATE INDEX IF NOT EXISTS feature_epic_idx ON prd.feature (epic_id);

CREATE TABLE IF NOT EXISTS prd.scenario (
  scenario_id   UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  feature_id    UUID NOT NULL REFERENCES prd.feature(feature_id) ON DELETE CASCADE,
  title         TEXT NOT NULL,
  given_when_then JSONB NOT NULL DEFAULT '{}'::jsonb,
  created_at    TIMESTAMPTZ NOT NULL DEFAULT now()
);

CREATE TABLE IF NOT EXISTS prd.task (
  task_id       UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  scenario_id   UUID NOT NULL REFERENCES prd.scenario(scenario_id) ON DELETE CASCADE,
  title         TEXT NOT NULL,
  description   TEXT NOT NULL DEFAULT '',
  assignee_persona_id UUID,
  status        TEXT NOT NULL DEFAULT 'backlog'
                  CHECK (status IN ('backlog','in-progress','blocked','done','cancelled')),
  created_at    TIMESTAMPTZ NOT NULL DEFAULT now()
);
CREATE INDEX IF NOT EXISTS task_scenario_idx ON prd.task (scenario_id);
