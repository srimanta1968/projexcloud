import type { Job } from './dispatcher';

export interface Technician {
  tech_id: string;
  active: boolean;
  current_lat: number;
  current_lng: number;
  active_job_count: number;
  certifications: string[];
}

export async function pickTechForJob(job: Job, candidates: Technician[]): Promise<Technician | null> {
  const available = candidates.filter((t) => t.active);
  if (available.length === 0) return null;
  // Strategy is wired here. The {{assignment_strategy}} answer feeds the weights.
  return available[0];
}
