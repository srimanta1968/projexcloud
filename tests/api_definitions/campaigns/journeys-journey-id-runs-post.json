{
  "name": "POST /api/campaigns/journeys/:journey_id/runs — sdk-campaign",
  "endpoint": "/api/campaigns/journeys/:journey_id/runs",
  "method": "POST",
  "requiresAuth": true,
  "dependsOn": [
    "POST /api/auth/signup-tenant",
    "POST /api/campaigns",
    "POST /api/campaigns/:campaign_id/journeys",
    "POST /api/personas"
  ],
  "expectedStatus": 201,
  "sdk": "sdk-campaign",
  "sourceFile": "packages/sdk-campaign/src/server/routes.ts",
  "_generated": true,
  "testability": "auto",
  "statusTransitions": {
    "entity": "campaign.journey_run",
    "field": "state",
    "flow": ["active", "paused", "completed", "exited"],
    "transitions": [
      { "from": "(none)", "to": "active", "via": "POST /api/campaigns/journeys/:journey_id/runs" },
      { "from": "active", "to": "completed", "via": "POST /api/campaigns/runs/:run_id/advance" }
    ]
  },
  "captureResponse": {
    "campaigns.run.create.response.data.run.run_id": "data.run.run_id",
    "campaigns.run.create.response.data.run.state": "data.run.state"
  },
  "testCases": [
    {
      "name": "Start a journey run for a subject persona",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "pathParams": {
        "journey_id": "{{cache:campaigns.journey.create.response.data.journey.journey_id}}"
      },
      "payload": {
        "subject_persona_id": "{{cache:personas.create.response.data.persona.persona_id}}"
      },
      "expectedStatus": 201
    }
  ]
}
