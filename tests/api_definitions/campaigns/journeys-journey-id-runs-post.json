{
  "name": "POST /api/campaigns/journeys/:journey_id/runs — sdk-campaign",
  "endpoint": "/api/campaigns/journeys/:journey_id/runs",
  "method": "POST",
  "description": "Starts a journey run for one subject persona; the run begins at current_step 0 in state 'active'. subject_persona_id is required. Edge cases: missing subject_persona_id -> 400; an unknown journey_id fails the FK inside the insert and surfaces as an unhandled 500 rather than a 404; nothing prevents starting a second concurrent run for the same (journey, persona) pair, so the endpoint is not idempotent and callers must de-duplicate.",
  "errorCases": [
    {
      "status": 401,
      "code": "Unauthorized",
      "message": "Missing bearer token",
      "when": "Authorization header absent or not in the form \"Bearer <jwt>\""
    },
    {
      "status": 401,
      "code": "Unauthorized",
      "message": "Invalid or expired token",
      "when": "JWT signature invalid, malformed, or past its exp claim"
    },
    {
      "status": 400,
      "code": "ValidationError",
      "message": "missing subject_persona_id",
      "when": "body omits subject_persona_id (details: [\"missing subject_persona_id\"])"
    }
  ],
  "requiresAuth": true,
  "dependsOn": [
    "POST /api/auth/signup-tenant",
    "POST /api/campaigns",
    "POST /api/campaigns/:campaign_id/journeys",
    "POST /api/personas"
  ],
  "expectedStatus": 201,
  "sdk": "sdk-campaign",
  "sourceFile": "packages/sdk-campaign/src/server/routes.ts",
  "_generated": true,
  "testability": "auto",
  "statusTransitions": {
    "entity": "campaign.journey_run",
    "field": "state",
    "flow": ["active", "paused", "completed", "exited"],
    "transitions": [
      { "from": "(none)", "to": "active", "via": "POST /api/campaigns/journeys/:journey_id/runs" },
      { "from": "active", "to": "completed", "via": "POST /api/campaigns/runs/:run_id/advance" }
    ]
  },
  "captureResponse": {
    "campaigns.run.create.response.data.run.run_id": "data.run.run_id",
    "campaigns.run.create.response.data.run.state": "data.run.state"
  },
  "testCases": [
    {
      "name": "Start a journey run for a subject persona",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "pathParams": {
        "journey_id": "{{cache:campaigns.journey.create.response.data.journey.journey_id}}"
      },
      "payload": {
        "subject_persona_id": "{{cache:personas.create.response.data.persona.persona_id}}"
      },
      "expectedStatus": 201
    }
  ]
}
