{
  "name": "POST /api/campaigns/:campaign_id/segments — sdk-campaign",
  "endpoint": "/api/campaigns/:campaign_id/segments",
  "method": "POST",
  "requiresAuth": true,
  "dependsOn": [
    "POST /api/auth/signup-tenant",
    "POST /api/campaigns"
  ],
  "expectedStatus": 201,
  "sdk": "sdk-campaign",
  "sourceFile": "packages/sdk-campaign/src/server/routes.ts",
  "_generated": true,
  "testability": "auto",
  "captureResponse": {
    "campaigns.segment.create.response.data.segment.segment_id": "data.segment.segment_id",
    "campaigns.segment.create.response.data.segment.campaign_id": "data.segment.campaign_id"
  },
  "testCases": [
    {
      "name": "Upsert a segment whose DSL targets the tenant population",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "pathParams": {
        "campaign_id": "{{cache:campaigns.create.response.data.campaign.campaign_id}}"
      },
      "payload": {
        "dsl": {
          "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}",
          "match": "all",
          "rules": [
            { "attr": "status", "op": "eq", "value": "active" }
          ]
        }
      },
      "expectedStatus": 201
    }
  ]
}
