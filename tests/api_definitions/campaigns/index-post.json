{
  "name": "POST /api/campaigns — sdk-campaign",
  "endpoint": "/api/campaigns",
  "method": "POST",
  "requiresAuth": true,
  "dependsOn": [
    "POST /api/auth/signup-tenant",
    "PUT /api/flags"
  ],
  "expectedStatus": 201,
  "sdk": "sdk-campaign",
  "sourceFile": "packages/sdk-campaign/src/server/routes.ts",
  "_generated": true,
  "testability": "auto",
  "statusTransitions": {
    "entity": "campaign.campaign",
    "field": "status",
    "flow": ["draft", "scheduled", "running", "paused", "completed"],
    "transitions": [
      { "from": "(none)", "to": "draft", "via": "POST /api/campaigns" }
    ]
  },
  "captureResponse": {
    "campaigns.create.response.data.campaign.campaign_id": "data.campaign.campaign_id",
    "campaigns.create.response.data.campaign.status": "data.campaign.status"
  },
  "testCases": [
    {
      "name": "Create a marketing campaign for the signed-up tenant",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "payload": {
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}",
        "name": "{{dynamic:name}}",
        "variant_flag_id": "{{cache:flags.create.response.data.flag.flag_id}}"
      },
      "expectedStatus": 201
    }
  ]
}
