{
  "name": "POST /api/campaigns/:campaign_id/journeys — sdk-campaign",
  "endpoint": "/api/campaigns/:campaign_id/journeys",
  "method": "POST",
  "requiresAuth": true,
  "dependsOn": [
    "POST /api/auth/signup-tenant",
    "POST /api/campaigns"
  ],
  "expectedStatus": 201,
  "sdk": "sdk-campaign",
  "sourceFile": "packages/sdk-campaign/src/server/routes.ts",
  "_generated": true,
  "testability": "auto",
  "captureResponse": {
    "campaigns.journey.create.response.data.journey.journey_id": "data.journey.journey_id",
    "campaigns.journey.create.response.data.journey.campaign_id": "data.journey.campaign_id"
  },
  "testCases": [
    {
      "name": "Define a two-step journey (delay then notification)",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "pathParams": {
        "campaign_id": "{{cache:campaigns.create.response.data.campaign.campaign_id}}"
      },
      "payload": {
        "steps": [
          { "kind": "delay", "duration_hours": 24 },
          { "kind": "notification", "template_code": "welcome_v1" }
        ]
      },
      "expectedStatus": 201
    }
  ]
}
