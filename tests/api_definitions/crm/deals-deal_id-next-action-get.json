{
  "sdk": "sdk-crm",
  "sourceFile": "packages/sdk-crm/src/server/routes.ts",
  "requiresAuth": true,
  "taskId": "7b73e8fb-544f-49dd-abc9-361c4510a3f4",
  "sprintId": "d4876947-8d18-4538-8e9f-51ba3e0735a9",
  "featureId": "b15ed3e2-02a0-4584-ac69-61da0250fc92",
  "epicId": "f7f7186e-8f69-4e44-97b8-212928e870f6",
  "testability": "auto",
  "name": "GET /api/crm/deals/:deal_id/next-action - Get the open NEXT action",
  "endpoint": "/api/crm/deals/:deal_id/next-action",
  "method": "GET",
  "expectedStatus": 200,
  "priority": 51,
  "description": "Get the deal's current open NEXT action. 404 if none is open. tenant_id query param required.",
  "dependsOn": [
    "POST /api/auth/signup-tenant",
    "POST /api/crm/deals",
    "POST /api/crm/deals/:deal_id/next-action"
  ],
  "testCases": [
    {
      "name": "Get the open next action",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "pathParams": {
        "deal_id": "{{cache:crm.deals.response.data.deal.deal_id}}"
      },
      "queryParams": {
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}"
      },
      "expectedStatus": 200,
      "expectedResponse": {
        "data": {
          "next_action": {
            "next_action_id": "string"
          }
        }
      }
    }
  ],
  "errorCases": [
    {
      "status": 400,
      "code": "ValidationError",
      "message": "tenant_id query param required",
      "when": "tenant_id missing"
    },
    {
      "status": 404,
      "code": "NotFound",
      "message": "no open NEXT action for this deal",
      "when": "deal has no open next action"
    }
  ]
}
