{
  "sdk": "sdk-crm",
  "sourceFile": "packages/sdk-crm/src/server/routes.ts",
  "requiresAuth": true,
  "taskId": "7b73e8fb-544f-49dd-abc9-361c4510a3f4",
  "sprintId": "d4876947-8d18-4538-8e9f-51ba3e0735a9",
  "featureId": "b15ed3e2-02a0-4584-ac69-61da0250fc92",
  "epicId": "f7f7186e-8f69-4e44-97b8-212928e870f6",
  "testability": "auto",
  "name": "POST /api/crm/deals/:deal_id/next-action/complete - Complete the NEXT action",
  "endpoint": "/api/crm/deals/:deal_id/next-action/complete",
  "method": "POST",
  "expectedStatus": 200,
  "priority": 53,
  "description": "Complete the deal's open NEXT action with an outcome (status -> completed). 404 if there is no open action. After completing, the deal needs a new NEXT action to pass the save-gate again (unless terminal). tenant_id required.",
  "dependsOn": [
    "POST /api/auth/signup-tenant",
    "POST /api/crm/deals",
    "POST /api/crm/deals/:deal_id/next-action",
    "GET /api/crm/deals/:deal_id/next-action"
  ],
  "testCases": [
    {
      "name": "Complete the next action",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "pathParams": {
        "deal_id": "{{cache:crm.deals.response.data.deal.deal_id}}"
      },
      "payload": {
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}",
        "outcome": "Spoke with buyer; budget confirmed"
      },
      "expectedStatus": 200,
      "expectedResponse": {
        "data": {
          "next_action": {
            "next_action_id": "string",
            "status": "string"
          }
        }
      }
    }
  ],
  "errorCases": [
    {
      "status": 400,
      "code": "ValidationError",
      "message": "tenant_id is required",
      "when": "tenant_id missing"
    },
    {
      "status": 404,
      "code": "NotFound",
      "message": "no open NEXT action to complete",
      "when": "deal has no open next action"
    }
  ]
}
