{
  "name": "POST /api/crm/deals — sdk-crm",
  "endpoint": "/api/crm/deals",
  "method": "POST",
  "requiresAuth": true,
  "dependsOn": [
    "POST /api/auth/register"
  ],
  "expectedStatus": 201,
  "sdk": "sdk-crm",
  "sourceFile": "packages/sdk-crm/src/server/routes.ts",
  "_generated": true,
  "captureResponse": {
    "crm.deals.response.data.deal.deal_id": "data.deal.deal_id"
  },
  "testCases": [
    {
      "name": "Create deal on an encounter (tenant_id + encounter_id + name required)",
      "headers": {
        "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
      },
      "payload": {
        "tenant_id": "{{dynamic:uuid}}",
        "encounter_id": "{{dynamic:uuid}}",
        "name": "{{dynamic:name}}",
        "amount": 5000,
        "currency": "USD",
        "close_probability": 50
      },
      "expectedStatus": 201
    }
  ]
}
