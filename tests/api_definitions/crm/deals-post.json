{
  "name": "POST /api/crm/deals — sdk-crm",
  "endpoint": "/api/crm/deals",
  "method": "POST",
  "requiresAuth": true,
  "dependsOn": [
    "POST /api/auth/signup-tenant",
    "POST /api/auth/register",
    "POST /api/app-identities",
    "POST /api/memberships",
    "POST /api/personas",
    "POST /api/crm/contacts",
    "POST /api/vault/keys",
    "POST /api/encounters"
  ],
  "expectedStatus": 201,
  "sdk": "sdk-crm",
  "sourceFile": "packages/sdk-crm/src/server/routes.ts",
  "_generated": true,
  "captureResponse": {
    "crm.deals.response.data.deal.deal_id": "data.deal.deal_id"
  },
  "testCases": [
    {
      "name": "Create deal on an encounter (tenant_id + encounter_id + name required)",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "payload": {
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}",
        "encounter_id": "{{cache:encounters.create.response.data.encounter.encounter_id}}",
        "contact_id": "{{cache:crm.contacts.response.data.contact.contact_id}}",
        "name": "{{dynamic:name}}",
        "amount": 5000,
        "currency": "USD",
        "close_probability": 50,
        "custom_fields": { "priority": "high" },
        "external_refs": { "crm_ref": "DEAL-001" }
      },
      "expectedStatus": 201
    }
  ]
}
