{
  "name": "POST /api/crm/activities — sdk-crm",
  "endpoint": "/api/crm/activities",
  "method": "POST",
  "requiresAuth": true,
  "dependsOn": [
    "POST /api/auth/register"
  ],
  "expectedStatus": 201,
  "sdk": "sdk-crm",
  "sourceFile": "packages/sdk-crm/src/server/routes.ts",
  "_generated": true,
  "fieldOptions": {
    "kind": ["call", "email", "meeting", "note", "task"]
  },
  "testCases": [
    {
      "name": "Log an activity inside an encounter (encounter_id + kind + actor_persona_id required)",
      "headers": {
        "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
      },
      "payload": {
        "encounter_id": "{{dynamic:uuid}}",
        "kind": "{{static:note}}",
        "actor_persona_id": "{{dynamic:uuid}}",
        "summary": "{{static:Follow-up call with prospect}}"
      },
      "expectedStatus": 201
    }
  ]
}
