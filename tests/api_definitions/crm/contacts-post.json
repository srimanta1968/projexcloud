{
  "name": "POST /api/crm/contacts — sdk-crm",
  "endpoint": "/api/crm/contacts",
  "method": "POST",
  "requiresAuth": true,
  "dependsOn": [
    "POST /api/auth/register"
  ],
  "expectedStatus": 201,
  "sdk": "sdk-crm",
  "sourceFile": "packages/sdk-crm/src/server/routes.ts",
  "_generated": true,
  "fieldOptions": {
    "lifecycle_stage": ["lead", "prospect", "customer", "churned", "former"]
  },
  "captureResponse": {
    "crm.contacts.response.data.contact.contact_id": "data.contact.contact_id"
  },
  "testCases": [
    {
      "name": "Create persona-keyed contact (tenant_id + persona_id required)",
      "headers": {
        "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
      },
      "payload": {
        "tenant_id": "{{dynamic:uuid}}",
        "persona_id": "{{dynamic:uuid}}",
        "lifecycle_stage": "{{static:lead}}",
        "source": "{{static:web}}"
      },
      "expectedStatus": 201
    }
  ]
}
