{
  "name": "PATCH /api/crm/contacts/:contact_id — sdk-crm",
  "endpoint": "/api/crm/contacts/:contact_id",
  "method": "PATCH",
  "description": "Partially updates a CRM contact; the whole request body is passed through as the field patch. Edge cases: an unknown contact_id returns 404; an empty body is accepted and results in a no-op update; field names are not whitelisted at the route, so unknown keys are handled by the service layer; the patch is idempotent - applying the same body twice yields the same row; a malformed (non-UUID) contact_id surfaces as an unhandled 500 from the uuid cast.",
  "errorCases": [
    {
      "status": 401,
      "code": "Unauthorized",
      "message": "Missing bearer token",
      "when": "Authorization header absent or not in the form \"Bearer <jwt>\""
    },
    {
      "status": 401,
      "code": "Unauthorized",
      "message": "Invalid or expired token",
      "when": "JWT signature invalid, malformed, or past its exp claim"
    },
    {
      "status": 404,
      "code": "NotFound",
      "message": "NotFound",
      "when": "no crm contact row exists for the given contact_id"
    }
  ],
  "requiresAuth": true,
  "dependsOn": [
    "POST /api/auth/signup-tenant",
    "POST /api/auth/register",
    "POST /api/app-identities",
    "POST /api/memberships",
    "POST /api/personas",
    "POST /api/crm/contacts"
  ],
  "expectedStatus": 200,
  "sdk": "sdk-crm",
  "sourceFile": "packages/sdk-crm/src/server/routes.ts",
  "_generated": true,
  "fieldEnums": {
    "lifecycle_stage": ["lead", "prospect", "customer", "churned", "former"]
  },
  "statusTransitions": {
    "entity": "contact",
    "field": "lifecycle_stage",
    "flow": ["lead", "prospect", "customer", "churned", "former"],
    "transitions": [
      { "from": "lead", "to": "prospect", "via": "PATCH /api/crm/contacts/:contact_id" },
      { "from": "prospect", "to": "customer", "via": "PATCH /api/crm/contacts/:contact_id" },
      { "from": "customer", "to": "churned", "via": "PATCH /api/crm/contacts/:contact_id" },
      { "from": "churned", "to": "former", "via": "PATCH /api/crm/contacts/:contact_id" }
    ]
  },
  "testCases": [
    {
      "name": "Update contact lifecycle_stage on an existing contact",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "pathParams": {
        "contact_id": "{{cache:crm.contacts.response.data.contact.contact_id}}"
      },
      "payload": {
        "lifecycle_stage": "customer",
        "owner_persona_id": "{{cache:personas.create.response.data.persona.persona_id}}",
        "custom_fields": { "tier": "gold" },
        "external_refs": { "hubspot_id": "HS-002" }
      },
      "expectedStatus": 200
    }
  ]
}
