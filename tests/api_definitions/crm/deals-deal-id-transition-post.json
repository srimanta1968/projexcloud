{
  "name": "POST /api/crm/deals/:deal_id/transition — sdk-crm",
  "endpoint": "/api/crm/deals/:deal_id/transition",
  "method": "POST",
  "requiresAuth": true,
  "dependsOn": [
    "POST /api/auth/register",
    "POST /api/crm/deals"
  ],
  "expectedStatus": 200,
  "sdk": "sdk-crm",
  "sourceFile": "packages/sdk-crm/src/server/routes.ts",
  "_generated": true,
  "fieldOptions": {
    "stage": ["qualifying", "proposal", "negotiation", "closed-won", "closed-lost"]
  },
  "testCases": [
    {
      "name": "Transition an existing deal to a valid stage",
      "headers": {
        "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
      },
      "pathParams": {
        "deal_id": "{{cache:crm.deals.response.data.deal.deal_id}}"
      },
      "payload": {
        "stage": "{{static:proposal}}"
      },
      "expectedStatus": 200
    }
  ]
}
