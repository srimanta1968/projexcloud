{
  "name": "POST /api/sla/policies - Create an SLA policy",
  "endpoint": "/api/sla/policies",
  "sdk": "sdk-sla",
  "sourceFile": "packages/sdk-sla/src/server/routes.ts",
  "method": "POST",
  "requiresAuth": true,
  "expectedStatus": 201,
  "taskId": "1dbcb185-1bb8-4af9-93ae-8438ba8fd513",
  "sprintId": "d4876947-8d18-4538-8e9f-51ba3e0735a9",
  "featureId": "af5400b6-00aa-4d5c-82f6-d9819457333f",
  "epicId": "39365400-aca0-4a86-9791-5771d19998f4",
  "priority": 88,
  "testability": "auto",
  "description": "Create the promise itself: which subject_kind it covers, for how many BUSINESS minutes, on which calendar, which subjects qualify (qualifying_predicate, evaluated as data so a vertical narrows a promise without a platform change), what may pause the clock (pause_conditions, each with a max_minutes cap so a clock cannot be parked indefinitely to dodge a breach) and what actually closes it (satisfaction_contract — without it \"satisfied\" degrades into whatever the closing service felt like asserting). Returns 201. Required: tenant_id, slug, name, subject_kind, duration_minutes (> 0) and calendar_id.",
  "dependsOn": [
    "POST /api/auth/signup-tenant",
    "POST /api/sla/calendars"
  ],
  "fieldEnums": {
    "predicate_op": [
      "eq",
      "ne",
      "in",
      "not_in",
      "gte",
      "lte",
      "exists"
    ],
    "accepted_kinds": [
      "outbound_reply",
      "resolution"
    ]
  },
  "testCases": [
    {
      "name": "A two-hour response promise with one legal pause and a real satisfaction contract",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "payload": {
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}",
        "slug": "first-response-{{dynamic:uuid}}",
        "name": "First response",
        "description": "Respond within two business hours",
        "subject_kind": "request",
        "duration_minutes": 120,
        "calendar_id": "{{cache:sla.calendar.create.response.data.calendar.calendar_id}}",
        "qualifying_predicate": {
          "all": [
            {
              "field": "priority",
              "op": "in",
              "value": [
                "high",
                "urgent"
              ]
            }
          ]
        },
        "pause_conditions": [
          {
            "reason": "awaiting_subject_reply",
            "max_minutes": 4320
          }
        ],
        "satisfaction_contract": {
          "requires_evidence_ref": true,
          "accepted_kinds": [
            "outbound_reply",
            "resolution"
          ],
          "min_evidence_count": 1,
          "requires_actor": true
        },
        "metadata": {
          "owner": "qa-runner"
        }
      },
      "expectedStatus": 201,
      "expectedResponse": {
        "data": {
          "policy": {
            "policy_id": "string",
            "duration_minutes": "number"
          }
        }
      }
    }
  ],
  "captureResponse": {
    "sla.policy.create.response.data.policy.policy_id": "data.policy.policy_id"
  },
  "errorCases": [
    {
      "status": 400,
      "code": "VALIDATION_ERROR",
      "message": "tenant_id, slug, name, subject_kind, duration_minutes and calendar_id are required",
      "when": "a required field is missing from the request"
    },
    {
      "status": 400,
      "code": "VALIDATION_ERROR",
      "message": "duration_minutes must be greater than zero",
      "when": "duration_minutes is zero or negative"
    },
    {
      "status": 401,
      "code": "Unauthorized",
      "message": "missing or invalid token",
      "when": "no valid tenant Bearer token on the request"
    }
  ]
}
