{
  "name": "GET /api/sla/policies/:policy_id - Read one policy",
  "endpoint": "/api/sla/policies/:policy_id",
  "sdk": "sdk-sla",
  "sourceFile": "packages/sdk-sla/src/server/routes.ts",
  "method": "GET",
  "requiresAuth": true,
  "expectedStatus": 200,
  "taskId": "1dbcb185-1bb8-4af9-93ae-8438ba8fd513",
  "sprintId": "d4876947-8d18-4538-8e9f-51ba3e0735a9",
  "featureId": "af5400b6-00aa-4d5c-82f6-d9819457333f",
  "epicId": "39365400-aca0-4a86-9791-5771d19998f4",
  "priority": 74,
  "testability": "auto",
  "description": "Read one policy with its qualifying predicate, pause conditions and satisfaction contract — the three pieces of data a caller needs to know why a clock qualified, what may pause it and what will close it. Returns 200, or 404 SLA_POLICY_NOT_FOUND outside the tenant.",
  "dependsOn": [
    "POST /api/auth/signup-tenant",
    "POST /api/sla/policies"
  ],
  "fieldEnums": {
    "predicate_op": [
      "eq",
      "ne",
      "in",
      "not_in",
      "gte",
      "lte",
      "exists"
    ]
  },
  "testCases": [
    {
      "name": "Read the policy created above",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "pathParams": {
        "policy_id": "{{cache:sla.policy.create.response.data.policy.policy_id}}"
      },
      "queryParams": {
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}"
      },
      "expectedStatus": 200,
      "expectedResponse": {
        "data": {
          "policy": {
            "policy_id": "string",
            "calendar_id": "string"
          }
        }
      }
    }
  ],
  "errorCases": [
    {
      "status": 400,
      "code": "VALIDATION_ERROR",
      "message": "tenant_id query param required",
      "when": "a required field is missing from the request"
    },
    {
      "status": 404,
      "code": "SLA_POLICY_NOT_FOUND",
      "message": "policy <id> not found for tenant",
      "when": "the policy does not exist for this tenant"
    },
    {
      "status": 401,
      "code": "Unauthorized",
      "message": "missing or invalid token",
      "when": "no valid tenant Bearer token on the request"
    }
  ]
}
