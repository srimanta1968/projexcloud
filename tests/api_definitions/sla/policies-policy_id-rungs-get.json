{
  "name": "GET /api/sla/policies/:policy_id/rungs - Read the ladder",
  "endpoint": "/api/sla/policies/:policy_id/rungs",
  "sdk": "sdk-sla",
  "sourceFile": "packages/sdk-sla/src/server/routes.ts",
  "method": "GET",
  "requiresAuth": true,
  "expectedStatus": 200,
  "taskId": "1dbcb185-1bb8-4af9-93ae-8438ba8fd513",
  "sprintId": "d4876947-8d18-4538-8e9f-51ba3e0735a9",
  "featureId": "af5400b6-00aa-4d5c-82f6-d9819457333f",
  "epicId": "39365400-aca0-4a86-9791-5771d19998f4",
  "priority": 72,
  "testability": "auto",
  "description": "The policy's ladder in rung order — active rungs by default, all of them with include_inactive=true. Returns 200 with rungs and a count. Each rung carries its offset, audience, severity, action and remediation hint, which is the whole configuration: nothing about escalation lives in code.",
  "dependsOn": [
    "POST /api/auth/signup-tenant",
    "POST /api/sla/policies/:policy_id/rungs"
  ],
  "fieldEnums": {
    "severity": [
      "info",
      "warning",
      "urgent",
      "critical"
    ],
    "audience_kind": [
      "owner",
      "refs",
      "on_call"
    ],
    "include_inactive": [
      "true",
      "false"
    ]
  },
  "testCases": [
    {
      "name": "Read the ladder including retired rungs",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "pathParams": {
        "policy_id": "{{cache:sla.policy.create.response.data.policy.policy_id}}"
      },
      "queryParams": {
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}",
        "include_inactive": "true"
      },
      "expectedStatus": 200,
      "expectedResponse": {
        "data": {
          "rungs": "array",
          "count": "number"
        }
      }
    }
  ],
  "errorCases": [
    {
      "status": 400,
      "code": "VALIDATION_ERROR",
      "message": "tenant_id query param required",
      "when": "a required field is missing from the request"
    },
    {
      "status": 401,
      "code": "Unauthorized",
      "message": "missing or invalid token",
      "when": "no valid tenant Bearer token on the request"
    }
  ]
}
