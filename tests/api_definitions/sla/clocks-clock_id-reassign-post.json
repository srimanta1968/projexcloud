{
  "name": "POST /api/sla/clocks/:clock_id/reassign - Move ownership, never the clock",
  "endpoint": "/api/sla/clocks/:clock_id/reassign",
  "sdk": "sdk-sla",
  "sourceFile": "packages/sdk-sla/src/server/routes.ts",
  "method": "POST",
  "requiresAuth": true,
  "expectedStatus": 200,
  "taskId": "1dbcb185-1bb8-4af9-93ae-8438ba8fd513",
  "sprintId": "d4876947-8d18-4538-8e9f-51ba3e0735a9",
  "featureId": "af5400b6-00aa-4d5c-82f6-d9819457333f",
  "epicId": "39365400-aca0-4a86-9791-5771d19998f4",
  "priority": 66,
  "testability": "auto",
  "description": "Hand the response to somebody else — the reassignment and backup-takeover path. It exists as a named operation precisely to make the safe change easy, so nobody reaches for an UPDATE that would also \"helpfully\" refresh the due date: source_timestamp, started_at and due_at are immutable and a database trigger rejects any attempt to move them. Ownership is fluid, timing is frozen. Returns 200 with the updated clock; 409 INVALID_CLOCK_TRANSITION on a clock that is already closed. Required: tenant_id, owner_ref.",
  "dependsOn": [
    "POST /api/auth/signup-tenant",
    "POST /api/sla/clocks"
  ],
  "fieldEnums": {
    "state": [
      "running",
      "paused",
      "satisfied",
      "breached",
      "cancelled"
    ]
  },
  "statusTransitions": {
    "entity": "sla.sla_clock",
    "field": "state",
    "note": "at_risk is a DERIVED view over running/paused clocks approaching due_at (GET /api/sla/at-risk), not a stored state — the column can only hold the five values in fieldEnums.state.",
    "flow": [
      "running",
      "paused",
      "satisfied",
      "breached",
      "cancelled"
    ],
    "transitions": [
      {
        "from": "running",
        "to": "paused",
        "via": "POST /api/sla/clocks/:clock_id/pause"
      },
      {
        "from": "paused",
        "to": "running",
        "via": "POST /api/sla/clocks/:clock_id/resume"
      },
      {
        "from": "running",
        "to": "satisfied",
        "via": "POST /api/sla/clocks/:clock_id/satisfy"
      },
      {
        "from": "paused",
        "to": "satisfied",
        "via": "POST /api/sla/clocks/:clock_id/satisfy"
      },
      {
        "from": "running",
        "to": "breached",
        "via": "POST /api/sla/breach-scan"
      },
      {
        "from": "breached",
        "to": "satisfied",
        "via": "POST /api/sla/clocks/:clock_id/satisfy",
        "note": "a missed promise can still be kept, late — satisfied_at then sits after due_at so attainment still counts it as a miss"
      },
      {
        "from": "running",
        "to": "cancelled",
        "via": "POST /api/sla/clocks/:clock_id/cancel"
      },
      {
        "from": "paused",
        "to": "cancelled",
        "via": "POST /api/sla/clocks/:clock_id/cancel"
      },
      {
        "from": "breached",
        "to": "cancelled",
        "via": "POST /api/sla/clocks/:clock_id/cancel"
      }
    ]
  },
  "testCases": [
    {
      "name": "Hand the overdue request to the backup owner",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "pathParams": {
        "clock_id": "{{cache:sla.clock.create.response.data.clock.clock_id}}"
      },
      "payload": {
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}",
        "owner_ref": "persona:backup-{{dynamic:uuid}}",
        "reason": "backup takeover",
        "actor_id": "qa-runner"
      },
      "expectedStatus": 200,
      "expectedResponse": {
        "data": {
          "clock": {
            "clock_id": "string",
            "owner_ref": "string",
            "due_at": "string"
          }
        }
      }
    }
  ],
  "errorCases": [
    {
      "status": 400,
      "code": "VALIDATION_ERROR",
      "message": "tenant_id and owner_ref are required",
      "when": "a required field is missing from the request"
    },
    {
      "status": 404,
      "code": "SLA_CLOCK_NOT_FOUND",
      "message": "clock <id> not found for tenant",
      "when": "the clock does not exist for this tenant"
    },
    {
      "status": 409,
      "code": "INVALID_CLOCK_TRANSITION",
      "message": "clock <id> cannot move satisfied -> satisfied",
      "when": "the clock is already satisfied, breached or cancelled"
    },
    {
      "status": 401,
      "code": "Unauthorized",
      "message": "missing or invalid token",
      "when": "no valid tenant Bearer token on the request"
    }
  ]
}
