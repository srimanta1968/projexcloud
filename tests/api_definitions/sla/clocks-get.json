{
  "name": "GET /api/sla/clocks - List clocks",
  "endpoint": "/api/sla/clocks",
  "sdk": "sdk-sla",
  "sourceFile": "packages/sdk-sla/src/server/routes.ts",
  "method": "GET",
  "requiresAuth": true,
  "expectedStatus": 200,
  "taskId": "1dbcb185-1bb8-4af9-93ae-8438ba8fd513",
  "sprintId": "d4876947-8d18-4538-8e9f-51ba3e0735a9",
  "featureId": "af5400b6-00aa-4d5c-82f6-d9819457333f",
  "epicId": "39365400-aca0-4a86-9791-5771d19998f4",
  "priority": 70,
  "testability": "auto",
  "description": "List clocks by deadline, narrowed by subject_ref, policy_id, state or owner_ref. Ordered by due_at ascending so the next thing to miss is first. Returns 200 with clocks and a count. Requires tenant_id.",
  "dependsOn": [
    "POST /api/auth/signup-tenant",
    "POST /api/sla/clocks"
  ],
  "fieldEnums": {
    "state": [
      "running",
      "paused",
      "satisfied",
      "breached",
      "cancelled"
    ]
  },
  "testCases": [
    {
      "name": "List the running clocks for this tenant",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "queryParams": {
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}",
        "state": "running",
        "limit": "20"
      },
      "expectedStatus": 200,
      "expectedResponse": {
        "data": {
          "clocks": "array",
          "count": "number"
        }
      }
    }
  ],
  "errorCases": [
    {
      "status": 400,
      "code": "VALIDATION_ERROR",
      "message": "tenant_id query param required",
      "when": "a required field is missing from the request"
    },
    {
      "status": 401,
      "code": "Unauthorized",
      "message": "missing or invalid token",
      "when": "no valid tenant Bearer token on the request"
    }
  ]
}
