{
  "name": "GET /api/sla/calendars - List business calendars",
  "endpoint": "/api/sla/calendars",
  "sdk": "sdk-sla",
  "sourceFile": "packages/sdk-sla/src/server/routes.ts",
  "method": "GET",
  "requiresAuth": true,
  "expectedStatus": 200,
  "taskId": "1dbcb185-1bb8-4af9-93ae-8438ba8fd513",
  "sprintId": "d4876947-8d18-4538-8e9f-51ba3e0735a9",
  "featureId": "af5400b6-00aa-4d5c-82f6-d9819457333f",
  "epicId": "39365400-aca0-4a86-9791-5771d19998f4",
  "priority": 80,
  "testability": "auto",
  "description": "List the tenant's business calendars in slug order, optionally filtered by is_active. Returns 200 with calendars and a count. Requires the tenant_id query param — a calendar list without a tenant would cross a tenant boundary.",
  "dependsOn": [
    "POST /api/auth/signup-tenant",
    "POST /api/sla/calendars"
  ],
  "fieldEnums": {
    "weekend_rule": [
      "saturday_sunday",
      "friday_saturday",
      "sunday_only",
      "none"
    ],
    "is_active": [
      "true",
      "false"
    ]
  },
  "testCases": [
    {
      "name": "List the active calendars for this tenant",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "queryParams": {
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}",
        "is_active": "true",
        "limit": "20"
      },
      "expectedStatus": 200,
      "expectedResponse": {
        "data": {
          "calendars": "array",
          "count": "number"
        }
      }
    }
  ],
  "errorCases": [
    {
      "status": 400,
      "code": "VALIDATION_ERROR",
      "message": "tenant_id query param required",
      "when": "a required field is missing from the request"
    },
    {
      "status": 401,
      "code": "Unauthorized",
      "message": "missing or invalid token",
      "when": "no valid tenant Bearer token on the request"
    }
  ]
}
