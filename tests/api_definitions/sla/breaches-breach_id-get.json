{
  "name": "GET /api/sla/breaches/:breach_id - Read one breach record",
  "endpoint": "/api/sla/breaches/:breach_id",
  "sdk": "sdk-sla",
  "sourceFile": "packages/sdk-sla/src/server/routes.ts",
  "method": "GET",
  "requiresAuth": true,
  "expectedStatus": 200,
  "taskId": "1dbcb185-1bb8-4af9-93ae-8438ba8fd513",
  "sprintId": "d4876947-8d18-4538-8e9f-51ba3e0735a9",
  "featureId": "af5400b6-00aa-4d5c-82f6-d9819457333f",
  "epicId": "39365400-aca0-4a86-9791-5771d19998f4",
  "priority": 44,
  "testability": "auto",
  "description": "One breach record: the cause and its detail, elapsed and overdue business minutes, the owner and source at breach time, whether it was flagged systemic, and the recovery if one has been recorded. Returns 200, or 404 SLA_BREACH_NOT_FOUND outside the tenant.",
  "dependsOn": [
    "POST /api/auth/signup-tenant",
    "POST /api/sla/clocks/:clock_id/breach"
  ],
  "fieldEnums": {
    "reason_code": [
      "awaiting_capacity",
      "no_capacity",
      "missed_handoff",
      "upstream_outage",
      "provider_down",
      "process_gap",
      "cause_not_recorded"
    ]
  },
  "testCases": [
    {
      "name": "Read the breach recorded above",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "pathParams": {
        "breach_id": "{{cache:sla.breach.record.response.data.breach.breach_id}}"
      },
      "queryParams": {
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}"
      },
      "expectedStatus": 200,
      "expectedResponse": {
        "data": {
          "breach": {
            "breach_id": "string",
            "reason_code": "string",
            "is_systemic": "boolean"
          }
        }
      }
    }
  ],
  "errorCases": [
    {
      "status": 400,
      "code": "VALIDATION_ERROR",
      "message": "tenant_id query param required",
      "when": "a required field is missing from the request"
    },
    {
      "status": 404,
      "code": "SLA_BREACH_NOT_FOUND",
      "message": "breach record <id> not found for tenant",
      "when": "the breach record does not exist for this tenant"
    },
    {
      "status": 401,
      "code": "Unauthorized",
      "message": "missing or invalid token",
      "when": "no valid tenant Bearer token on the request"
    }
  ]
}
