{
  "name": "GET /api/sla/policies - List SLA policies",
  "endpoint": "/api/sla/policies",
  "sdk": "sdk-sla",
  "sourceFile": "packages/sdk-sla/src/server/routes.ts",
  "method": "GET",
  "requiresAuth": true,
  "expectedStatus": 200,
  "taskId": "1dbcb185-1bb8-4af9-93ae-8438ba8fd513",
  "sprintId": "d4876947-8d18-4538-8e9f-51ba3e0735a9",
  "featureId": "af5400b6-00aa-4d5c-82f6-d9819457333f",
  "epicId": "39365400-aca0-4a86-9791-5771d19998f4",
  "priority": 76,
  "testability": "auto",
  "description": "List the tenant's policies in slug order, optionally narrowed by subject_kind and is_active. Returns 200 with policies and a count. Requires tenant_id.",
  "dependsOn": [
    "POST /api/auth/signup-tenant",
    "POST /api/sla/policies"
  ],
  "fieldEnums": {
    "is_active": [
      "true",
      "false"
    ]
  },
  "testCases": [
    {
      "name": "List active request policies",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "queryParams": {
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}",
        "subject_kind": "request",
        "is_active": "true"
      },
      "expectedStatus": 200,
      "expectedResponse": {
        "data": {
          "policies": "array",
          "count": "number"
        }
      }
    }
  ],
  "errorCases": [
    {
      "status": 400,
      "code": "VALIDATION_ERROR",
      "message": "tenant_id query param required",
      "when": "a required field is missing from the request"
    },
    {
      "status": 401,
      "code": "Unauthorized",
      "message": "missing or invalid token",
      "when": "no valid tenant Bearer token on the request"
    }
  ]
}
