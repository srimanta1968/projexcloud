{
  "name": "POST /api/sla/clocks/:clock_id/resume - Restart the clock and record the interval",
  "endpoint": "/api/sla/clocks/:clock_id/resume",
  "sdk": "sdk-sla",
  "sourceFile": "packages/sdk-sla/src/server/routes.ts",
  "method": "POST",
  "requiresAuth": true,
  "expectedStatus": 200,
  "taskId": "1dbcb185-1bb8-4af9-93ae-8438ba8fd513",
  "sprintId": "d4876947-8d18-4538-8e9f-51ba3e0735a9",
  "featureId": "af5400b6-00aa-4d5c-82f6-d9819457333f",
  "epicId": "39365400-aca0-4a86-9791-5771d19998f4",
  "priority": 60,
  "testability": "auto",
  "description": "Resume a paused clock, appending the closed interval to paused_intervals with its reason so elapsed business minutes stay honest about what was parked and why. Only a paused clock can resume; anything else is 409 INVALID_CLOCK_TRANSITION. Returns 200 with the updated clock. Required: tenant_id.",
  "dependsOn": [
    "POST /api/sla/clocks",
    "POST /api/auth/signup-tenant",
    "POST /api/sla/clocks/:clock_id/pause"
  ],
  "fieldEnums": {
    "state": [
      "running",
      "paused",
      "satisfied",
      "breached",
      "cancelled"
    ]
  },
  "statusTransitions": {
    "entity": "sla.sla_clock",
    "field": "state",
    "note": "at_risk is a DERIVED view over running/paused clocks approaching due_at (GET /api/sla/at-risk), not a stored state \u2014 the column can only hold the five values in fieldEnums.state.",
    "flow": [
      "running",
      "paused",
      "satisfied",
      "breached",
      "cancelled"
    ],
    "transitions": [
      {
        "from": "running",
        "to": "paused",
        "via": "POST /api/sla/clocks/:clock_id/pause"
      },
      {
        "from": "paused",
        "to": "running",
        "via": "POST /api/sla/clocks/:clock_id/resume"
      },
      {
        "from": "running",
        "to": "satisfied",
        "via": "POST /api/sla/clocks/:clock_id/satisfy"
      },
      {
        "from": "paused",
        "to": "satisfied",
        "via": "POST /api/sla/clocks/:clock_id/satisfy"
      },
      {
        "from": "running",
        "to": "breached",
        "via": "POST /api/sla/breach-scan"
      },
      {
        "from": "breached",
        "to": "satisfied",
        "via": "POST /api/sla/clocks/:clock_id/satisfy",
        "note": "a missed promise can still be kept, late \u2014 satisfied_at then sits after due_at so attainment still counts it as a miss"
      },
      {
        "from": "running",
        "to": "cancelled",
        "via": "POST /api/sla/clocks/:clock_id/cancel"
      },
      {
        "from": "paused",
        "to": "cancelled",
        "via": "POST /api/sla/clocks/:clock_id/cancel"
      },
      {
        "from": "breached",
        "to": "cancelled",
        "via": "POST /api/sla/clocks/:clock_id/cancel"
      }
    ]
  },
  "testCases": [
    {
      "name": "Resume the paused clock",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "pathParams": {
        "clock_id": "{{cache:sla.clock.create.response.data.clock.clock_id}}"
      },
      "payload": {
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}",
        "actor_id": "qa-runner"
      },
      "expectedStatus": 200,
      "expectedResponse": {
        "data": {
          "clock": {
            "clock_id": "string",
            "state": "string",
            "paused_intervals": "array"
          }
        }
      }
    }
  ],
  "errorCases": [
    {
      "status": 400,
      "code": "VALIDATION_ERROR",
      "message": "tenant_id is required",
      "when": "a required field is missing from the request"
    },
    {
      "status": 409,
      "code": "INVALID_CLOCK_TRANSITION",
      "message": "clock <id> cannot move running -> running",
      "when": "the clock is not paused"
    },
    {
      "status": 401,
      "code": "Unauthorized",
      "message": "missing or invalid token",
      "when": "no valid tenant Bearer token on the request"
    }
  ]
}