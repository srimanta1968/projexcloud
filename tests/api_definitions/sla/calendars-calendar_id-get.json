{
  "name": "GET /api/sla/calendars/:calendar_id - Read one calendar",
  "endpoint": "/api/sla/calendars/:calendar_id",
  "sdk": "sdk-sla",
  "sourceFile": "packages/sdk-sla/src/server/routes.ts",
  "method": "GET",
  "requiresAuth": true,
  "expectedStatus": 200,
  "taskId": "1dbcb185-1bb8-4af9-93ae-8438ba8fd513",
  "sprintId": "d4876947-8d18-4538-8e9f-51ba3e0735a9",
  "featureId": "af5400b6-00aa-4d5c-82f6-d9819457333f",
  "epicId": "39365400-aca0-4a86-9791-5771d19998f4",
  "priority": 78,
  "testability": "auto",
  "description": "Read one business calendar scoped to the tenant, including its working windows, holiday dates, weekend rule and late-coverage extension. Returns 200, or 404 SLA_CALENDAR_NOT_FOUND when the calendar does not belong to this tenant — the same answer as a calendar that does not exist, so the endpoint cannot be used to probe another tenant.",
  "dependsOn": [
    "POST /api/auth/signup-tenant",
    "POST /api/sla/calendars"
  ],
  "fieldEnums": {
    "weekend_rule": [
      "saturday_sunday",
      "friday_saturday",
      "sunday_only",
      "none"
    ]
  },
  "testCases": [
    {
      "name": "Read the calendar created above",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "pathParams": {
        "calendar_id": "{{cache:sla.calendar.create.response.data.calendar.calendar_id}}"
      },
      "queryParams": {
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}"
      },
      "expectedStatus": 200,
      "expectedResponse": {
        "data": {
          "calendar": {
            "calendar_id": "string",
            "working_windows": "object"
          }
        }
      }
    }
  ],
  "errorCases": [
    {
      "status": 400,
      "code": "VALIDATION_ERROR",
      "message": "tenant_id query param required",
      "when": "a required field is missing from the request"
    },
    {
      "status": 404,
      "code": "SLA_CALENDAR_NOT_FOUND",
      "message": "calendar <id> not found for tenant",
      "when": "the calendar does not exist for this tenant"
    },
    {
      "status": 401,
      "code": "Unauthorized",
      "message": "missing or invalid token",
      "when": "no valid tenant Bearer token on the request"
    }
  ]
}
