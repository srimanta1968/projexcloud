{
  "name": "GET /api/sla/breaches - List recorded misses",
  "endpoint": "/api/sla/breaches",
  "sdk": "sdk-sla",
  "sourceFile": "packages/sdk-sla/src/server/routes.ts",
  "method": "GET",
  "requiresAuth": true,
  "expectedStatus": 200,
  "taskId": "1dbcb185-1bb8-4af9-93ae-8438ba8fd513",
  "sprintId": "d4876947-8d18-4538-8e9f-51ba3e0735a9",
  "featureId": "af5400b6-00aa-4d5c-82f6-d9819457333f",
  "epicId": "39365400-aca0-4a86-9791-5771d19998f4",
  "priority": 46,
  "testability": "auto",
  "description": "Recorded misses, most recent first, narrowed by policy, owner, reason_code, window, or unrecovered_only — that last filter being the working queue: misses nobody has said what they did about yet. Returns 200 with breaches and a count. Requires tenant_id.",
  "dependsOn": [
    "POST /api/auth/signup-tenant",
    "POST /api/sla/clocks/:clock_id/breach"
  ],
  "fieldEnums": {
    "reason_code": [
      "awaiting_capacity",
      "no_capacity",
      "missed_handoff",
      "upstream_outage",
      "provider_down",
      "process_gap",
      "cause_not_recorded"
    ],
    "unrecovered_only": [
      "true",
      "false"
    ]
  },
  "testCases": [
    {
      "name": "List every recorded miss for this tenant",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "queryParams": {
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}",
        "unrecovered_only": "false",
        "limit": "50"
      },
      "expectedStatus": 200,
      "expectedResponse": {
        "data": {
          "breaches": "array",
          "count": "number"
        }
      }
    }
  ],
  "errorCases": [
    {
      "status": 400,
      "code": "VALIDATION_ERROR",
      "message": "tenant_id query param required",
      "when": "a required field is missing from the request"
    },
    {
      "status": 401,
      "code": "Unauthorized",
      "message": "missing or invalid token",
      "when": "no valid tenant Bearer token on the request"
    }
  ]
}
