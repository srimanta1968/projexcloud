{
  "name": "GET /api/sla/clocks/:clock_id - Read a clock with elapsed business minutes",
  "endpoint": "/api/sla/clocks/:clock_id",
  "sdk": "sdk-sla",
  "sourceFile": "packages/sdk-sla/src/server/routes.ts",
  "method": "GET",
  "requiresAuth": true,
  "expectedStatus": 200,
  "taskId": "1dbcb185-1bb8-4af9-93ae-8438ba8fd513",
  "sprintId": "d4876947-8d18-4538-8e9f-51ba3e0735a9",
  "featureId": "af5400b6-00aa-4d5c-82f6-d9819457333f",
  "epicId": "39365400-aca0-4a86-9791-5771d19998f4",
  "priority": 68,
  "testability": "auto",
  "description": "Read one clock, plus the answer to the question every caller asks next: elapsed_business_minutes — how long this has been waiting in the hours the business is actually open, net of any paused intervals — alongside the policy duration it is measured against and whether it is already overdue. Computing that from the raw columns needs the calendar, so it is returned here rather than left to the caller. Returns 200, or 404 SLA_CLOCK_NOT_FOUND outside the tenant.",
  "dependsOn": [
    "POST /api/auth/signup-tenant",
    "POST /api/sla/clocks"
  ],
  "fieldEnums": {
    "state": [
      "running",
      "paused",
      "satisfied",
      "breached",
      "cancelled"
    ]
  },
  "statusTransitions": {
    "entity": "sla.sla_clock",
    "field": "state",
    "note": "at_risk is a DERIVED view over running/paused clocks approaching due_at (GET /api/sla/at-risk), not a stored state — the column can only hold the five values in fieldEnums.state.",
    "flow": [
      "running",
      "paused",
      "satisfied",
      "breached",
      "cancelled"
    ],
    "transitions": [
      {
        "from": "running",
        "to": "paused",
        "via": "POST /api/sla/clocks/:clock_id/pause"
      },
      {
        "from": "paused",
        "to": "running",
        "via": "POST /api/sla/clocks/:clock_id/resume"
      },
      {
        "from": "running",
        "to": "satisfied",
        "via": "POST /api/sla/clocks/:clock_id/satisfy"
      },
      {
        "from": "paused",
        "to": "satisfied",
        "via": "POST /api/sla/clocks/:clock_id/satisfy"
      },
      {
        "from": "running",
        "to": "breached",
        "via": "POST /api/sla/breach-scan"
      },
      {
        "from": "breached",
        "to": "satisfied",
        "via": "POST /api/sla/clocks/:clock_id/satisfy",
        "note": "a missed promise can still be kept, late — satisfied_at then sits after due_at so attainment still counts it as a miss"
      },
      {
        "from": "running",
        "to": "cancelled",
        "via": "POST /api/sla/clocks/:clock_id/cancel"
      },
      {
        "from": "paused",
        "to": "cancelled",
        "via": "POST /api/sla/clocks/:clock_id/cancel"
      },
      {
        "from": "breached",
        "to": "cancelled",
        "via": "POST /api/sla/clocks/:clock_id/cancel"
      }
    ]
  },
  "testCases": [
    {
      "name": "Read the overdue clock created above",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "pathParams": {
        "clock_id": "{{cache:sla.clock.create.response.data.clock.clock_id}}"
      },
      "queryParams": {
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}"
      },
      "expectedStatus": 200,
      "expectedResponse": {
        "data": {
          "clock": {
            "clock_id": "string",
            "state": "string",
            "source_timestamp": "string"
          },
          "elapsed_business_minutes": "number",
          "duration_minutes": "number",
          "is_overdue": "boolean"
        }
      }
    }
  ],
  "errorCases": [
    {
      "status": 400,
      "code": "VALIDATION_ERROR",
      "message": "tenant_id query param required",
      "when": "a required field is missing from the request"
    },
    {
      "status": 404,
      "code": "SLA_CLOCK_NOT_FOUND",
      "message": "clock <id> not found for tenant",
      "when": "the clock does not exist for this tenant"
    },
    {
      "status": 401,
      "code": "Unauthorized",
      "message": "missing or invalid token",
      "when": "no valid tenant Bearer token on the request"
    }
  ]
}
