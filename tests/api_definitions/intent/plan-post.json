{
  "name": "POST /intent/plan — semantic-service",
  "endpoint": "/intent/plan",
  "method": "POST",
  "requiresAuth": false,
  "expectedStatus": 200,
  "sdk": "semantic-service",
  "sourceFile": "services/semantic-service/src/routes.ts",
  "_generated": true,
  "testability": "auto",
  "dependsOn": [
    "POST /api/auth/signup-tenant",
    "POST /ontology/register"
  ],
  "captureResponse": {
    "intent.plan.response.data.plan_id": "data.plan_id",
    "intent.plan.response.data.intent_id": "data.intent_id",
    "intent.plan.response.data.subject_id": "data.subject_id",
    "intent.plan.response.data.status": "data.status"
  },
  "fieldEnums": {
    "status": ["proposed", "approved", "executing", "completed", "abandoned"]
  },
  "testCases": [
    {
      "name": "Plan a goal that matches a seeded capability edge (subject Patient)",
      "payload": {
        "intent": {
          "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}",
          "ontology_id": "{{cache:ontology.register.response.data.ontology.ontology_id}}",
          "goal": "summarize clinical note",
          "subject": {
            "type": "Patient",
            "id": "{{var:subject_id}}"
          },
          "parameters": {},
          "trace_id": "{{var:trace_id}}"
        },
        "agent_run_id": null
      },
      "expectedStatus": 200
    }
  ]
}
