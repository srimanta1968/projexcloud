{
  "endpoint": "/api/trace/exports",
  "sdk": "sdk-trace",
  "method": "POST",
  "taskId": "9f183ada-928d-4928-9d50-602d445af41d",
  "description": "Signed PDF/JSON trace export. Persists trace.export with artifact_s3_key + HMAC signature; emits trace.export.requested.v1 + trace.export.ready.v1 (operational retention).",
  "requiresAuth": true,
  "priority": 510,
  "sourceFile": "packages/sdk-trace/src/server/handlers/traceController.ts",
  "testability": "auto",
  "dependsOn": [
    "POST /api/auth/signup-tenant",
    "POST /api/personas",
    "POST /policy/:id/evaluate"
  ],
  "fieldEnums": {
    "format": [
      "pdf",
      "json"
    ]
  },
  "testCases": [
    {
      "name": "PDF export persists trace.export row with signature",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "payload": {
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}",
        "requestor_persona_id": "{{cache:personas.create.response.data.persona.persona_id}}",
        "trace_id": "{{cache:policy.evaluate.response.data.trace_id}}",
        "format": "pdf"
      },
      "expectedStatus": 201,
      "expectedResponse": {
        "success": true
      }
    }
  ],
  "captureResponse": {
    "trace.exports.response.data.export_id": "data.export_id",
    "trace.exports.response.data.trace_id": "data.trace_id",
    "trace.exports.response.data.tenant_id": "data.tenant_id",
    "trace.exports.response.data.artifact_s3_key": "data.artifact_s3_key"
  },
  "errorCases": [
    {
      "status": 401,
      "code": "Unauthorized",
      "message": "Missing bearer token",
      "when": "Authorization header absent or not Bearer form (requireAuth)"
    },
    {
      "status": 401,
      "code": "Unauthorized",
      "message": "Invalid or expired token",
      "when": "Bearer token fails JWT verification (requireAuth)"
    },
    {
      "status": 400,
      "code": "ValidationError",
      "message": "Required: tenant_id, requestor_persona_id, trace_id, format (pdf|json)",
      "when": "any of tenant_id/requestor_persona_id/trace_id/format missing"
    },
    {
      "status": 400,
      "code": "ValidationError",
      "message": "format must be pdf or json",
      "when": "format present but not 'pdf' or 'json'"
    },
    {
      "status": 404,
      "code": "NotFound",
      "message": "trace_id <id> not found",
      "when": "exportTrace/getTraceTimeline throws an Error whose message includes 'not found'"
    },
    {
      "status": 500,
      "code": "ExportFailed",
      "message": "Export failed",
      "when": "any other error thrown by exportTrace (insert failure, etc.)"
    }
  ]
}
