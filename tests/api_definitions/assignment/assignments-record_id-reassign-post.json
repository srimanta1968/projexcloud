{
  "sdk": "sdk-assignment",
  "sourceFile": "packages/sdk-assignment/src/server/routes.ts",
  "requiresAuth": true,
  "sprintId": "d4876947-8d18-4538-8e9f-51ba3e0735a9",
  "epicId": "af159e51-90a4-46cf-8d57-444515cfbe56",
  "taskId": "efd127bc-a016-41e2-8831-bca0388ebba1",
  "priority": 15,
  "testability": "auto",
  "name": "POST /api/assignments/:record_id/reassign - Move it, with a reason",
  "endpoint": "/api/assignments/:record_id/reassign",
  "method": "POST",
  "expectedStatus": 200,
  "description": "Moves ownership to a named persona. The reason is required for the same reason a decline needs one: without it the history reads as noise. THE SOURCE TIMESTAMP DOES NOT MOVE - this is the invariant the whole lifecycle is built around, enforced by a database trigger rather than trusted to callers, because a reassignment that reset the clock would make a subject waiting six hours read as fresh and the breach report say all is well. QA edge cases: reassigning a COMPLETED or CANCELLED assignment is 409; the new owner gets a fresh acceptance window; original_persona_id still names whoever had it first.",
  "dependsOn": [
    "POST /api/auth/signup-tenant",
    "POST /api/assignments",
    "POST /api/personas"
  ],
  "testCases": [
    {
      "name": "Reassign with a reason",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "pathParams": {
        "record_id": "{{cache:assignment.assignments.create.record_id}}"
      },
      "payload": {
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}",
        "to_persona_id": "{{var:coverage_backup_persona_id}}",
        "reason": "territory rebalance",
        "actor": "{{static:qa-manager}}"
      },
      "expectedStatus": 200,
      "expectedResponse": {
        "data": {
          "record_id": "string",
          "source_timestamp": "string"
        }
      }
    },
    {
      "name": "400 - a reassignment with no to_persona_id is refused",
      "testType": "negative",
      "coversErrorCase": "400|VALIDATION_ERROR",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "pathParams": {
        "record_id": "{{cache:assignment.assignments.create.record_id}}"
      },
      "payload": {
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}",
        "reason": "territory rebalance",
        "actor": "{{static:qa-manager}}"
      },
      "expectedStatus": 400,
      "expectedError": {
        "code": "VALIDATION_ERROR"
      }
    },
    {
      "name": "400 - a reassignment with no reason is refused",
      "testType": "negative",
      "coversErrorCase": "400|REASON_REQUIRED",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "pathParams": {
        "record_id": "{{cache:assignment.assignments.create.record_id}}"
      },
      "payload": {
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}",
        "to_persona_id": "{{var:coverage_backup_persona_id}}",
        "actor": "{{static:qa-manager}}"
      },
      "expectedStatus": 400,
      "expectedError": {
        "code": "REASON_REQUIRED"
      }
    },
    {
      "name": "401 - no tenant bearer token",
      "testType": "negative",
      "coversErrorCase": "401|Unauthorized",
      "headers": {},
      "pathParams": {
        "record_id": "{{cache:assignment.assignments.create.record_id}}"
      },
      "payload": {
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}",
        "to_persona_id": "{{var:coverage_backup_persona_id}}",
        "reason": "territory rebalance",
        "actor": "{{static:qa-manager}}"
      },
      "expectedStatus": 401,
      "expectedError": {
        "code": "Unauthorized"
      }
    }
  ],
  "errorCases": [
    {
      "name": "A reassignment with no target is refused",
      "status": 400,
      "code": "VALIDATION_ERROR",
      "message": "to_persona_id is required",
      "when": "the payload omits to_persona_id",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "pathParams": {
        "record_id": "{{cache:assignment.assignments.create.record_id}}"
      },
      "payload": {
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}",
        "reason": "x"
      },
      "expectedStatus": 400,
      "expectedError": {
        "code": "VALIDATION_ERROR"
      }
    },
    {
      "status": 400,
      "code": "REASON_REQUIRED",
      "message": "a reassignment must carry a reason",
      "when": "reason is missing, empty or whitespace"
    },
    {
      "name": "Unauthenticated is refused by the default-deny gate",
      "status": 401,
      "code": "Unauthorized",
      "message": "missing or invalid tenant token",
      "when": "no valid tenant Bearer token or scoped API key on the request",
      "expectedStatus": 401,
      "pathParams": {
        "record_id": "{{cache:assignment.assignments.create.record_id}}"
      },
      "payload": {
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}",
        "to_persona_id": "{{cache:personas.create.response.data.persona.persona_id}}",
        "reason": "x"
      }
    }
  ]
}
