{
  "sdk": "sdk-assignment",
  "sourceFile": "packages/sdk-assignment/src/server/routes.ts",
  "requiresAuth": true,
  "sprintId": "d4876947-8d18-4538-8e9f-51ba3e0735a9",
  "epicId": "af159e51-90a4-46cf-8d57-444515cfbe56",
  "taskId": "efd127bc-a016-41e2-8831-bca0388ebba1",
  "priority": 15,
  "testability": "auto",
  "name": "POST /api/assignments/:record_id/accept - The owner takes it",
  "endpoint": "/api/assignments/:record_id/accept",
  "method": "POST",
  "expectedStatus": 200,
  "description": "Marks the current primary as having accepted, which stops the acceptance window. IDEMPOTENT: accepting twice returns the ORIGINAL acceptance time rather than erroring, because a retrying client is ordinary and failing the retry would leave an acceptance that happened looking like one that did not. QA edge cases: accepting an assignment that is already COMPLETED or CANCELLED is 409; the source timestamp is untouched, as it is by every other transition.",
  "dependsOn": [
    "POST /api/personas",
    "POST /api/auth/signup-tenant",
    "POST /api/assignments"
  ],
  "captureResponse": {
    "assignment.accept.record_id": "data.record_id"
  },
  "testCases": [
    {
      "name": "Accept an offered assignment",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "pathParams": {
        "record_id": "{{cache:assignment.assignments.create.record_id}}"
      },
      "payload": {
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}",
        "persona_id": "{{cache:personas.create.response.data.persona.persona_id}}",
        "actor": "{{static:qa}}"
      },
      "expectedStatus": 200,
      "expectedResponse": {
        "data": {
          "record_id": "string",
          "state": "string"
        }
      }
    },
    {
      "name": "404 - the id names no assignment this tenant owns",
      "testType": "negative",
      "coversErrorCase": "404|ASSIGNMENT_NOT_FOUND",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "pathParams": {
        "record_id": "{{dynamic:uuid}}"
      },
      "payload": {
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}",
        "persona_id": "{{cache:personas.create.response.data.persona.persona_id}}",
        "actor": "{{static:qa}}"
      },
      "expectedStatus": 404,
      "expectedError": {
        "code": "ASSIGNMENT_NOT_FOUND"
      }
    },
    {
      "name": "401 - no tenant bearer token",
      "testType": "negative",
      "coversErrorCase": "401|Unauthorized",
      "headers": {},
      "pathParams": {
        "record_id": "{{cache:assignment.assignments.create.record_id}}"
      },
      "payload": {
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}",
        "persona_id": "{{cache:personas.create.response.data.persona.persona_id}}",
        "actor": "{{static:qa}}"
      },
      "expectedStatus": 401,
      "expectedError": {
        "code": "Unauthorized"
      }
    }
  ],
  "errorCases": [
    {
      "status": 409,
      "code": "INVALID_ASSIGNMENT_TRANSITION",
      "message": "cannot accept an assignment that is COMPLETED",
      "when": "the assignment has already been closed"
    },
    {
      "name": "An unknown assignment is refused",
      "status": 404,
      "code": "ASSIGNMENT_NOT_FOUND",
      "message": "no assignment <id>",
      "when": "the id names nothing belonging to this tenant",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "pathParams": {
        "record_id": "{{var:absent_uuid}}"
      },
      "payload": {
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}"
      },
      "expectedStatus": 404,
      "expectedError": {
        "code": "ASSIGNMENT_NOT_FOUND"
      }
    },
    {
      "name": "Unauthenticated is refused by the default-deny gate",
      "status": 401,
      "code": "Unauthorized",
      "message": "missing or invalid tenant token",
      "when": "no valid tenant Bearer token or scoped API key on the request",
      "expectedStatus": 401,
      "pathParams": {
        "record_id": "{{cache:assignment.assignments.create.record_id}}"
      },
      "payload": {
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}"
      }
    }
  ]
}
