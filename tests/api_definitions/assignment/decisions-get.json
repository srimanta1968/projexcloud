{
  "sdk": "sdk-assignment",
  "sourceFile": "packages/sdk-assignment/src/server/routes.ts",
  "requiresAuth": true,
  "sprintId": "d4876947-8d18-4538-8e9f-51ba3e0735a9",
  "epicId": "af159e51-90a4-46cf-8d57-444515cfbe56",
  "taskId": "efd127bc-a016-41e2-8831-bca0388ebba1",
  "priority": 15,
  "testability": "auto",
  "name": "GET /api/assignment/decisions - The recorded decisions and their traces",
  "endpoint": "/api/assignment/decisions",
  "method": "GET",
  "expectedStatus": 200,
  "description": "Reads decisions back: one by decision_id, or a filtered list by subject or outcome. Filtering on REVIEW is how an operator works the queue of subjects the pipeline deliberately refused to guess about. QA edge cases: the trace returned is the one recorded AT THE TIME, including the rule version - it is not recomputed, so it stays valid after the rules change; a decision_id belonging to another tenant is 404 rather than 403, because confirming an id exists elsewhere is itself a leak; the list is newest-first and limit is clamped to 500.",
  "dependsOn": [
    "POST /api/auth/signup-tenant",
    "POST /api/assignment/route"
  ],
  "fieldEnums": {
    "outcome": [
      "ASSIGNED",
      "FALLBACK",
      "REVIEW",
      "UNROUTABLE"
    ]
  },
  "testCases": [
    {
      "name": "Read one recorded decision by id",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "queryParams": {
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}",
        "decision_id": "{{cache:assignment.route.decision_id}}"
      },
      "expectedStatus": 200,
      "expectedResponse": {
        "data": {
          "decision_id": "string",
          "steps": "array"
        }
      }
    },
    {
      "name": "404 - the id names no decision this tenant owns",
      "testType": "negative",
      "coversErrorCase": "404|ROUTING_DECISION_NOT_FOUND",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "queryParams": {
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}",
        "decision_id": "{{dynamic:uuid}}"
      },
      "expectedStatus": 404,
      "expectedError": {
        "code": "ROUTING_DECISION_NOT_FOUND"
      }
    },
    {
      "name": "401 - no tenant bearer token",
      "testType": "negative",
      "coversErrorCase": "401|Unauthorized",
      "headers": {},
      "queryParams": {
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}",
        "decision_id": "{{cache:assignment.route.decision_id}}"
      },
      "expectedStatus": 401,
      "expectedError": {
        "code": "Unauthorized"
      }
    }
  ],
  "errorCases": [
    {
      "name": "An unknown decision id is refused",
      "status": 404,
      "code": "ROUTING_DECISION_NOT_FOUND",
      "message": "no decision <id>",
      "when": "the id names nothing belonging to this tenant",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "queryParams": {
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}",
        "decision_id": "{{var:absent_uuid}}"
      },
      "expectedStatus": 404,
      "expectedError": {
        "code": "ROUTING_DECISION_NOT_FOUND"
      }
    },
    {
      "name": "Unauthenticated is refused by the default-deny gate",
      "status": 401,
      "code": "Unauthorized",
      "message": "missing or invalid tenant token",
      "when": "no valid tenant Bearer token or scoped API key on the request",
      "expectedStatus": 401,
      "queryParams": {
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}"
      }
    }
  ]
}
