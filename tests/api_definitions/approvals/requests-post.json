{
  "name": "POST /api/approvals/requests - Submit approval request against a route",
  "endpoint": "/api/approvals/requests",
  "sdk": "sdk-approval",
  "sourceFile": "packages/sdk-approval/src/server/routes.ts",
  "method": "POST",
  "requiresAuth": true,
  "expectedStatus": 201,
  "taskId": "096441a3-9cf9-40e1-90ee-d0e0019da684",
  "sprintId": "8ef1d09e-dd8e-4daf-8d03-54dcd9f812f8",
  "featureId": "b273628f-6bee-4ad4-b5c0-9a9cb38da247",
  "epicId": "d83f7b6e-821c-4fe1-96e6-910eca8fbbfc",
  "priority": 30,
  "testability": "auto",
  "dependsOn": [
    "POST /api/auth/signup-tenant",
    "POST /api/approvals/routes"
  ],
  "testCases": [
    {
      "name": "Submit refund approval request",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "payload": {
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}",
        "route_id": "{{cache:approvals.routes.create.response.data.route.route_id}}",
        "subject_kind": "payment.refund",
        "subject_id": "{{dynamic:slug}}",
        "initiator_persona_id": "{{cache:auth.signup-tenant.response.data.userId}}",
        "reason": "Customer dispute - high value refund"
      },
      "expectedStatus": 201
    }
  ],
  "expectedResponse": {
    "data": {
      "request": {
        "request_id": "string",
        "status": "string"
      },
      "pending_steps": "array"
    }
  },
  "statusTransitions": {
    "entity": "approval.request",
    "field": "status",
    "flow": ["pending", "approved", "rejected", "escalated", "timed-out", "cancelled"],
    "transitions": [
      { "from": null, "to": "pending", "via": "POST /api/approvals/requests" }
    ]
  },
  "captureResponse": {
    "approvals.requests.create.response.data.request.request_id": "data.request.request_id",
    "approvals.requests.create.response.data.pending_steps.0.step_id": "data.pending_steps.0.step_id"
  }
}
