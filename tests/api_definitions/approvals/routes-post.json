{
  "name": "POST /api/approvals/routes - Create approval route definition",
  "endpoint": "/api/approvals/routes",
  "sdk": "sdk-approval",
  "sourceFile": "packages/sdk-approval/src/server/routes.ts",
  "method": "POST",
  "requiresAuth": true,
  "expectedStatus": 201,
  "taskId": "096441a3-9cf9-40e1-90ee-d0e0019da684",
  "sprintId": "8ef1d09e-dd8e-4daf-8d03-54dcd9f812f8",
  "featureId": "b273628f-6bee-4ad4-b5c0-9a9cb38da247",
  "epicId": "d83f7b6e-821c-4fe1-96e6-910eca8fbbfc",
  "priority": 20,
  "testability": "auto",
  "dependsOn": [
    "POST /api/auth/signup-tenant"
  ],
  "testCases": [
    {
      "name": "Create 2-step approval route (manager single -> finance m-of-n)",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "payload": {
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}",
        "name": "high-value-refund",
        "description": "Refunds above $10k",
        "kind_pattern": "payment.refund > 10000 USD",
        "steps": [
          {
            "name": "manager",
            "kind": "single",
            "approver_persona_id": "{{cache:auth.signup-tenant.response.data.userId}}",
            "sla_minutes": 60
          },
          {
            "name": "finance",
            "kind": "m-of-n",
            "m": 1,
            "approvers": [
              "{{cache:auth.signup-tenant.response.data.userId}}"
            ],
            "sla_minutes": 120
          }
        ],
        "delegation_rules": {}
      },
      "expectedStatus": 201
    }
  ],
  "expectedResponse": {
    "data": {
      "route": {
        "route_id": "string",
        "status": "string"
      }
    }
  },
  "fieldEnums": {
    "kind": ["single", "m-of-n", "role"],
    "status": ["draft", "active", "deprecated"]
  },
  "captureResponse": {
    "approvals.routes.create.response.data.route.route_id": "data.route.route_id"
  }
}
