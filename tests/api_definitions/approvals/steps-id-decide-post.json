{
  "name": "POST /api/approvals/steps/:step_id/decide - Approve or reject a step",
  "endpoint": "/api/approvals/steps/:step_id/decide",
  "sdk": "sdk-approval",
  "method": "POST",
  "requiresAuth": true,
  "expectedStatus": 200,
  "taskId": "096441a3-9cf9-40e1-90ee-d0e0019da684",
  "sprintId": "8ef1d09e-dd8e-4daf-8d03-54dcd9f812f8",
  "featureId": "b273628f-6bee-4ad4-b5c0-9a9cb38da247",
  "epicId": "d83f7b6e-821c-4fe1-96e6-910eca8fbbfc",
  "priority": 40,
  "testability": "manual",
  "skipReason": "Depends on a pending step assigned to the calling persona; covered by integration test.",
  "dependsOn": [
    "POST /api/auth/register",
    "POST /api/approvals/requests"
  ],
  "testCases": [
    {
      "name": "Approve manager step",
      "headers": {
        "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
      },
      "pathParams": {
        "step_id": "{{cache:approvals.requests.create.response.data.pending_steps.0.step_id}}"
      },
      "payload": {
        "decision": "{{static:approve}}",
        "acting_persona_id": "{{cache:auth.register.response.data.userId}}",
        "reason": "{{static:LGTM after review}}"
      },
      "expectedStatus": 200
    }
  ],
  "expectedResponse": {
    "data": {
      "step": {
        "decision": "string"
      },
      "request": {
        "status": "string"
      }
    }
  }
}
