{
  "name": "POST /api/assets — register a robot asset + component/sensor tree",
  "endpoint": "/api/assets",
  "sdk": "sdk-asset",
  "method": "POST",
  "requiresAuth": true,
  "expectedStatus": 201,
  "taskId": "7f314182-82c6-4490-88c3-0566cd805276",
  "featureId": "85dfaccb-afa3-4127-a702-7b0f7a116503",
  "epicId": "d386cc32-4151-4ae2-a337-a00891fc1d44",
  "sprintId": "efcf9cbd-5e84-469e-946e-efcabf8c88e1",
  "priority": 20,
  "dependsOn": [
    "POST /api/auth/signup-tenant"
  ],
  "testability": "auto",
  "captureResponse": {
    "assets.create.response.data.asset_id": "data.asset_id"
  },
  "testCases": [
    {
      "name": "Register a humanoid with a component/sensor tree",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "payload": {
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}",
        "bu_id": "{{var:bu_id}}",
        "device_uuid": "dev_robotA",
        "model": "Humanoid-X1",
        "display_name": "Unit-001",
        "components": [
          {
            "kind": "head",
            "name": "head",
            "position": { "x": 0, "y": 0, "z": 1 },
            "sensors": [
              {
                "kind": "camera",
                "unit": "frame",
                "min_value": 0,
                "max_value": 60,
                "sample_rate_hz": 30
              }
            ]
          },
          {
            "kind": "arm",
            "name": "left_arm",
            "children": [
              {
                "kind": "hand",
                "children": [
                  {
                    "kind": "finger",
                    "sensors": [
                      {
                        "kind": "force",
                        "unit": "N",
                        "min_value": 0,
                        "max_value": 100,
                        "sample_rate_hz": 200
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      },
      "expectedStatus": 201
    }
  ]
}
