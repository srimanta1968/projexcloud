{
  "name": "POST /api/taxonomy/versions/:taxonomy_version_id/activate — sdk-taxonomy",
  "endpoint": "/api/taxonomy/versions/:taxonomy_version_id/activate",
  "method": "POST",
  "requiresAuth": true,
  "dependsOn": [
    "POST /api/auth/signup-tenant"
  ],
  "expectedStatus": 200,
  "sdk": "sdk-taxonomy",
  "sourceFile": "packages/sdk-taxonomy/src/server/routes.ts",
  "_generated": true,
  "testability": "auto",
  "captureResponse": {
    "taxonomy.activate.response.data.activated_version_id": "data.activated_version_id"
  },
  "statusTransitions": {
    "entity": "taxonomy.version",
    "field": "status",
    "flow": [
      "draft",
      "active",
      "deprecated",
      "retired"
    ],
    "transitions": [
      {
        "from": "draft",
        "to": "active",
        "via": "POST /api/taxonomy/versions/:taxonomy_version_id/activate"
      },
      {
        "from": "active",
        "to": "deprecated",
        "via": "POST /api/taxonomy/versions/:taxonomy_version_id/activate"
      }
    ]
  },
  "testCases": [
    {
      "name": "Activate a taxonomy version (demotes prior active version to deprecated)",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "pathParams": {
        "taxonomy_version_id": "{{var:taxonomy_version_id}}"
      },
      "payload": {
        "taxonomy_version_id": "{{var:taxonomy_version_id}}"
      },
      "expectedStatus": 200
    }
  ]
}
