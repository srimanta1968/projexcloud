{
  "name": "PUT /api/flags - Upsert a feature flag",
  "endpoint": "/api/flags",
  "sdk": "sdk-feature-flags",
  "method": "PUT",
  "requiresAuth": true,
  "expectedStatus": 200,
  "taskId": "cbf65711-e8e1-41ad-84e6-7aa87b76d5a6",
  "sprintId": "8ef1d09e-dd8e-4daf-8d03-54dcd9f812f8",
  "featureId": "8eb2c617-783e-46b1-833c-93f347d4bb65",
  "epicId": "93a549d6-9a93-4d82-86bb-bac5167fa960",
  "priority": 30,
  "dependsOn": [
    "POST /api/auth/register"
  ],
  "testCases": [
    {
      "name": "Upsert agent kill-switch flag",
      "headers": {
        "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
      },
      "payload": {
        "flag_id": "{{static:agent.cost-steward.enabled}}",
        "description": "{{static:Per-agent kill switch}}",
        "kind": "{{static:boolean}}",
        "default_value": true,
        "kill_switch": false
      },
      "expectedStatus": 200
    }
  ],
  "captureResponse": {
    "flags.create.response.data.flag.flag_id": "data.flag.flag_id"
  }
}
