{
  "name": "POST /api/sequences/:sequence_id/triggers - Create an enrollment trigger",
  "endpoint": "/api/sequences/:sequence_id/triggers",
  "sdk": "sdk-sequence",
  "sourceFile": "packages/sdk-sequence/src/server/routes.ts",
  "method": "POST",
  "requiresAuth": true,
  "expectedStatus": 201,
  "taskId": "b926ca9e-6297-4c36-9c45-98552dfac81a",
  "sprintId": "d4876947-8d18-4538-8e9f-51ba3e0735a9",
  "priority": 44,
  "testability": "auto",
  "description": "Create (or upsert) an event-based enrollment trigger for a sequence: form_submit / reply / stage_change / manual / booking / tag_added. For stage_change, stage_id + trigger_on (enter/exit) apply. Idempotent per (sequence, event_type, stage_id, trigger_on). tenant_id is required.",
  "dependsOn": [
    "POST /api/auth/signup-tenant",
    "POST /api/sequences"
  ],
  "fieldEnums": {
    "event_type": ["form_submit", "reply", "stage_change", "manual", "booking", "tag_added"],
    "trigger_on": ["enter", "exit"]
  },
  "testCases": [
    {
      "name": "Enroll on form submission",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "pathParams": {
        "sequence_id": "{{cache:sequences.create.response.data.sequence.sequence_id}}"
      },
      "payload": {
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}",
        "event_type": "form_submit",
        "trigger_on": "enter",
        "condition_json": {},
        "enabled": true
      },
      "expectedStatus": 201,
      "expectedResponse": { "data": { "trigger": { "trigger_id": "string" } } }
    }
  ],
  "captureResponse": {
    "sequences.triggers.create.response.data.trigger.trigger_id": "data.trigger.trigger_id"
  },
  "errorCases": [
    { "status": 400, "code": "ValidationError", "message": "tenant_id is required", "when": "tenant_id missing" },
    { "status": 401, "code": "Unauthorized", "message": "missing or invalid token", "when": "no valid Bearer token" }
  ]
}
