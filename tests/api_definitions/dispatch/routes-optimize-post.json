{
  "name": "POST /api/dispatch/routes/optimize — api-gateway",
  "endpoint": "/api/dispatch/routes/optimize",
  "sdk": "sdk-dispatch",
  "method": "POST",
  "requiresAuth": true,
  "expectedStatus": 200,
  "sourceFile": "services/api-gateway/src/app.ts",
  "_generated": true,
  "testability": "auto",
  "dependsOn": [
    "POST /api/auth/register",
    "POST /api/app-identities",
    "POST /api/memberships",
    "POST /api/personas"
  ],
  "testCases": [
    {
      "name": "Optimize a dispatcher route from queued tasks",
      "payload": {
        "persona_id": "{{cache:personas.create.response.data.persona.persona_id}}",
        "task_ids": [
          "{{var:dispatch_task_id}}"
        ],
        "start_task_id": "{{var:dispatch_task_id}}"
      },
      "expectedStatus": 200,
      "headers": {
        "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
      }
    }
  ],
  "captureResponse": {
    "dispatch-routes.optimize.response.data.route_id": "route_id",
    "dispatch-routes.optimize.response.data.persona_id": "persona_id"
  }
}
