{
  "name": "POST /api/vault/encrypt - Envelope encrypt under a SecretRef",
  "endpoint": "/api/vault/encrypt",
  "method": "POST",
  "requiresAuth": true,
  "expectedStatus": 200,
  "taskId": "b58a50dc-fa1b-4964-8b9a-6a234b8d748c",
  "sprintId": "8ef1d09e-dd8e-4daf-8d03-54dcd9f812f8",
