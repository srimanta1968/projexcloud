  "epicId": "ee93bf20-3149-45d5-a712-d55cc74df2d9",
  "testCases": [
    {
      "name": "Encrypt a base64 plaintext",
      "payload": {
        "ref": "{{cache:secrets.store.response.data.ref}}",
        "plaintext_b64": "aGVsbG8td29ybGQ="
      },
      "expectedStatus": 200,
      "headers": {
        "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
      }
    }
  ],
  "dependsOn": ["POST /api/auth/register", "POST /api/secrets"],
  "expectedResponse": {
    "data": {
      "ciphertext_b64": "string",
