{
  "name": "POST /api/vault/keys — sdk-vault",
  "endpoint": "/api/vault/keys",
  "method": "POST",
  "requiresAuth": true,
  "dependsOn": [
    "POST /api/auth/signup-tenant",
    "POST /admin/vault/keys"
  ],
  "priority": 25,
  "expectedStatus": 201,
  "sdk": "sdk-vault",
  "sourceFile": "packages/sdk-vault/src/server/routes.ts",
  "_generated": true,
  "testability": "auto",
  "fieldEnums": {
    "tier": [
      "root",
      "app",
      "pool",
      "tenant",
      "person",
      "device",
      "encounter"
    ],
    "algorithm": [
      "AES-256-GCM",
      "ChaCha20-Poly1305"
    ]
  },
  "testCases": [
    {
      "name": "Issue the run tenant's tenant-tier key under the operator's root",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "payload": {
        "tier": "tenant",
        "parent_key_id": "{{cache:admin.vault.keys.create.response.data.key_id}}",
        "kms_ref": "{{static:kms-tenant-api-test}}",
        "algorithm": "AES-256-GCM",
        "region": "us-east-1"
      },
      "expectedStatus": 201,
      "expectedResponse": {
        "data": {
          "key_id": "string",
          "tier": "tenant"
        }
      }
    },
    {
      "name": "403 - a tenant cannot mint a platform (root) key",
      "testType": "negative",
      "coversErrorCase": "403|PlatformTier",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "payload": {
        "tier": "root",
        "kms_ref": "{{static:kms-root-x}}",
        "algorithm": "AES-256-GCM",
        "region": "us-east-1"
      },
      "expectedStatus": 403,
      "expectedError": {
        "code": "PlatformTier"
      }
    },
    {
      "name": "404 - the parent must be the tenant's own (or a platform key for the tenant tier)",
      "testType": "negative",
      "coversErrorCase": "404|NotFound",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "payload": {
        "tier": "person",
        "parent_key_id": "{{dynamic:uuid}}",
        "kms_ref": "{{static:kms-p}}",
        "algorithm": "AES-256-GCM",
        "region": "us-east-1"
      },
      "expectedStatus": 404
    },
    {
      "name": "401 - no token",
      "testType": "negative",
      "coversErrorCase": "401|Unauthorized",
      "headers": {},
      "payload": {
        "tier": "tenant"
      },
      "expectedStatus": 401
    }
  ],
  "captureResponse": {
    "vault.keys.create.response.data.key_id": "data.key_id"
  },
  "description": "Tenant route (Bearer JWT). A tenant issues a key in ITS OWN hierarchy: tenant_id comes from the token (a body tenant_id must match), platform tiers (root/app/pool) are refused with 403 PlatformTier (operators use POST /admin/vault/keys), and the parent must be the tenant's own key - or, for the tenant tier itself, a platform key. A tenant-tier key's scope_id is the tenant. The chain: the operator issues a root key, then this issues the run tenant's tenant-tier key under it - which is what POST /api/media/upload-url resolves (tier=tenant, scope=tenant, active), so no SQL seed is needed. 201 { data: key }. Errors: bad body 400; platform tier or another tenant 403; parent not the tenant's 404; no token 401.",
  "errorCases": [
    {
      "status": 400,
      "code": "ValidationError",
      "message": "parent_key_id is required for non-root tiers",
      "when": "bad body"
    },
    {
      "status": 403,
      "code": "PlatformTier",
      "message": "root keys wrap every tenant and are issued by an operator (POST /admin/vault/keys)",
      "when": "root/app/pool tier"
    },
    {
      "status": 404,
      "code": "NotFound",
      "message": "parent key not found",
      "when": "parent is another tenant's key or unknown"
    },
    {
      "status": 401,
      "code": "Unauthorized",
      "message": "authentication required",
      "when": "missing token"
    }
  ],
  "taskId": "d16623c0-a671-4f32-b8a1-6970f0773d76",
  "sprintId": "d4876947-8d18-4538-8e9f-51ba3e0735a9"
}
