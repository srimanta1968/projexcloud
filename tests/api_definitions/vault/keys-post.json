{
  "name": "POST /api/vault/keys — sdk-vault",
  "endpoint": "/api/vault/keys",
  "method": "POST",
  "requiresAuth": true,
  "dependsOn": [
    "POST /api/auth/register"
  ],
  "expectedStatus": 201,
  "sdk": "sdk-vault",
  "sourceFile": "packages/sdk-vault/src/server/routes.ts",
  "_generated": true,
  "testability": "auto",
  "fieldEnums": {
    "tier": ["root", "app", "pool", "tenant", "person", "device", "encounter"],
    "algorithm": ["AES-256-GCM", "ChaCha20-Poly1305"]
  },
  "testCases": [
    {
      "name": "Issue a root-tier vault key",
      "headers": {
        "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
      },
      "payload": {
        "tier": "root",
        "kms_ref": "kms-root-001",
        "algorithm": "AES-256-GCM",
        "region": "us-east-1"
      },
      "expectedStatus": 201
    }
  ],
  "captureResponse": {
    "vault.keys.create.response.data.key_id": "data.key_id"
  }
}
