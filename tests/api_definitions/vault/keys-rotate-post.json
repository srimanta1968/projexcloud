{
  "name": "POST /api/vault/keys/:key_id/rotate - Rotate vault key",
  "endpoint": "/api/vault/keys/:key_id/rotate",
  "sdk": "sdk-vault",
  "method": "POST",
  "requiresAuth": true,
  "expectedStatus": 200,
  "taskId": "bf11a5c0-8563-48d6-906e-9a9827d849f0",
  "sprintId": "8ef1d09e-dd8e-4daf-8d03-54dcd9f812f8",
  "featureId": "150fa460-13da-408f-8853-23942d923cf2",
  "epicId": "ee93bf20-3149-45d5-a712-d55cc74df2d9",
  "sourceFile": "packages/sdk-vault/src/server/routes.ts",
  "testability": "auto",
  "testCases": [
    {
      "name": "Rotate a freshly-issued key",
      "pathParams": {
        "key_id": "{{cache:vault.keys.create.response.data.key_id}}"
      },
      "payload": {
        "reason": "scheduled"
      },
      "expectedStatus": 200,
      "headers": {
        "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
      }
    }
  ],
  "dependsOn": [
    "POST /api/auth/register",
    "POST /api/vault/keys"
  ],
  "statusTransitions": {
    "entity": "vault.key",
    "field": "state",
    "flow": ["issued", "active", "rotated", "shredded"],
    "transitions": [
      { "from": "active", "to": "rotated", "via": "POST /api/vault/keys/:key_id/rotate" }
    ]
  },
  "captureResponse": {
    "vault.rotate.response.data.key_id": "data.key_id"
  }
}
