{
  "name": "POST /api/vault/keys/:key_id/shred — sdk-vault",
  "endpoint": "/api/vault/keys/:key_id/shred",
  "method": "POST",
  "requiresAuth": true,
  "dependsOn": [
    "POST /api/auth/register",
    "POST /api/vault/keys"
  ],
  "expectedStatus": 200,
  "sdk": "sdk-vault",
  "sourceFile": "packages/sdk-vault/src/server/routes.ts",
  "_generated": true,
  "testability": "auto",
  "testCases": [
    {
      "name": "Cryptographic-shred an issued key",
      "headers": {
        "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
      },
      "pathParams": {
        "key_id": "{{cache:vault.keys.create.response.data.key_id}}"
      },
      "payload": {
        "reason": "compliance-shred"
      },
      "expectedStatus": 200
    }
  ],
  "statusTransitions": {
    "entity": "vault.key",
    "field": "state",
    "flow": ["issued", "active", "rotated", "shredded"],
    "transitions": [
      { "from": "active", "to": "shredded", "via": "POST /api/vault/keys/:key_id/shred" },
      { "from": "rotated", "to": "shredded", "via": "POST /api/vault/keys/:key_id/shred" }
    ]
  },
  "captureResponse": {
    "vault.shred.response.data.key_id": "data.key_id"
  }
}
