{
  "name": "POST /api/vault/decrypt — sdk-vault",
  "endpoint": "/api/vault/decrypt",
  "method": "POST",
  "requiresAuth": true,
  "dependsOn": [
    "POST /api/auth/register",
    "POST /api/secrets",
    "POST /api/vault/encrypt"
  ],
  "expectedStatus": 200,
  "sdk": "sdk-vault",
  "sourceFile": "packages/sdk-vault/src/server/routes.ts",
  "_generated": true,
  "testability": "auto",
  "testCases": [
    {
      "name": "Decrypt an envelope bundle produced by /api/vault/encrypt",
      "headers": {
        "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
      },
      "payload": {
        "ref": "{{cache:secrets.store.response.data.ref}}",
        "ciphertext_b64": "{{cache:vault.encrypt.response.data.ciphertext_b64}}",
        "wrapped_dek_b64": "{{cache:vault.encrypt.response.data.wrapped_dek_b64}}",
        "iv_b64": "{{cache:vault.encrypt.response.data.iv_b64}}",
        "tag_b64": "{{cache:vault.encrypt.response.data.tag_b64}}"
      },
      "expectedStatus": 200
    }
  ],
  "expectedResponse": {
    "data": {
      "plaintext_b64": "string"
    }
  },
  "captureResponse": {
    "vault.decrypt.response.data.plaintext_b64": "data.plaintext_b64"
  }
}
