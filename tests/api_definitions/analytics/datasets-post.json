{
  "name": "POST /api/analytics/datasets — register a feature-dataset spec",
  "endpoint": "/api/analytics/datasets",
  "sdk": "sdk-analytics",
  "method": "POST",
  "requiresAuth": true,
  "expectedStatus": 201,
  "taskId": "1e108f10-9db0-467e-8457-e966deb347bf",
  "sprintId": "efcf9cbd-5e84-469e-946e-efcabf8c88e1",
  "priority": 50,
  "dependsOn": [
    "POST /api/auth/signup-tenant",
    "POST /api/assets"
  ],
  "testability": "auto",
  "fieldEnums": {
    "grain": ["minute", "hour", "day"],
    "aggregations": ["avg", "min", "max", "last", "count"]
  },
  "captureResponse": {
    "analytics.dataset.response.data.spec_id": "data.spec_id"
  },
  "testCases": [
    {
      "name": "Register a per-minute feature dataset spec",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "payload": {
        "name": "{{dynamic:name}}",
        "asset_id": "{{cache:assets.create.response.data.asset_id}}",
        "sensor_ids": [],
        "grain": "minute",
        "aggregations": [
          "avg",
          "min",
          "max",
          "last",
          "count"
        ],
        "label_source": {
          "kind": "intervals",
          "default_label": 0,
          "intervals": []
        }
      },
      "expectedStatus": 201,
      "testability": "auto"
    }
  ]
}
