  "testability": "manual",
  "skipReason": "Needs a real sub-bearing JWT and a registered dataset spec. Sets the labeling source (inline intervals, or a provider that joins events/evidence) so the next build produces a supervised dataset.",
  "testCases": [
    {
      "name": "Set interval-based labels",
      "headers": { "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}" },
