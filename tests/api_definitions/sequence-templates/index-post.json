{
  "name": "POST /api/sequence-templates - Create a reusable channel template",
  "endpoint": "/api/sequence-templates",
  "sdk": "sdk-sequence",
  "sourceFile": "packages/sdk-sequence/src/server/routes.ts",
  "method": "POST",
  "requiresAuth": true,
  "expectedStatus": 201,
  "taskId": "b926ca9e-6297-4c36-9c45-98552dfac81a",
  "sprintId": "d4876947-8d18-4538-8e9f-51ba3e0735a9",
  "priority": 41,
  "testability": "auto",
  "description": "Create a reusable message template (subject/body per channel) that sequence steps can reference. tenant_id and name are required; channel defaults to 'email'. UNIQUE per (tenant, name).",
  "dependsOn": [
    "POST /api/auth/signup-tenant"
  ],
  "fieldEnums": {
    "channel": ["email", "sms", "call", "linkedin", "task"]
  },
  "testCases": [
    {
      "name": "Create an email welcome template",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "payload": {
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}",
        "name": "{{dynamic:name}}",
        "channel": "email",
        "subject": "Welcome aboard",
        "body": "Hi {{name}}, welcome!",
        "category": "custom",
        "variables": ["name"]
      },
      "expectedStatus": 201,
      "expectedResponse": { "data": { "template": { "template_id": "string" } } }
    }
  ],
  "captureResponse": {
    "sequence-templates.create.response.data.template.template_id": "data.template.template_id"
  },
  "errorCases": [
    { "status": 400, "code": "ValidationError", "message": "tenant_id and name are required", "when": "tenant_id or name missing" },
    { "status": 401, "code": "Unauthorized", "message": "missing or invalid token", "when": "no valid Bearer token" }
  ]
}
