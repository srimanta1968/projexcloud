{
  "name": "POST /api/ingest/:entity/batch — sdk-ingest",
  "endpoint": "/api/ingest/:entity/batch",
  "method": "POST",
  "requiresAuth": false,
  "expectedStatus": 200,
  "sdk": "sdk-ingest",
  "sourceFile": "packages/sdk-ingest/src/server.ts",
  "testCases": [
    {
      "name": "Land a one-record batch for an entity (idempotent upsert)",
      "pathParams": {
        "entity": "{{static:demo_entity}}"
      },
      "payload": {
        "mode": "{{static:upsert}}",
        "idempotency_key": "{{dynamic:uuid}}",
        "records": [
          {
            "external_id": "{{dynamic:uuid}}",
            "name": "Demo Record",
            "value": 42
          }
        ]
      },
      "expectedStatus": 200
    }
  ],
  "fieldOptions": {
    "mode": ["upsert", "insert"]
  }
}
