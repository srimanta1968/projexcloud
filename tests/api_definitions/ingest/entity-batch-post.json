{
  "name": "POST /api/ingest/:entity/batch — sdk-ingest",
  "endpoint": "/api/ingest/:entity/batch",
  "method": "POST",
  "requiresAuth": true,
  "expectedStatus": 200,
  "sdk": "sdk-ingest",
  "sourceFile": "packages/sdk-ingest/src/server.ts",
  "fieldEnums": {
    "mode": [
      "upsert",
      "insert"
    ]
  },
  "captureResponse": {
    "ingest.batch.response.entity": "entity",
    "ingest.batch.response.imported": "imported"
  },
  "testCases": [
    {
      "name": "Land a one-record batch for an entity (idempotent upsert)",
      "pathParams": {
        "entity": "customer"
      },
      "payload": {
        "mode": "upsert",
        "idempotency_key": "{{dynamic:uuid}}",
        "records": [
          {
            "external_id": "EXT-1001",
            "name": "Demo Record",
            "value": 42
          }
        ]
      },
      "expectedStatus": 200,
      "headers": {
        "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
      }
    }
  ],
  "dependsOn": [
    "POST /api/auth/register"
  ]
}
