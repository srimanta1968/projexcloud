  "epicId": "93a549d6-9a93-4d82-86bb-bac5167fa960",
  "priority": 30,
  "testability": "auto",
  "dependsOn": [
    "POST /api/auth/register",
    "POST /scim/v2/Users"
  ],
  "captureResponse": {
    "claims.register.response.data.claim.claim_id": "data.claim.claim_id",
