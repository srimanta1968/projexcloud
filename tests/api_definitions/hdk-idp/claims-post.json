{
  "name": "POST /api/hdk-idp/claims - Register device claim (biometric + PIN)",
  "endpoint": "/api/hdk-idp/claims",
  "sdk": "hdk-idp",
  "method": "POST",
  "requiresAuth": true,
  "expectedStatus": 201,
  "taskId": "20d05b4b-b543-4b2d-b1e3-c230df085ecb",
  "sprintId": "8ef1d09e-dd8e-4daf-8d03-54dcd9f812f8",
