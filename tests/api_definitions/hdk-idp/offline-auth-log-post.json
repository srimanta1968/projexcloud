{
  "name": "POST /api/hdk-idp/offline-auth/log - Sync offline-auth event",
  "endpoint": "/api/hdk-idp/offline-auth/log",
  "sdk": "hdk-idp",
  "method": "POST",
  "requiresAuth": true,
  "expectedStatus": 201,
  "taskId": "20d05b4b-b543-4b2d-b1e3-c230df085ecb",
  "sprintId": "8ef1d09e-dd8e-4daf-8d03-54dcd9f812f8",
  "featureId": "c6a628f9-6d3a-4b36-b075-a3269e98833c",
  "epicId": "93a549d6-9a93-4d82-86bb-bac5167fa960",
  "priority": 50,
  "testability": "auto",
  "dependsOn": [
    "POST /api/auth/register",
    "POST /api/hdk-idp/claims"
  ],
  "fieldEnums": {
    "method": ["biometric", "pin", "passkey"]
  },
  "captureResponse": {
    "offline-auth.log.response.data.log.log_id": "data.log.log_id",
    "offline-auth.log.response.data.log.device_uuid": "data.log.device_uuid",
    "offline-auth.log.response.data.log.person_id": "data.log.person_id"
  },
  "testCases": [
    {
      "name": "Sync biometric offline-auth",
      "headers": {
        "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
      },
      "payload": {
        "device_uuid": "{{cache:claims.register.response.data.claim.device_uuid}}",
        "person_id": "{{cache:claims.register.response.data.claim.person_id}}",
        "method": "biometric",
        "occurred_at": "{{dynamic:pastdatetime}}"
      },
      "expectedStatus": 201
    }
  ]
}
