{
  "sdk": "sdk-api-keys",
  "sourceFile": "packages/sdk-api-keys/src/server/routes.ts",
  "requiresAuth": true,
  "sprintId": "d4876947-8d18-4538-8e9f-51ba3e0735a9",
  "epicId": "783fc94b-6992-49a5-a492-74ee0450a92f",
  "testability": "auto",
  "name": "GET /api/applications/{application_id} - Application with its keys",
  "endpoint": "/api/applications/:application_id",
  "method": "GET",
  "expectedStatus": 200,
  "taskId": "bcf23c76-2e69-48c2-af3f-84acc9e636d2",
  "featureId": "888ec9d8-5cbb-4d77-9082-fd78b08334ad",
  "priority": 22,
  "description": "One application and every key issued under it, revoked ones included so the history stays legible. Constrained to the tenant of the caller: an application_id belonging to somebody else answers 404 rather than 403, because a 403 confirms the id is real - exactly the fact an attacker enumerating ids is trying to establish. Returns 200 with application and keys.",
  "dependsOn": [
    "POST /api/auth/signup-tenant",
    "POST /api/applications"
  ],
  "fieldEnums": {
    "status": [
      "active",
      "rotating",
      "revoked",
      "expired"
    ],
    "environment": [
      "live",
      "test"
    ]
  },
  "testCases": [
    {
      "name": "Read the application just created",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "pathParams": {
        "application_id": "{{cache:applications.create.response.data.application.application_id}}"
      },
      "expectedStatus": 200,
      "expectedResponse": {
        "data": {
          "application": {
            "application_id": "string"
          },
          "keys": "array"
        }
      }
    }
  ],
  "errorCases": [
    {
      "name": "The application of another tenant is indistinguishable from one that does not exist",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "pathParams": {
        "application_id": "00000000-0000-0000-0000-0000000000ff"
      },
      "expectedStatus": 404
    }
  ]
}
