{
  "name": "POST /api/data-rights/requests - Submit DSAR request (AC-9)",
  "endpoint": "/api/data-rights/requests",
  "sdk": "sdk-data-rights",
  "sourceFile": "packages/sdk-data-rights/src/server/routes.ts",
  "method": "POST",
  "requiresAuth": true,
  "expectedStatus": 201,
  "taskId": "4e811425-e319-451a-9fa6-30c71717d88f",
  "sprintId": "8ef1d09e-dd8e-4daf-8d03-54dcd9f812f8",
  "featureId": "3eee9beb-21fc-4fd1-bf3f-1c172143a39b",
  "epicId": "93a549d6-9a93-4d82-86bb-bac5167fa960",
  "priority": 30,
  "testability": "auto",
  "dependsOn": [
    "POST /api/auth/signup-tenant",
    "POST /scim/v2/Users"
  ],
  "testCases": [
    {
      "name": "Submit erasure request",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "payload": {
        "person_id": "{{cache:scim.create.response.data.person_id}}",
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}",
        "kind": "erasure",
        "jurisdiction": "GDPR",
        "approval_policy": "manager-approval"
      },
      "expectedStatus": 201
    }
  ],
  "fieldEnums": {
    "kind": [
      "access",
      "erasure",
      "rectification",
      "restriction",
      "objection",
      "portability"
    ],
    "jurisdiction": [
      "GDPR",
      "DPDP",
      "CCPA",
      "LGPD"
    ],
    "approval_policy": [
      "auto",
      "manager-approval",
      "cross-tenant-approval"
    ]
  },
  "statusTransitions": {
    "entity": "data_rights.request",
    "field": "status",
    "flow": [
      "submitted",
      "identity-verified",
      "approval-pending",
      "grace-period",
      "executing",
      "certificate-issued",
      "audited"
    ],
    "transitions": [
      {
        "from": null,
        "to": "submitted",
        "via": "POST /api/data-rights/requests"
      }
    ]
  },
  "captureResponse": {
    "data-rights-requests.create.response.data.request.request_id": "data.request.request_id"
  }
}
