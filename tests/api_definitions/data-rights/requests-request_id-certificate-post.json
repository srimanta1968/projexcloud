{
  "name": "POST /api/data-rights/requests/:request_id/certificate - Issue completion certificate (AC-9)",
  "endpoint": "/api/data-rights/requests/:request_id/certificate",
  "sdk": "sdk-data-rights",
  "sourceFile": "packages/sdk-data-rights/src/server/routes.ts",
  "method": "POST",
  "requiresAuth": true,
  "expectedStatus": 201,
  "taskId": "4e811425-e319-451a-9fa6-30c71717d88f",
  "sprintId": "8ef1d09e-dd8e-4daf-8d03-54dcd9f812f8",
  "featureId": "3eee9beb-21fc-4fd1-bf3f-1c172143a39b",
  "epicId": "93a549d6-9a93-4d82-86bb-bac5167fa960",
  "priority": 80,
  "testability": "auto",
  "dependsOn": [
    "POST /api/auth/signup-tenant",
    "POST /api/data-rights/requests",
    "POST /api/data-rights/reconciliation/run"
  ],
  "testCases": [
    {
      "name": "Issue cert with shred proofs",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "pathParams": {
        "request_id": "{{cache:data-rights-requests.create.response.data.request.request_id}}"
      },
      "payload": {
        "shred_proofs": {
          "admin-us-east-1": "audit-hash-base64"
        },
        "artifact_s3_key": "s3://dsar-certs/erasure-cert.pdf",
        "signed_by_audit_entry_id": "{{var:signed_by_audit_entry_id}}"
      },
      "expectedStatus": 201
    }
  ],
  "captureResponse": {
    "data-rights-certificate.issue.response.data.certificate.certificate_id": "data.certificate.certificate_id"
  }
}
