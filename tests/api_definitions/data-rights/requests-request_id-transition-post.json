{
  "name": "POST /api/data-rights/requests/:request_id/transition - Advance DSAR state machine",
  "endpoint": "/api/data-rights/requests/:request_id/transition",
  "sdk": "sdk-data-rights",
  "sourceFile": "packages/sdk-data-rights/src/server/routes.ts",
  "method": "POST",
  "description": "Advances a DSAR request to a new lifecycle state. body.to must be one of submitted, identity-verified, approval-pending, grace-period, executing, certificate-issued, audited, rejected; approval_ref and grace_until are optional companions (grace_until is parsed as a Date). Edge cases: a missing or non-enum target state -> 400; an unknown request_id -> 404; a transition the state machine forbids from the request's current status -> 409 InvalidTransition carrying 'Invalid transition <current> -> <to>'; an unparseable grace_until becomes an Invalid Date rather than a 400; re-sending the same transition after it has been applied is itself an invalid transition and returns 409, so the endpoint is not idempotent.",
  "errorCases": [
    {
      "status": 401,
      "code": "Unauthorized",
      "message": "Missing bearer token",
      "when": "Authorization header absent or not in the form \"Bearer <jwt>\""
    },
    {
      "status": 401,
      "code": "Unauthorized",
      "message": "Invalid or expired token",
      "when": "JWT signature invalid, malformed, or past its exp claim"
    },
    {
      "status": 400,
      "code": "ValidationError",
      "message": "invalid target state",
      "when": "body.to is missing or not one of the eight DSAR_STATES values"
    },
    {
      "status": 404,
      "code": "NotFound",
      "message": "NotFound",
      "when": "transitionRequest finds no request row for request_id"
    },
    {
      "status": 409,
      "code": "InvalidTransition",
      "message": "Invalid transition <current status> → <to>",
      "when": "the DSAR state machine does not permit moving from the request's current status to the requested one"
    }
  ],
  "requiresAuth": true,
  "expectedStatus": 200,
  "taskId": "4e811425-e319-451a-9fa6-30c71717d88f",
  "sprintId": "8ef1d09e-dd8e-4daf-8d03-54dcd9f812f8",
  "featureId": "3eee9beb-21fc-4fd1-bf3f-1c172143a39b",
  "epicId": "93a549d6-9a93-4d82-86bb-bac5167fa960",
  "priority": 60,
  "testability": "auto",
  "dependsOn": [
    "POST /api/auth/signup-tenant",
    "POST /api/data-rights/requests"
  ],
  "testCases": [
    {
      "name": "Transition submitted -> identity-verified",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "pathParams": {
        "request_id": "{{cache:data-rights-requests.create.response.data.request.request_id}}"
      },
      "payload": {
        "to": "identity-verified",
        "approval_ref": "{{var:approval_ref}}",
        "grace_until": "{{dynamic:futuredatetime}}"
      },
      "expectedStatus": 200
    }
  ],
  "captureResponse": {
    "data-rights-requests.transition.response.data.request.request_id": "data.request.request_id",
    "data-rights-requests.transition.response.data.request.status": "data.request.status"
  },
  "fieldEnums": {
    "to": [
      "submitted",
      "identity-verified",
      "approval-pending",
      "grace-period",
      "executing",
      "certificate-issued",
      "audited",
      "rejected"
    ]
  },
  "statusTransitions": {
    "entity": "data_rights.request",
    "field": "status",
    "flow": [
      "submitted",
      "identity-verified",
      "approval-pending",
      "grace-period",
      "executing",
      "certificate-issued",
      "audited"
    ],
    "transitions": [
      {
        "from": "submitted",
        "to": "identity-verified",
        "via": "POST /api/data-rights/requests/:request_id/transition"
      },
      {
        "from": "identity-verified",
        "to": "approval-pending",
        "via": "POST /api/data-rights/requests/:request_id/transition"
      },
      {
        "from": "approval-pending",
        "to": "grace-period",
        "via": "POST /api/data-rights/requests/:request_id/transition"
      },
      {
        "from": "grace-period",
        "to": "executing",
        "via": "POST /api/data-rights/requests/:request_id/transition"
      },
      {
        "from": "executing",
        "to": "certificate-issued",
        "via": "POST /api/data-rights/requests/:request_id/transition"
      },
      {
        "from": "certificate-issued",
        "to": "audited",
        "via": "POST /api/data-rights/requests/:request_id/transition"
      },
      {
        "from": "submitted",
        "to": "rejected",
        "via": "POST /api/data-rights/requests/:request_id/transition"
      },
      {
        "from": "identity-verified",
        "to": "rejected",
        "via": "POST /api/data-rights/requests/:request_id/transition"
      },
      {
        "from": "approval-pending",
        "to": "rejected",
        "via": "POST /api/data-rights/requests/:request_id/transition"
      }
    ]
  }
}
