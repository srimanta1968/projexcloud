{
  "name": "POST /api/data-rights/residency/touch - Touch person_pool_residency (G5)",
  "endpoint": "/api/data-rights/residency/touch",
  "sdk": "sdk-data-rights",
  "sourceFile": "packages/sdk-data-rights/src/server/routes.ts",
  "method": "POST",
  "requiresAuth": true,
  "expectedStatus": 200,
  "taskId": "4e811425-e319-451a-9fa6-30c71717d88f",
  "sprintId": "8ef1d09e-dd8e-4daf-8d03-54dcd9f812f8",
  "featureId": "3eee9beb-21fc-4fd1-bf3f-1c172143a39b",
  "epicId": "93a549d6-9a93-4d82-86bb-bac5167fa960",
  "priority": 30,
  "testability": "auto",
  "dependsOn": [
    "POST /api/auth/signup-tenant"
  ],
  "testCases": [
    {
      "name": "Record residency for a person+pool",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "payload": {
        "person_id": "{{var:person_id}}",
        "pool_index": "admin-us-east-1",
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}",
        "data_classes": [
          "profile",
          "persona"
        ]
      },
      "expectedStatus": 200
    }
  ],
  "captureResponse": {
    "data-rights-residency.touch.response.data.residency.residency_id": "data.residency.residency_id"
  },
  "description": "Upserts (touches) a person_pool_residency record for a person+pool, returning 200 with the record. Requires person_id, pool_index and tenant_id; data_classes is optional and defaults to an empty array. Edge cases: each of the three required fields missing.",
  "errorCases": [
    {
      "status": 401,
      "code": "Unauthorized",
      "message": "Missing bearer token",
      "when": "Authorization header absent or not Bearer form (requireAuth)"
    },
    {
      "status": 401,
      "code": "Unauthorized",
      "message": "Invalid or expired token",
      "when": "Bearer token fails JWT verification (requireAuth)"
    },
    {
      "status": 400,
      "code": "ValidationError",
      "message": "missing fields",
      "when": "person_id, pool_index or tenant_id missing from body"
    }
  ]
}
