{
  "name": "PUT /api/profile/bands - Upsert L2 profile band",
  "endpoint": "/api/profile/bands",
  "sdk": "sdk-profile",
  "method": "PUT",
  "requiresAuth": true,
  "expectedStatus": 200,
  "taskId": "dc2e5cf3-1b7b-4dad-ae74-78b9f5ed6d14",
  "sprintId": "8ef1d09e-dd8e-4daf-8d03-54dcd9f812f8",
