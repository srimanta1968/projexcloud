{
  "name": "POST /api/hdk/measure — hdk-measure",
  "endpoint": "/api/hdk/measure",
  "method": "POST",
  "requiresAuth": false,
  "expectedStatus": 201,
  "sdk": "hdk-measure",
  "sourceFile": "packages/hdk-measure/src/server/index.ts",
  "_generated": true,
  "testability": "auto",
  "dependsOn": [
    "POST /api/auth/signup-tenant"
  ],
  "fieldEnums": {
