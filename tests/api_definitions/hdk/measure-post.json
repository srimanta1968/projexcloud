  "captureResponse": {
    "measure.create.response.data.measurement_id": "data.measurement_id",
    "measure.create.response.data.capture_id": "data.capture_id"
  },
  "testCases": [
    {
      "name": "Record an AR measurement",
      "payload": {
        "capture_id": "{{var:capture_id}}",
        "kind": "distance",
        "value": 3.5,
        "unit": "m",
        "accuracy_class": "high",
        "device_uuid": "{{dynamic:uuid}}",
        "captured_at": "{{dynamic:pastdatetime}}",
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}"
      },
      "expectedStatus": 201
    }
  ]
}
