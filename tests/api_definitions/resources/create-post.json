{
  "name": "POST /api/resources - register an owned infra resource",
  "endpoint": "/api/resources",
  "method": "POST",
  "requiresAuth": true,
  "expectedStatus": 201,
  "taskId": "317eb69b-9b28-4831-a9d6-fa823384b2c6",
  "sprintId": "efcf9cbd-5e84-469e-946e-efcabf8c88e1",
  "featureId": "a5e2bb64-87b9-4f98-abb8-383750f3b56b",
  "epicId": "1f467f44-ec1c-4e5e-86f7-c5e33b6b58b6",
  "priority": 30,
  "dependsOn": ["POST /api/auth/register"],
  "captureResponse": {
    "resources.create.response.data.resource.resource_id": "data.resource.resource_id"
  },
  "testCases": [
    {
      "name": "Register an owned resource with owner + approver",
      "headers": { "Authorization": "Bearer {{cache:auth.register.response.data.token}}" },
      "payload": {
        "resource_id": "{{dynamic:uuid}}",
        "resource_type": "s3_bucket",
        "environment": "dev",
        "owner": "platform-team",
        "approved_by": "cto"
      },
      "expectedStatus": 201
    }
  ],
  "expectedResponse": {
    "data": { "resource": { "resource_id": "string", "owner": "string", "approved_by": "string" } }
  }
}
