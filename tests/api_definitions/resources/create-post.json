{
  "name": "POST /api/resources - register an owned infra resource",
  "endpoint": "/api/resources",
  "sdk": "sdk-resource-registry",
  "method": "POST",
  "requiresAuth": true,
  "expectedStatus": 201,
  "taskId": "317eb69b-9b28-4831-a9d6-fa823384b2c6",
  "sprintId": "efcf9cbd-5e84-469e-946e-efcabf8c88e1",
  "featureId": "a5e2bb64-87b9-4f98-abb8-383750f3b56b",
  "epicId": "1f467f44-ec1c-4e5e-86f7-c5e33b6b58b6",
  "priority": 30,
  "dependsOn": [
    "POST /api/auth/register"
  ],
  "captureResponse": {
    "resources.create.response.data.resource.resource_id": "data.resource.resource_id"
  },
  "fieldEnums": {
    "environment": ["dev", "staging", "prod"],
    "status": ["registered", "quarantined"]
  },
  "testCases": [
    {
      "name": "Register an owned resource with owner + approver",
      "headers": {
        "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
      },
      "payload": {
        "resource_id": "{{var:resource_id}}",
        "resource_type": "s3_bucket",
        "environment": "dev",
        "owner": "platform-team",
        "approved_by": "cto",
        "team": "platform",
        "repo": "org/infra-platform",
        "terraform_module": "modules/s3-bucket",
        "cloud_account": "123456789012",
        "cost_center": "CC-1001",
        "data_classification": "internal",
        "network_zone": "private",
        "created_by": "gitops-sync",
        "expires_at": "{{dynamic:futuredatetime}}"
      },
      "expectedStatus": 201
    }
  ],
  "expectedResponse": {
    "data": {
      "resource": {
        "resource_id": "string",
        "owner": "string",
        "approved_by": "string"
      }
    }
  }
}
