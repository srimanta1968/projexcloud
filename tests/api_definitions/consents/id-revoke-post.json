{
  "name": "POST /api/consents/:receipt_id/revoke - Revoke consent",
  "endpoint": "/api/consents/:receipt_id/revoke",
  "sdk": "sdk-consent",
  "sourceFile": "packages/sdk-consent/src/server/routes.ts",
  "method": "POST",
  "requiresAuth": true,
  "expectedStatus": 200,
  "taskId": "67ffde85-0978-4c52-889c-9641ee995256",
  "sprintId": "8ef1d09e-dd8e-4daf-8d03-54dcd9f812f8",
  "featureId": "29651845-09ac-4f92-8964-35792daf8a86",
  "epicId": "00996d23-f667-4a82-9285-7728ba357e7b",
  "priority": 60,
  "dependsOn": [
    "POST /api/auth/register",
    "POST /api/consents/purposes",
    "POST /api/consents"
  ],
  "testCases": [
    {
      "name": "Revoke the previously granted receipt",
      "headers": {
        "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
      },
      "pathParams": {
        "receipt_id": "{{cache:consents.create.response.data.receipt.receipt_id}}"
      },
      "payload": {
        "revoked_by": "{{cache:auth.register.response.data.userId}}",
        "reason": "User requested withdrawal of marketing consent."
      },
      "expectedStatus": 200
    }
  ],
  "statusTransitions": {
    "entity": "consent.receipt",
    "field": "revoked_at",
    "flow": [
      "active",
      "revoked"
    ],
    "transitions": [
      {
        "from": "active",
        "to": "revoked",
        "via": "POST /api/consents/:receipt_id/revoke"
      }
    ]
  },
  "expectedResponse": {
    "data": {
      "revocation": {
        "revocation_id": "string",
        "receipt_id": "string"
      }
    }
  },
  "captureResponse": {
    "consents.revoke.response.data.revocation.revocation_id": "data.revocation.revocation_id"
  }
}
