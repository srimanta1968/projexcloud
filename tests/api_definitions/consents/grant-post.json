{
  "name": "POST /api/consents - Grant consent receipt",
  "endpoint": "/api/consents",
  "sdk": "sdk-consent",
  "method": "POST",
  "requiresAuth": true,
  "expectedStatus": 201,
  "taskId": "23e995f5-e424-4525-8748-64937ca3181b",
  "sprintId": "8ef1d09e-dd8e-4daf-8d03-54dcd9f812f8",
  "featureId": "29651845-09ac-4f92-8964-35792daf8a86",
  "epicId": "00996d23-f667-4a82-9285-7728ba357e7b",
  "priority": 40,
  "dependsOn": [
    "POST /api/auth/register",
    "POST /api/consents/purposes"
  ],
  "testCases": [
    {
      "name": "Grant consent for the registered purpose",
      "headers": {
        "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
      },
      "payload": {
        "person_id": "{{cache:auth.register.response.data.userId}}",
        "purpose_id": "{{cache:consents.purposes.create.response.data.purpose.purpose_id}}",
        "processor": "tenant",
        "app_id": "healthcare",
        "jurisdiction": "US-CA",
        "granted_by_actor": "{{cache:auth.register.response.data.userId}}"
      },
      "expectedStatus": 201
    }
  ],
  "expectedResponse": {
    "data": {
      "receipt": {
        "receipt_id": "string",
        "person_id": "string",
        "purpose_id": "string"
      }
    }
  },
  "captureResponse": {
    "consents.create.response.data.receipt.receipt_id": "data.receipt.receipt_id"
  }
}
