{
  "name": "POST /api/consents/purposes - Register typed purpose",
  "endpoint": "/api/consents/purposes",
  "sdk": "sdk-consent",
  "sourceFile": "packages/sdk-consent/src/server/routes.ts",
  "method": "POST",
  "requiresAuth": true,
  "expectedStatus": 201,
  "taskId": "64896498-5d10-47c8-b27a-dd94525f1c52",
  "sprintId": "8ef1d09e-dd8e-4daf-8d03-54dcd9f812f8",
  "featureId": "29651845-09ac-4f92-8964-35792daf8a86",
  "epicId": "00996d23-f667-4a82-9285-7728ba357e7b",
  "priority": 30,
  "dependsOn": [
    "POST /api/auth/register"
  ],
  "testCases": [
    {
      "name": "Register a marketing-email purpose",
      "headers": {
        "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
      },
      "payload": {
        "purpose_id": "{{dynamic:slug}}",
        "app_id": "healthcare",
        "description": "Send transactional and marketing emails about appointments and offers.",
        "legal_basis": "consent",
        "default_jurisdictions": [
          "US-CA",
          "EU"
        ]
      },
      "expectedStatus": 201
    }
  ],
  "fieldEnums": {
    "legal_basis": [
      "consent",
      "contract",
      "legitimate-interest",
      "vital",
      "public-task",
      "legal-obligation"
    ]
  },
  "expectedResponse": {
    "data": {
      "purpose": {
        "purpose_id": "string",
        "app_id": "string",
        "legal_basis": "string"
      }
    }
  },
  "captureResponse": {
    "consents.purposes.create.response.data.purpose.purpose_id": "data.purpose.purpose_id"
  }
}
