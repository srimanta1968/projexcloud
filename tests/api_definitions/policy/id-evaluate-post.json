{
  "name": "POST /policy/:id/evaluate — semantic-service",
  "endpoint": "/policy/:id/evaluate",
  "method": "POST",
  "requiresAuth": true,
  "expectedStatus": 200,
  "sdk": "semantic-service",
  "sourceFile": "services/semantic-service/src/routes.ts",
  "_generated": true,
  "dependsOn": [
    "POST /api/auth/register",
    "POST /policy/register"
  ],
  "testability": "auto",
  "testCases": [
    {
      "name": "Evaluate an active semantic policy (happy path)",
      "pathParams": {
        "id": "{{cache:policy.register.response.data.policy_id}}"
      },
      "payload": {
        "subject_type": "Doctor",
        "subject_id": "{{var:subject_id}}",
        "action": "write",
        "resource_type": "Prescription",
        "resource_id": "{{var:resource_id}}",
        "active_edges": [
          {
            "kind": "care-team",
            "from_object_type": "Doctor",
            "to_object_type": "Patient",
            "to_object_id": "{{var:resource_id}}",
            "active": true
          }
        ],
        "trace_id": "{{var:trace_id}}"
      },
      "expectedStatus": 200,
      "headers": {
        "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
      }
    }
  ],
  "expectedResponse": {
    "data": {
      "policy_id": "string",
      "decision": "string",
      "reason": "string",
      "latency_ms": 0,
      "trace_id": "string"
    }
  },
  "captureResponse": {
    "policy.evaluate.response.data.policy_id": "data.policy_id",
    "policy.evaluate.response.data.decision": "data.decision",
    "policy.evaluate.response.data.trace_id": "data.trace_id"
  }
}
