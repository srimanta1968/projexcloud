{
  "name": "POST /policy/register — semantic-service",
  "endpoint": "/policy/register",
  "method": "POST",
  "requiresAuth": false,
  "expectedStatus": 200,
  "sdk": "semantic-service",
  "sourceFile": "services/semantic-service/src/routes.ts",
  "_generated": true,
  "testability": "auto",
  "dependsOn": [
    "POST /api/auth/signup-tenant",
    "POST /ontology/register"
  ],
  "testCases": [
    {
      "name": "Register + activate a Doctor→Prescription semantic policy",
      "payload": {
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}",
        "ontology_id": "{{cache:ontology.register.response.data.ontology.ontology_id}}",
        "name": "{{dynamic:name}}",
        "description": "Doctor with active care-team may write a Prescription",
        "iql_source": "ALLOW Doctor WITH care-team(Patient) TO write Prescription",
        "activate": true
      },
      "expectedStatus": 200
    }
  ],
  "statusTransitions": {
    "entity": "semantic.policy",
    "field": "status",
    "flow": ["draft", "active", "deprecated"],
    "transitions": [
      { "from": "draft", "to": "active", "via": "POST /policy/register" }
    ]
  },
  "expectedResponse": {
    "data": {
      "policy_id": "string",
      "tenant_id": "string",
      "ontology_id": "string",
      "name": "string",
      "status": "string"
    }
  },
  "captureResponse": {
    "policy.register.response.data.policy_id": "data.policy_id",
    "policy.register.response.data.ontology_id": "data.ontology_id",
    "policy.register.response.data.status": "data.status"
  }
}
