  "testCases": [
    {
      "name": "List the tenant's draft campaigns",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "queryParams": {
        "status": "{{static:draft}}"
      },
      "expectedStatus": 200,
