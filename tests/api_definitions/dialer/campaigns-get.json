              "name": "string",
              "status": "string",
              "window_start": "string",
              "window_end": "string"
            }
          ],
          "limit": "number",
          "offset": "number"
        }
      }
    },
    {
      "name": "Reject an unknown status filter",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "queryParams": {
        "status": "{{static:exploded}}"
      },
      "expectedStatus": 400
    }
  ],
  "errorCases": [
    {
      "status": 400,
