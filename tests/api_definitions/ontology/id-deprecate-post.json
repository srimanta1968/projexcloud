{
  "name": "POST /ontology/:id/deprecate — semantic-service",
  "endpoint": "/ontology/:id/deprecate",
  "method": "POST",
  "requiresAuth": true,
  "expectedStatus": 200,
  "sdk": "semantic-service",
  "sourceFile": "services/semantic-service/src/routes.ts",
  "_generated": true,
  "testability": "auto",
  "dependsOn": [
