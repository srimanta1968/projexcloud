      "name": "Deprecate a registered ontology version",
      "pathParams": {
        "id": "{{cache:ontology.register.response.data.ontology.ontology_id}}"
      },
      "payload": {
        "reason": "superseded by healthcare-core 2.0.0"
      },
      "expectedStatus": 200,
      "headers": {
        "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
      }
    }
  ]
