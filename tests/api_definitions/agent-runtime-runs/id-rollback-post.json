{
  "endpoint": "/api/agent-runtime/runs/:run_id/rollback",
  "sdk": "sdk-agent-runtime",
  "method": "POST",
  "taskId": "d5cab8c0-26bf-462e-9a49-d11aed1552e8",
  "description": "Roll back an agent run by replaying agents.action_journal in reverse from latest step down to ?to_seq=N. Invokes per-action_type compensation handlers. Returns RollbackSummary. AC-8. A freshly-started run has an empty action_journal, so rollback returns 200 with attempted=0.",
  "sourceFile": "packages/sdk-agent-runtime/src/server/handlers/rollbackController.ts",
  "requiresAuth": true,
  "priority": 210,
  "testability": "auto",
  "dependsOn": [
    "POST /api/auth/register",
    "POST /api/personas",
    "POST /api/agent-runtime/agents",
    "POST /api/agent-runtime/runs"
  ],
  "captureResponse": {
    "agent-runtime-runs.rollback.response.data.run_id": "data.run_id"
  },
  "testCases": [
    {
      "name": "Roll back a freshly-started run (empty action journal) returns 200",
      "headers": {
        "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
      },
      "pathParams": {
        "run_id": "{{cache:agent-runtime-runs.create.response.data.run_id}}"
      },
      "payload": {
        "reason": "Operator-initiated rollback for testing",
        "actor_id": "{{var:operator_id}}"
      },
      "expectedStatus": 200,
      "expectedResponse": {
        "success": true
      }
    }
  ]
}
