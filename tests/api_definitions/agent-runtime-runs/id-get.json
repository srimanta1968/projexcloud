{
  "endpoint": "/api/agent-runtime/runs/:id",
  "sdk": "sdk-agent-runtime",
  "method": "GET",
  "taskId": "72094eaa-8bdc-4be0-9fe4-e35f952b98cf",
  "description": "Fetch a single agent_run including agent_chain + execution_log_ref.",
  "requiresAuth": true,
  "priority": 80,
  "dependsOn": [
    "POST /api/auth/register",
    "POST /api/agent-runtime/runs"
  ],
  "testCases": [
    {
      "name": "Get agent run",
      "headers": {
        "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
      },
      "pathParams": {
        "id": "{{cache:agent-runtime-runs.create.response.data.run_id}}"
      },
      "expectedStatus": 200,
      "expectedResponse": {
        "success": true
      }
    }
  ],
  "errorCases": [
    {
      "status": 401,
      "code": "Unauthorized",
      "message": "Missing bearer token",
      "when": "No Authorization: Bearer <jwt> header on a requireAuth route"
    },
    {
      "status": 401,
      "code": "Unauthorized",
      "message": "Invalid or expired token",
      "when": "Bearer token fails verifyJwt (bad signature, malformed, or exp in the past)"
    },
    {
      "status": 400,
      "code": "ValidationError",
      "message": "Missing path param: id",
      "when": "The :id path segment resolves to an empty value"
    },
    {
      "status": 404,
      "code": "NotFound",
      "message": "agent_run not found",
      "when": "getAgentRun returns no row for the supplied id"
    },
    {
      "status": 500,
      "code": "InternalError",
      "message": "Lookup failed",
      "when": "getAgentRun throws — e.g. id is not a valid UUID and the query cast fails, or the database is unreachable"
    }
  ]
}
