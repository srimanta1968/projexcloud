{
  "name": "POST /api/break-glass/:grant_id/decide - approve/reject emergency access",
  "endpoint": "/api/break-glass/:grant_id/decide",
  "sdk": "sdk-approval",
  "sourceFile": "packages/sdk-approval/src/server/routes.ts",
  "method": "POST",
  "requiresAuth": true,
  "taskId": "a89d8cd9-638e-40e6-86d3-c22bf8385c53",
  "sprintId": "efcf9cbd-5e84-469e-946e-efcabf8c88e1",
  "featureId": "d00b18c5-a75a-4a02-8e0e-b6f941ac60c1",
  "epicId": "0d61fa89-b842-43af-baf9-42454044726f",
  "expectedStatus": 200,
  "testability": "auto",
  "dependsOn": [
    "POST /api/auth/signup-tenant",
    "POST /api/approvals/routes",
    "POST /api/break-glass"
  ],
  "testCases": [
    {
      "name": "Approve the gating request, activating the grant",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "pathParams": {
        "grant_id": "{{cache:break-glass.request.response.data.grant.grant_id}}"
      },
      "payload": {
        "step_id": "{{cache:break-glass.request.response.data.pending_step_ids.0}}",
        "decision": "approve",
        "reason": "Emergency verified - access approved"
      },
      "expectedStatus": 200
    }
  ],
  "expectedResponse": {
    "data": {
      "grant": {
        "grant_id": "string",
        "status": "string"
      }
    }
  },
  "fieldEnums": {
    "decision": ["approve", "reject"]
  },
  "statusTransitions": {
    "entity": "approval.break_glass_grant",
    "field": "status",
    "flow": ["pending", "active", "expired", "revoked"],
    "transitions": [
      { "from": "pending", "to": "active", "via": "POST /api/break-glass/:grant_id/decide" },
      { "from": "pending", "to": "revoked", "via": "POST /api/break-glass/:grant_id/decide" }
    ]
  },
  "captureResponse": {
    "break-glass.decide.response.data.grant.grant_id": "data.grant.grant_id",
    "break-glass.decide.response.data.grant.status": "data.grant.status"
  }
}
