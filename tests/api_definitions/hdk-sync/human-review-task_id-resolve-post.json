{
  "name": "POST /api/hdk-sync/human-review/:task_id/resolve - Reviewer resolves a queued conflict",
  "endpoint": "/api/hdk-sync/human-review/:task_id/resolve",
  "sdk": "hdk-sync",
  "method": "POST",
  "requiresAuth": true,
  "expectedStatus": 200,
  "taskId": "07a04c67-09aa-4656-9ec7-84301089abeb",
  "sprintId": "8ef1d09e-dd8e-4daf-8d03-54dcd9f812f8",
  "featureId": "83a11862-0f2a-43be-b8bf-c2bec019500d",
  "epicId": "93a549d6-9a93-4d82-86bb-bac5167fa960",
  "priority": 80,
  "testability": "auto",
  "dependsOn": [
    "POST /api/auth/register",
    "PUT /api/hdk-sync/event-type-policies",
    "POST /api/hdk-sync/conflicts/resolve"
  ],
  "testCases": [
    {
      "name": "Mark task resolved",
      "headers": {
        "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
      },
      "pathParams": {
        "task_id": "{{cache:hdk-sync.conflicts-resolve.response.data.human_review_task.task_id}}"
      },
      "payload": {
        "status": "resolved",
        "resolved_value": {
          "decision": "merge"
        }
      },
      "expectedStatus": 200
    }
  ],
  "fieldEnums": {
    "status": [
      "open",
      "in-review",
      "resolved",
      "rejected"
    ]
  },
  "statusTransitions": {
    "entity": "hdk_sync.human_review_task",
    "field": "status",
    "flow": [
      "open",
      "in-review",
      "resolved",
      "rejected"
    ],
    "transitions": [
      {
        "from": "open",
        "to": "resolved",
        "via": "POST /api/hdk-sync/human-review/:task_id/resolve"
      },
      {
        "from": "open",
        "to": "rejected",
        "via": "POST /api/hdk-sync/human-review/:task_id/resolve"
      },
      {
        "from": "in-review",
        "to": "resolved",
        "via": "POST /api/hdk-sync/human-review/:task_id/resolve"
      }
    ]
  },
  "captureResponse": {
    "hdk-sync.human-review-resolve.response.data.task.task_id": "data.task.task_id"
  },
  "description": "Resolves a queued human-review task by setting its status (open | in-review | resolved | rejected) and recording the reviewer's chosen resolved_value. resolved_value is optional and defaults to NULL, so a task may be rejected with no payload. Edge cases: status is checked against an explicit whitelist, so a missing OR unrecognised status is a 400; an unknown :task_id returns 404; there is no state-machine guard — re-resolving an already-resolved task is accepted as long as the row still matches, so idempotency must be enforced by the caller.",
  "errorCases": [
    {
      "status": 401,
      "code": "Unauthorized",
      "message": "Missing bearer token",
      "when": "Authorization header absent or not in 'Bearer <jwt>' form (requireAuth preHandler)"
    },
    {
      "status": 401,
      "code": "Unauthorized",
      "message": "Invalid or expired token",
      "when": "JWT signature invalid, malformed, or exp has elapsed"
    },
    {
      "status": 400,
      "code": "ValidationError",
      "message": "invalid status",
      "when": "status is absent or is not one of open, in-review, resolved, rejected"
    },
    {
      "status": 404,
      "code": "NotFound",
      "message": "NotFound",
      "when": "no human-review task matches :task_id"
    }
  ]
}
