{
  "name": "POST /api/commands \u2014 issue a command to a robot asset/component",
  "endpoint": "/api/commands",
  "sdk": "sdk-command",
  "sourceFile": "services/api-gateway/src/app.ts",
  "method": "POST",
  "requiresAuth": true,
  "expectedStatus": 201,
  "taskId": "2714a4d2-08d5-41cd-99ac-5677bd53c6d4",
  "sprintId": "efcf9cbd-5e84-469e-946e-efcabf8c88e1",
  "priority": 40,
  "dependsOn": [
    "POST /api/auth/signup-tenant",
    "POST /api/assets"
  ],
  "testability": "auto",
  "fieldEnums": {
    "risk_class": [
      "low",
      "medium",
      "high",
      "critical"
    ]
  },
  "statusTransitions": {
    "entity": "command.command",
    "field": "status",
    "flow": [
      "pending",
      "approved",
      "rejected",
      "dispatched",
      "acked",
      "failed",
      "expired",
      "cancelled"
    ],
    "transitions": [
      {
        "from": null,
        "to": "approved",
        "via": "POST /api/commands"
      },
      {
        "from": null,
        "to": "pending",
        "via": "POST /api/commands"
      },
      {
        "from": "pending",
        "to": "approved",
        "via": "POST /api/commands/:command_id/decision"
      },
      {
        "from": "pending",
        "to": "rejected",
        "via": "POST /api/commands/:command_id/decision"
      },
      {
        "from": "approved",
        "to": "dispatched",
        "via": "INTERNAL sdk-command background dispatcher"
      },
      {
        "from": "dispatched",
        "to": "acked",
        "via": "POST /api/commands/:command_id/ack"
      },
      {
        "from": "dispatched",
        "to": "failed",
        "via": "POST /api/commands/:command_id/ack"
      }
    ]
  },
  "captureResponse": {
    "commands.create.response.data.command_id": "data.command_id",
    "commands.create.response.data.status": "data.status"
  },
  "testCases": [
    {
      "name": "Issue a low-risk move command",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "payload": {
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}",
        "target_asset_id": "{{cache:assets.create.response.data.asset_id}}",
        "target_component_id": "{{var:component_id}}",
        "type": "move",
        "params": {
          "x": 1,
          "y": 2
        },
        "risk_class": "high"
      },
      "expectedStatus": 201
    }
  ]
}