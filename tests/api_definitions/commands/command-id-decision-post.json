{
  "name": "POST /api/commands/:command_id/decision — approve/reject a gated command",
  "endpoint": "/api/commands/:command_id/decision",
  "sdk": "sdk-command",
  "sourceFile": "services/api-gateway/src/app.ts",
  "method": "POST",
  "requiresAuth": true,
  "expectedStatus": 200,
  "taskId": "b1fd6243-7bbf-4494-84ff-68d7194b0698",
  "sprintId": "efcf9cbd-5e84-469e-946e-efcabf8c88e1",
  "priority": 41,
  "dependsOn": [
    "POST /api/auth/signup-tenant",
    "POST /api/assets",
    "POST /api/commands"
  ],
  "testability": "auto",
  "statusTransitions": {
    "entity": "command.command",
    "field": "status",
    "flow": ["pending", "approved", "rejected"],
    "transitions": [
      { "from": "pending", "to": "approved", "via": "POST /api/commands/:command_id/decision" },
      { "from": "pending", "to": "rejected", "via": "POST /api/commands/:command_id/decision" }
    ]
  },
  "captureResponse": {
    "commands.decision.response.data.command_id": "data.command_id",
    "commands.decision.response.data.status": "data.status"
  },
  "testCases": [
    {
      "name": "Approve a pending risky command",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "pathParams": {
        "command_id": "{{cache:commands.create.response.data.command_id}}"
      },
      "payload": {
        "approved": true,
        "reason": "operator confirmed safe"
      },
      "expectedStatus": 200
    }
  ]
}
