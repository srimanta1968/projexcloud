{
  "name": "GET /api/scheduling/appointments/:appointment_id - Fetch one appointment",
  "endpoint": "/api/scheduling/appointments/:appointment_id",
  "sdk": "sdk-scheduling",
  "sourceFile": "packages/sdk-scheduling/src/server/routes.ts",
  "method": "GET",
  "requiresAuth": true,
  "expectedStatus": 200,
  "taskId": "41c92779-7aec-4747-b111-ada104733228",
  "sprintId": "d4876947-8d18-4538-8e9f-51ba3e0735a9",
  "featureId": "c705caee-690d-465f-8ae4-c84521bacb7d",
  "epicId": "4df864ec-e460-4cc9-a58a-92baadec5269",
  "priority": 56,
  "testability": "auto",
  "description": "Fetch a single appointment by id (tenant-scoped). Returns 404 if no appointment with that id exists for the tenant. tenant_id query param is required.",
  "dependsOn": [
    "POST /api/auth/signup-tenant",
    "POST /api/scheduling/appointments"
  ],
  "testCases": [
    {
      "name": "Get a booked appointment by id",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "pathParams": {
        "appointment_id": "{{cache:scheduling.appointment.create.response.data.appointment.appointment_id}}"
      },
      "queryParams": {
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}"
      },
      "expectedStatus": 200,
      "expectedResponse": { "data": { "appointment": { "appointment_id": "string", "status": "string" } } }
    }
  ],
  "errorCases": [
    { "status": 400, "code": "ValidationError", "message": "tenant_id query param required", "when": "tenant_id query param missing" },
    { "status": 404, "code": "NotFound", "message": "appointment not found", "when": "no appointment with that id for the tenant" },
    { "status": 401, "code": "Unauthorized", "message": "missing or invalid token", "when": "no valid Bearer token" }
  ]
}
