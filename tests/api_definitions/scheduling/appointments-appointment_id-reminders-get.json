  "name": "GET /api/scheduling/appointments/:appointment_id/reminders - List reminders",
  "endpoint": "/api/scheduling/appointments/:appointment_id/reminders",
  "method": "GET",
  "expectedStatus": 200,
  "priority": 66,
  "description": "List an appointment's scheduled reminders (soonest first). tenant_id query param required.",
  "dependsOn": [
    "POST /api/auth/signup-tenant",
    "POST /api/personas",
    "POST /api/scheduling/meeting-types",
    "POST /api/scheduling/appointments"
  ],
  "testCases": [
    {
      "name": "List reminders",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "pathParams": {
        "appointment_id": "{{cache:scheduling.appointment.create.response.data.appointment.appointment_id}}"
      },
      "queryParams": {
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}"
      },
      "expectedStatus": 200,
      "expectedResponse": {
        "data": {
          "reminders": "array"
        }
      }
    }
  ],
  "errorCases": [
    {
      "status": 400,
      "code": "ValidationError",
      "message": "tenant_id query param required",
      "when": "tenant_id missing"
