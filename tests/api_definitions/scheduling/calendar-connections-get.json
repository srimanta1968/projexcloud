  "name": "GET /api/scheduling/calendar-connections - List calendar connections",
  "endpoint": "/api/scheduling/calendar-connections",
  "method": "GET",
  "expectedStatus": 200,
  "priority": 71,
  "description": "List a tenant's calendar connections (optionally filtered by host_persona_id), newest first. tenant_id query param required.",
  "dependsOn": [
    "POST /api/auth/signup-tenant",
    "POST /api/scheduling/calendar-connections"
