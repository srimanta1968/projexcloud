{
  "sdk": "sdk-scheduling",
  "sourceFile": "packages/sdk-scheduling/src/server/routes.ts",
  "requiresAuth": true,
  "taskId": "6645f35d-6f20-4f27-8253-dd87b85fe4c2",
  "sprintId": "d4876947-8d18-4538-8e9f-51ba3e0735a9",
  "featureId": "efe48c51-3e78-4392-9621-85b916186487",
  "epicId": "4df864ec-e460-4cc9-a58a-92baadec5269",
  "testability": "auto",
  "name": "POST /api/scheduling/calendar-connections/:connection_id/sync - Two-way sync",
  "endpoint": "/api/scheduling/calendar-connections/:connection_id/sync",
  "method": "POST",
  "expectedStatus": 200,
  "priority": 73,
  "description": "Run a two-way sync for a connection: push unmapped non-cancelled appointments to the external calendar (outbound) and pull provider changes to apply reschedules/cancellations (inbound), advancing the sync token. Idempotent. Returns {pushed, pulled, applied}. tenant_id required.",
  "dependsOn": [
    "POST /api/auth/signup-tenant",
    "POST /api/scheduling/calendar-connections"
  ],
  "testCases": [
    {
      "name": "Sync the connection",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "pathParams": {
        "connection_id": "{{cache:scheduling.calendar-connection.create.response.data.connection.connection_id}}"
      },
      "payload": {
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}"
      },
      "expectedStatus": 200,
      "expectedResponse": {
        "data": {
          "pushed": "number",
          "pulled": "number",
          "applied": "number"
        }
      }
    }
  ],
  "errorCases": [
    {
      "status": 400,
      "code": "ValidationError",
      "message": "tenant_id is required",
      "when": "tenant_id missing"
    },
    {
      "status": 404,
      "code": "NotFound",
      "message": "connection not found",
      "when": "no connection for tenant"
    }
  ]
}
