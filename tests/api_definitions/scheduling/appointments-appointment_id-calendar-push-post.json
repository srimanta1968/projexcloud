{
  "sdk": "sdk-scheduling",
  "sourceFile": "packages/sdk-scheduling/src/server/routes.ts",
  "requiresAuth": true,
  "taskId": "6645f35d-6f20-4f27-8253-dd87b85fe4c2",
  "sprintId": "d4876947-8d18-4538-8e9f-51ba3e0735a9",
  "featureId": "efe48c51-3e78-4392-9621-85b916186487",
  "epicId": "4df864ec-e460-4cc9-a58a-92baadec5269",
  "testability": "auto",
  "name": "POST /api/scheduling/appointments/:appointment_id/calendar-push - Push to provider",
  "endpoint": "/api/scheduling/appointments/:appointment_id/calendar-push",
  "method": "POST",
  "expectedStatus": 200,
  "priority": 74,
  "description": "Push a single appointment to a connection's external calendar, creating the external event or updating/cancelling it if already mapped (this is how reschedule/cancel propagate to the provider). Records the appointment <-> external event mapping. tenant_id and connection_id required.",
  "dependsOn": [
    "POST /api/auth/signup-tenant",
    "POST /api/personas",
    "POST /api/scheduling/meeting-types",
    "POST /api/scheduling/appointments",
    "POST /api/scheduling/calendar-connections"
  ],
  "testCases": [
    {
      "name": "Push appointment to Google",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "pathParams": {
        "appointment_id": "{{cache:scheduling.appointment.create.response.data.appointment.appointment_id}}"
      },
      "payload": {
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}",
        "connection_id": "{{cache:scheduling.calendar-connection.create.response.data.connection.connection_id}}"
      },
      "expectedStatus": 200,
      "expectedResponse": {
        "data": {
          "external_event_id": "string",
          "operation": "string"
        }
      }
    }
  ],
  "errorCases": [
    {
      "status": 400,
      "code": "ValidationError",
      "message": "tenant_id and connection_id are required",
      "when": "required field missing"
    },
    {
      "status": 404,
      "code": "NotFound",
      "message": "connection/appointment not found",
      "when": "no connection or appointment for tenant"
    }
  ]
}
