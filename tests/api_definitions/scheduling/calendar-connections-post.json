{
  "sdk": "sdk-scheduling",
  "sourceFile": "packages/sdk-scheduling/src/server/routes.ts",
  "requiresAuth": true,
  "taskId": "6645f35d-6f20-4f27-8253-dd87b85fe4c2",
  "sprintId": "d4876947-8d18-4538-8e9f-51ba3e0735a9",
  "featureId": "efe48c51-3e78-4392-9621-85b916186487",
  "epicId": "4df864ec-e460-4cc9-a58a-92baadec5269",
  "testability": "auto",
  "name": "POST /api/scheduling/calendar-connections - Connect an external calendar",
  "endpoint": "/api/scheduling/calendar-connections",
  "method": "POST",
  "expectedStatus": 201,
  "priority": 70,
  "description": "Bind a host to an external calendar provider (google/microsoft/caldav) via an sdk-connectors install. Upsert per (host, provider, external calendar). tenant_id, host_persona_id and provider are required. direction defaults to both.",
  "dependsOn": [
    "POST /api/auth/signup-tenant",
    "POST /api/personas"
  ],
  "fieldEnums": {
    "provider": [
      "google",
      "microsoft",
      "caldav"
    ],
    "direction": [
      "inbound",
      "outbound",
      "both"
    ]
  },
  "captureResponse": {
    "scheduling.calendar-connection.create.response.data.connection.connection_id": "data.connection.connection_id"
  },
  "testCases": [
    {
      "name": "Connect a Google calendar",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "payload": {
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}",
        "host_persona_id": "{{cache:personas.create.response.data.persona.persona_id}}",
        "provider": "google",
        "connector_install_id": null,
        "external_calendar_id": "primary-{{dynamic:uuid}}",
        "direction": "both",
        "metadata": {}
      },
      "expectedStatus": 201,
      "expectedResponse": {
        "data": {
          "connection": {
            "connection_id": "string",
            "provider": "string"
          }
        }
      }
    }
  ],
  "errorCases": [
    {
      "status": 400,
      "code": "ValidationError",
      "message": "tenant_id, host_persona_id and provider are required",
      "when": "required field missing"
    },
    {
      "status": 400,
      "code": "ValidationError",
      "message": "provider must be google, microsoft or caldav",
      "when": "invalid provider"
    }
  ]
}
