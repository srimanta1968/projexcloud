{
  "sdk": "sdk-scheduling",
  "sourceFile": "packages/sdk-scheduling/src/server/routes.ts",
  "requiresAuth": true,
  "taskId": "b1b6ed6d-9513-4dc2-8791-dbea3fbb4ecd",
  "sprintId": "d4876947-8d18-4538-8e9f-51ba3e0735a9",
  "featureId": "9219a230-d47e-41f0-8f7a-8adb6065437f",
  "epicId": "4df864ec-e460-4cc9-a58a-92baadec5269",
  "testability": "auto",
  "name": "POST /api/scheduling/appointments/:appointment_id/confirm - Confirm a booking",
  "endpoint": "/api/scheduling/appointments/:appointment_id/confirm",
  "method": "POST",
  "expectedStatus": 200,
  "priority": 60,
  "description": "Confirm a pending/confirmed appointment (idempotent) and fire the confirmation notice to both parties (pluggable booking notifier -> sdk-notification). Sets confirmed_at and appends a booking_event. Confirming a cancelled/completed appointment returns 409.",
  "dependsOn": [
    "POST /api/auth/signup-tenant",
    "POST /api/personas",
    "POST /api/scheduling/meeting-types",
    "POST /api/scheduling/appointments"
  ],
  "statusTransitions": {
    "entity": "scheduling.appointment",
    "field": "status",
    "flow": [
      "confirmed"
    ],
    "transitions": [
      {
        "from": "pending",
        "to": "confirmed",
        "via": "POST /api/scheduling/appointments/:appointment_id/confirm"
      }
    ]
  },
  "testCases": [
    {
      "name": "Confirm the appointment",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "pathParams": {
        "appointment_id": "{{cache:scheduling.appointment.create.response.data.appointment.appointment_id}}"
      },
      "payload": {
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}"
      },
      "expectedStatus": 200,
      "expectedResponse": {
        "data": {
          "appointment": {
            "appointment_id": "string",
            "status": "string"
          }
        }
      }
    }
  ],
  "errorCases": [
    {
      "status": 400,
      "code": "ValidationError",
      "message": "tenant_id is required",
      "when": "tenant_id missing"
    },
    {
      "status": 404,
      "code": "NotFound",
      "message": "appointment not found",
      "when": "no appointment for tenant"
    },
    {
      "status": 409,
      "code": "InvalidTransition",
      "message": "cannot confirm an appointment in status 'cancelled'",
      "when": "appointment already cancelled/completed"
    }
  ]
}
