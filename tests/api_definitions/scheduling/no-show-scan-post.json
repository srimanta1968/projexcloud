  "testability": "auto",
  "name": "POST /api/scheduling/no-show/scan - Mark no-shows",
  "endpoint": "/api/scheduling/no-show/scan",
  "method": "POST",
  "expectedStatus": 200,
  "priority": 68,
  "description": "Mark confirmed appointments whose end_time passed by grace_minutes (default 10) and that were never completed as no_show, appending a booking_event for each. Returns {marked, appointment_ids} so a caller can offer a rescue/rebook. Also runs on the scheduling worker timer.",
  "dependsOn": [
    "POST /api/auth/signup-tenant"
  ],
  "fieldEnums": {},
  "testCases": [
    {
      "name": "Run a no-show scan",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "payload": {
        "grace_minutes": 10,
        "batch_size": 100
      },
      "expectedStatus": 200,
      "expectedResponse": {
        "data": {
          "marked": "number",
          "appointment_ids": "array"
        }
      }
    }
  ],
  "errorCases": [
    {
      "status": 401,
      "code": "Unauthorized",
      "message": "missing or invalid token",
      "when": "no valid Bearer token"
    }
  ]
}
