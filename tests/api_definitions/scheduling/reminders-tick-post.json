  "name": "POST /api/scheduling/reminders/tick - Drain due reminders",
  "endpoint": "/api/scheduling/reminders/tick",
  "method": "POST",
  "expectedStatus": 200,
  "priority": 67,
  "description": "Drain due reminders on demand: claim pending reminder rows whose remind_at has passed (FOR UPDATE SKIP LOCKED), fire the reminder notice for each still-active appointment, and mark rows sent/skipped. Also runs on a timer when SCHEDULING_WORKER_ENABLED. batch_size optional. Returns {claimed, sent, skipped}.",
  "dependsOn": [
    "POST /api/auth/signup-tenant"
  ],
  "testCases": [
    {
      "name": "Run a reminder tick",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "payload": {
        "batch_size": 50
      },
      "expectedStatus": 200,
      "expectedResponse": {
        "data": {
          "claimed": "number",
          "sent": "number",
          "skipped": "number"
        }
      }
    }
  ],
  "errorCases": [
    {
      "status": 401,
      "code": "Unauthorized",
      "message": "missing or invalid token",
      "when": "no valid Bearer token"
    }
  ]
