{
  "name": "POST /api/scheduling/appointments - Book an appointment (double-book guarded)",
  "endpoint": "/api/scheduling/appointments",
  "sdk": "sdk-scheduling",
  "sourceFile": "packages/sdk-scheduling/src/server/routes.ts",
  "method": "POST",
  "requiresAuth": true,
  "expectedStatus": 201,
  "taskId": "41c92779-7aec-4747-b111-ada104733228",
  "sprintId": "d4876947-8d18-4538-8e9f-51ba3e0735a9",
  "featureId": "c705caee-690d-465f-8ae4-c84521bacb7d",
  "epicId": "4df864ec-e460-4cc9-a58a-92baadec5269",
  "priority": 54,
  "testability": "auto",
  "description": "Book an appointment on a host's calendar with double-booking prevention: the overlap check and insert run in one transaction, so a window that overlaps an existing non-cancelled appointment for the same host is rejected with 409. end_time must be strictly after start_time (else 400). subject_persona_id is the invitee/lead persona. Required: tenant_id, host_persona_id, title, start_time, end_time.",
  "dependsOn": [
    "POST /api/auth/signup-tenant",
    "POST /api/personas",
    "POST /api/scheduling/meeting-types"
  ],
  "fieldEnums": {
    "status": ["pending", "confirmed", "cancelled", "completed", "no_show"],
    "location_type": ["video", "phone", "in_person", "custom"],
    "source": ["internal", "public_link", "sequence", "import", "provider_sync"]
  },
  "statusTransitions": {
    "entity": "scheduling.appointment",
    "field": "status",
    "flow": ["confirmed", "completed"],
    "transitions": [
      { "from": "confirmed", "to": "cancelled", "via": "cancel (TK-3624 booking lifecycle)" },
      { "from": "confirmed", "to": "completed", "via": "complete (TK-3624 booking lifecycle)" },
      { "from": "confirmed", "to": "no_show", "via": "no-show detection (TK-3625)" }
    ]
  },
  "testCases": [
    {
      "name": "Book a 30-minute confirmed appointment",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "payload": {
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}",
        "host_persona_id": "{{cache:personas.create.response.data.persona.persona_id}}",
        "subject_persona_id": "{{cache:personas.create.response.data.persona.persona_id}}",
        "meeting_type_id": "{{cache:scheduling.meeting-type.create.response.data.meeting_type.meeting_type_id}}",
        "title": "{{dynamic:text}}",
        "description": "Discovery call booked from availability",
        "start_time": "{{dynamic:futuredatetime}}",
        "end_time": "{{dynamic:futuredatetime+30m}}",
        "timezone": "America/New_York",
        "location_type": "video",
        "location_detail": "Google Meet",
        "meeting_url": "https://meet.example.com/abc",
        "attendees": [],
        "notes": "Booked via QA",
        "entity_ref": "lead:{{dynamic:uuid}}",
        "source": "internal"
      },
      "expectedStatus": 201,
      "expectedResponse": { "data": { "appointment": { "appointment_id": "string", "status": "string" } } }
    }
  ],
  "captureResponse": {
    "scheduling.appointment.create.response.data.appointment.appointment_id": "data.appointment.appointment_id",
    "scheduling.appointment.create.response.data.appointment.status": "data.appointment.status"
  },
  "errorCases": [
    { "status": 400, "code": "ValidationError", "message": "tenant_id, host_persona_id, title, start_time and end_time are required", "when": "any required field missing from body" },
    { "status": 400, "code": "ValidationError", "message": "end_time must be after start_time", "when": "end_time <= start_time" },
    { "status": 409, "code": "DoubleBooking", "message": "the host already has an appointment overlapping this window", "when": "the requested window overlaps an existing non-cancelled appointment for the same host" },
    { "status": 401, "code": "Unauthorized", "message": "missing or invalid token", "when": "no valid Bearer token" }
  ]
}
