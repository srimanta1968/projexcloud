{
  "name": "POST /api/scheduling/meeting-types - Create a bookable meeting type",
  "endpoint": "/api/scheduling/meeting-types",
  "sdk": "sdk-scheduling",
  "sourceFile": "packages/sdk-scheduling/src/server/routes.ts",
  "method": "POST",
  "requiresAuth": true,
  "expectedStatus": 201,
  "taskId": "41c92779-7aec-4747-b111-ada104733228",
  "sprintId": "d4876947-8d18-4538-8e9f-51ba3e0735a9",
  "featureId": "c705caee-690d-465f-8ae4-c84521bacb7d",
  "epicId": "4df864ec-e460-4cc9-a58a-92baadec5269",
  "priority": 50,
  "testability": "auto",
  "description": "Create a reusable meeting type (bookable meeting kind) for a tenant — name, unique slug, duration (15/30/45/60 min are the common presets), booking buffers and location type. Slug is unique per tenant (a duplicate returns 409). Referenced by availability slotting, appointments and public scheduling links. tenant_id, name and slug are required.",
  "dependsOn": [
    "POST /api/auth/signup-tenant",
    "POST /api/personas"
  ],
  "fieldEnums": {
    "location_type": ["video", "phone", "in_person", "custom"]
  },
  "testCases": [
    {
      "name": "Create a 30-minute discovery call meeting type",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "payload": {
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}",
        "host_persona_id": "{{cache:personas.create.response.data.persona.persona_id}}",
        "name": "{{dynamic:name}}",
        "slug": "discovery-{{dynamic:uuid}}",
        "description": "30-minute discovery call",
        "duration_minutes": 30,
        "buffer_before_minutes": 5,
        "buffer_after_minutes": 5,
        "location_type": "video",
        "location_detail": "Google Meet",
        "metadata": {}
      },
      "expectedStatus": 201,
      "expectedResponse": { "data": { "meeting_type": { "meeting_type_id": "string", "slug": "string", "duration_minutes": "number" } } }
    }
  ],
  "captureResponse": {
    "scheduling.meeting-type.create.response.data.meeting_type.meeting_type_id": "data.meeting_type.meeting_type_id",
    "scheduling.meeting-type.create.response.data.meeting_type.slug": "data.meeting_type.slug"
  },
  "errorCases": [
    { "status": 400, "code": "ValidationError", "message": "tenant_id, name and slug are required", "when": "tenant_id, name or slug missing from body" },
    { "status": 409, "code": "Conflict", "message": "a meeting type with this slug already exists for the tenant", "when": "slug already used by another meeting type in the tenant (UNIQUE tenant_id, slug)" },
    { "status": 401, "code": "Unauthorized", "message": "missing or invalid token", "when": "no valid Bearer token" }
  ]
}
