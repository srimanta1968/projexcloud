{
  "name": "POST /api/secrets - Register a SecretRef",
  "endpoint": "/api/secrets",
  "method": "POST",
  "requiresAuth": true,
  "expectedStatus": 201,
  "taskId": "c8411120-9121-4a12-835b-8332ec992e2d",
  "sprintId": "8ef1d09e-dd8e-4daf-8d03-54dcd9f812f8",
  "featureId": "36d7be6f-03a6-4d40-aa64-cd3552ef5683",
  "epicId": "ee93bf20-3149-45d5-a712-d55cc74df2d9",
  "testCases": [
    {
      "name": "Register a tenant-scoped SecretRef",
      "payload": {
        "ref": "secret://tenant/{{dynamic:name}}",
        "scope": "tenant",
        "kms_key_id": "mock-key-1"
      },
      "expectedStatus": 201,
      "headers": {
        "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
      }
    }
  ],
  "dependsOn": ["POST /api/auth/register"],
  "expectedResponse": {
    "data": {
      "ref": "string",
      "scope": "string",
      "kms_key_id": "string"
    }
  },
  "captureResponse": {
    "secrets.store.response.data.ref": "data.ref"
  }
}
