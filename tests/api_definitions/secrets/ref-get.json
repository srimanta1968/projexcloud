{
  "name": "GET /api/secrets/:ref \u2014 sdk-secrets",
  "endpoint": "/api/secrets/:ref",
  "method": "GET",
  "requiresAuth": true,
  "dependsOn": [
    "POST /api/auth/register",
    "POST /api/secrets"
  ],
  "expectedStatus": 200,
  "sdk": "sdk-secrets",
  "sourceFile": "packages/sdk-secrets/src/server/routes.ts",
  "testability": "auto",
  "testCases": [
    {
      "name": "Retrieve a previously registered SecretRef by ref",
      "headers": {
        "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
      },
      "pathParams": {
        "ref": "secret%3A%2F%2Ftenant%2Fdev-test-key-001"
      },
      "expectedStatus": 200
    }
  ],
  "expectedResponse": {
    "data": {
      "ref": "string",
      "scope": "string",
      "provider": "string",
      "kms_key_id": "string",
      "created_at": "string",
      "rotated_at": "string"
    }
  }
}