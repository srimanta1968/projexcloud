{
  "name": "POST /api/identity/social/:provider/callback - Social IdP callback",
  "endpoint": "/api/identity/social/:provider/callback",
  "sdk": "sdk-social",
  "method": "POST",
  "requiresAuth": false,
  "expectedStatus": 200,
  "taskId": "66002fc9-fe2a-4aec-85e3-98ad5ca6f334",
