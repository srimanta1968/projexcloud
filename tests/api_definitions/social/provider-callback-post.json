  "dependsOn": [
    "POST /api/auth/signup-tenant"
  ],
  "fieldEnums": {
    "provider": ["google", "apple", "microsoft"]
  },
  "testCases": [
    {
      "name": "Google callback with verified id_token claims",
      "pathParams": {
        "provider": "google"
      },
      "payload": {
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}",
        "verified_claims": {
          "sub": "{{dynamic:name}}",
          "email": "{{dynamic:email}}",
          "email_verified": true
        }
      },
      "expectedStatus": 200
    }
  ],
  "expectedResponse": {
    "data": { "person_id": "string", "jit_provisioned": true }
  },
  "captureResponse": {
    "social.social-callback.response.data.person_id": "data.person_id"
  }
