{
  "name": "POST /api/social/handles — sdk-social",
  "endpoint": "/api/social/handles",
  "method": "POST",
  "requiresAuth": true,
  "dependsOn": [
    "POST /api/auth/signup-tenant"
  ],
  "expectedStatus": 201,
  "sdk": "sdk-social",
  "sourceFile": "packages/sdk-social/src/server/routes.ts",
  "_generated": true,
  "fieldEnums": {
    "network": ["twitter", "linkedin", "instagram", "facebook", "tiktok"]
  },
  "testCases": [
    {
      "name": "Authorize a social handle for a tenant",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "payload": {
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}",
        "network": "twitter",
        "external_handle_id": "{{dynamic:name}}",
        "authorized_persona_id": "{{cache:auth.signup-tenant.response.data.userId}}"
      },
      "expectedStatus": 201
    }
  ],
  "expectedResponse": {
    "data": { "handle": { "handle_id": "string", "network": "string" } }
  },
  "captureResponse": {
    "social.handles.create.response.data.handle.handle_id": "data.handle.handle_id"
  }
}
