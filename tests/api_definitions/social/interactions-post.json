{
  "name": "POST /api/social/interactions — sdk-social",
  "endpoint": "/api/social/interactions",
  "method": "POST",
  "requiresAuth": true,
  "dependsOn": [
    "POST /api/auth/register",
    "POST /api/social/handles"
  ],
  "expectedStatus": 201,
  "sdk": "sdk-social",
  "sourceFile": "packages/sdk-social/src/server/routes.ts",
  "_generated": true,
  "fieldOptions": {
    "kind": ["dm", "comment", "mention", "review"]
  },
  "testCases": [
    {
      "name": "Ingest an inbound social interaction",
      "headers": {
        "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
      },
      "payload": {
        "handle_id": "{{cache:social.handles.create.response.data.handle.handle_id}}",
        "kind": "{{static:comment}}",
        "author_external_id": "{{dynamic:name}}",
        "author_persona_id": "{{cache:auth.register.response.data.userId}}",
        "body": "{{static:Loving the new product launch!}}"
      },
      "expectedStatus": 201
    }
  ],
  "expectedResponse": {
    "data": { "interaction": { "interaction_id": "string", "kind": "string" } }
  },
  "captureResponse": {
    "social.interactions.create.response.data.interaction.interaction_id": "data.interaction.interaction_id"
  }
}
