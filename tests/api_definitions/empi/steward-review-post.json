{
  "name": "POST /api/empi/candidate-links/:link_id/steward-review - queue for steward",
  "endpoint": "/api/empi/candidate-links/:link_id/steward-review",
  "sdk": "sdk-identity-resolver",
  "sourceFile": "packages/sdk-identity-resolver/src/server/routes.ts",
  "method": "POST",
  "requiresAuth": true,
  "taskId": "363e7b37-752c-497e-baa4-47eee238621c",
