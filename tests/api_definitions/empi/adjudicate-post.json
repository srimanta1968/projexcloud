{
  "name": "POST /api/empi/candidate-links/:link_id/adjudicate - steward decision",
  "endpoint": "/api/empi/candidate-links/:link_id/adjudicate",
  "sdk": "sdk-identity-resolver",
  "sourceFile": "packages/sdk-identity-resolver/src/server/routes.ts",
  "method": "POST",
  "requiresAuth": true,
  "taskId": "67aa387a-d7cf-4107-a28f-fa096804b910",
  "sprintId": "efcf9cbd-5e84-469e-946e-efcabf8c88e1",
  "featureId": "01f9d9f9-989e-4cd7-b6cf-50173e3830bd",
  "epicId": "2e2950d2-3772-4768-bd85-8a8734958c78",
  "expectedStatus": 200,
  "testability": "auto",
  "dependsOn": [
    "POST /api/auth/signup-tenant",
    "POST /api/empi/candidate-links/:link_id/steward-review"
  ],
  "testCases": [
    {
      "name": "Steward approves a candidate link (triggers reversible merge)",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "pathParams": {
        "link_id": "{{cache:empi.steward-review.response.data.link.link_id}}"
      },
      "payload": {
        "step_id": "{{cache:empi.steward-review.response.data.pending_step_ids.0}}",
        "decision": "approve",
        "reason": "Records confirmed as the same patient"
      },
      "expectedStatus": 200
    }
  ],
  "expectedResponse": {
    "data": {
      "link": {
        "link_id": "string",
        "status": "string"
      }
    }
  },
  "fieldEnums": {
    "decision": ["approve", "reject"]
  },
  "statusTransitions": {
    "entity": "candidate_link",
    "field": "status",
    "flow": ["open", "merged", "rejected", "superseded"],
    "transitions": [
      { "from": "open", "to": "merged", "via": "POST /api/empi/candidate-links/:link_id/adjudicate" },
      { "from": "open", "to": "rejected", "via": "POST /api/empi/candidate-links/:link_id/adjudicate" }
    ]
  },
  "captureResponse": {
    "empi.adjudicate.response.data.link.link_id": "data.link.link_id",
    "empi.adjudicate.response.data.link.status": "data.link.status"
  }
}
