  "statusTransitions": {
    "entity": "candidate_link",
    "field": "status",
    "flow": ["open", "merged", "rejected", "superseded"],
    "transitions": [
      { "from": "merged", "to": "open", "via": "POST /api/empi/merges/:merge_id/unmerge" }
