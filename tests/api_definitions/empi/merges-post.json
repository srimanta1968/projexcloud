{
  "name": "POST /api/empi/merges - reversible merge of two persons",
  "endpoint": "/api/empi/merges",
  "method": "POST",
  "requiresAuth": true,
  "taskId": "f01a9d81-9d1c-46e2-95f2-7dc193e70aa5",
