{
  "name": "GET /api/storm/overlay — api-gateway",
  "endpoint": "/api/storm/overlay",
  "sdk": "sdk-storm",
  "method": "GET",
  "requiresAuth": false,
  "expectedStatus": 200,
  "sourceFile": "services/api-gateway/src/app.ts",
  "testability": "auto",
  "testCases": [
    {
      "name": "Query storm events + intensity cell counts overlapping a bbox",
      "queryParams": {
        "min_lat": "24.0",
        "min_lng": "-125.0",
        "max_lat": "49.0",
        "max_lng": "-66.0",
        "since": "{{dynamic:pastdatetime}}"
      },
      "expectedStatus": 200
    },
    {
      "name": "Missing bbox floats returns 400",
      "queryParams": {
        "min_lat": "24.0",
        "min_lng": "-125.0"
      },
      "expectedStatus": 400
    },
    {
      "name": "min greater than max returns 400",
      "queryParams": {
        "min_lat": "49.0",
        "min_lng": "-66.0",
        "max_lat": "24.0",
        "max_lng": "-125.0"
      },
      "expectedStatus": 400
    }
  ],
  "expectedResponse": {
    "events": "array",
    "cell_count": "number"
  }
}
