{
  "name": "POST /api/encounters/:encounter_id/transition — sdk-engagement",
  "endpoint": "/api/encounters/:encounter_id/transition",
  "method": "POST",
  "requiresAuth": true,
  "dependsOn": [
    "POST /api/auth/register",
    "POST /api/encounters",
    "POST /api/personas"
  ],
  "expectedStatus": 200,
  "sdk": "sdk-engagement",
  "sourceFile": "packages/sdk-engagement/src/server/routes.ts",
  "_generated": true,
  "testability": "manual",
  "skipReason": "Requires an open encounter; transitionEncounter validates the state machine (open -> in-progress/closed/sealed).",
  "fieldOptions": {
    "to": ["open", "in-progress", "closed", "sealed"]
  },
  "testCases": [
    {
      "name": "Transition the encounter open -> in-progress",
      "headers": {
        "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
      },
      "pathParams": {
        "encounter_id": "{{cache:encounters.create.response.data.encounter.encounter_id}}"
      },
      "payload": {
        "to": "{{static:in-progress}}",
        "actor_id": "{{cache:personas.create.response.data.persona.persona_id}}"
      },
      "expectedStatus": 200
    }
  ]
}
