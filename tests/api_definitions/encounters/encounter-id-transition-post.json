{
  "name": "POST /api/encounters/:encounter_id/transition — sdk-engagement",
  "endpoint": "/api/encounters/:encounter_id/transition",
  "method": "POST",
  "requiresAuth": true,
  "dependsOn": [
    "POST /api/auth/register",
    "POST /api/encounters",
    "POST /api/personas"
  ],
  "expectedStatus": 200,
  "sdk": "sdk-engagement",
  "sourceFile": "packages/sdk-engagement/src/server/routes.ts",
  "_generated": true,
  "testability": "auto",
  "fieldEnums": {
    "to": ["open", "in-progress", "closed", "sealed"]
  },
  "statusTransitions": {
    "entity": "encounter",
    "field": "state",
    "flow": ["open", "in-progress", "closed", "sealed"],
    "transitions": [
      { "from": "open", "to": "in-progress", "via": "POST /api/encounters/:encounter_id/transition" },
      { "from": "open", "to": "closed", "via": "POST /api/encounters/:encounter_id/transition" },
      { "from": "open", "to": "sealed", "via": "POST /api/encounters/:encounter_id/transition" },
      { "from": "in-progress", "to": "closed", "via": "POST /api/encounters/:encounter_id/transition" },
      { "from": "in-progress", "to": "sealed", "via": "POST /api/encounters/:encounter_id/transition" },
      { "from": "closed", "to": "sealed", "via": "POST /api/encounters/:encounter_id/transition" }
    ]
  },
  "testCases": [
    {
      "name": "Transition the encounter open -> in-progress",
      "headers": {
        "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
      },
      "pathParams": {
        "encounter_id": "{{cache:encounters.create.response.data.encounter.encounter_id}}"
      },
      "payload": {
        "to": "in-progress",
        "actor_id": "{{cache:personas.create.response.data.persona.persona_id}}"
      },
      "expectedStatus": 200
    }
  ],
  "captureResponse": {
    "encounters.transition.response.data.encounter.encounter_id": "data.encounter.encounter_id"
  }
}
