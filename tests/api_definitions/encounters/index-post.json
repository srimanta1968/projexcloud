{
  "name": "POST /api/encounters — sdk-engagement",
  "endpoint": "/api/encounters",
  "method": "POST",
  "requiresAuth": true,
  "dependsOn": [
    "POST /api/auth/register",
    "POST /api/tenants",
    "POST /api/vault/keys"
  ],
  "expectedStatus": 201,
  "sdk": "sdk-engagement",
  "sourceFile": "packages/sdk-engagement/src/server/routes.ts",
  "_generated": true,
  "testability": "manual",
  "skipReason": "Requires a tenant and a provisioned app-pool Vault key (parent_key_id); openEncounter issues a per-encounter Vault key before inserting the row.",
  "testCases": [
    {
      "name": "Open an encounter (issues per-encounter Vault key)",
      "headers": {
        "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
      },
      "payload": {
        "tenant_id": "{{cache:tenants.create.response.data.tenant_id}}",
        "kind": "{{static:visit}}",
        "retention_policy": "{{static:default-7y}}",
        "region": "{{static:us-east-1}}",
        "parent_key_id": "{{cache:vault.keys.create.response.data.key_id}}"
      },
      "expectedStatus": 201
    }
  ]
}
