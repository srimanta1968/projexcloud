{
  "name": "POST /api/encounters — sdk-engagement",
  "endpoint": "/api/encounters",
  "method": "POST",
  "requiresAuth": true,
  "dependsOn": [
    "POST /api/auth/signup-tenant",
    "POST /api/vault/keys"
  ],
  "expectedStatus": 201,
  "sdk": "sdk-engagement",
  "sourceFile": "packages/sdk-engagement/src/server/routes.ts",
  "_generated": true,
  "testability": "auto",
  "fieldEnums": {
    "kind": ["visit", "order", "deal", "session", "capital-call", "support"]
  },
  "testCases": [
    {
      "name": "Open an encounter (issues per-encounter Vault key)",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "payload": {
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}",
        "kind": "visit",
        "retention_policy": "default-7y",
        "region": "us-east-1",
        "parent_key_id": "{{cache:vault.keys.create.response.data.key_id}}",
        "parent_encounter_id": null,
        "address_id": null,
        "billing_ref": "billing-ref-001"
      },
      "expectedStatus": 201
    }
  ],
  "captureResponse": {
    "encounters.create.response.data.encounter.encounter_id": "data.encounter.encounter_id"
  }
}
