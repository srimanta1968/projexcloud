{
  "name": "POST /api/encounters/:encounter_id/participants — sdk-engagement",
  "endpoint": "/api/encounters/:encounter_id/participants",
  "method": "POST",
  "requiresAuth": true,
  "dependsOn": [
    "POST /api/auth/register",
    "POST /api/encounters",
    "POST /api/personas"
  ],
  "expectedStatus": 201,
  "sdk": "sdk-engagement",
  "sourceFile": "packages/sdk-engagement/src/server/routes.ts",
  "_generated": true,
  "testability": "auto",
  "testCases": [
    {
      "name": "Add a participant persona to the encounter",
      "headers": {
        "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
      },
      "pathParams": {
        "encounter_id": "{{cache:encounters.create.response.data.encounter.encounter_id}}"
      },
      "payload": {
        "persona_id": "{{cache:personas.create.response.data.persona.persona_id}}",
        "role": "attendee",
        "required": false
      },
      "expectedStatus": 201
    }
  ],
  "captureResponse": {
    "encounters.add-participant.response.data.participant.participant_id": "data.participant.participant_id"
  }
}
