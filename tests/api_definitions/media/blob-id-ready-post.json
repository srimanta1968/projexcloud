{
  "name": "POST /api/media/:blob_id/ready — sdk-media",
  "endpoint": "/api/media/:blob_id/ready",
  "method": "POST",
  "requiresAuth": true,
  "dependsOn": [
    "POST /api/auth/signup-tenant",
    "POST /api/media/upload-url"
  ],
  "expectedStatus": 200,
  "sdk": "sdk-media",
  "sourceFile": "packages/sdk-media/src/server/handlers/mediaController.ts",
  "_generated": true,
  "testability": "auto",
  "statusTransitions": {
    "entity": "media.blob",
    "field": "status",
    "flow": ["uploading", "ready", "transcoded", "shredded"],
    "transitions": [
      {
        "from": "uploading",
        "to": "ready",
        "via": "POST /api/media/:blob_id/ready"
      }
    ]
  },
  "testCases": [
    {
      "name": "Commit an uploaded blob with its SHA-256 checksum",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "pathParams": {
        "blob_id": "{{cache:media.upload-url.create.response.data.blob_id}}"
      },
      "payload": {
        "checksum_hex": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
      },
      "expectedStatus": 200
    }
  ],
  "expectedResponse": {
    "data": {
      "blob": {
        "blob_id": "string",
        "tenant_id": "string",
        "persona_id": "string",
        "s3_key": "string",
        "content_type": "string",
        "byte_size": 0,
        "status": "string"
      }
    }
  },
  "captureResponse": {
    "media.ready.response.data.blob.blob_id": "data.blob.blob_id",
    "media.ready.response.data.blob.status": "data.blob.status"
  }
}
