{
  "name": "GET /api/media/transcode-jobs/:job_id — sdk-media",
  "endpoint": "/api/media/transcode-jobs/:job_id",
  "method": "GET",
  "requiresAuth": true,
  "dependsOn": [
    "POST /api/auth/signup-tenant",
    "POST /api/media/upload-url",
    "POST /api/media/:blob_id/transcode"
  ],
  "expectedStatus": 200,
  "sdk": "sdk-media",
  "sourceFile": "packages/sdk-media/src/server/handlers/mediaController.ts",
  "_generated": true,
  "testability": "auto",
  "fieldEnums": {
    "pipeline": ["video-mp4-hls", "image-optimize", "pdf-thumbnail"],
    "status": ["queued", "running", "succeeded", "failed"]
  },
  "testCases": [
    {
      "name": "Poll a transcode job by id",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "pathParams": {
        "job_id": "{{cache:media.transcode.response.data.job.job_id}}"
      },
      "expectedStatus": 200
    }
  ],
  "expectedResponse": {
    "data": {
      "job": {
        "job_id": "string",
        "blob_id": "string",
        "pipeline": "string",
        "status": "string",
        "output_blob_ids": [],
        "billed_units": 0,
        "error_message": null
      }
    }
  }
}
