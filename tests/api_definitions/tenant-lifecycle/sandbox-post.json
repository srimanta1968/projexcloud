{
  "name": "POST /api/tenant-lifecycle/sandbox - Create sandbox sub-tenant",
  "endpoint": "/api/tenant-lifecycle/sandbox",
  "sdk": "sdk-tenant-lifecycle",
  "sourceFile": "packages/sdk-tenant-lifecycle/src/server/routes.ts",
  "method": "POST",
  "requiresAuth": true,
  "expectedStatus": 201,
  "taskId": "10360bb1-eaa7-4d76-999b-57d60662885b",
  "sprintId": "8ef1d09e-dd8e-4daf-8d03-54dcd9f812f8",
  "featureId": "a5489f77-208c-47d4-9662-93a2a183a4c1",
  "epicId": "d83f7b6e-821c-4fe1-96e6-910eca8fbbfc",
  "priority": 50,
  "testability": "auto",
  "dependsOn": [
    "POST /api/auth/signup-tenant"
  ],
  "testCases": [
    {
      "name": "Create sandbox sub-tenant from caller's tenant_id",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "payload": {
        "expires_at": "{{dynamic:futuredatetime}}",
        "sanitization_policy": "default-mask-pii"
      },
      "expectedStatus": 201
    }
  ],
  "captureResponse": {
    "tenant-lifecycle.sandbox.response.data.sandbox.sandbox_tenant_id": "data.sandbox.sandbox_tenant_id",
    "tenant-lifecycle.sandbox.response.data.sandbox.parent_tenant_id": "data.sandbox.parent_tenant_id"
  },
  "fieldEnums": {
    "current_state": ["active", "suspended", "offboarding", "offboarded", "sandbox"]
  },
  "statusTransitions": {
    "entity": "tenant_lifecycle.state",
    "field": "current_state",
    "flow": ["active", "sandbox", "offboarded"],
    "transitions": [
      { "from": "active", "to": "sandbox", "via": "POST /api/tenant-lifecycle/sandbox" },
      { "from": "sandbox", "to": "offboarded", "via": "scheduler:runOffboardDeadlineTick" }
    ]
  }
}
