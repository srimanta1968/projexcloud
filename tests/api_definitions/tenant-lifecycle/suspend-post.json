{
  "name": "POST /api/tenant-lifecycle/:tenant_id/suspend - Suspend tenant",
  "endpoint": "/api/tenant-lifecycle/:tenant_id/suspend",
  "sdk": "sdk-tenant-lifecycle",
  "sourceFile": "packages/sdk-tenant-lifecycle/src/server/routes.ts",
  "method": "POST",
  "requiresAuth": true,
  "expectedStatus": 200,
  "taskId": "10360bb1-eaa7-4d76-999b-57d60662885b",
  "sprintId": "8ef1d09e-dd8e-4daf-8d03-54dcd9f812f8",
  "featureId": "a5489f77-208c-47d4-9662-93a2a183a4c1",
  "epicId": "d83f7b6e-821c-4fe1-96e6-910eca8fbbfc",
  "priority": 30,
  "testability": "auto",
  "dependsOn": [
    "POST /api/auth/signup-tenant"
  ],
  "testCases": [
    {
      "name": "Suspend tenant (active -> suspended)",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "pathParams": {
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}"
      },
      "payload": {
        "reason": "non-payment"
      },
      "expectedStatus": 200
    }
  ],
  "captureResponse": {
    "tenant-lifecycle.suspend.response.data.state.tenant_id": "data.state.tenant_id",
    "tenant-lifecycle.suspend.response.data.state.current_state": "data.state.current_state"
  },
  "fieldEnums": {
    "current_state": ["active", "suspended", "offboarding", "offboarded", "sandbox"]
  },
  "statusTransitions": {
    "entity": "tenant_lifecycle.state",
    "field": "current_state",
    "flow": ["active", "suspended", "offboarding", "offboarded"],
    "transitions": [
      { "from": "active", "to": "suspended", "via": "POST /api/tenant-lifecycle/:tenant_id/suspend" },
      { "from": "suspended", "to": "active", "via": "POST /api/tenant-lifecycle/:tenant_id/reinstate" },
      { "from": "active", "to": "offboarding", "via": "POST /api/tenant-lifecycle/:tenant_id/offboard" },
      { "from": "suspended", "to": "offboarding", "via": "POST /api/tenant-lifecycle/:tenant_id/offboard" },
      { "from": "offboarding", "to": "offboarded", "via": "scheduler:runOffboardDeadlineTick" }
    ]
  }
}
