{
  "endpoint": "/api/agent-runtime/agents",
  "sdk": "sdk-agent-runtime",
  "method": "POST",
  "taskId": "d9609d02-6991-45a5-94dd-9c10e02e6448",
  "description": "Create an agent_definition. Required: name, acting_persona_id, tier, vector_namespace, created_by. Returns the row including server-generated agent_id + timestamps.",
  "requiresAuth": true,
  "priority": 50,
  "dependsOn": [
    "POST /api/auth/register"
  ],
  "fieldEnums": {
    "tier": [
      "sync",
      "orchestration",
      "batch"
    ]
  },
  "captureResponse": {
    "agent-runtime-agents.create.response.data.agent_id": "data.agent_id"
  },
  "testCases": [
    {
      "name": "Create agent definition",
      "headers": {
        "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
      },
      "payload": {
        "tenant_id": null,
        "name": "{{dynamic:name}}",
        "description": "QA automation agent definition",
        "acting_persona_id": "{{var:acting_persona_id}}",
        "agent_scope": [],
        "default_ttl_seconds": 30,
        "tier": "sync",
        "kill_switch_flag_id": null,
        "vector_namespace": "agents-qa-ns-default",
        "tool_manifest": [
          "crm.contact.create"
        ],
        "created_by": "qa-automation"
      },
      "expectedStatus": 201,
      "expectedResponse": {
        "success": true
      }
    }
  ]
}
