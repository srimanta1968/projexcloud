{
  "name": "POST /api/resolver/explain - Explain attribute provenance (FR-IDR-6)",
  "endpoint": "/api/resolver/explain",
  "sdk": "sdk-identity-resolver",
  "method": "POST",
  "requiresAuth": true,
  "expectedStatus": 200,
  "taskId": "304f05ff-29db-482b-9248-4ed36b7289e7",
  "sprintId": "8ef1d09e-dd8e-4daf-8d03-54dcd9f812f8",
  "featureId": "9daac052-eec4-48be-ac02-eda45bf2f005",
  "epicId": "93a549d6-9a93-4d82-86bb-bac5167fa960",
  "priority": 35,
  "testability": "auto",
  "dependsOn": [
    "POST /api/auth/signup-tenant",
    "POST /scim/v2/Users"
  ],
  "fieldEnums": {
    "attribute": [
      "primary_persona_id",
      "all_persona_ids",
      "effective_role_closure",
      "active_consents",
      "admin_pool_index",
      "app_pool_index",
      "rebac_edges",
      "abac_attributes"
    ]
  },
  "testCases": [
    {
      "name": "Explain primary_persona_id provenance",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "payload": {
        "person_id": "{{cache:scim.create.response.data.person_id}}",
        "app_id": "{{cache:auth.signup-tenant.response.data.app_id}}",
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}",
        "attribute": "primary_persona_id"
      },
      "expectedStatus": 200
    }
  ],
  "captureResponse": {
    "resolver.explain.response.data.provenance.attribute": "data.provenance.attribute",
    "resolver.explain.response.data.provenance.source_sdk": "data.provenance.source_sdk",
    "resolver.explain.response.data.provenance.projection_version": "data.provenance.projection_version"
  },
  "description": "Returns provenance metadata (source SDK, computed_at, projection_version) for a single resolved identity attribute of a person within a tenant/app context. Requires person_id, app_id, tenant_id and attribute — any missing field yields 400. attribute is NOT enum-validated: an unrecognized attribute returns 200 with source_sdk=\"sdk-identity\" via the explain() default branch. A downstream resolve failure surfaces as Fastify default 500 (no explicit branch).",
  "errorCases": [
    {
      "status": 401,
      "code": "Unauthorized",
      "message": "Missing bearer token",
      "when": "Authorization header absent or not Bearer form (requireAuth)"
    },
    {
      "status": 401,
      "code": "Unauthorized",
      "message": "Invalid or expired token",
      "when": "Bearer token fails JWT verification (requireAuth)"
    },
    {
      "status": 400,
      "code": "ValidationError",
      "message": "missing required fields",
      "when": "person_id, app_id, tenant_id or attribute missing/falsy in body"
    }
  ]
}
