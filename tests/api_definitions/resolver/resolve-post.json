{
  "name": "POST /api/resolver/resolve - Resolve IdentityContext (FR-IDR-1)",
  "endpoint": "/api/resolver/resolve",
  "sdk": "sdk-identity-resolver",
  "method": "POST",
  "requiresAuth": true,
  "expectedStatus": 200,
  "taskId": "304f05ff-29db-482b-9248-4ed36b7289e7",
  "sprintId": "8ef1d09e-dd8e-4daf-8d03-54dcd9f812f8",
  "featureId": "9daac052-eec4-48be-ac02-eda45bf2f005",
  "epicId": "93a549d6-9a93-4d82-86bb-bac5167fa960",
  "priority": 30,
  "testability": "auto",
  "dependsOn": [
    "POST /api/auth/signup-tenant",
    "POST /scim/v2/Users"
  ],
  "testCases": [
    {
      "name": "Resolve identity context",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "payload": {
        "person_id": "{{cache:scim.create.response.data.person_id}}",
        "app_id": "{{cache:auth.signup-tenant.response.data.app_id}}",
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}",
        "bypass_cache": false
      },
      "expectedStatus": 200
    }
  ],
  "captureResponse": {
    "resolver.resolve.response.data.identity_context.person_id": "data.identity_context.person_id",
    "resolver.resolve.response.data.identity_context.tenant_id": "data.identity_context.tenant_id",
    "resolver.resolve.response.data.identity_context.projection_version": "data.identity_context.projection_version"
  },
  "description": "Resolves and returns the full IdentityContext for a person in a tenant/app (personas, role closure, consents, pool indices) from the Redis/Postgres projection with a live-compose fallback on projection miss. Requires person_id, app_id and tenant_id; optional bypass_cache boolean skips the projection cache. Any missing required field yields 400; an internal resolve failure falls through to Fastify default 500.",
  "errorCases": [
    {
      "status": 401,
      "code": "Unauthorized",
      "message": "Missing bearer token",
      "when": "Authorization header absent or not Bearer form (requireAuth)"
    },
    {
      "status": 401,
      "code": "Unauthorized",
      "message": "Invalid or expired token",
      "when": "Bearer token fails JWT verification (requireAuth)"
    },
    {
      "status": 400,
      "code": "ValidationError",
      "message": "missing required fields",
      "when": "person_id, app_id or tenant_id missing/falsy in body"
    }
  ]
}
