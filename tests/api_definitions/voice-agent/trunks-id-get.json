  "epicId": "7aa29f0e-cca5-46fa-8055-bd79b25855bf",
  "testability": "auto",
  "name": "GET /api/voice-agent/trunks/:trunk_id - One SIP trunk",
  "endpoint": "/api/voice-agent/trunks/:trunk_id",
  "method": "GET",
  "expectedStatus": 200,
  "priority": 142,
  "coversCriterion": [
    "506bbf30-2d83-440b-a853-1a8205f4b3cb#AC1"
  ],
  "description": "One of the tenant's SIP trunks (506bbf30-2d83-440b-a853-1a8205f4b3cb#AC1); another tenant's trunk or an unknown id is 404. The API runner has no Twilio account or LiveKit SIP service, so its datasets lead with the deterministic refusals; the provisioning path is exercised against Twilio/LiveKit API stubs that check every request.",
  "dependsOn": [
    "POST /api/auth/signup-tenant"
  ],
  "pathParams": {
    "trunk_id": {
      "type": "string",
      "format": "uuid",
      "required": true
    }
  },
  "fieldEnums": {
    "status": [
      "provisioning",
      "active",
      "error",
      "deleted"
    ]
  },
  "testCases": [
    {
      "name": "Unknown trunk",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "pathParams": {
        "trunk_id": "{{dynamic:uuid}}"
      },
      "expectedStatus": 404,
      "expectedResponse": {
        "error": "string",
        "details": [
          "string"
        ]
      }
    }
  ],
  "errorCases": [
    {
      "status": 404,
      "code": "NotFound",
      "message": "trunk not found",
      "when": "no trunk with that id for the caller's tenant (includes another tenant's trunk)"
    },
    {
      "status": 401,
      "code": "Unauthorized",
      "message": "Missing bearer token",
      "when": "no Authorization header"
    }
  ]
}
