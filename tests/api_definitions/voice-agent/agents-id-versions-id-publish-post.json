{
  "name": "POST /api/voice-agent/agents/:agent_id/versions/:version_id/publish - Publish a version (gated)",
  "endpoint": "/api/voice-agent/agents/:agent_id/versions/:version_id/publish",
  "sdk": "sdk-voice-agent",
  "sourceFile": "packages/sdk-voice-agent/src/server/agentRoutes.ts",
  "method": "POST",
  "requiresAuth": true,
  "expectedStatus": 200,
  "taskId": "ebbb8ef0-b3d9-4250-9b61-97d3b55b63dd",
  "sprintId": "d4876947-8d18-4538-8e9f-51ba3e0735a9",
  "featureId": "8076dcb4-e91f-46a5-9825-f6bf2e2b2a47",
  "epicId": "9c7a8dc4-3db7-4cd2-9121-7649f143525c",
  "priority": 77,
  "testability": "auto",
  "coversCriterion": [
    "8076dcb4-e91f-46a5-9825-f6bf2e2b2a47#AC2"
  ],
  "description": "Puts a version live only when BOTH gates hold (8076dcb4-e91f-46a5-9825-f6bf2e2b2a47#AC2 — publishing a version fails unless it has a passing evaluation run and an approval): the newest eval run for the version passed, AND its sdk-approval request is approved for exactly this version. Otherwise 409 PublishBlocked naming the unmet gate. In the dependency chain the approval has just been requested and is still pending, so the first case asserts the gate refusing; the approved path is the second dataset. On success the agent's published_version_id moves to the version, status becomes published, and voice.agent.published.v1 is emitted. Re-publishing the live version is idempotent (200).",
  "dependsOn": [
    "POST /api/auth/signup-tenant",
    "POST /api/ai-gateway/tenant-credentials",
    "POST /api/voice-agent/stack-profiles",
    "POST /api/voice-agent/agents",
    "POST /api/voice-agent/agents/:agent_id/versions",
    "POST /api/voice-agent/agents/:agent_id/versions/:version_id/eval-runs",
    "POST /api/approvals/routes",
    "POST /api/voice-agent/agents/:agent_id/versions/:version_id/publish-request"
  ],
  "statusTransitions": {
    "entity": "voice_agent.agent",
    "field": "status",
    "flow": [
      "draft",
      "published",
      "paused",
      "archived"
    ],
    "transitions": [
      {
        "from": "",
        "to": "draft",
        "via": "POST /api/voice-agent/agents"
      },
      {
        "from": "draft",
        "to": "published",
        "via": "POST /api/voice-agent/agents/:agent_id/versions/:version_id/publish"
      },
      {
        "from": "published",
        "to": "published",
        "via": "POST /api/voice-agent/agents/:agent_id/rollback"
      }
    ]
  },
  "testCases": [
    {
      "name": "Publish is blocked while the approval is still pending",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "pathParams": {
        "agent_id": "{{cache:voice-agent.agents.create.response.data.agent.agent_id}}",
        "version_id": "{{cache:voice-agent.agents.versions.create.response.data.version.version_id}}"
      },
      "payload": {},
      "expectedStatus": 409,
      "expectedResponse": {
        "error": "PublishBlocked"
      }
    },
    {
      "name": "Publish after the approval step is approved",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "pathParams": {
        "agent_id": "{{cache:voice-agent.agents.create.response.data.agent.agent_id}}",
        "version_id": "{{cache:voice-agent.agents.versions.create.response.data.version.version_id}}"
      },
      "payload": {},
      "expectedStatus": 200,
      "expectedResponse": {
        "data": {
          "agent": {
            "published_version_id": "string",
            "status": "string"
          },
          "version": {
            "is_live": "boolean"
          }
        }
      }
    }
  ],
  "captureResponse": {
    "voice-agent.agents.versions.publish.response.data.agent.published_version_id": "data.agent.published_version_id"
  },
  "errorCases": [
    {
      "status": 409,
      "code": "PublishBlocked",
      "message": "no evaluation run recorded for this version | the latest evaluation run for this version did not pass | no approval has been requested for this version | approval is <status>, not approved",
      "when": "either gate unmet"
    },
    {
      "status": 404,
      "code": "NotFound",
      "message": "agent not found",
      "when": "no agent with that id for the authenticated tenant"
    },
    {
      "status": 409,
      "code": "Conflict",
      "message": "archived agents cannot be published",
      "when": "agent archived"
    },
    {
      "status": 401,
      "code": "Unauthorized",
      "message": "Missing bearer token",
      "when": "no Authorization header"
    }
  ]
}
