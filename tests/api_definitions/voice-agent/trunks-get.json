  "name": "GET /api/voice-agent/trunks - The tenant's SIP trunks",
  "endpoint": "/api/voice-agent/trunks",
  "method": "GET",
  "expectedStatus": 200,
  "priority": 141,
  "coversCriterion": [
    "506bbf30-2d83-440b-a853-1a8205f4b3cb#AC1"
  ],
  "description": "Lists the tenant's SIP trunks newest first (deleted ones included) with carrier refs, the LiveKit inbound/outbound trunk and dispatch-rule ids, the attached numbers and status (506bbf30-2d83-440b-a853-1a8205f4b3cb#AC1). Never includes the SIP password.",
  "dependsOn": [
    "POST /api/auth/signup-tenant"
  ],
  "fieldEnums": {
    "status": [
      "provisioning",
      "active",
      "error",
      "deleted"
    ],
    "carrier": [
      "twilio",
      "telnyx"
    ]
  },
  "testCases": [
    {
      "name": "List the tenant's trunks",
      "capturesResponse": true,
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "expectedStatus": 200,
      "expectedResponse": {
        "data": {
          "trunks": "array"
        }
