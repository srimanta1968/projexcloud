{
  "name": "GET /api/voice-agent/stack-profiles - List the tenant's stack profiles",
  "endpoint": "/api/voice-agent/stack-profiles",
  "sdk": "sdk-voice-agent",
  "sourceFile": "packages/sdk-voice-agent/src/server/routes.ts",
  "method": "GET",
  "requiresAuth": true,
  "expectedStatus": 200,
  "taskId": "9911dc89-b62c-408c-a819-f94578e92fed",
  "sprintId": "d4876947-8d18-4538-8e9f-51ba3e0735a9",
  "featureId": "deef80bf-b0ce-4295-9cf0-878c4f5bfd02",
  "epicId": "9c7a8dc4-3db7-4cd2-9121-7649f143525c",
  "priority": 62,
  "testability": "auto",
  "coversCriterion": ["deef80bf-b0ce-4295-9cf0-878c4f5bfd02#AC3"],
  "description": "Lists the authenticated tenant's stack profiles, newest first, paged by limit (1-100, default 50) and offset. status filters active (default) or archived. Supports deef80bf-b0ce-4295-9cf0-878c4f5bfd02#AC3 by showing the profile created from a preset. Tenant comes from the JWT; an explicit tenant_id query param must match it (403 Forbidden otherwise).",
  "dependsOn": [
    "POST /api/auth/signup-tenant",
    "POST /api/ai-gateway/tenant-credentials",
    "POST /api/voice-agent/stack-profiles"
  ],
  "fieldEnums": { "status": ["active", "archived"] },
  "testCases": [
    {
      "name": "List active stack profiles",
      "headers": { "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}" },
      "queryParams": { "status": "{{static:active}}", "limit": "{{static:20}}" },
      "expectedStatus": 200,
      "expectedResponse": { "data": { "stack_profiles": [ { "profile_id": "string", "name": "string", "preset_key": "string" } ], "limit": "number", "offset": "number" } }
    },
    {
      "name": "Reject a status outside active/archived",
      "headers": { "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}" },
      "queryParams": { "status": "{{static:deleted}}" },
      "expectedStatus": 400
    }
  ],
  "errorCases": [
    { "status": 400, "code": "ValidationError", "message": "status must be active or archived", "when": "status query param outside the enum" },
    { "status": 403, "code": "Forbidden", "message": "tenant_id does not match the authenticated tenant", "when": "tenant_id query param differs from the JWT tenant" },
    { "status": 401, "code": "Unauthorized", "message": "Missing bearer token", "when": "no Authorization header" }
  ]
}
