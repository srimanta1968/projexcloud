{
  "name": "POST /api/tenants/:tenant_id/sub-tenants - Create sub-tenant",
  "endpoint": "/api/tenants/:tenant_id/sub-tenants",
  "sdk": "sdk-tenant",
  "method": "POST",
  "requiresAuth": true,
  "expectedStatus": 201,
  "taskId": "df5db7ba-0b3f-4c70-96ff-9fad07030640",
  "sprintId": "8ef1d09e-dd8e-4daf-8d03-54dcd9f812f8",
  "featureId": "d3f526f1-243f-4b31-b538-aeffeddca534",
  "epicId": "00996d23-f667-4a82-9285-7728ba357e7b",
  "priority": 35,
  "testability": "auto",
  "dependsOn": [
    "POST /api/auth/signup-tenant"
  ],
  "testCases": [
    {
      "name": "Create a sub-tenant that shares parent pool",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "pathParams": {
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}"
      },
      "payload": {
        "app_id": "{{cache:auth.signup-tenant.response.data.app_id}}",
        "display_name": "{{dynamic:name}}",
        "region": "us-east-1",
        "placement": "share",
        "isolation_tier": "S",
        "brand_domain": "sub.example.com"
      },
      "expectedStatus": 201
    }
  ],
  "fieldEnums": {
    "placement": ["share", "tier-p", "tier-g"],
    "isolation_tier": ["S", "P", "G"]
  },
  "captureResponse": {
    "tenants.create-sub-tenant.response.data.tenant_id": "data.tenant_id",
    "tenants.create-sub-tenant.response.data.parent_tenant_id": "data.parent_tenant_id"
  }
}
