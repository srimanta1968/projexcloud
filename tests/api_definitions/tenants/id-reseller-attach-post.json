{
  "name": "POST /api/tenants/:tenant_id/reseller-attach - Attach reseller",
  "endpoint": "/api/tenants/:tenant_id/reseller-attach",
  "sdk": "sdk-tenant",
  "method": "POST",
  "requiresAuth": true,
  "expectedStatus": 200,
  "taskId": "436582de-8e8d-4a25-a828-b211af7720e1",
  "sprintId": "8ef1d09e-dd8e-4daf-8d03-54dcd9f812f8",
  "featureId": "d3f526f1-243f-4b31-b538-aeffeddca534",
  "epicId": "00996d23-f667-4a82-9285-7728ba357e7b",
  "priority": 50,
  "testability": "auto",
  "dependsOn": [
    "POST /api/auth/signup-tenant",
    "POST /api/resellers"
  ],
  "testCases": [
    {
      "name": "Attach a reseller to a tenant with custom commission",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "pathParams": {
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}"
      },
      "payload": {
        "reseller_id": "{{cache:resellers.create.response.data.reseller.reseller_id}}",
        "commission_rules": {
          "default_pct": 12
        }
      },
      "expectedStatus": 200
    }
  ],
  "captureResponse": {
    "tenants.attach-reseller.response.data.tenant_id": "data.tenant_id",
    "tenants.attach-reseller.response.data.reseller_id": "data.reseller_id"
  }
}
