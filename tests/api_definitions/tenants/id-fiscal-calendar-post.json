{
  "name": "POST /api/tenants/:tenant_id/fiscal-calendar - Set fiscal calendar",
  "endpoint": "/api/tenants/:tenant_id/fiscal-calendar",
  "sdk": "sdk-tenant",
  "method": "POST",
  "requiresAuth": true,
  "expectedStatus": 201,
  "taskId": "3f6dedbe-57fa-4eeb-94e7-42f6ff444b09",
  "sprintId": "8ef1d09e-dd8e-4daf-8d03-54dcd9f812f8",
  "featureId": "d3f526f1-243f-4b31-b538-aeffeddca534",
  "epicId": "00996d23-f667-4a82-9285-7728ba357e7b",
  "priority": 45,
  "testability": "auto",
  "dependsOn": [
    "POST /api/auth/signup-tenant"
  ],
  "testCases": [
    {
      "name": "Set fiscal year starting in April with USD",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "pathParams": {
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}"
      },
      "payload": {
        "year_start_month": 4,
        "base_currency": "USD",
        "period_kind": "quarter"
      },
      "expectedStatus": 201
    }
  ],
  "fieldEnums": {
    "period_kind": ["year", "quarter", "month", "week"]
  },
  "captureResponse": {
    "tenants.set-fiscal-calendar.response.data.periods.0.fiscal_period_id": "data.periods.0.fiscal_period_id"
  }
}
