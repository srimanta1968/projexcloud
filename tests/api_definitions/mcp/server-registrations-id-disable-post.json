{
  "name": "POST /api/mcp/server-registrations/:id/disable — sdk-mcp-bridge",
  "endpoint": "/api/mcp/server-registrations/:id/disable",
  "sdk": "sdk-mcp-bridge",
  "sourceFile": "packages/sdk-mcp-bridge/src/server/handlers/mcpController.ts",
  "method": "POST",
  "requiresAuth": true,
  "expectedStatus": 200,
  "testability": "auto",
  "dependsOn": [
    "POST /api/auth/signup-tenant",
