        "via": "POST /api/mcp/server-registrations/:id/disable"
      }
    ]
  },
  "testCases": [
    {
      "name": "Disable a registered MCP server",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "pathParams": {
        "id": "{{cache:mcp-server-registrations.create.response.data.server.registration_id}}"
      },
      "payload": {
        "reason": "Decommissioned by automated test"
      },
      "expectedStatus": 200
    }
  ],
  "expectedResponse": {
    "success": true,
    "data": {
      "registration_id": "string",
      "disabled": true
    }
  },
  "captureResponse": {
    "mcp-server-registrations.disable.response.data.registration_id": "data.registration_id"
  }
}
