{
  "sdk": "sdk-api-keys",
  "sourceFile": "packages/sdk-api-keys/src/server/routes.ts",
  "requiresAuth": true,
  "sprintId": "d4876947-8d18-4538-8e9f-51ba3e0735a9",
  "epicId": "783fc94b-6992-49a5-a492-74ee0450a92f",
  "testability": "auto",
  "name": "POST /api/api-keys/{key_id}/revoke - Revoke immediately",
  "endpoint": "/api/api-keys/:key_id/revoke",
  "method": "POST",
  "expectedStatus": 200,
  "taskId": "bcf23c76-2e69-48c2-af3f-84acc9e636d2",
  "featureId": "888ec9d8-5cbb-4d77-9082-fd78b08334ad",
  "priority": 30,
  "description": "Stops a credential at once and broadcasts the revocation over Redis so every gateway replica drops its cached copy within a second rather than at cache expiry. Tenant-constrained, and a key_id belonging to somebody else answers 404 rather than 403 so the response cannot be used to confirm that an id is real. Revoking twice answers 404, because the second call changes nothing.",
  "dependsOn": [
    "POST /api/auth/signup-tenant",
    "POST /api/applications",
    "POST /api/applications/:application_id/keys",
    "POST /api/api-keys/:key_id/rotate"
  ],
  "fieldEnums": {
    "status": [
      "active",
      "rotating",
      "revoked",
      "expired"
    ]
  },
  "testCases": [
    {
      "name": "Revoke the issued key",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "pathParams": {
        "key_id": "{{cache:applications.id-keys.response.data.key.key_id}}"
      },
      "payload": {
        "reason": "rotated out of service"
      },
      "expectedStatus": 200,
      "expectedResponse": {
        "data": {
          "key": {
            "key_id": "string",
            "status": "string"
          }
        }
      }
    }
  ],
  "errorCases": [
    {
      "name": "A key in another tenant answers 404",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "pathParams": {
        "key_id": "00000000-0000-0000-0000-0000000000ff"
      },
      "payload": {
        "reason": "not mine"
      },
      "expectedStatus": 404
    }
  ]
}
