{
  "name": "POST /api/api-keys/:key_id/revoke - Revoke API key",
  "endpoint": "/api/api-keys/:key_id/revoke",
  "sdk": "sdk-api-keys",
  "method": "POST",
  "requiresAuth": true,
  "expectedStatus": 200,
  "taskId": "649c02dd-6922-48af-a637-c88aea12d665",
  "sprintId": "8ef1d09e-dd8e-4daf-8d03-54dcd9f812f8",
  "featureId": "7a33ef6c-2dad-4c40-a8a2-f414c13e6c48",
  "epicId": "00996d23-f667-4a82-9285-7728ba357e7b",
  "priority": 60,
  "testability": "auto",
  "dependsOn": [
    "POST /api/auth/signup-tenant",
    "POST /api/api-keys"
  ],
  "testCases": [
    {
      "name": "Revoke the freshly-issued key",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "pathParams": {
        "key_id": "{{cache:api-keys.create.response.data.key.key_id}}"
      },
      "payload": {},
      "expectedStatus": 200
    }
  ],
  "statusTransitions": {
    "entity": "api-key",
    "field": "status",
    "flow": [
      "active",
      "rotating",
      "revoked",
      "expired"
    ],
    "transitions": [
      {
        "from": "active",
        "to": "revoked",
        "via": "POST /api/api-keys/:key_id/revoke"
      },
      {
        "from": "rotating",
        "to": "revoked",
        "via": "POST /api/api-keys/:key_id/revoke"
      }
    ]
  },
  "expectedResponse": {
    "data": {
      "key": {
        "key_id": "string",
        "status": "string"
      }
    }
  },
  "captureResponse": {
    "api-keys.revoke.response.data.key.key_id": "data.key.key_id",
    "api-keys.revoke.response.data.key.status": "data.key.status"
  }
}
