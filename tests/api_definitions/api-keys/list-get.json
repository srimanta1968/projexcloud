{
  "sdk": "sdk-api-keys",
  "sourceFile": "packages/sdk-api-keys/src/server/routes.ts",
  "requiresAuth": true,
  "sprintId": "d4876947-8d18-4538-8e9f-51ba3e0735a9",
  "epicId": "783fc94b-6992-49a5-a492-74ee0450a92f",
  "testability": "auto",
  "name": "GET /api/api-keys - List the keys of this tenant",
  "endpoint": "/api/api-keys",
  "method": "GET",
  "expectedStatus": 200,
  "taskId": "bcf23c76-2e69-48c2-af3f-84acc9e636d2",
  "featureId": "888ec9d8-5cbb-4d77-9082-fd78b08334ad",
  "priority": 28,
  "description": "Every key belonging to the calling tenant, newest first, optionally narrowed to one application. Returns the display prefix and never the key itself or its hash - a list endpoint that could return a credential would make the one-time reveal meaningless. Tenant comes from the caller claims, so there is no tenant_id parameter and no way to list the credentials of somebody else.",
  "dependsOn": [
    "POST /api/auth/signup-tenant",
    "POST /api/applications",
    "POST /api/applications/{application_id}/keys"
  ],
  "fieldEnums": {
    "status": [
      "active",
      "rotating",
      "revoked",
      "expired"
    ],
    "environment": [
      "live",
      "test"
    ]
  },
  "testCases": [
    {
      "name": "List every key of the tenant",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "expectedStatus": 200,
      "expectedResponse": {
        "data": {
          "keys": "array"
        }
      }
    },
    {
      "name": "Narrow to one application",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "queryParams": {
        "application_id": "{{cache:applications.create.response.data.application.application_id}}"
      },
      "expectedStatus": 200
    }
  ],
  "errorCases": [
    {
      "name": "Unauthenticated",
      "expectedStatus": 401
    }
  ]
}
