{
  "sdk": "sdk-api-keys",
  "sourceFile": "packages/sdk-api-keys/src/server/routes.ts",
  "requiresAuth": true,
  "sprintId": "d4876947-8d18-4538-8e9f-51ba3e0735a9",
  "epicId": "783fc94b-6992-49a5-a492-74ee0450a92f",
  "testability": "auto",
  "name": "POST /api/api-keys - Issue an API key",
  "endpoint": "/api/api-keys",
  "method": "POST",
  "expectedStatus": 201,
  "taskId": "bcf23c76-2e69-48c2-af3f-84acc9e636d2",
  "featureId": "888ec9d8-5cbb-4d77-9082-fd78b08334ad",
  "priority": 27,
  "description": "Issues a key without naming the application in the path; application_id may still travel in the body. The tenant comes from the caller claims - it used to be read from the payload with no ownership check at all, which let any signed-in user mint and manage credentials against any tenant on the platform. A payload tenant_id that disagrees with the credential is now a 403 rather than being silently ignored, because ignoring it hides a misconfigured caller until it writes somewhere it should not. Plaintext is returned exactly once.",
  "dependsOn": [
    "POST /api/auth/signup-tenant",
    "POST /api/applications"
  ],
  "fieldEnums": {
    "scopes": [
      "sla.clock.read",
      "sla.clock.write",
      "crm.contact.read"
    ],
    "status": [
      "active",
      "rotating",
      "revoked",
      "expired"
    ]
  },
  "testCases": [
    {
      "name": "Issue a key naming the application in the body",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "payload": {
        "application_id": "{{cache:applications.create.response.data.application.application_id}}",
        "name": "body-named key",
        "scopes": [
          "sla.clock.read"
        ],
        "rate_limit_rpm": 600
      },
      "expectedStatus": 201,
      "expectedResponse": {
        "data": {
          "key": {
            "key_id": "string",
            "prefix": "string"
          },
          "plaintext": "string"
        }
      }
    }
  ],
  "errorCases": [
    {
      "name": "A payload naming a different tenant is refused",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "payload": {
        "tenant_id": "00000000-0000-0000-0000-0000000000ff",
        "scopes": [
          "sla.clock.read"
        ]
      },
      "expectedStatus": 403
    },
    {
      "name": "Scopes are required",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "payload": {
        "name": "x"
      },
      "expectedStatus": 400
    }
  ]
}
