{
  "name": "POST /api/payments/methods - Attach PCI-tokenized payment method",
  "endpoint": "/api/payments/methods",
  "sdk": "sdk-payment",
  "method": "POST",
  "requiresAuth": true,
  "expectedStatus": 201,
  "taskId": "2d3f74a8-f5f9-4765-a598-3c2adc5bf755",
  "sprintId": "8ef1d09e-dd8e-4daf-8d03-54dcd9f812f8",
  "featureId": "33deeb13-adc2-4198-b1e1-1315ca492994",
  "epicId": "d83f7b6e-821c-4fe1-96e6-910eca8fbbfc",
  "priority": 20,
  "testability": "auto",
  "dependsOn": [
    "POST /api/auth/signup-tenant"
  ],
  "fieldEnums": {
    "provider": ["stripe", "razorpay", "plaid", "ach"],
    "kind": ["card", "bank-account", "upi", "wallet"]
  },
  "testCases": [
    {
      "name": "Attach Stripe card via tokenized ref",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "payload": {
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}",
        "persona_id": "{{cache:auth.signup-tenant.response.data.userId}}",
        "provider": "stripe",
        "provider_token": "pm_card_visa",
        "kind": "card",
        "last4": "4242",
        "brand": "visa",
        "exp_month": 12,
        "exp_year": 2030,
        "secure_data_field_ref": "{{var:secure_data_field_ref}}"
      },
      "expectedStatus": 201
    }
  ],
  "expectedResponse": {
    "data": {
      "method": {
        "method_id": "string",
        "provider": "string",
        "last4": "string"
      }
    }
  },
  "captureResponse": {
    "payments.methods.create.response.data.method.method_id": "data.method.method_id"
  }
}
