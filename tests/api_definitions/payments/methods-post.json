{
  "name": "POST /api/payments/methods - Attach PCI-tokenized payment method",
  "endpoint": "/api/payments/methods",
  "method": "POST",
  "requiresAuth": true,
  "expectedStatus": 201,
  "taskId": "2d3f74a8-f5f9-4765-a598-3c2adc5bf755",
  "sprintId": "8ef1d09e-dd8e-4daf-8d03-54dcd9f812f8",
  "featureId": "33deeb13-adc2-4198-b1e1-1315ca492994",
  "epicId": "d83f7b6e-821c-4fe1-96e6-910eca8fbbfc",
  "priority": 20,
  "testability": "manual",
  "skipReason": "Requires a real provider token (Stripe pi_*); covered by vendor sandbox test per AC-3.",
  "dependsOn": ["POST /api/auth/register"],
  "testCases": [
    {
      "name": "Attach Stripe card via tokenized ref",
      "headers": { "Authorization": "Bearer {{cache:auth.register.response.data.token}}" },
      "payload": {
        "tenant_id": "{{static:00000000-0000-0000-0000-000000000001}}",
        "persona_id": "{{cache:auth.register.response.data.userId}}",
        "provider": "stripe",
        "provider_token": "{{static:pm_card_visa}}",
        "kind": "card",
        "last4": "{{static:4242}}",
        "brand": "{{static:visa}}",
        "exp_month": 12,
        "exp_year": 2030
      },
      "expectedStatus": 201
    }
  ],
  "expectedResponse": {
    "data": { "method": { "method_id": "string", "provider": "string", "last4": "string" } }
  },
  "captureResponse": {
    "payments.methods.create.response.data.method.method_id": "data.method.method_id"
  }
}
