{
  "name": "POST /api/payments/:charge_id/refund - Issue refund (sdk-approval gates high-value)",
  "endpoint": "/api/payments/:charge_id/refund",
  "sdk": "sdk-payment",
  "method": "POST",
  "requiresAuth": true,
  "expectedStatus": 201,
  "taskId": "21db10b8-b400-4672-a4b2-9227032d12c0",
  "sprintId": "8ef1d09e-dd8e-4daf-8d03-54dcd9f812f8",
  "featureId": "33deeb13-adc2-4198-b1e1-1315ca492994",
  "epicId": "d83f7b6e-821c-4fe1-96e6-910eca8fbbfc",
  "priority": 50,
  "testability": "auto",
  "dependsOn": [
    "POST /api/auth/signup-tenant",
    "POST /api/payments/methods",
    "POST /api/payments/charge"
  ],
  "statusTransitions": {
    "entity": "refund",
    "field": "status",
    "flow": ["pending", "awaiting_approval", "approved", "rejected", "succeeded", "failed"],
    "transitions": [
      { "from": "pending", "to": "succeeded", "via": "POST /api/payments/:charge_id/refund" },
      { "from": "pending", "to": "awaiting_approval", "via": "POST /api/payments/:charge_id/refund" },
      { "from": "awaiting_approval", "to": "approved", "via": "POST /api/payments/:charge_id/refund" }
    ]
  },
  "testCases": [
    {
      "name": "Refund $5.00 USD below approval threshold",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "pathParams": {
        "charge_id": "{{cache:payments.charge.response.data.charge.charge_id}}"
      },
      "payload": {
        "amount": 5,
        "reason": "customer requested partial refund",
        "approval_threshold": 10000
      },
      "expectedStatus": 201
    }
  ],
  "expectedResponse": {
    "data": {
      "refund": {
        "refund_id": "string",
        "status": "string",
        "amount": "string"
      }
    }
  },
  "captureResponse": {
    "payments.refund.response.data.refund.refund_id": "data.refund.refund_id"
  }
}
