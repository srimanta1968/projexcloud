{
  "name": "POST /api/payments/charge - Capture a charge via provider",
  "endpoint": "/api/payments/charge",
  "sdk": "sdk-payment",
  "method": "POST",
  "requiresAuth": true,
  "expectedStatus": 201,
  "taskId": "2d3f74a8-f5f9-4765-a598-3c2adc5bf755",
  "sprintId": "8ef1d09e-dd8e-4daf-8d03-54dcd9f812f8",
  "featureId": "33deeb13-adc2-4198-b1e1-1315ca492994",
  "epicId": "d83f7b6e-821c-4fe1-96e6-910eca8fbbfc",
  "priority": 30,
  "testability": "auto",
  "dependsOn": [
    "POST /api/auth/signup-tenant",
    "POST /api/payments/methods"
  ],
  "statusTransitions": {
    "entity": "charge",
    "field": "status",
    "flow": ["requires_action", "authorized", "captured", "failed", "refunded", "disputed"],
    "transitions": [
      { "from": "requires_action", "to": "captured", "via": "POST /api/payments/charge" },
      { "from": "requires_action", "to": "failed", "via": "POST /api/payments/charge" },
      { "from": "captured", "to": "refunded", "via": "POST /api/payments/:charge_id/refund" }
    ]
  },
  "testCases": [
    {
      "name": "Charge $25.00 USD",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "payload": {
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}",
        "method_id": "{{cache:payments.methods.create.response.data.method.method_id}}",
        "amount": 25,
        "currency": "USD",
        "encounter_id": "{{var:encounter_id}}",
        "idempotency_key": "{{dynamic:slug}}"
      },
      "expectedStatus": 201
    }
  ],
  "expectedResponse": {
    "data": {
      "charge": {
        "charge_id": "string",
        "status": "string",
        "amount": "string"
      }
    }
  },
  "captureResponse": {
    "payments.charge.response.data.charge.charge_id": "data.charge.charge_id"
  }
}
