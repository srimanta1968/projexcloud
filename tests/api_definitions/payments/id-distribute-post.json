{
  "name": "POST /api/payments/:charge_id/distribute - Append immutable distribution ledger entries",
  "endpoint": "/api/payments/:charge_id/distribute",
  "sdk": "sdk-payment",
  "method": "POST",
  "requiresAuth": true,
  "expectedStatus": 201,
  "taskId": "21db10b8-b400-4672-a4b2-9227032d12c0",
  "sprintId": "8ef1d09e-dd8e-4daf-8d03-54dcd9f812f8",
  "featureId": "33deeb13-adc2-4198-b1e1-1315ca492994",
  "epicId": "d83f7b6e-821c-4fe1-96e6-910eca8fbbfc",
  "priority": 60,
  "testability": "auto",
  "dependsOn": [
    "POST /api/auth/signup-tenant",
    "POST /api/payments/methods",
    "POST /api/payments/charge"
  ],
  "testCases": [
    {
      "name": "Split charge between two parties",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "pathParams": {
        "charge_id": "{{cache:payments.charge.response.data.charge.charge_id}}"
      },
      "payload": {
        "currency": "USD",
        "splits": [
          {
            "party_persona_id": "{{cache:auth.signup-tenant.response.data.userId}}",
            "share": 20
          },
          {
            "party_persona_id": "{{var:persona_id}}",
            "share": 5
          }
        ]
      },
      "expectedStatus": 201
    }
  ],
  "expectedResponse": {
    "data": {
      "distributions": [
        {
          "distribution_id": "string",
          "charge_id": "string",
          "party_persona_id": "string",
          "share": "string",
          "seq": "string"
        }
      ]
    }
  },
  "captureResponse": {
    "payments.distribute.response.data.distribution.distribution_id": "data.distributions.0.distribution_id"
  }
}
