{
  "name": "GET /api/consent/receipts — api-gateway",
  "endpoint": "/api/consent/receipts",
  "sdk": "sdk-consent",
  "method": "GET",
  "requiresAuth": true,
  "expectedStatus": 200,
  "sourceFile": "services/api-gateway/src/app.ts",
  "testability": "auto",
  "dependsOn": [
    "POST /api/auth/register",
    "POST /api/auth/signup-tenant",
    "POST /api/app-identities",
    "POST /api/memberships",
    "POST /api/personas",
    "POST /api/consents/purposes"
  ],
  "testCases": [
    {
      "name": "List consent receipts filtered by tenant, subject and purpose",
      "queryParams": {
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}",
        "subject_persona_id": "{{cache:personas.create.response.data.persona.persona_id}}",
        "purpose_id": "{{cache:consents.purposes.create.response.data.purpose.purpose_id}}"
      },
      "expectedStatus": 200,
      "headers": {
        "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
      }
    }
  ],
  "expectedResponse": {
    "success": "boolean",
    "data": "array"
  }
}
