{
  "name": "POST /api/consent/receipts/:receipt_id/revoke — api-gateway",
  "endpoint": "/api/consent/receipts/:receipt_id/revoke",
  "sdk": "sdk-consent",
  "method": "POST",
  "requiresAuth": true,
  "expectedStatus": 200,
  "sourceFile": "services/api-gateway/src/app.ts",
  "testability": "auto",
  "dependsOn": [
    "POST /api/auth/register",
    "POST /api/auth/signup-tenant",
    "POST /api/consents/purposes",
    "POST /api/consents"
  ],
  "testCases": [
    {
      "name": "Revoke a previously granted consent receipt",
      "pathParams": {
        "receipt_id": "{{cache:consents.create.response.data.receipt.receipt_id}}"
      },
      "payload": {
        "reason": "User requested withdrawal of consent."
      },
      "expectedStatus": 200,
      "headers": {
        "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
      }
    }
  ],
  "statusTransitions": {
    "entity": "consent.receipt",
    "field": "status",
    "flow": [
      "active",
      "revoked"
    ],
    "transitions": [
      {
        "from": "active",
        "to": "revoked",
        "via": "POST /api/consent/receipts/:receipt_id/revoke"
      }
    ]
  },
  "expectedResponse": {
    "success": "boolean"
  },
  "captureResponse": {
    "consent.revoke.response.success": "success"
  }
}
