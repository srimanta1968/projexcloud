{
  "name": "POST /api/events/tickets — sdk-event",
  "endpoint": "/api/events/tickets",
  "method": "POST",
  "requiresAuth": true,
  "dependsOn": [
    "POST /api/auth/register",
    "POST /api/auth/signup-tenant",
    "POST /api/vault/keys",
    "POST /api/encounters",
    "POST /api/events/sessions",
    "POST /api/app-identities",
    "POST /api/memberships",
    "POST /api/personas"
  ],
  "expectedStatus": 201,
  "sdk": "sdk-event",
  "sourceFile": "packages/sdk-event/src/server/routes.ts",
  "_generated": true,
  "testability": "auto",
  "testCases": [
    {
      "name": "Issue a ticket for a session",
      "headers": {
        "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
      },
      "payload": {
        "session_id": "{{cache:events.sessions.create.response.data.session.session_id}}",
        "holder_persona_id": "{{cache:personas.create.response.data.persona.persona_id}}",
        "price": 50
      },
      "expectedStatus": 201
    }
  ],
  "captureResponse": {
    "events.tickets.create.response.data.ticket.ticket_id": "data.ticket.ticket_id",
    "events.tickets.create.response.data.ticket.qr_token": "data.ticket.qr_token",
    "events.tickets.create.response.data.ticket.status": "data.ticket.status"
  }
}
