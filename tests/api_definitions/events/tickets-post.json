{
  "name": "POST /api/events/tickets — sdk-event",
  "endpoint": "/api/events/tickets",
  "method": "POST",
  "requiresAuth": true,
  "dependsOn": [
    "POST /api/auth/register",
    "POST /api/events/sessions",
    "POST /api/personas"
  ],
  "expectedStatus": 201,
  "sdk": "sdk-event",
  "sourceFile": "packages/sdk-event/src/server/routes.ts",
  "_generated": true,
  "testability": "manual",
  "skipReason": "Requires a scheduled/live session with capacity and a holder persona; issueTicket reserves capacity and mints a qr_token.",
  "testCases": [
    {
      "name": "Issue a ticket for a session",
      "headers": {
        "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
      },
      "payload": {
        "session_id": "{{cache:events.sessions.create.response.data.session.session_id}}",
        "holder_persona_id": "{{cache:personas.create.response.data.persona.persona_id}}",
        "price": 50
      },
      "expectedStatus": 201
    }
  ]
}
