{
  "name": "POST /api/ai-gateway/tenant-credentials — bind tenant provider key",
  "endpoint": "/api/ai-gateway/tenant-credentials",
  "sdk": "sdk-ai-gateway",
  "method": "POST",
  "requiresAuth": true,
  "expectedStatus": 201,
  "taskId": "b4854376-a79f-43b1-a6fe-028ff2d0fe65",
  "sprintId": "8ef1d09e-dd8e-4daf-8d03-54dcd9f812f8",
  "featureId": "4fd90c9b-ab74-41ae-a6f4-0cff5cb038c8",
  "epicId": "76ec75df-cf40-4336-b591-42019674d864",
  "priority": 20,
  "testability": "manual",
  "skipReason": "Requires a real tenant_id from POST /api/tenants and a real provider key — covered by integration test, not synthetic-payload runner.",
  "dependsOn": [
    "POST /api/auth/register"
  ],
  "testCases": [
    {
      "name": "Bind an OpenAI key for the tenant",
      "headers": {
        "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
      },
      "payload": {
        "tenant_id": "{{static:00000000-0000-0000-0000-000000000001}}",
        "provider_id": "openai",
        "raw_key": "{{static:sk-test-DUMMYKEYFORTESTING}}",
        "model_allowlist": [
          "gpt-4o",
          "gpt-4o-mini"
        ],
        "fallback_on_error": true
      },
      "expectedStatus": 201
    }
  ],
  "expectedResponse": {
    "data": {
      "binding": {
        "binding_id": "string",
        "tenant_id": "string",
        "provider_id": "string",
        "status": "string",
        "last_4": "string",
        "bound_at": "string"
      }
    }
  },
  "captureResponse": {
    "ai-gateway.tenant-credentials.create.response.data.binding.binding_id": "data.binding.binding_id"
  }
}
