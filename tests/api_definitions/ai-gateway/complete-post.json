{
  "endpoint": "/api/ai-gateway/complete",
  "sdk": "sdk-ai-gateway",
  "sourceFile": "packages/sdk-ai-gateway/src/server/handlers/completionController.ts",
  "method": "POST",
  "taskId": "33b1ff5b-534c-4fd3-bc2b-b2ac3e0e7d33",
  "description": "Non-streaming LLM completion. Pipeline: route resolution -> PII redaction -> credential unwrap -> retry-wrapped provider call -> ai_gateway.completion insert + ai-gateway.complete.v1 audit. Closes AC-1.",
  "requiresAuth": true,
  "priority": 300,
  "dependsOn": [
    "POST /api/auth/signup-tenant",
    "POST /api/personas",
    "POST /api/agent-runtime/agents",
    "POST /api/agent-runtime/runs"
  ],
  "testability": "auto",
  "fieldEnums": {
    "request.provider_hint": [
      "anthropic",
      "openai",
      "gemini",
      "bedrock",
      "local-llama",
      "local-mistral"
    ]
  },
  "testCases": [
    {
      "name": "Completion records consent + budget + redaction + trace",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "payload": {
        "request": {
          "model": "gpt-4o-mini",
          "prompt": "Summarize the onboarding checklist in one sentence.",
          "max_tokens": 100,
          "temperature": 0.7,
          "top_p": 1,
          "stop_sequences": [],
          "task_tag": "test",
          "provider_hint": "openai",
          "tools": [],
          "stream": false
        },
        "context": {
          "agent_id": "{{cache:agent-runtime-agents.create.response.data.agent_id}}",
          "run_id": "{{cache:agent-runtime-runs.create.response.data.run_id}}",
          "acting_persona_id": "{{cache:personas.create.response.data.persona.persona_id}}",
          "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}",
          "trace_id": "{{dynamic:uuid}}",
          "span_id": "{{dynamic:uuid}}",
          "ttl_deadline": "{{dynamic:futuredatetime}}",
          "agent_chain": []
        }
      },
      "expectedStatus": 200,
      "expectedResponse": {
        "success": true
      }
    }
  ]
}
