{
  "endpoint": "/api/ai-gateway/complete",
  "sdk": "sdk-ai-gateway",
  "sourceFile": "packages/sdk-ai-gateway/src/server/handlers/completionController.ts",
  "method": "POST",
  "taskId": "33b1ff5b-534c-4fd3-bc2b-b2ac3e0e7d33",
  "description": "Non-streaming LLM completion. Pipeline: route resolution -> PII redaction -> credential unwrap -> retry-wrapped provider call -> ai_gateway.completion insert + ai-gateway.complete.v1 audit. Closes AC-1.",
  "requiresAuth": true,
  "priority": 300,
  "dependsOn": [
    "POST /api/auth/signup-tenant",
    "POST /api/personas",
    "POST /api/agent-runtime/agents",
    "POST /api/agent-runtime/runs"
  ],
  "testability": "auto",
  "fieldEnums": {
    "request.provider_hint": [
      "anthropic",
      "openai",
      "gemini",
      "bedrock",
      "local-llama",
      "local-mistral"
    ]
  },
  "testCases": [
    {
      "name": "Completion records consent + budget + redaction + trace",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "payload": {
        "request": {
          "model": "gpt-4o-mini",
          "prompt": "Summarize the onboarding checklist in one sentence.",
          "max_tokens": 100,
          "temperature": 0.7,
          "top_p": 1,
          "stop_sequences": [],
          "task_tag": "test",
          "provider_hint": "openai",
          "tools": [],
          "stream": false
        },
        "context": {
          "agent_id": "{{cache:agent-runtime-agents.create.response.data.agent_id}}",
          "run_id": "{{cache:agent-runtime-runs.create.response.data.run_id}}",
          "acting_persona_id": "{{cache:personas.create.response.data.persona.persona_id}}",
          "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}",
          "trace_id": "{{dynamic:uuid}}",
          "span_id": "{{dynamic:uuid}}",
          "ttl_deadline": "{{dynamic:futuredatetime}}",
          "agent_chain": []
        }
      },
      "expectedStatus": 200,
      "expectedResponse": {
        "success": true
      }
    }
  ],
  "errorCases": [
    {
      "status": 401,
      "code": "Unauthorized",
      "message": "Missing bearer token",
      "when": "Authorization header absent or not Bearer form (requireAuth)"
    },
    {
      "status": 401,
      "code": "Unauthorized",
      "message": "Invalid or expired token",
      "when": "Bearer token fails JWT verification (requireAuth)"
    },
    {
      "status": 400,
      "code": "ValidationError",
      "message": "Missing required: request, context",
      "when": "body.request or body.context absent"
    },
    {
      "status": 400,
      "code": "ValidationError",
      "message": "request.model and request.prompt are required",
      "when": "request.model or request.prompt missing"
    },
    {
      "status": 400,
      "code": "ValidationError",
      "message": "context.agent_id, context.run_id, and context.trace_id are required",
      "when": "any of context.agent_id/run_id/trace_id missing"
    },
    {
      "status": 503,
      "code": "ProviderUnavailable",
      "message": "provider not available / no route matches and no provider_hint supplied",
      "when": "complete() throws an Error whose message includes 'not available' or 'no route matches'"
    },
    {
      "status": 500,
      "code": "CompletionFailed",
      "message": "Completion failed",
      "when": "any other error thrown by complete() (kill-switch, provider adapter failure, DB insert failure)"
    }
  ]
}
