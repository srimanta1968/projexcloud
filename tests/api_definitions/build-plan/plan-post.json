{
  "endpoint": "/api/build/plan",
  "sdk": "semantic-service",
  "method": "POST",
  "taskId": "5081ed9f-bd47-4e8d-a16f-2400fe7e4dde",
  "featureId": "338dfcbc-f3b5-4566-8991-d5f6ed531903",
  "epicId": "4a3cb476-6cb9-4427-b89d-2307f7cb78e3",
  "sprintId": "8ef1d09e-dd8e-4daf-8d03-54dcd9f812f8",
  "description": "Planner v2: retrieve-then-compose. Embeds the intent locally (bge-small), retrieves top-K candidate SDKs, injects the foundation/AIM tier + dependency closure, then composes a plan from candidates only. Returns { plan: { summary, recommended_sdks[], custom_work[], clarifying_questions[], vertical_pack, complexity }, meta: { catalog_size, provider, audit_status, retrieval } }.",
  "requiresAuth": true,
  "priority": 40,
  "dependsOn": [
    "POST /api/auth/register"
  ],
  "captureResponse": {
    "build-plan.compose.response.data.provider": "meta.provider",
    "build-plan.compose.response.data.catalog_size": "meta.catalog_size"
  },
  "testCases": [
    {
      "name": "Compose a plan for a financial accounting app",
      "headers": {
        "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
      },
      "payload": {
        "intent": "A financial accounting system with invoices, AR/AP and monthly close"
      },
      "expectedStatus": 200,
      "expectedResponse": {
        "plan": {
          "recommended_sdks": []
        }
      }
    },
    {
      "name": "Reject empty intent",
      "headers": {
        "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
      },
      "payload": {
        "intent": ""
      },
      "expectedStatus": 400
    },
    {
      "name": "Reject unauthenticated request",
      "payload": {
        "intent": "a dispatch app"
      },
      "expectedStatus": 401
    }
  ],
  "testability": "auto"
}
