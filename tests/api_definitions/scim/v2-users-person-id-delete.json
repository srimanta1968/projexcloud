{
  "name": "DELETE /scim/v2/Users/:person_id — sdk-identity",
  "endpoint": "/scim/v2/Users/:person_id",
  "method": "DELETE",
  "requiresAuth": true,
  "dependsOn": [
    "POST /api/auth/signup-tenant",
    "POST /scim/v2/Users"
  ],
  "expectedStatus": 204,
  "sdk": "sdk-identity",
  "sourceFile": "packages/sdk-identity/src/server/handlers/federationController.ts",
  "testability": "auto",
  "testCases": [
    {
      "name": "Deprovision a SCIM-provisioned user (offboards tenant membership)",
      "headers": {
        "Authorization": "Bearer {{var:scim_bearer_token}}",
        "x-tenant-id": "{{cache:auth.signup-tenant.response.data.tenant_id}}"
      },
      "pathParams": {
        "person_id": "{{cache:scim.create.response.data.person_id}}"
      },
      "expectedStatus": 204
    }
  ]
}
