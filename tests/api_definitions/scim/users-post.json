{
  "name": "POST /scim/v2/Users - SCIM 2.0 JIT provisioning",
  "endpoint": "/scim/v2/Users",
  "sdk": "sdk-identity",
  "method": "POST",
  "requiresAuth": true,
  "expectedStatus": 201,
  "taskId": "105ef015-365e-4fc6-bb42-4e8df7293e8d",
  "sprintId": "8ef1d09e-dd8e-4daf-8d03-54dcd9f812f8",
  "featureId": "f493450e-8ed8-425c-b905-f8a76a70bdcc",
  "epicId": "00996d23-f667-4a82-9285-7728ba357e7b",
  "priority": 20,
  "sourceFile": "packages/sdk-identity/src/server/handlers/federationController.ts",
  "testability": "auto",
  "dependsOn": [
    "POST /api/auth/signup-tenant"
  ],
  "captureResponse": {
    "scim.create.response.data.person_id": "id"
  },
  "testCases": [
    {
      "name": "Provision a new user via SCIM 2.0",
      "headers": {
        "Authorization": "Bearer {{var:scim_bearer_token}}",
        "x-tenant-id": "{{cache:auth.signup-tenant.response.data.tenant_id}}"
      },
      "payload": {
        "schemas": [
          "urn:ietf:params:scim:schemas:core:2.0:User"
        ],
        "userName": "{{dynamic:email}}",
        "active": true,
        "emails": [
          {
            "value": "{{dynamic:email}}",
            "primary": true
          }
        ],
        "name": {
          "givenName": "Ada",
          "familyName": "Lovelace"
        },
        "groups": [
          {
            "display": "Engineering",
            "value": "eng"
          }
        ]
      },
      "expectedStatus": 201
    }
  ]
}
