{
  "endpoint": "/api/config/rotate",
  "method": "POST",
  "expectedStatus": 200,
  "description": "Rotates a secret value's sdk-secrets envelope pointer in place (secret_ref swapped, value cleared, re-activated). Operates on its OWN key, qa.config.rotate.smoke, which POST /api/config creates in this same run with an initial secret_ref (declared in dependsOn), so it needs no SQL seed. Tenant JWT required + scope-ownership guard. Edge cases: scope + key + secret_ref required (400); unknown row 404.",
  "dependsOn": [
    "POST /api/auth/signup-tenant",
    "POST /api/config"
  ],
  "testability": "auto",
  "fieldEnums": {
    "scope": [
      "platform",
      "tenant",
      "app",
      "app_user"
    ]
  },
  "testCases": [
    {
      "name": "Rotate a tenant secret config value",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "payload": {
        "scope": "tenant",
        "scope_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}",
        "key": "qa.config.rotate.smoke",
        "secret_ref": "vault:rotated-{{dynamic:slug}}"
      },
      "expectedStatus": 200
    }
  ],
  "expectedResponse": {
    "data": {
      "config_id": "string",
      "secret_ref": "string",
      "status": "string"
    }
  },
  "errorCases": [
    {
      "status": 400,
      "code": "ValidationError",
      "message": "scope, key and secret_ref are required",
      "when": "any required field missing"
    },
    {
      "status": 404,
      "code": "NotFound",
      "message": "config value not found",
      "when": "no row for that scope/scope_id/key"
    },
    {
      "status": 401,
      "code": "Unauthorized",
      "message": "Missing bearer token",
      "when": "no/invalid tenant JWT"
    }
  ],
  "sdk": "sdk-config",
  "sourceFile": "packages/sdk-config/src/server/index.ts",
  "taskId": "e03d5fa3-db58-4a95-8d38-f7f2425aa947",
  "requiresAuth": true
}
