{
  "endpoint": "/api/config/revoke",
  "method": "POST",
  "expectedStatus": 200,
  "description": "Soft-deletes a config value (status='revoked') so resolution stops without losing the audit row. Operates on its OWN seeded key so it never revokes the read tests' value. Tenant JWT required + scope-ownership guard. Edge cases: scope + key required (400); unknown row 404; cross-tenant/platform without operator 403.",
  "dependsOn": [
    "POST /api/auth/signup-tenant"
  ],
  "testability": "semi-auto",
  "setupScript": "config_revoke_rotate_seed.sql",
  "fieldEnums": {
    "scope": [
      "platform",
      "tenant",
      "app",
      "app_user"
    ]
  },
  "testCases": [
    {
      "name": "Revoke a tenant config value",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "payload": {
        "scope": "tenant",
        "scope_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}",
        "key": "qa.config.revoke.smoke"
      },
      "expectedStatus": 200
    }
  ],
  "expectedResponse": {
    "data": {
      "config_id": "string",
      "status": "string"
    }
  },
  "errorCases": [
    {
      "status": 400,
      "code": "ValidationError",
      "message": "scope and key are required",
      "when": "scope missing/invalid or key missing"
    },
    {
      "status": 404,
      "code": "NotFound",
      "message": "config value not found",
      "when": "no row for that scope/scope_id/key"
    },
    {
      "status": 401,
      "code": "Unauthorized",
      "message": "Missing bearer token",
      "when": "no/invalid tenant JWT"
    }
  ],
  "sdk": "sdk-config",
  "sourceFile": "packages/sdk-config/src/server/index.ts",
  "taskId": "e03d5fa3-db58-4a95-8d38-f7f2425aa947",
  "requiresAuth": true
}
