{
  "name": "POST /api/devices/:device_uuid/revoke - Revoke a device (status=revoked|stolen)",
  "endpoint": "/api/devices/:device_uuid/revoke",
  "sdk": "sdk-device",
  "method": "POST",
  "requiresAuth": true,
  "expectedStatus": 200,
  "taskId": "378b540d-7ce1-4578-a2d0-39b178d4ac2c",
  "sprintId": "8ef1d09e-dd8e-4daf-8d03-54dcd9f812f8",
  "featureId": "79c31000-997a-49ea-9980-85b94d6ef7b6",
  "epicId": "93a549d6-9a93-4d82-86bb-bac5167fa960",
  "priority": 85,
  "dependsOn": [
    "POST /api/auth/register",
    "POST /api/devices"
  ],
  "fieldEnums": {
    "reason": ["revoked", "stolen"]
  },
  "statusTransitions": {
    "entity": "device",
    "field": "status",
    "flow": ["active", "revoked", "stolen"],
    "transitions": [
      { "from": "active", "to": "revoked", "via": "POST /api/devices/:device_uuid/revoke" },
      { "from": "active", "to": "stolen", "via": "POST /api/devices/:device_uuid/revoke" }
    ]
  },
  "testCases": [
    {
      "name": "Revoke device",
      "headers": {
        "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
      },
      "pathParams": {
        "device_uuid": "{{cache:devices.create.response.data.device.device_uuid}}"
      },
      "payload": {
        "reason": "revoked"
      },
      "expectedStatus": 200
    }
  ],
  "captureResponse": {
    "devices.revoke.response.data.device.device_uuid": "data.device.device_uuid"
  }
}
