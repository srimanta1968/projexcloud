{
  "name": "POST /api/devices/:device_uuid/link-person - Link person to device",
  "endpoint": "/api/devices/:device_uuid/link-person",
  "sdk": "sdk-device",
  "method": "POST",
  "requiresAuth": true,
  "expectedStatus": 200,
  "taskId": "378b540d-7ce1-4578-a2d0-39b178d4ac2c",
  "sprintId": "8ef1d09e-dd8e-4daf-8d03-54dcd9f812f8",
  "featureId": "79c31000-997a-49ea-9980-85b94d6ef7b6",
  "epicId": "93a549d6-9a93-4d82-86bb-bac5167fa960",
  "priority": 55,
  "testability": "auto",
  "dependsOn": [
    "POST /api/auth/register",
    "POST /api/devices",
    "POST /scim/v2/Users"
  ],
  "fieldEnums": {
    "status": [
      "active",
      "suspended",
      "revoked"
    ]
  },
  "testCases": [
    {
      "name": "Link person to device",
      "headers": {
        "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
      },
      "pathParams": {
        "device_uuid": "{{cache:devices.create.response.data.device.device_uuid}}"
      },
      "payload": {
        "person_id": "{{cache:scim.create.response.data.person_id}}"
      },
      "expectedStatus": 200
    }
  ],
  "captureResponse": {
    "devices.link-person.response.data.link.link_id": "data.link.link_id"
  },
  "description": "Links a person to a device (device_uuid path param) via linkPerson, returning 200 with the created link record. Requires person_id in the body; no not-found guard on device_uuid (an unknown device passes through to the service layer). Edge cases: missing person_id, auth failures.",
  "errorCases": [
    {
      "status": 401,
      "code": "Unauthorized",
      "message": "Missing bearer token",
      "when": "Authorization header absent or not Bearer form (requireAuth)"
    },
    {
      "status": 401,
      "code": "Unauthorized",
      "message": "Invalid or expired token",
      "when": "Bearer token fails JWT verification (requireAuth)"
    },
    {
      "status": 400,
      "code": "ValidationError",
      "message": "missing person_id",
      "when": "person_id missing from body"
    }
  ]
}
