{
  "name": "POST /api/devices/:device_uuid/attest - Record device attestation",
  "endpoint": "/api/devices/:device_uuid/attest",
  "sdk": "sdk-device",
  "method": "POST",
  "requiresAuth": true,
  "expectedStatus": 201,
  "taskId": "378b540d-7ce1-4578-a2d0-39b178d4ac2c",
  "sprintId": "8ef1d09e-dd8e-4daf-8d03-54dcd9f812f8",
  "featureId": "79c31000-997a-49ea-9980-85b94d6ef7b6",
  "epicId": "93a549d6-9a93-4d82-86bb-bac5167fa960",
  "priority": 50,
  "dependsOn": [
    "POST /api/auth/register",
    "POST /api/devices"
  ],
  "fieldEnums": {
    "method": ["secure-enclave", "key-attestation", "safetynet", "play-integrity"]
  },
  "testCases": [
    {
      "name": "Attest via secure-enclave",
      "headers": {
        "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
      },
      "pathParams": {
        "device_uuid": "{{cache:devices.create.response.data.device.device_uuid}}"
      },
      "payload": {
        "method": "secure-enclave",
        "signature_envelope": "YmFzZTY0ZW52ZWxvcGU=",
        "expires_at": "{{dynamic:futuredatetime}}",
        "verified": true
      },
      "expectedStatus": 201
    }
  ],
  "captureResponse": {
    "devices.attest.response.data.attestation.attestation_id": "data.attestation.attestation_id"
  }
}
