{
  "name": "GET /api/source-records - List captures, filtered by trust state or origin",
  "endpoint": "/api/source-records",
  "sdk": "sdk-source-record",
  "sourceFile": "packages/sdk-source-record/src/server/routes.ts",
  "method": "GET",
  "requiresAuth": true,
  "expectedStatus": 200,
  "taskId": "3837bea9-c427-4ec0-a9c7-c2bd94c51c38",
  "sprintId": "d4876947-8d18-4538-8e9f-51ba3e0735a9",
  "featureId": "32707c6f-ae2c-4e31-bf2f-2c39c0f5cc2e",
  "epicId": "fa43f2ff-2e6e-4f27-894a-4992cc2dace9",
  "priority": 59,
  "testability": "auto",
  "description": "List a tenant's captures, newest first. Every filter is optional and ANDed: trust_state and origin_class narrow by the ENUM columns, source_system and subject_ref by exact match. limit is clamped to 1..500 (default 50) so an unbounded page can never be requested, and offset is floored at 0. Returns an empty array — not a 404 — when nothing matches. Required: tenant_id query param.",
  "dependsOn": [
    "POST /api/auth/signup-tenant",
    "POST /api/source-records"
  ],
  "fieldEnums": {
    "trust_state": [
      "P0_CAPTURED",
      "P1_NORMALIZED",
      "P2_CANDIDATE",
      "P3_LINKED",
      "P4_DIRECT"
    ],
    "origin_class": [
      "USER_PROVIDED",
      "FIRST_PARTY_DIRECT",
      "TENANT_FIRST_PARTY_CRM",
      "USER_AUTHORIZED_CONTACT_STORE",
      "PUBLIC_RECORD",
      "LICENSED_THIRD_PARTY",
      "PARTNER_PROVIDED",
      "UNKNOWN_QUARANTINED"
    ]
  },
  "testCases": [
    {
      "name": "List captures for the tenant",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "queryParams": {
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}",
        "trust_state": "P0_CAPTURED",
        "origin_class": "PUBLIC_RECORD",
        "limit": "50",
        "offset": "0"
      },
      "expectedStatus": 200,
      "expectedResponse": {
        "data": {
          "source_records": "array",
          "count": "number"
        }
      }
    }
  ],
  "errorCases": [
    {
      "status": 400,
      "code": "VALIDATION_ERROR",
      "message": "tenant_id query param required",
      "when": "the tenant_id query param is absent"
    },
    {
      "status": 401,
      "code": "Unauthorized",
      "message": "missing or invalid token",
      "when": "no valid tenant Bearer token on the request"
    }
  ]
}
