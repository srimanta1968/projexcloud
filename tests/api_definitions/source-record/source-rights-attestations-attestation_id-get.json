{
  "name": "GET /api/source-rights/attestations/:attestation_id - Read a signed attestation",
  "endpoint": "/api/source-rights/attestations/:attestation_id",
  "sdk": "sdk-source-record",
  "sourceFile": "packages/sdk-source-record/src/server/routes.ts",
  "method": "GET",
  "requiresAuth": true,
  "expectedStatus": 200,
  "taskId": "3837bea9-c427-4ec0-a9c7-c2bd94c51c38",
  "sprintId": "d4876947-8d18-4538-8e9f-51ba3e0735a9",
  "featureId": "32707c6f-ae2c-4e31-bf2f-2c39c0f5cc2e",
  "epicId": "fa43f2ff-2e6e-4f27-894a-4992cc2dace9",
  "priority": 50,
  "testability": "auto",
  "description": "Read one signed attestation with its full terms: attestor principal, permitted uses, jurisdiction, licence reference, collection period, evidence blob reference and the signature over them. 404 when the attestation belongs to another tenant, so an id from elsewhere is indistinguishable from one that does not exist. Required: tenant_id query param.",
  "dependsOn": [
    "POST /api/auth/signup-tenant",
    "POST /api/source-records",
    "POST /api/source-rights/attestations"
  ],
  "fieldEnums": {
    "origin_class": [
      "USER_PROVIDED",
      "FIRST_PARTY_DIRECT",
      "TENANT_FIRST_PARTY_CRM",
      "USER_AUTHORIZED_CONTACT_STORE",
      "PUBLIC_RECORD",
      "LICENSED_THIRD_PARTY",
      "PARTNER_PROVIDED",
      "UNKNOWN_QUARANTINED"
    ],
    "evidence_kind": [
      "RAW_PAYLOAD",
      "API_RESPONSE",
      "DOCUMENT",
      "SCREENSHOT",
      "LICENSE_TERMS",
      "CONSENT_RECEIPT",
      "SIGNATURE",
      "OTHER"
    ]
  },
  "testCases": [
    {
      "name": "Read the attestation just signed",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "pathParams": {
        "attestation_id": "{{cache:source-record.attestation.create.response.data.attestation.attestation_id}}"
      },
      "queryParams": {
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}"
      },
      "expectedStatus": 200,
      "expectedResponse": {
        "data": {
          "attestation": {
            "attestation_id": "string",
            "permitted_uses": "array"
          }
        }
      }
    }
  ],
  "errorCases": [
    {
      "status": 400,
      "code": "VALIDATION_ERROR",
      "message": "tenant_id query param required",
      "when": "the tenant_id query param is absent"
    },
    {
      "status": 404,
      "code": "ATTESTATION_NOT_FOUND",
      "message": "attestation <id> not found for tenant",
      "when": "the attestation does not exist, or belongs to another tenant"
    },
    {
      "status": 401,
      "code": "Unauthorized",
      "message": "missing or invalid token",
      "when": "no valid tenant Bearer token on the request"
    }
  ]
}
