{
  "name": "POST /api/source-records/:capture_id/crosswalks - Preserve an external identifier",
  "endpoint": "/api/source-records/:capture_id/crosswalks",
  "sdk": "sdk-source-record",
  "sourceFile": "packages/sdk-source-record/src/server/routes.ts",
  "method": "POST",
  "requiresAuth": true,
  "expectedStatus": 201,
  "taskId": "3837bea9-c427-4ec0-a9c7-c2bd94c51c38",
  "sprintId": "d4876947-8d18-4538-8e9f-51ba3e0735a9",
  "featureId": "32707c6f-ae2c-4e31-bf2f-2c39c0f5cc2e",
  "epicId": "fa43f2ff-2e6e-4f27-894a-4992cc2dace9",
  "priority": 55,
  "testability": "auto",
  "description": "Record the external system + id this capture came from, kept forever. The pair is immutable and the row is undeletable by database trigger: overwriting a crosswalk would silently break the link back to the source system. Idempotent per (tenant, external_system, external_id) — re-linking the same external identity returns the EXISTING crosswalk rather than erroring, which is what makes a retried import safe. Required: tenant_id, external_system, external_id.",
  "dependsOn": [
    "POST /api/auth/signup-tenant",
    "POST /api/source-records"
  ],
  "testCases": [
    {
      "name": "Link the capture to its external system identifier",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "pathParams": {
        "capture_id": "{{cache:source-record.capture.response.data.source_record.capture_id}}"
      },
      "payload": {
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}",
        "external_system": "registry-{{dynamic:slug}}",
        "external_id": "EXT-{{dynamic:uuid}}",
        "subject_ref": "{{cache:source-record.capture.response.data.source_record.subject_ref}}",
        "metadata": {
          "linked_by": "qa-runner"
        },
        "actor_id": "qa-runner",
        "purpose": "crosswalk linkage",
        "causation_id": "{{dynamic:uuid}}"
      },
      "expectedStatus": 201,
      "expectedResponse": {
        "data": {
          "crosswalk": {
            "crosswalk_id": "string",
            "external_system": "string",
            "external_id": "string"
          }
        }
      }
    }
  ],
  "captureResponse": {
    "source-record.crosswalk.response.data.crosswalk.crosswalk_id": "data.crosswalk.crosswalk_id"
  },
  "errorCases": [
    {
      "status": 400,
      "code": "VALIDATION_ERROR",
      "message": "tenant_id, external_system and external_id are required",
      "when": "any of the three required fields is missing"
    },
    {
      "status": 404,
      "code": "SOURCE_RECORD_NOT_FOUND",
      "message": "capture <id> not found for tenant",
      "when": "the capture does not exist for this tenant"
    },
    {
      "status": 401,
      "code": "Unauthorized",
      "message": "missing or invalid token",
      "when": "no valid tenant Bearer token on the request"
    }
  ]
}
