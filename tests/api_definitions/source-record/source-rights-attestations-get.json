{
  "name": "GET /api/source-rights/attestations - List signed attestations",
  "endpoint": "/api/source-rights/attestations",
  "sdk": "sdk-source-record",
  "sourceFile": "packages/sdk-source-record/src/server/routes.ts",
  "method": "GET",
  "requiresAuth": true,
  "expectedStatus": 200,
  "taskId": "3837bea9-c427-4ec0-a9c7-c2bd94c51c38",
  "sprintId": "d4876947-8d18-4538-8e9f-51ba3e0735a9",
  "featureId": "32707c6f-ae2c-4e31-bf2f-2c39c0f5cc2e",
  "epicId": "fa43f2ff-2e6e-4f27-894a-4992cc2dace9",
  "priority": 49,
  "testability": "auto",
  "description": "List a tenant's signed attestations, newest first, optionally narrowed to one capture or one origin class. Returns an empty array rather than a 404 when nothing matches. limit is clamped to 1..500 (default 50). Required: tenant_id query param.",
  "dependsOn": [
    "POST /api/auth/signup-tenant",
    "POST /api/source-records",
    "POST /api/source-rights/attestations"
  ],
  "fieldEnums": {
    "origin_class": [
      "USER_PROVIDED",
      "FIRST_PARTY_DIRECT",
      "TENANT_FIRST_PARTY_CRM",
      "USER_AUTHORIZED_CONTACT_STORE",
      "PUBLIC_RECORD",
      "LICENSED_THIRD_PARTY",
      "PARTNER_PROVIDED",
      "UNKNOWN_QUARANTINED"
    ]
  },
  "testCases": [
    {
      "name": "List attestations for the capture",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "queryParams": {
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}",
        "capture_id": "{{cache:source-record.capture.response.data.source_record.capture_id}}",
        "origin_class": "LICENSED_THIRD_PARTY",
        "limit": "50",
        "offset": "0"
      },
      "expectedStatus": 200,
      "expectedResponse": {
        "data": {
          "attestations": "array",
          "count": "number"
        }
      }
    }
  ],
  "errorCases": [
    {
      "status": 400,
      "code": "VALIDATION_ERROR",
      "message": "tenant_id query param required",
      "when": "the tenant_id query param is absent"
    },
    {
      "status": 401,
      "code": "Unauthorized",
      "message": "missing or invalid token",
      "when": "no valid tenant Bearer token on the request"
    }
  ]
}
