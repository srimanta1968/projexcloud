{
  "name": "GET /api/source-records/:capture_id - Read one capture with its crosswalks",
  "endpoint": "/api/source-records/:capture_id",
  "sdk": "sdk-source-record",
  "sourceFile": "packages/sdk-source-record/src/server/routes.ts",
  "method": "GET",
  "requiresAuth": true,
  "expectedStatus": 200,
  "taskId": "3837bea9-c427-4ec0-a9c7-c2bd94c51c38",
  "sprintId": "d4876947-8d18-4538-8e9f-51ba3e0735a9",
  "featureId": "32707c6f-ae2c-4e31-bf2f-2c39c0f5cc2e",
  "epicId": "fa43f2ff-2e6e-4f27-894a-4992cc2dace9",
  "priority": 58,
  "testability": "auto",
  "description": "Read a single capture and every external identifier crosswalked to it. The crosswalks are returned inline because an external id is what makes the capture re-findable in the system it came from — reading one without the other is almost always a bug. 404 when the capture does not belong to the tenant, so a capture id from another tenant is indistinguishable from one that does not exist. Required: tenant_id query param.",
  "dependsOn": [
    "POST /api/auth/signup-tenant",
    "POST /api/source-records"
  ],
  "fieldEnums": {
    "trust_state": [
      "P0_CAPTURED",
      "P1_NORMALIZED",
      "P2_CANDIDATE",
      "P3_LINKED",
      "P4_DIRECT"
    ],
    "origin_class": [
      "USER_PROVIDED",
      "FIRST_PARTY_DIRECT",
      "TENANT_FIRST_PARTY_CRM",
      "USER_AUTHORIZED_CONTACT_STORE",
      "PUBLIC_RECORD",
      "LICENSED_THIRD_PARTY",
      "PARTNER_PROVIDED",
      "UNKNOWN_QUARANTINED"
    ]
  },
  "testCases": [
    {
      "name": "Read the capture created by the producer",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "pathParams": {
        "capture_id": "{{cache:source-record.capture.response.data.source_record.capture_id}}"
      },
      "queryParams": {
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}"
      },
      "expectedStatus": 200,
      "expectedResponse": {
        "data": {
          "source_record": {
            "capture_id": "string"
          },
          "crosswalks": "array"
        }
      }
    }
  ],
  "errorCases": [
    {
      "status": 400,
      "code": "VALIDATION_ERROR",
      "message": "tenant_id query param required",
      "when": "the tenant_id query param is absent"
    },
    {
      "status": 404,
      "code": "SOURCE_RECORD_NOT_FOUND",
      "message": "capture <id> not found for tenant",
      "when": "the capture does not exist, or belongs to another tenant"
    },
    {
      "status": 401,
      "code": "Unauthorized",
      "message": "missing or invalid token",
      "when": "no valid tenant Bearer token on the request"
    }
  ]
}
