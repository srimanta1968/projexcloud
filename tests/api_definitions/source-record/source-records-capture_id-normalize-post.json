{
  "name": "POST /api/source-records/:capture_id/normalize - P0 -> P1 via sdk-parsing",
  "endpoint": "/api/source-records/:capture_id/normalize",
  "sdk": "sdk-source-record",
  "sourceFile": "packages/sdk-source-record/src/server/routes.ts",
  "method": "POST",
  "requiresAuth": true,
  "expectedStatus": 200,
  "taskId": "3837bea9-c427-4ec0-a9c7-c2bd94c51c38",
  "sprintId": "d4876947-8d18-4538-8e9f-51ba3e0735a9",
  "featureId": "32707c6f-ae2c-4e31-bf2f-2c39c0f5cc2e",
  "epicId": "fa43f2ff-2e6e-4f27-894a-4992cc2dace9",
  "priority": 57,
  "testability": "auto",
  "description": "Extract structured fields from the capture and move it P0_CAPTURED -> P1_NORMALIZED. Extraction is delegated to sdk-parsing through an injected hook; with no parser wired the default is a structural pass-through, so the rung still advances honestly rather than failing closed. The result lands in `normalized` ALONGSIDE raw_evidence, which the database refuses to let anyone overwrite. Idempotent: re-normalizing an already-normalized capture refreshes `normalized` and returns 200 without appending a second transition to the audit chain, because the trust state did not move. Refused with 409 for a quarantined capture — a record with no established provenance does not climb. Returns 200, not 201: it moves an existing resource. Required: tenant_id.",
  "dependsOn": [
    "POST /api/auth/signup-tenant",
    "POST /api/source-records"
  ],
  "fieldEnums": {
    "trust_state": [
      "P0_CAPTURED",
      "P1_NORMALIZED",
      "P2_CANDIDATE",
      "P3_LINKED",
      "P4_DIRECT"
    ]
  },
  "statusTransitions": {
    "entity": "source_record.source_record",
    "field": "trust_state",
    "flow": [
      "P0_CAPTURED",
      "P1_NORMALIZED",
      "P2_CANDIDATE",
      "P3_LINKED",
      "P4_DIRECT"
    ],
    "transitions": [
      {
        "from": "P0_CAPTURED",
        "to": "P1_NORMALIZED",
        "via": "POST /api/source-records/:capture_id/normalize"
      },
      {
        "from": "P1_NORMALIZED",
        "to": "P2_CANDIDATE",
        "via": "POST /api/source-records/:capture_id/promote (requires a normalized payload)"
      },
      {
        "from": "P2_CANDIDATE",
        "to": "P3_LINKED",
        "via": "POST /api/source-records/:capture_id/promote (requires subject_ref)"
      },
      {
        "from": "P3_LINKED",
        "to": "P4_DIRECT",
        "via": "POST /api/source-records/:capture_id/promote (requires a FIRST-PARTY evidence_ref)"
      }
    ]
  },
  "testCases": [
    {
      "name": "Normalize the capture to P1_NORMALIZED",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "pathParams": {
        "capture_id": "{{cache:source-record.capture.response.data.source_record.capture_id}}"
      },
      "payload": {
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}",
        "actor_id": "qa-runner",
        "purpose": "normalization",
        "causation_id": "{{dynamic:uuid}}"
      },
      "expectedStatus": 200,
      "expectedResponse": {
        "data": {
          "source_record": {
            "trust_state": "string"
          }
        }
      }
    }
  ],
  "captureResponse": {
    "source-record.normalize.response.data.source_record.trust_state": "data.source_record.trust_state"
  },
  "errorCases": [
    {
      "status": 400,
      "code": "VALIDATION_ERROR",
      "message": "tenant_id is required",
      "when": "tenant_id missing from the body"
    },
    {
      "status": 404,
      "code": "SOURCE_RECORD_NOT_FOUND",
      "message": "capture <id> not found for tenant",
      "when": "the capture does not exist for this tenant"
    },
    {
      "status": 409,
      "code": "RECORD_QUARANTINED",
      "message": "capture <id> is quarantined and cannot be promoted",
      "when": "the capture landed UNKNOWN_QUARANTINED because its provenance was never established"
    },
    {
      "status": 401,
      "code": "Unauthorized",
      "message": "missing or invalid token",
      "when": "no valid tenant Bearer token on the request"
    }
  ]
}
