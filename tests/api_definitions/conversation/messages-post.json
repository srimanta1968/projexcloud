{
  "name": "POST /api/conversations/messages — record a message on a thread",
  "endpoint": "/api/conversations/messages",
  "sdk": "sdk-conversation",
  "sourceFile": "packages/sdk-conversation/src/server/routes.ts",
  "method": "POST",
  "requiresAuth": true,
  "expectedStatus": 201,
  "taskId": "e5a557ae-1ca4-4476-850b-0107e9b23db1",
  "sprintId": "d4876947-8d18-4538-8e9f-51ba3e0735a9",
  "featureId": "41f67890-b988-4afc-935a-1ce48d600677",
  "epicId": "54b75cbb-e257-4e64-a356-3817f73256e2",
  "priority": 31,
  "testability": "auto",
  "dependsOn": [
    "POST /api/auth/signup-tenant",
    "POST /api/conversations/threads"
  ],
  "coversCriterion": [],
  "description": "Records one message onto an existing thread. Collection-root create, so 201 with { data: { message } }. body_ref is a vault/blob REFERENCE, never the body text: message content is customer data and a text column here would put it in every backup, replica and query plan that touches the table. occurred_at is when the provider says it HAPPENED and is the sort key; received_at is stamped server-side and is a diagnostic only, so a message delivered late still renders in the right place. Writes carrying external_message_id are idempotent on (tenant_id, channel, external_message_id) — a retried provider webhook returns the row it already wrote instead of double-posting into the thread. INTERNAL_NOTE (or direction INTERNAL) is routed internally to addInternalNote, which hard-codes the undispatchable shape; the ordinary path is refused for notes because it accepts a caller-supplied delivery_state and that is exactly the field a note must never set. QA edge cases: 401 without a tenant Bearer; 400 for a missing tenant_id/thread_id/channel/body_ref/actor, an unknown channel, a direction other than INBOUND/OUTBOUND on a customer-facing channel, a blank body_ref, an unparseable occurred_at, or delivery_state 'NOT_APPLICABLE' on a customer-facing channel (that state is reserved for internal notes and the conv_message_dispatchable_state CHECK rejects it at the database too); 404 when thread_id names no thread. An inbound message defaults to delivery_state RECEIVED and read_state UNREAD, an outbound one to PENDING and READ, and the rollup trigger then updates the thread's channel_set, unread_count, last_message_at and status.",
  "captureResponse": {
    "conversations.messages.response.data.message.message_id": "data.message.message_id"
  },
  "testCases": [
    {
      "name": "Record an outbound SMS on the thread",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "payload": {
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}",
        "thread_id": "{{cache:conversations.threads.response.data.thread.thread_id}}",
        "channel": "SMS",
        "direction": "OUTBOUND",
        "body_ref": "vault:blob/outbound-sms-1",
        "body_preview": "Following up on your renewal",
        "actor": "persona:{{dynamic:uuid}}",
        "occurred_at": "{{dynamic:pastdatetime}}",
        "provider_message_key": "carrier-{{dynamic:uuid}}"
      },
      "expectedStatus": 201
    },
    {
      "name": "Record an internal note — accepted, but structurally undispatchable",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "payload": {
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}",
        "thread_id": "{{cache:conversations.threads.response.data.thread.thread_id}}",
        "channel": "INTERNAL_NOTE",
        "direction": "INTERNAL",
        "body_ref": "vault:blob/note-1",
        "actor": "persona:{{dynamic:uuid}}"
      },
      "expectedStatus": 201
    },
    {
      "name": "400 - NOT_APPLICABLE is reserved for internal notes",
      "testType": "negative",
      "coversErrorCase": "400|VALIDATION_ERROR|reserved-state",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "payload": {
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}",
        "thread_id": "{{cache:conversations.threads.response.data.thread.thread_id}}",
        "channel": "SMS",
        "direction": "OUTBOUND",
        "body_ref": "vault:blob/outbound-sms-1",
        "body_preview": "Following up on your renewal",
        "actor": "persona:{{dynamic:uuid}}",
        "occurred_at": "{{dynamic:pastdatetime}}",
        "provider_message_key": "carrier-{{dynamic:uuid}}",
        "delivery_state": "NOT_APPLICABLE"
      },
      "expectedStatus": 400,
      "expectedError": {
        "code": "VALIDATION_ERROR"
      }
    },
    {
      "name": "400 - a channel outside the eight is refused",
      "testType": "negative",
      "coversErrorCase": "400|VALIDATION_ERROR|unknown-channel",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "payload": {
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}",
        "thread_id": "{{cache:conversations.threads.response.data.thread.thread_id}}",
        "channel": "{{static:CARRIER_PIGEON}}",
        "direction": "OUTBOUND",
        "body_ref": "vault:blob/outbound-sms-1",
        "body_preview": "Following up on your renewal",
        "actor": "persona:{{dynamic:uuid}}",
        "occurred_at": "{{dynamic:pastdatetime}}",
        "provider_message_key": "carrier-{{dynamic:uuid}}"
      },
      "expectedStatus": 400,
      "expectedError": {
        "code": "VALIDATION_ERROR"
      }
    },
    {
      "name": "400 - a message with no body_ref is refused",
      "testType": "negative",
      "coversErrorCase": "400|VALIDATION_ERROR|body-ref",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "payload": {
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}",
        "thread_id": "{{cache:conversations.threads.response.data.thread.thread_id}}",
        "channel": "SMS",
        "direction": "OUTBOUND",
        "body_preview": "Following up on your renewal",
        "actor": "persona:{{dynamic:uuid}}",
        "occurred_at": "{{dynamic:pastdatetime}}",
        "provider_message_key": "carrier-{{dynamic:uuid}}"
      },
      "expectedStatus": 400,
      "expectedError": {
        "code": "VALIDATION_ERROR"
      }
    },
    {
      "name": "401 - no tenant bearer token",
      "testType": "negative",
      "coversErrorCase": "401|Unauthorized",
      "headers": {},
      "payload": {
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}",
        "thread_id": "{{cache:conversations.threads.response.data.thread.thread_id}}",
        "channel": "SMS",
        "direction": "OUTBOUND",
        "body_ref": "vault:blob/outbound-sms-1",
        "body_preview": "Following up on your renewal",
        "actor": "persona:{{dynamic:uuid}}",
        "occurred_at": "{{dynamic:pastdatetime}}",
        "provider_message_key": "carrier-{{dynamic:uuid}}"
      },
      "expectedStatus": 401,
      "expectedError": {
        "code": "Unauthorized"
      }
    }
  ],
  "errorCases": [
    {
      "name": "A customer-facing message may not claim the note-only delivery state",
      "status": 400,
      "code": "VALIDATION_ERROR",
      "message": "[sdk-conversation] delivery_state 'NOT_APPLICABLE' is reserved for internal notes",
      "when": "delivery_state NOT_APPLICABLE is sent on any channel other than INTERNAL_NOTE — that state is what marks a row as never-to-be-dispatched",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "payload": {
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}",
        "thread_id": "{{cache:conversations.threads.response.data.thread.thread_id}}",
        "channel": "SMS",
        "direction": "OUTBOUND",
        "body_ref": "vault:blob/bad-state",
        "actor": "persona:test",
        "delivery_state": "NOT_APPLICABLE"
      },
      "expectedStatus": 400,
      "expectedError": {
        "code": "VALIDATION_ERROR"
      }
    },
    {
      "name": "An unknown channel is refused",
      "status": 400,
      "code": "VALIDATION_ERROR",
      "message": "channel must be one of: EMAIL, SMS, VOICE, VOICEMAIL, SOCIAL_DM, WEB_CHAT, IN_PERSON, INTERNAL_NOTE",
      "when": "channel is not one of the eight enumerated values",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "payload": {
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}",
        "thread_id": "{{cache:conversations.threads.response.data.thread.thread_id}}",
        "channel": "CARRIER_PIGEON",
        "direction": "OUTBOUND",
        "body_ref": "vault:blob/x",
        "actor": "persona:test"
      },
      "expectedStatus": 400,
      "expectedError": {
        "code": "VALIDATION_ERROR"
      }
    },
    {
      "name": "A message with no body reference is refused",
      "status": 400,
      "code": "VALIDATION_ERROR",
      "message": "body_ref is required",
      "when": "body_ref is absent, empty or whitespace-only",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "payload": {
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}",
        "thread_id": "{{cache:conversations.threads.response.data.thread.thread_id}}",
        "channel": "EMAIL",
        "direction": "OUTBOUND",
        "actor": "persona:test"
      },
      "expectedStatus": 400,
      "expectedError": {
        "code": "VALIDATION_ERROR"
      }
    },
    {
      "name": "Unauthenticated is refused by the default-deny gate",
      "status": 401,
      "code": "Unauthorized",
      "message": "missing or invalid tenant token",
      "when": "no valid tenant Bearer token on the request",
      "payload": {
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}",
        "thread_id": "{{cache:conversations.threads.response.data.thread.thread_id}}",
        "channel": "SMS",
        "direction": "OUTBOUND",
        "body_ref": "vault:blob/unauth",
        "actor": "persona:test"
      },
      "expectedStatus": 401
    }
  ]
}
