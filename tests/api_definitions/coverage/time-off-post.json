{
  "sdk": "sdk-coverage",
  "sourceFile": "packages/sdk-coverage/src/server/routes.ts",
  "requiresAuth": true,
  "sprintId": "d4876947-8d18-4538-8e9f-51ba3e0735a9",
  "epicId": "75f3f5a3-faa8-4b82-badf-4feda46c00e7",
  "featureId": "5f6dc00d-cb8f-4a54-9a19-9b1e0f0b2f5a",
  "taskId": "422472b0-117e-4cb0-9f90-0c6962439155",
  "testability": "auto",
  "name": "POST /api/coverage/time-off - Record time away",
  "endpoint": "/api/coverage/time-off",
  "method": "POST",
  "expectedStatus": 201,
  "priority": 12,
  "description": "Records an interval a persona is unavailable. Intervals MAY overlap by design - a meeting inside a PTO day is not a contradiction, and eligibility takes the union - so there is no exclusion constraint. kind separates the reasons because they read differently to an operator deciding whether to interrupt somebody. source distinguishes a calendar sync from a manual entry, so a re-sync can update its own rows without overwriting what a human typed.",
  "dependsOn": [
    "POST /api/auth/signup-tenant",
    "POST /api/personas"
  ],
  "fieldEnums": {
    "kind": [
      "PTO",
      "MEETING",
      "OUTAGE",
      "HOLIDAY"
    ],
    "source": [
      "MANUAL",
      "CALENDAR",
      "SYSTEM"
    ]
  },
  "testCases": [
    {
      "name": "A day of PTO",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "payload": {
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}",
        "persona_id": "{{cache:personas.create.response.data.persona.persona_id}}",
        "kind": "PTO",
        "starts_at": "{{dynamic:futuredatetime+1d}}",
        "ends_at": "{{dynamic:futuredatetime+2d}}",
        "reason": "annual leave"
      },
      "expectedStatus": 201,
      "expectedResponse": {
        "data": {
          "time_off": {
            "time_off_id": "string",
            "kind": "string"
          }
        }
      }
    },
    {
      "name": "A meeting block overlapping the same day",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "payload": {
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}",
        "persona_id": "{{cache:personas.create.response.data.persona.persona_id}}",
        "kind": "MEETING",
        "starts_at": "{{dynamic:futuredatetime+1d}}",
        "ends_at": "{{dynamic:futuredatetime+1d}}",
        "source": "CALENDAR",
        "source_ref": "cal-evt-1"
      },
      "expectedStatus": 201
    }
  ],
  "errorCases": [
    {
      "name": "An interval that ends before it starts is refused",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "payload": {
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}",
        "persona_id": "{{cache:personas.create.response.data.persona.persona_id}}",
        "kind": "PTO",
        "starts_at": "{{dynamic:futuredatetime+2d}}",
        "ends_at": "{{dynamic:futuredatetime+1d}}"
      },
      "expectedStatus": 422
    },
    {
      "name": "An unknown kind is refused",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "payload": {
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}",
        "persona_id": "{{cache:personas.create.response.data.persona.persona_id}}",
        "kind": "SABBATICAL",
        "starts_at": "{{dynamic:futuredatetime+1d}}",
        "ends_at": "{{dynamic:futuredatetime+2d}}"
      },
      "expectedStatus": 422
    }
  ]
}
