{
  "name": "PUT /api/relationships/:relationship_id/scope - Update scope or status",
  "endpoint": "/api/relationships/:relationship_id/scope",
  "sdk": "sdk-rebac",
  "method": "PUT",
  "requiresAuth": true,
  "expectedStatus": 200,
  "taskId": "9a8dd905-ed8f-4968-89ec-b81ddde6a00c",
  "sprintId": "8ef1d09e-dd8e-4daf-8d03-54dcd9f812f8",
  "featureId": "7efe9f11-7029-470a-abd6-fe506151fb65",
  "epicId": "00996d23-f667-4a82-9285-7728ba357e7b",
  "priority": 50,
  "testability": "auto",
  "sourceFile": "packages/sdk-rebac/src/server/routes.ts",
  "dependsOn": [
    "POST /api/auth/register",
    "POST /api/app-identities",
    "POST /api/memberships",
    "POST /api/personas",
    "POST /api/relationships"
  ],
  "testCases": [
    {
      "name": "Suspend the relationship and narrow scope",
      "headers": {
        "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
      },
      "pathParams": {
        "relationship_id": "{{cache:relationships.create.response.data.relationship.relationship_id}}"
      },
      "payload": {
        "status": "suspended",
        "scope": {
          "encounter_kind": "primary-care"
        }
      },
      "expectedStatus": 200
    }
  ],
  "fieldEnums": {
    "status": ["open", "active", "suspended", "terminated", "expired"]
  },
  "statusTransitions": {
    "entity": "relationship",
    "field": "status",
    "flow": ["open", "active", "suspended", "terminated", "expired"],
    "transitions": [
      { "from": "active", "to": "suspended", "via": "PUT /api/relationships/:relationship_id/scope" },
      { "from": "suspended", "to": "active", "via": "PUT /api/relationships/:relationship_id/scope" },
      { "from": "active", "to": "terminated", "via": "PUT /api/relationships/:relationship_id/scope" },
      { "from": "active", "to": "expired", "via": "PUT /api/relationships/:relationship_id/scope" }
    ]
  },
  "expectedResponse": {
    "data": {
      "relationship": {
        "relationship_id": "string",
        "status": "string"
      }
    }
  }
}
