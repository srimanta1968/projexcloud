{
  "name": "POST /api/relationships - Create relationship edge",
  "endpoint": "/api/relationships",
  "sdk": "sdk-rebac",
  "method": "POST",
  "requiresAuth": true,
  "expectedStatus": 201,
  "taskId": "6cf92af0-79d0-4ead-9396-7689ffbab81a",
  "sprintId": "8ef1d09e-dd8e-4daf-8d03-54dcd9f812f8",
  "featureId": "7efe9f11-7029-470a-abd6-fe506151fb65",
  "epicId": "00996d23-f667-4a82-9285-7728ba357e7b",
  "priority": 30,
  "testability": "auto",
  "sourceFile": "packages/sdk-rebac/src/server/routes.ts",
  "dependsOn": [
    "POST /api/auth/register",
    "POST /api/app-identities",
    "POST /api/memberships",
    "POST /api/personas"
  ],
  "testCases": [
    {
      "name": "Create a care-team relationship",
      "headers": {
        "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
      },
      "payload": {
        "kind": "care-team",
        "persona_a": "{{cache:personas.create.response.data.persona.persona_id}}",
        "persona_b": "{{cache:personas.create.response.data.persona.persona_id}}",
        "scope": {
          "encounter_kind": "primary-care"
        },
        "consent_ref": "{{var:customer_consent_ref}}",
        "expires_at": "2027-01-01T00:00:00Z",
        "reattest_due_at": "2026-12-01T00:00:00Z",
        "cross_tenant": false
      },
      "expectedStatus": 201
    }
  ],
  "expectedResponse": {
    "data": {
      "relationship": {
        "relationship_id": "string",
        "kind": "string",
        "status": "string"
      }
    }
  },
  "captureResponse": {
    "relationships.create.response.data.relationship.relationship_id": "data.relationship.relationship_id",
    "relationships.create.response.data.relationship.status": "data.relationship.status"
  },
  "description": "Creates a new relationship edge between two personas, returning 201 with the created relationship. Requires non-empty kind, persona_a and persona_b (trimmed), and persona_a must differ from persona_b (self-edges rejected). Optional fields (scope, consent_ref, expires_at, reattest_due_at, cross_tenant) are coerced/ignored if wrong type. A DB check-constraint violation maps to 400; other insert failures return 500.",
  "errorCases": [
    {
      "status": 401,
      "code": "Unauthorized",
      "message": "Missing bearer token",
      "when": "Authorization header absent or not Bearer form (requireAuth)"
    },
    {
      "status": 401,
      "code": "Unauthorized",
      "message": "Invalid or expired token",
      "when": "Bearer token fails JWT verification (requireAuth)"
    },
    {
      "status": 400,
      "code": "ValidationError",
      "message": "details[] lists failing fields: kind/persona_a/persona_b required, persona_a and persona_b must differ, or body must be an object",
      "when": "body not an object, a required field empty/missing, or persona_a === persona_b"
    },
    {
      "status": 400,
      "code": "ValidationError",
      "message": "raw DB check-constraint message",
      "when": "createRelationship() throws an error whose message includes \"check constraint\""
    },
    {
      "status": 500,
      "code": "InternalError",
      "message": "InternalError",
      "when": "createRelationship() throws any other error or an error escapes the controller"
    }
  ]
}
