{
  "name": "POST /api/workflows/start - Start a run of a registered workflow",
  "endpoint": "/api/workflows/start",
  "sdk": "sdk-workflow",
  "sourceFile": "packages/sdk-workflow/src/server/handlers/workflowController.ts",
  "method": "POST",
  "requiresAuth": true,
  "expectedStatus": 201,
  "taskId": "37e8f14e-2c81-415f-9fa9-e2ff755d74f8",
  "sprintId": "8ef1d09e-dd8e-4daf-8d03-54dcd9f812f8",
  "featureId": "c8c3cd6c-f966-406e-b761-7d6fa53d786a",
  "epicId": "d83f7b6e-821c-4fe1-96e6-910eca8fbbfc",
  "priority": 30,
  "testability": "auto",
  "dependsOn": [
    "POST /api/auth/register",
    "POST /api/personas",
    "POST /policy/:id/evaluate",
    "POST /api/workflows/definitions"
  ],
  "testCases": [
    {
      "name": "Start qa-workflow-demo run (platform-scoped)",
      "headers": {
        "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
      },
      "payload": {
        "name": "qa-workflow-demo",
        "version": "1.0.0",
        "namespace": "admin",
        "envelope": {
          "persona_id": "{{cache:personas.create.response.data.persona.persona_id}}",
          "trace_id": "{{cache:policy.evaluate.response.data.trace_id}}",
          "actor": {
            "kind": "service",
            "id": "{{var:person_id}}"
          }
        },
        "input": {
          "amount": 1500,
          "currency": "USD"
        }
      },
      "expectedStatus": 201
    }
  ],
  "fieldEnums": {
    "envelope.actor.kind": [
      "human",
      "service",
      "agent",
      "support_impersonator"
    ]
  },
  "statusTransitions": {
    "entity": "workflow.run",
    "field": "status",
    "flow": [
      "running",
      "completed",
      "compensated"
    ],
    "transitions": [
      {
        "from": "running",
        "to": "completed",
        "via": "POST /api/workflows/start"
      },
      {
        "from": "running",
        "to": "compensated",
        "via": "POST /api/workflows/start"
      }
    ]
  },
  "expectedResponse": {
    "data": {
      "run_id": "string",
      "status": "string",
      "steps": "array",
      "output": "object"
    }
  },
  "captureResponse": {
    "workflows.start.response.data.run_id": "data.run_id",
    "workflows.start.response.data.status": "data.status"
  },
  "description": "Starts a run of a registered workflow definition, resolving the active definition by name (+ optional version/namespace, default namespace \"admin\"), drives the runtime engine, and returns 201 with run_id/status/steps/output. The envelope is inherited from the JWT (tenant_id/sub) when not supplied. Edge cases: missing name (only required field), a name/version/namespace with no matching active definition (404), and a step whose handler is not registered in-process (400).",
  "errorCases": [
    {
      "status": 401,
      "code": "Unauthorized",
      "message": "Missing bearer token",
      "when": "Authorization header absent or not Bearer form (requireAuth)"
    },
    {
      "status": 401,
      "code": "Unauthorized",
      "message": "Invalid or expired token",
      "when": "Bearer token fails JWT verification (requireAuth)"
    },
    {
      "status": 400,
      "code": "ValidationError",
      "message": "details[]: name is required / body must be an object",
      "when": "validateStartRun fails"
    },
    {
      "status": 404,
      "code": "WorkflowDefinitionNotFound",
      "message": "No active workflow definition for name=... version=... namespace=...",
      "when": "startRun finds no active definition"
    },
    {
      "status": 400,
      "code": "StepHandlerNotFound",
      "message": "step handler not registered",
      "when": "executeRun hits a step with no in-process handler"
    },
    {
      "status": 500,
      "code": "InternalError",
      "message": "InternalError",
      "when": "any other unmapped error"
    }
  ]
}
