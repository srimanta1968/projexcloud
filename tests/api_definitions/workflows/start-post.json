{
  "name": "POST /api/workflows/start - Start a run of a registered workflow",
  "endpoint": "/api/workflows/start",
  "sdk": "sdk-workflow",
  "sourceFile": "packages/sdk-workflow/src/server/handlers/workflowController.ts",
  "method": "POST",
  "requiresAuth": true,
  "expectedStatus": 201,
  "taskId": "37e8f14e-2c81-415f-9fa9-e2ff755d74f8",
  "sprintId": "8ef1d09e-dd8e-4daf-8d03-54dcd9f812f8",
  "featureId": "c8c3cd6c-f966-406e-b761-7d6fa53d786a",
  "epicId": "d83f7b6e-821c-4fe1-96e6-910eca8fbbfc",
  "priority": 30,
  "testability": "auto",
  "dependsOn": [
    "POST /api/auth/register",
    "POST /api/workflows/definitions"
  ],
  "testCases": [
    {
      "name": "Start qa-workflow-demo run (platform-scoped)",
      "headers": {
        "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
      },
      "payload": {
        "name": "qa-workflow-demo",
        "version": "1.0.0",
        "namespace": "admin",
        "envelope": {
          "persona_id": "{{var:persona_id}}",
          "trace_id": "{{var:trace_id}}",
          "actor": {
            "kind": "service",
            "id": "{{var:person_id}}"
          }
        },
        "input": {
          "amount": 1500,
          "currency": "USD"
        }
      },
      "expectedStatus": 201
    }
  ],
  "fieldEnums": {
    "envelope.actor.kind": ["human", "service", "agent", "support_impersonator"]
  },
  "statusTransitions": {
    "entity": "workflow.run",
    "field": "status",
    "flow": ["running", "completed", "compensated"],
    "transitions": [
      { "from": "running", "to": "completed", "via": "POST /api/workflows/start" },
      { "from": "running", "to": "compensated", "via": "POST /api/workflows/start" }
    ]
  },
  "expectedResponse": {
    "data": {
      "run_id": "string",
      "status": "string",
      "steps": "array",
      "output": "object"
    }
  },
  "captureResponse": {
    "workflows.start.response.data.run_id": "data.run_id",
    "workflows.start.response.data.status": "data.status"
  }
}
