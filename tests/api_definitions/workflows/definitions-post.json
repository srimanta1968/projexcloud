{
  "name": "POST /api/workflows/definitions - Register/upsert workflow definition",
  "endpoint": "/api/workflows/definitions",
  "sdk": "sdk-workflow",
  "sourceFile": "packages/sdk-workflow/src/server/handlers/workflowController.ts",
  "method": "POST",
  "requiresAuth": true,
  "expectedStatus": 201,
  "taskId": "a23465f8-71aa-4fa5-8a01-3439359a2ead",
  "sprintId": "8ef1d09e-dd8e-4daf-8d03-54dcd9f812f8",
  "featureId": "c8c3cd6c-f966-406e-b761-7d6fa53d786a",
  "epicId": "d83f7b6e-821c-4fe1-96e6-910eca8fbbfc",
  "priority": 20,
  "testability": "auto",
  "dependsOn": [
    "POST /api/auth/register"
  ],
  "testCases": [
    {
      "name": "Register a 2-step workflow using boot-registered step handlers",
      "headers": {
        "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
      },
      "payload": {
        "name": "qa-workflow-demo",
        "version": "1.0.0",
        "namespace": "admin",
        "step_specs": [
          {
            "name": "dunning.send-reminder",
            "compensate": "dunning.rollback-reminder"
          },
          {
            "name": "dunning.write-off"
          }
        ]
      },
      "expectedStatus": 201
    }
  ],
  "expectedResponse": {
    "data": {
      "definition": {
        "workflow_def_id": "string",
        "name": "string",
        "version": "string",
        "namespace": "string",
        "step_specs": "array",
        "status": "string"
      }
    }
  },
  "captureResponse": {
    "workflows.register.response.data.definition.workflow_def_id": "data.definition.workflow_def_id",
    "workflows.register.response.data.definition.status": "data.definition.status"
  }
}
