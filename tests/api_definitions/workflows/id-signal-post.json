{
  "name": "POST /api/workflows/:run_id/signal - Signal in-flight run",
  "endpoint": "/api/workflows/:run_id/signal",
  "sdk": "sdk-workflow",
  "sourceFile": "packages/sdk-workflow/src/server/handlers/workflowController.ts",
  "method": "POST",
  "requiresAuth": true,
  "expectedStatus": 200,
  "taskId": "37e8f14e-2c81-415f-9fa9-e2ff755d74f8",
  "sprintId": "8ef1d09e-dd8e-4daf-8d03-54dcd9f812f8",
  "featureId": "c8c3cd6c-f966-406e-b761-7d6fa53d786a",
  "epicId": "d83f7b6e-821c-4fe1-96e6-910eca8fbbfc",
  "priority": 40,
  "testability": "auto",
  "dependsOn": [
    "POST /api/auth/register",
    "POST /api/workflows/definitions",
    "POST /api/workflows/start"
  ],
  "testCases": [
    {
      "name": "Send approval signal to a run",
      "headers": {
        "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
      },
      "pathParams": {
        "run_id": "{{cache:workflows.start.response.data.run_id}}"
      },
      "payload": {
        "signal_name": "approve",
        "payload": {
          "approver_id": "{{cache:auth.register.response.data.userId}}"
        }
      },
      "expectedStatus": 200
    }
  ],
  "expectedResponse": {
    "data": {
      "signaled": "boolean"
    }
  },
  "captureResponse": {
    "workflows.signal.response.data.signaled": "data.signaled"
  }
}
