{
  "name": "POST /api/service-request/tickets/:ticket_id/transition — sdk-service-request",
  "endpoint": "/api/service-request/tickets/:ticket_id/transition",
  "method": "POST",
  "requiresAuth": true,
  "dependsOn": [
    "POST /api/auth/register",
    "POST /api/service-request/tickets"
  ],
  "expectedStatus": 200,
  "sdk": "sdk-service-request",
  "sourceFile": "packages/sdk-service-request/src/server/routes.ts",
  "_generated": true,
  "fieldOptions": {
    "to": ["new", "in-progress", "awaiting-customer", "resolved", "closed"]
  },
  "testCases": [
    {
      "name": "Transition a new ticket to in-progress (valid transition from default status 'new')",
      "headers": {
        "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
      },
      "pathParams": {
        "ticket_id": "{{cache:service-request.tickets.response.data.ticket.ticket_id}}"
      },
      "payload": {
        "to": "{{static:in-progress}}"
      },
      "expectedStatus": 200
    }
  ]
}
