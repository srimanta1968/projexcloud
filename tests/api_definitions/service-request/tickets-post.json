{
  "name": "POST /api/service-request/tickets — sdk-service-request",
  "endpoint": "/api/service-request/tickets",
  "method": "POST",
  "requiresAuth": true,
  "dependsOn": [
    "POST /api/auth/signup-tenant",
    "POST /api/personas",
    "POST /api/encounters",
    "POST /api/service-request/queues"
  ],
  "expectedStatus": 201,
  "sdk": "sdk-service-request",
  "sourceFile": "packages/sdk-service-request/src/server/routes.ts",
  "_generated": true,
  "fieldEnums": {
    "priority": ["low", "normal", "high", "urgent"],
    "severity": ["trivial", "minor", "major", "critical"]
  },
  "captureResponse": {
    "service-request.tickets.response.data.ticket.ticket_id": "data.ticket.ticket_id"
  },
  "testCases": [
    {
      "name": "Open a ticket (tenant_id + encounter_id + requester_persona_id required)",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "payload": {
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}",
        "encounter_id": "{{cache:encounters.create.response.data.encounter.encounter_id}}",
        "requester_persona_id": "{{cache:personas.create.response.data.persona.persona_id}}",
        "queue_id": "{{cache:service-request.queues.response.data.queue.queue_id}}",
        "priority": "normal",
        "severity": "minor",
        "external_refs": {
          "zendesk_id": "ZD-1001"
        }
      },
      "expectedStatus": 201
    }
  ]
}
