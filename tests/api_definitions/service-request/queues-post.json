{
  "name": "POST /api/service-request/queues — sdk-service-request",
  "endpoint": "/api/service-request/queues",
  "method": "POST",
  "requiresAuth": true,
  "dependsOn": [
    "POST /api/auth/register"
  ],
  "expectedStatus": 201,
  "sdk": "sdk-service-request",
  "sourceFile": "packages/sdk-service-request/src/server/routes.ts",
  "_generated": true,
  "captureResponse": {
    "service-request.queues.response.data.queue.queue_id": "data.queue.queue_id"
  },
  "testCases": [
    {
      "name": "Create a service-request queue (tenant_id + name required)",
      "headers": {
        "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
      },
      "payload": {
        "tenant_id": "{{dynamic:uuid}}",
        "name": "{{dynamic:name}}",
        "priority": 100
      },
      "expectedStatus": 201
    }
  ]
}
