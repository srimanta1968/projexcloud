{
  "name": "POST /api/service-request/tickets/:ticket_id/assign — sdk-service-request",
  "endpoint": "/api/service-request/tickets/:ticket_id/assign",
  "method": "POST",
  "requiresAuth": true,
  "dependsOn": [
    "POST /api/auth/register",
    "POST /api/service-request/tickets"
  ],
  "expectedStatus": 200,
  "sdk": "sdk-service-request",
  "sourceFile": "packages/sdk-service-request/src/server/routes.ts",
  "_generated": true,
  "testCases": [
    {
      "name": "Assign an existing ticket to a persona (assignee_persona_id required)",
      "headers": {
        "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
      },
      "pathParams": {
        "ticket_id": "{{cache:service-request.tickets.response.data.ticket.ticket_id}}"
      },
      "payload": {
        "assignee_persona_id": "{{dynamic:uuid}}"
      },
      "expectedStatus": 200
    }
  ]
}
