{
  "name": "POST /api/billing/reprice-dry-run - What-if catalog comparison",
  "endpoint": "/api/billing/reprice-dry-run",
  "sdk": "sdk-billing",
  "sourceFile": "packages/sdk-billing/src/server/routes.ts",
  "method": "POST",
  "requiresAuth": true,
  "expectedStatus": 201,
  "taskId": "12c03a30-b9f7-4c46-8ad6-12584dad6739",
  "sprintId": "8ef1d09e-dd8e-4daf-8d03-54dcd9f812f8",
  "featureId": "27e7a551-ff73-49df-977a-1c1f56126bbb",
  "epicId": "d83f7b6e-821c-4fe1-96e6-910eca8fbbfc",
  "priority": 50,
  "testability": "auto",
  "dependsOn": [
    "POST /api/auth/signup-tenant",
    "POST /admin/meter/pricing-catalogs",
    "PUT /admin/meter/pricing-catalogs/:catalog_id/rates/:sku",
    "PATCH /admin/meter/pricing-catalogs/:catalog_id/status"
  ],
  "testCases": [
    {
      "name": "Compare current catalog against itself (baseline == target dry-run)",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "payload": {
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}",
        "period_start": "2026-01-01",
        "period_end": "2026-01-31",
        "baseline_catalog_id": "{{cache:meter-pricing-catalogs.create.response.data.catalog_id}}",
        "target_catalog_id": "{{cache:meter-pricing-catalogs.create.response.data.catalog_id}}",
        "usage": [
          {
            "sku": "api.call",
            "app_id": "admin",
            "bu_id": "finance",
            "persona_kind": "human",
            "encounter_id": null,
            "actor_kind": "service",
            "units": 50000,
            "vendor_cost": 0
          }
        ]
      },
      "expectedStatus": 201
    }
  ],
  "expectedResponse": {
    "data": {
      "dry_run": {
        "dry_run_id": "string",
        "delta_amount": "string"
      },
      "baseline_total": "number",
      "target_total": "number"
    }
  },
  "fieldEnums": {
    "actor_kind": ["human", "agent", "service"]
  },
  "captureResponse": {
    "billing-reprice.dry-run.response.data.dry_run.dry_run_id": "data.dry_run.dry_run_id"
  }
}
