{
  "name": "POST /api/billing/invoices/generate - Trigger month-close invoice generation",
  "endpoint": "/api/billing/invoices/generate",
  "sdk": "sdk-billing",
  "sourceFile": "packages/sdk-billing/src/server/routes.ts",
  "method": "POST",
  "requiresAuth": true,
  "expectedStatus": 201,
  "taskId": "f8589102-1711-4791-b17e-7fc636a49be0",
  "sprintId": "8ef1d09e-dd8e-4daf-8d03-54dcd9f812f8",
  "featureId": "27e7a551-ff73-49df-977a-1c1f56126bbb",
  "epicId": "d83f7b6e-821c-4fe1-96e6-910eca8fbbfc",
  "priority": 30,
  "testability": "auto",
  "dependsOn": [
    "POST /api/auth/signup-tenant",
    "POST /admin/meter/pricing-catalogs",
    "PUT /admin/meter/pricing-catalogs/:catalog_id/rates/:sku",
    "PATCH /admin/meter/pricing-catalogs/:catalog_id/status"
  ],
  "testCases": [
    {
      "name": "Generate Jan 2026 invoice",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "payload": {
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}",
        "catalog_id": "{{cache:meter-pricing-catalogs.create.response.data.catalog_id}}",
        "period_start": "2026-01-01",
        "period_end": "2026-01-31",
        "currency": "USD",
        "tax_rate": 0.0875,
        "usage": [
          {
            "sku": "api.call",
            "app_id": "admin",
            "bu_id": "finance",
            "persona_kind": "human",
            "encounter_id": null,
            "actor_kind": "human",
            "units": 12000,
            "vendor_cost": 0
          }
        ]
      },
      "expectedStatus": 201
    }
  ],
  "expectedResponse": {
    "data": {
      "invoice": {
        "invoice_id": "string",
        "status": "string",
        "total": "string"
      },
      "line_items": "array"
    }
  },
  "fieldEnums": {
    "actor_kind": ["human", "agent", "service"]
  },
  "statusTransitions": {
    "entity": "invoice",
    "field": "status",
    "flow": ["draft", "finalized", "paid", "void", "failed"],
    "transitions": [
      { "from": "draft", "to": "finalized", "via": "POST /api/billing/invoices/generate" }
    ]
  },
  "captureResponse": {
    "billing-invoices.generate.response.data.invoice.invoice_id": "data.invoice.invoice_id",
    "billing-invoices.generate.response.data.invoice.status": "data.invoice.status"
  }
}
