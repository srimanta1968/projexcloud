{
  "name": "POST /api/resellers - Create reseller",
  "endpoint": "/api/resellers",
  "sdk": "sdk-tenant",
  "method": "POST",
  "requiresAuth": true,
  "expectedStatus": 201,
  "taskId": "cad291a5-9a0a-434d-8e2b-11b73e3a8c23",
  "sprintId": "8ef1d09e-dd8e-4daf-8d03-54dcd9f812f8",
  "featureId": "d3f526f1-243f-4b31-b538-aeffeddca534",
  "epicId": "00996d23-f667-4a82-9285-7728ba357e7b",
  "priority": 25,
  "testability": "auto",
  "dependsOn": [
    "POST /api/auth/signup-tenant"
  ],
  "fieldEnums": {
    "invoice_aggregation": ["per-tenant", "consolidated"]
  },
  "testCases": [
    {
      "name": "Create a reseller with brand + commission rules",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "payload": {
        "org_id": "{{cache:auth.signup-tenant.response.data.org_id}}",
        "brand_name": "{{dynamic:name}}",
        "cname_host": "reseller.example.com",
        "support_contact": {
          "email": "support@reseller.example.com",
          "phone": "+1-555-0100"
        },
        "commission_rules": {
          "default_pct": 15
        },
        "invoice_aggregation": "consolidated"
      },
      "expectedStatus": 201
    }
  ],
  "expectedResponse": {
    "data": {
      "reseller": {
        "reseller_id": "string",
        "org_id": "string",
        "brand_name": "string",
        "cname_host": "string",
        "support_contact": {},
        "commission_rules": {},
        "invoice_aggregation": "string",
        "portfolio_kill_switch": false,
        "created_at": "string"
      }
    }
  },
  "captureResponse": {
    "resellers.create.response.data.reseller.reseller_id": "data.reseller.reseller_id",
    "resellers.create.response.data.reseller.org_id": "data.reseller.org_id"
  }
}
