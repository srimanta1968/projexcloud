  "epicId": "249cbae0-e76c-42c0-8afd-9c825f5419c7",
  "testCases": [
    {
      "name": "Append entry to canonical audit chain",
      "payload": {
        "pool_index": "app-healthcare-007",
        "event_type": "identity.login.v1",
        "payload": {
          "action": "create",
          "resource": "{{dynamic:name}}"
        },
        "actor_kind": "human",
        "retention_class": "operational",
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}",
        "org_id": "{{cache:auth.signup-tenant.response.data.org_id}}",
        "app_id": "{{cache:auth.signup-tenant.response.data.app_id}}",
        "bu_id": "{{var:bu_id}}",
        "subject_kind": "user",
        "subject_id": "{{cache:scim.create.response.data.person_id}}"
      },
      "expectedStatus": 201,
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      }
    }
  ],
  "dependsOn": [
    "POST /api/auth/signup-tenant",
    "POST /scim/v2/Users"
  ],
  "fieldEnums": {
    "actor_kind": ["human", "service", "agent"],
    "retention_class": ["transient", "operational", "regulated"]
  },
  "expectedResponse": {
    "data": {
      "entry_id": "string",
      "pool_index": "string",
      "seq": "number",
      "entry_hash": "string",
      "prev_hash": "string",
      "recorded_at": "string",
      "retention_class": "string",
      "expires_at": "string"
    }
  },
  "captureResponse": {
    "audit.append.response.data.entry_id": "data.entry_id",
    "audit.append.response.data.entry_hash": "data.entry_hash"
  }
}
