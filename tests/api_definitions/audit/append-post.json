{
  "name": "POST /api/audit/append - Append entry to audit chain",
  "endpoint": "/api/audit/append",
  "sdk": "sdk-audit",
  "sourceFile": "packages/sdk-audit/src/server/handlers/auditController.ts",
  "method": "POST",
  "requiresAuth": true,
  "expectedStatus": 201,
  "taskId": "17087035-d9ed-4636-b2ea-06ea5bdc884e",
  "sprintId": "8ef1d09e-dd8e-4daf-8d03-54dcd9f812f8",
