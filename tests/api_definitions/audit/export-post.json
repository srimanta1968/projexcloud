{
  "name": "POST /api/audit/export — sdk-audit",
  "endpoint": "/api/audit/export",
  "method": "POST",
  "requiresAuth": true,
  "dependsOn": [
    "POST /api/auth/signup-tenant"
  ],
  "expectedStatus": 201,
  "sdk": "sdk-audit",
  "sourceFile": "packages/sdk-audit/src/server/handlers/exportController.ts",
  "_generated": true,
  "testability": "auto",
  "testCases": [
    {
      "name": "Request an inline JSONL export of the tenant audit chain",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "payload": {
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}",
        "format": "jsonl",
        "range_start": "{{dynamic:pastdatetime}}",
        "range_end": "{{dynamic:futuredatetime}}",
        "inline": true
      },
      "expectedStatus": 201
    }
  ],
  "fieldEnums": {
    "format": ["pdf", "jsonl"]
  },
  "statusTransitions": {
    "entity": "export_request",
    "field": "status",
    "flow": ["pending", "running", "ready", "failed"],
    "transitions": [
      { "from": "pending", "to": "running", "via": "POST /api/audit/export" },
      { "from": "running", "to": "ready", "via": "POST /api/audit/export" },
      { "from": "running", "to": "failed", "via": "POST /api/audit/export" }
    ]
  },
  "expectedResponse": {
    "data": {
      "request_id": "string",
      "status": "string",
      "artifact_s3_key": "string",
      "signature_hex": "string"
    }
  },
  "captureResponse": {
    "audit.export.response.data.request_id": "data.request_id"
  }
}
