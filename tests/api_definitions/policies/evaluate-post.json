  "dependsOn": ["POST /api/auth/register", "POST /api/policies"],
  "testCases": [
    {
      "name": "Evaluate the doctor-care-team policy for a subject",
      "headers": { "Authorization": "Bearer {{cache:auth.register.response.data.token}}" },
      "payload": {
        "policy_id": "{{cache:policies.create.response.data.policy.policy_id}}",
