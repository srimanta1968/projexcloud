{
  "name": "POST /api/policies/evaluate - Evaluate policy with subject + context",
  "endpoint": "/api/policies/evaluate",
  "sdk": "sdk-policy",
  "method": "POST",
  "requiresAuth": true,
  "expectedStatus": 200,
  "taskId": "b1f2120c-97b0-4e75-9cf3-124e572ece27",
  "sprintId": "8ef1d09e-dd8e-4daf-8d03-54dcd9f812f8",
  "featureId": "15044723-73ce-4f33-8443-4c3a970380dd",
  "epicId": "00996d23-f667-4a82-9285-7728ba357e7b",
  "priority": 50,
  "dependsOn": [
    "POST /api/auth/register",
    "POST /api/policies"
  ],
  "testCases": [
    {
      "name": "Evaluate the doctor-care-team policy for a subject",
      "headers": {
        "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
      },
      "payload": {
        "policy_id": "{{cache:policies.create.response.data.policy.policy_id}}",
        "subject_id": "{{cache:auth.register.response.data.userId}}",
        "target_id": "{{var:target_id}}",
        "context": {
          "subject": {
            "persona": {
              "role": "doctor"
            }
          },
          "rebac": {
            "care-team:*": true
          },
          "projection_version": 1
        },
        "purpose": "treatment",
        "purpose_bound": false,
        "consent_receipts": [],
        "resource_class": "sensitive"
      },
      "expectedStatus": 200
    }
  ],
  "fieldEnums": {
    "resource_class": ["sensitive", "low_risk"]
  },
  "expectedResponse": {
    "data": {
      "decision": "string",
      "reason": "string",
      "layers_used": "array",
      "cached": "boolean"
    }
  },
  "captureResponse": {
    "policies.evaluate.response.data.decision": "data.decision"
  }
}
