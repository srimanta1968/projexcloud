{
  "name": "POST /api/policies - Create versioned policy bundle",
  "endpoint": "/api/policies",
  "sdk": "sdk-policy",
  "method": "POST",
  "requiresAuth": true,
  "expectedStatus": 201,
  "taskId": "51b17a8e-2035-4fae-af64-f6e30dd7bc9c",
  "sprintId": "8ef1d09e-dd8e-4daf-8d03-54dcd9f812f8",
  "featureId": "15044723-73ce-4f33-8443-4c3a970380dd",
  "epicId": "00996d23-f667-4a82-9285-7728ba357e7b",
  "priority": 30,
  "dependsOn": [
    "POST /api/auth/register"
  ],
  "testCases": [
    {
      "name": "Create a doctor-care-team policy bundle",
      "headers": {
        "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
      },
      "payload": {
        "name": "{{dynamic:name}}",
        "version": "1.0.0",
        "iql_source": "subject.persona(role=\"doctor\") and relationship(type=\"care-team\")"
      },
      "expectedStatus": 201
    }
  ],
  "expectedResponse": {
    "data": {
      "policy": {
        "policy_id": "string",
        "name": "string",
        "version": "string"
      }
    }
  },
  "captureResponse": {
    "policies.create.response.data.policy.policy_id": "data.policy.policy_id"
  }
}
