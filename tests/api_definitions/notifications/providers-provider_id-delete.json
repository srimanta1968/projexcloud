{
  "name": "DELETE /api/notifications/providers/:provider_id - Revoke tenant email provider",
  "endpoint": "/api/notifications/providers/:provider_id",
  "sdk": "sdk-notification",
  "method": "DELETE",
  "requiresAuth": true,
  "taskId": "77a29699-191e-4d2f-82ac-6376d14cfbc1",
  "sprintId": "efcf9cbd-5e84-469e-946e-efcabf8c88e1",
  "featureId": "e9e9b8ee-101b-4a6c-8100-538b861781a8",
  "epicId": "f9bd4029-5fd6-4dc1-bfce-00af515b8294",
  "priority": 40,
  "dependsOn": ["POST /api/auth/signup-tenant", "POST /api/notifications/providers"],
  "testCases": [
    {
      "name": "Revoke the tenant's email provider",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "pathParams": {
        "provider_id": "{{cache:notifications.providers.create.response.data.provider.binding_id}}"
      },
      "payload": {
        "reason": "{{static:QA revoke test for email provider}}"
      },
      "expectedStatus": 200,
      "expectedResponse": {
        "data": {
          "provider": {
            "status": "revoked"
          }
        }
      }
    }
  ]
}
