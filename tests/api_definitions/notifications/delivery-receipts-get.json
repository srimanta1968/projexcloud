{
  "sdk": "sdk-notification",
  "sourceFile": "packages/sdk-notification/src/server/routes.ts",
  "taskId": "d6184d21-cc25-4e19-81f7-d46eb6d62c83",
  "sprintId": "d4876947-8d18-4538-8e9f-51ba3e0735a9",
  "featureId": "73f2d42d-acc1-4317-9e31-604bc330a08a",
  "epicId": "f7f7186e-8f69-4e44-97b8-212928e870f6",
  "testability": "auto",
  "name": "GET /api/notifications/delivery-receipts - List delivery receipts",
  "endpoint": "/api/notifications/delivery-receipts",
  "method": "GET",
  "requiresAuth": true,
  "expectedStatus": 200,
  "priority": 46,
  "description": "List a tenant's provider delivery-status receipts (newest first), optionally filtered by status. tenant_id query param required.",
  "dependsOn": [
    "POST /api/auth/signup-tenant",
    "POST /api/notifications/webhooks/delivery/:provider"
  ],
  "fieldEnums": {
    "status": [
      "queued",
      "sent",
      "delivered",
      "failed",
      "bounced",
      "undelivered",
      "complaint"
    ]
  },
  "testCases": [
    {
      "name": "List delivery receipts",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "queryParams": {
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}",
        "status": "delivered"
      },
      "expectedStatus": 200,
      "expectedResponse": {
        "data": {
          "receipts": "array"
        }
      }
    }
  ],
  "errorCases": [
    {
      "status": 400,
      "code": "ValidationError",
      "message": "tenant_id query param required",
      "when": "tenant_id missing"
    }
  ]
}
