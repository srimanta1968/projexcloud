{
  "name": "POST /api/notifications/send - Dispatch notification with consent + quiet-hours + render",
  "endpoint": "/api/notifications/send",
  "sdk": "sdk-notification",
  "method": "POST",
  "requiresAuth": true,
  "expectedStatus": 201,
  "taskId": "0240664d-92bd-49c3-916d-165ccb77bde7",
  "sprintId": "8ef1d09e-dd8e-4daf-8d03-54dcd9f812f8",
  "featureId": "01ca8316-09cf-462d-bf9d-7eeac8745bff",
  "epicId": "d83f7b6e-821c-4fe1-96e6-910eca8fbbfc",
  "priority": 40,
  "testability": "auto",
  "dependsOn": [
    "POST /api/auth/signup-tenant",
    "POST /api/notifications/templates"
  ],
  "testCases": [
    {
      "name": "Send email notification with rendered body",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "payload": {
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}",
        "template_code": "{{cache:notifications.templates.create.response.data.template.code}}",
        "person_id": "{{cache:auth.signup-tenant.response.data.userId}}",
        "app_identity_id": "{{cache:auth.signup-tenant.response.data.userId}}",
        "channel": "email",
        "destination": "{{dynamic:email}}",
        "payload": {
          "name": "Alice"
        },
        "locale": "en-US",
        "scheduled_at": "{{dynamic:futuredatetime}}",
        "enforce_consent": false,
        "honor_quiet_hours": false
      },
      "expectedStatus": 201
    }
  ],
  "expectedResponse": {
    "data": {
      "message": {
        "message_id": "string",
        "status": "string"
      },
      "status": "string",
      "rendered_body": "string"
    }
  },
  "captureResponse": {
    "notifications.send.response.data.message.message_id": "data.message.message_id"
  },
  "fieldEnums": {
    "channel": ["email", "sms", "whatsapp", "push", "slack"]
  }
}
