{
  "name": "POST /api/notifications/templates - Register template (platform default or tenant override)",
  "endpoint": "/api/notifications/templates",
  "sdk": "sdk-notification",
  "method": "POST",
  "requiresAuth": true,
  "expectedStatus": 201,
  "taskId": "0240664d-92bd-49c3-916d-165ccb77bde7",
  "sprintId": "8ef1d09e-dd8e-4daf-8d03-54dcd9f812f8",
  "featureId": "01ca8316-09cf-462d-bf9d-7eeac8745bff",
  "epicId": "d83f7b6e-821c-4fe1-96e6-910eca8fbbfc",
  "priority": 20,
  "testability": "auto",
  "dependsOn": [
    "POST /api/auth/signup-tenant"
  ],
  "testCases": [
    {
      "name": "Register a tenant-scoped email template",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "payload": {
        "code": "{{dynamic:slug}}",
        "channel": "email",
        "locale_bundles": {
          "en-US": {
            "subject": "Welcome",
            "body": "Hi {name}, welcome!"
          }
        },
        "required_consent_purpose": null,
        "version": "1.0.0"
      },
      "expectedStatus": 201
    }
  ],
  "expectedResponse": {
    "data": {
      "template": {
        "template_id": "string",
        "code": "string",
        "channel": "string"
      }
    }
  },
  "captureResponse": {
    "notifications.templates.create.response.data.template.template_id": "data.template.template_id",
    "notifications.templates.create.response.data.template.code": "data.template.code"
  },
  "fieldEnums": {
    "channel": ["email", "sms", "whatsapp", "push", "slack"]
  }
}
