{
  "sdk": "sdk-notification",
  "sourceFile": "packages/sdk-notification/src/server/routes.ts",
  "taskId": "a53a3912-4598-4dfe-a728-21e6ab9a5d4c",
  "sprintId": "d4876947-8d18-4538-8e9f-51ba3e0735a9",
  "featureId": "73f2d42d-acc1-4317-9e31-604bc330a08a",
  "epicId": "f7f7186e-8f69-4e44-97b8-212928e870f6",
  "testability": "auto",
  "name": "GET /api/notifications/sms-inbound - List inbound SMS",
  "endpoint": "/api/notifications/sms-inbound",
  "method": "GET",
  "requiresAuth": true,
  "expectedStatus": 200,
  "priority": 42,
  "description": "List a tenant's inbound SMS (newest first), optionally filtered by keyword intent (opt_out/opt_in/help/none). tenant_id query param required.",
  "dependsOn": [
    "POST /api/auth/signup-tenant",
    "POST /api/notifications/webhooks/sms/inbound"
  ],
  "fieldEnums": {
    "intent": [
      "opt_out",
      "opt_in",
      "help",
      "none"
    ]
  },
  "testCases": [
    {
      "name": "List inbound SMS",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "queryParams": {
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}",
        "intent": "opt_out"
      },
      "expectedStatus": 200,
      "expectedResponse": {
        "data": {
          "messages": "array"
        }
      }
    }
  ],
  "errorCases": [
    {
      "status": 401,
      "code": "Unauthorized",
      "message": "Missing bearer token",
      "when": "Authorization header absent or not in 'Bearer <jwt>' form (requireAuth preHandler)"
    },
    {
      "status": 401,
      "code": "Unauthorized",
      "message": "Invalid or expired token",
      "when": "JWT signature invalid, malformed, or exp has elapsed"
    },
    {
      "status": 400,
      "code": "ValidationError",
      "message": "tenant_id query param required",
      "when": "tenant_id missing"
    }
  ]
}
