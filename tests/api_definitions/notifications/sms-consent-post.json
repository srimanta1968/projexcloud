{
  "sdk": "sdk-notification",
  "sourceFile": "packages/sdk-notification/src/server/routes.ts",
  "requiresAuth": true,
  "taskId": "7a2e2b13-f353-464d-8ea3-6c67f5b1ed00",
  "sprintId": "d4876947-8d18-4538-8e9f-51ba3e0735a9",
  "featureId": "73f2d42d-acc1-4317-9e31-604bc330a08a",
  "epicId": "f7f7186e-8f69-4e44-97b8-212928e870f6",
  "testability": "auto",
  "name": "POST /api/notifications/sms-consent - Propagate SMS opt-out/opt-in",
  "endpoint": "/api/notifications/sms-consent",
  "method": "POST",
  "expectedStatus": 200,
  "priority": 47,
  "description": "Propagate an SMS opt-out (STOP) or opt-in (START) to BOTH the suppression list (reason-tagged, via sdk-deliverability) AND the local consent record, emitting a PII-safe opt-out/opt-in event. Idempotent per (tenant, number): a duplicate leaves state unchanged (changed=false). The number is stored only as a sha256 hash + last 4 digits (never plaintext). tenant_id, phone and action are required.",
  "dependsOn": [
    "POST /api/auth/signup-tenant"
  ],
  "fieldEnums": {
    "action": [
      "opt_out",
      "opt_in"
    ]
  },
  "testCases": [
    {
      "name": "Opt a number out (STOP)",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "payload": {
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}",
        "phone": "+1555{{dynamic:number}}",
        "action": "opt_out",
        "source": "api",
        "purpose": "marketing"
      },
      "expectedStatus": 200,
      "expectedResponse": {
        "data": {
          "consent": {
            "status": "string",
            "phone_last4": "string"
          }
        }
      }
    }
  ],
  "errorCases": [
    {
      "status": 401,
      "code": "Unauthorized",
      "message": "Missing bearer token",
      "when": "Authorization header absent or not in 'Bearer <jwt>' form (requireAuth preHandler)"
    },
    {
      "status": 401,
      "code": "Unauthorized",
      "message": "Invalid or expired token",
      "when": "JWT signature invalid, malformed, or exp has elapsed"
    },
    {
      "status": 400,
      "code": "ValidationError",
      "message": "tenant_id, phone and action are required",
      "when": "required field missing"
    },
    {
      "status": 400,
      "code": "ValidationError",
      "message": "action must be opt_out or opt_in",
      "when": "invalid action"
    }
  ]
}
