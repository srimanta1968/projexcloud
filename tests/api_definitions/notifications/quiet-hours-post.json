{
  "name": "POST /api/notifications/quiet-hours - Upsert per-persona quiet-hours",
  "endpoint": "/api/notifications/quiet-hours",
  "method": "POST",
  "requiresAuth": true,
  "expectedStatus": 200,
  "taskId": "e5cdee5a-51ea-43ba-862a-903dbb683d27",
  "sprintId": "8ef1d09e-dd8e-4daf-8d03-54dcd9f812f8",
  "featureId": "01ca8316-09cf-462d-bf9d-7eeac8745bff",
  "epicId": "d83f7b6e-821c-4fe1-96e6-910eca8fbbfc",
  "priority": 25,
  "testability": "manual",
  "skipReason": "FR-NTF-5 quiet-hours upsert requires tenant-scoped JWT (req.auth.tenant_id). The /api/auth/register flow returns a JWT with tenant_id=null, so this endpoint 403s. Re-enable when test harness can mint a tenant-scoped token, or add a setupScript that seeds a tenant + tenant-scoped login.",
  "dependsOn": ["POST /api/auth/register"],
  "testCases": [
    {
      "name": "Set nightly 22:00-06:00 PT quiet window",
      "headers": { "Authorization": "Bearer {{cache:auth.register.response.data.token}}" },
      "payload": {
        "persona_id": "{{cache:auth.register.response.data.userId}}",
        "windows": [
          { "dow": 0, "start": "22:00", "end": "06:00", "tz": "America/Los_Angeles" },
          { "dow": 1, "start": "22:00", "end": "06:00", "tz": "America/Los_Angeles" }
        ],
        "dnd": false
      },
      "expectedStatus": 200
    }
  ],
  "expectedResponse": {
    "data": { "quiet_hours": { "persona_id": "string", "dnd": "boolean" } }
  }
}
