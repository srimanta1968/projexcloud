{
  "sdk": "sdk-offer-catalog",
  "sourceFile": "packages/sdk-offer-catalog/src/server/routes.ts",
  "requiresAuth": true,
  "taskId": "1a62f247-b638-412d-a317-e9da3dbd6dc4",
  "sprintId": "d4876947-8d18-4538-8e9f-51ba3e0735a9",
  "featureId": "50face32-51ba-4a44-8641-d2d1ee5d96c9",
  "epicId": "9a0f06fa-f1a9-4292-8bc5-715ec836bbc8",
  "testability": "auto",
  "name": "POST /api/offers/:offer_id/versions - Create a version",
  "endpoint": "/api/offers/:offer_id/versions",
  "method": "POST",
  "expectedStatus": 201,
  "priority": 11,
  "description": "Create an immutable offer version (starts in status 'draft'). version is unique per (tenant, offer). tenant_id and version required.",
  "dependsOn": [
    "POST /api/auth/signup-tenant",
    "POST /api/offers"
  ],
  "captureResponse": {
    "offers.version.create.response.data.version.offer_version_id": "data.version.offer_version_id"
  },
  "testCases": [
    {
      "name": "Create a draft version",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "pathParams": {
        "offer_id": "{{cache:offers.create.response.data.offer.offer_id}}"
      },
      "payload": {
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}",
        "version": "v-{{dynamic:uuid}}",
        "title": "Pro v1",
        "price": 49.0,
        "currency": "USD",
        "body": {}
      },
      "expectedStatus": 201,
      "expectedResponse": {
        "data": {
          "version": {
            "offer_version_id": "string",
            "status": "string"
          }
        }
      }
    }
  ],
  "errorCases": [
    {
      "status": 400,
      "code": "ValidationError",
      "message": "tenant_id and version are required",
      "when": "required missing"
    },
    {
      "status": 409,
      "code": "Conflict",
      "message": "this version already exists for the offer",
      "when": "version reused"
    }
  ]
}
