{
  "sdk": "sdk-offer-catalog",
  "sourceFile": "packages/sdk-offer-catalog/src/server/routes.ts",
  "requiresAuth": true,
  "taskId": "d9297510-1f78-447e-9764-b10cc6235a2c",
  "sprintId": "d4876947-8d18-4538-8e9f-51ba3e0735a9",
  "featureId": "7079a34d-8593-4978-944a-7162513d8c91",
  "epicId": "9a0f06fa-f1a9-4292-8bc5-715ec836bbc8",
  "testability": "auto",
  "name": "GET /api/offers/:offer_id/versions/:version_id/features - Read the feature matrix",
  "endpoint": "/api/offers/:offer_id/versions/:version_id/features",
  "method": "GET",
  "expectedStatus": 200,
  "priority": 26,
  "description": "Read a version's feature-status matrix (by sort order then key). Each row is one feature's status within that immutable version. tenant_id query param required.",
  "dependsOn": [
    "POST /api/auth/signup-tenant",
    "POST /api/offers",
    "POST /api/offers/:offer_id/versions",
    "POST /api/offers/:offer_id/versions/:version_id/features"
  ],
  "fieldEnums": {
    "status": [
      "included",
      "excluded",
      "beta",
      "roadmap",
      "add_on",
      "deprecated"
    ]
  },
  "testCases": [
    {
      "name": "List the feature matrix",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "pathParams": {
        "offer_id": "{{cache:offers.create.response.data.offer.offer_id}}",
        "version_id": "{{cache:offers.version.create.response.data.version.offer_version_id}}"
      },
      "queryParams": {
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}"
      },
      "expectedStatus": 200,
      "expectedResponse": {
        "data": {
          "features": "array"
        }
      }
    }
  ],
  "errorCases": [
    {
      "status": 400,
      "code": "ValidationError",
      "message": "tenant_id query param required",
      "when": "tenant_id missing"
    }
  ]
}
