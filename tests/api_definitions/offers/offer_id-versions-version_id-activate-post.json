{
  "sdk": "sdk-offer-catalog",
  "sourceFile": "packages/sdk-offer-catalog/src/server/routes.ts",
  "requiresAuth": true,
  "taskId": "1a62f247-b638-412d-a317-e9da3dbd6dc4",
  "sprintId": "d4876947-8d18-4538-8e9f-51ba3e0735a9",
  "featureId": "50face32-51ba-4a44-8641-d2d1ee5d96c9",
  "epicId": "9a0f06fa-f1a9-4292-8bc5-715ec836bbc8",
  "testability": "auto",
  "name": "POST /api/offers/:offer_id/versions/:version_id/activate - Activate",
  "endpoint": "/api/offers/:offer_id/versions/:version_id/activate",
  "method": "POST",
  "expectedStatus": 200,
  "priority": 12,
  "description": "Activate/publish a version: atomically demote the prior live version for this offer (-> retired) and promote the target (-> live, activated_at now), emitting offer_catalog.version.activated.v1. At most one live version per offer. tenant_id required.",
  "dependsOn": [
    "POST /api/auth/signup-tenant",
    "POST /api/offers",
    "POST /api/offers/:offer_id/versions"
  ],
  "statusTransitions": {
    "entity": "offer_catalog.offer_version",
    "field": "status",
    "flow": [
      "draft",
      "live"
    ],
    "transitions": [
      {
        "from": "draft",
        "to": "live",
        "via": "POST /api/offers/:offer_id/versions/:version_id/activate"
      },
      {
        "from": "live",
        "to": "retired",
        "via": "activation of a newer version (auto-demote)"
      }
    ]
  },
  "testCases": [
    {
      "name": "Activate the draft version",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "pathParams": {
        "offer_id": "{{cache:offers.create.response.data.offer.offer_id}}",
        "version_id": "{{cache:offers.version.create.response.data.version.offer_version_id}}"
      },
      "payload": {
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}"
      },
      "expectedStatus": 200,
      "expectedResponse": {
        "data": {
          "version": {
            "status": "string"
          }
        }
      }
    }
  ],
  "errorCases": [
    {
      "status": 400,
      "code": "ValidationError",
      "message": "tenant_id is required",
      "when": "tenant_id missing"
    },
    {
      "status": 404,
      "code": "NotFound",
      "message": "offer version not found",
      "when": "no version"
    }
  ]
}
