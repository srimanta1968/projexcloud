{
  "sdk": "sdk-offer-catalog",
  "sourceFile": "packages/sdk-offer-catalog/src/server/routes.ts",
  "requiresAuth": true,
  "taskId": "d9297510-1f78-447e-9764-b10cc6235a2c",
  "sprintId": "d4876947-8d18-4538-8e9f-51ba3e0735a9",
  "featureId": "7079a34d-8593-4978-944a-7162513d8c91",
  "epicId": "9a0f06fa-f1a9-4292-8bc5-715ec836bbc8",
  "testability": "auto",
  "name": "POST /api/offers/:offer_id/versions/:version_id/features - Set a feature status",
  "endpoint": "/api/offers/:offer_id/versions/:version_id/features",
  "method": "POST",
  "expectedStatus": 201,
  "priority": 25,
  "description": "Set (upsert) one feature's status within an immutable offer version \u2014 the feature-status matrix cell. Idempotent per (version, feature_key). tenant_id, feature_key and name required; status defaults to 'included'.",
  "dependsOn": [
    "POST /api/auth/signup-tenant",
    "POST /api/offers",
    "POST /api/offers/:offer_id/versions"
  ],
  "fieldEnums": {
    "status": [
      "included",
      "excluded",
      "beta",
      "roadmap",
      "add_on",
      "deprecated"
    ]
  },
  "testCases": [
    {
      "name": "Mark a feature included",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "pathParams": {
        "offer_id": "{{cache:offers.create.response.data.offer.offer_id}}",
        "version_id": "{{cache:offers.version.create.response.data.version.offer_version_id}}"
      },
      "payload": {
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}",
        "feature_key": "api-access",
        "name": "API Access",
        "status": "included",
        "value": "unlimited",
        "sort_order": 1
      },
      "expectedStatus": 201,
      "expectedResponse": {
        "data": {
          "feature": {
            "offer_feature_id": "string",
            "status": "string"
          }
        }
      }
    }
  ],
  "errorCases": [
    {
      "status": 400,
      "code": "ValidationError",
      "message": "tenant_id, feature_key and name are required",
      "when": "required missing"
    },
    {
      "status": 400,
      "code": "ValidationError",
      "message": "status must be one of included, excluded, beta, roadmap, add_on, deprecated",
      "when": "invalid status"
    },
    {
      "status": 404,
      "code": "NotFound",
      "message": "offer version not found",
      "when": "no version"
    }
  ]
}
