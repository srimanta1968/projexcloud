{
  "sdk": "sdk-offer-catalog",
  "sourceFile": "packages/sdk-offer-catalog/src/server/routes.ts",
  "requiresAuth": true,
  "taskId": "6335a8f8-7275-4461-add6-8b386bc5c84f",
  "sprintId": "d4876947-8d18-4538-8e9f-51ba3e0735a9",
  "featureId": "50face32-51ba-4a44-8641-d2d1ee5d96c9",
  "epicId": "9a0f06fa-f1a9-4292-8bc5-715ec836bbc8",
  "testability": "auto",
  "name": "POST /api/offers/:offer_id/versions/:version_id/publish-decision - Record approval decision",
  "endpoint": "/api/offers/:offer_id/versions/:version_id/publish-decision",
  "method": "POST",
  "expectedStatus": 200,
  "priority": 21,
  "description": "Record the sdk-approval decision for a version's publish request: approved (activation now permitted) or rejected (activation stays blocked). tenant_id and decision required.",
  "dependsOn": [
    "POST /api/auth/signup-tenant",
    "POST /api/offers",
    "POST /api/offers/:offer_id/versions",
    "POST /api/offers/:offer_id/versions/:version_id/publish-request"
  ],
  "fieldEnums": {
    "decision": [
      "approved",
      "rejected"
    ]
  },
  "statusTransitions": {
    "entity": "offer_catalog.offer_version",
    "field": "approval_status",
    "flow": [
      "pending",
      "approved"
    ],
    "transitions": [
      {
        "from": "pending",
        "to": "approved",
        "via": "POST .../publish-decision {approved}"
      },
      {
        "from": "pending",
        "to": "rejected",
        "via": "POST .../publish-decision {rejected}"
      }
    ]
  },
  "testCases": [
    {
      "name": "Approve the publish request",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "pathParams": {
        "offer_id": "{{cache:offers.create.response.data.offer.offer_id}}",
        "version_id": "{{cache:offers.version.create.response.data.version.offer_version_id}}"
      },
      "payload": {
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}",
        "decision": "approved"
      },
      "expectedStatus": 200,
      "expectedResponse": {
        "data": {
          "version": {
            "approval_status": "string"
          }
        }
      }
    }
  ],
  "errorCases": [
    {
      "status": 400,
      "code": "ValidationError",
      "message": "tenant_id and decision are required",
      "when": "required missing"
    },
    {
      "status": 400,
      "code": "ValidationError",
      "message": "decision must be approved or rejected",
      "when": "invalid decision"
    },
    {
      "status": 404,
      "code": "NotFound",
      "message": "offer version not found",
      "when": "no version"
    }
  ]
}
