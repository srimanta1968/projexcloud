{
  "name": "POST /api/identity/aliases - MDM alias merge",
  "endpoint": "/api/identity/aliases",
  "sdk": "sdk-identity",
  "method": "POST",
  "requiresAuth": true,
  "expectedStatus": 201,
  "taskId": "0e2928eb-b86b-49ce-ae5f-bac92478e954",
  "sprintId": "8ef1d09e-dd8e-4daf-8d03-54dcd9f812f8",
  "featureId": "7e463119-3ef9-497a-96ca-8453f7a60048",
  "epicId": "00996d23-f667-4a82-9285-7728ba357e7b",
  "priority": 30,
  "testability": "auto",
  "dependsOn": [
    "POST /api/auth/register"
  ],
  "fieldEnums": {
    "kind": [
      "email",
      "phone",
      "gov_id",
      "biometric_template_ref",
      "social_idp_subject",
      "saml_nameid"
    ]
  },
  "testCases": [
    {
      "name": "Attach a phone alias to the registered person",
      "headers": {
        "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
      },
      "payload": {
        "person_id": "{{cache:auth.register.response.data.userId}}",
        "kind": "phone",
        "value": "{{dynamic:phone}}"
      },
      "expectedStatus": 201
    }
  ],
  "captureResponse": {
    "identity.aliases.response.data.alias.alias_id": "data.alias.alias_id",
    "identity.aliases.response.data.alias.person_id": "data.alias.person_id"
  },
  "expectedResponse": {
    "data": {
      "alias": {
        "alias_id": "string",
        "person_id": "string",
        "kind": "string",
        "created_at": "string",
        "merged_into": "string"
      }
    }
  }
}
