{
  "name": "POST /api/geo/merge - Merge two canonical addresses",
  "endpoint": "/api/geo/merge",
  "sdk": "sdk-geo",
  "method": "POST",
  "requiresAuth": true,
  "expectedStatus": 200,
  "taskId": "610809fe-0b1d-44e8-8e63-faa200e605d9",
  "sprintId": "8ef1d09e-dd8e-4daf-8d03-54dcd9f812f8",
  "featureId": "a135ad4d-61af-40c2-ac4d-a5b4f0a6ae55",
  "epicId": "93a549d6-9a93-4d82-86bb-bac5167fa960",
  "priority": 80,
  "testability": "auto",
  "dependsOn": [
    "POST /api/auth/register",
    "POST /api/geo/canonicalize"
  ],
  "testCases": [
    {
      "name": "Merge two addresses",
      "headers": {
        "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
      },
      "payload": {
        "winner_address_id": "{{cache:geo.canonicalize.response.data.address.address_id}}",
        "loser_address_id": "{{var:geo_loser_address_id}}",
        "operator_id": "{{var:operator_id}}"
      },
      "expectedStatus": 200
    }
  ],
  "captureResponse": {
    "geo.merge.response.data.merge.merge_id": "data.merge.merge_id"
  }
}
