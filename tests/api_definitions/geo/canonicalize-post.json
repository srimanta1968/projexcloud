{
  "name": "POST /api/geo/canonicalize - Canonicalize an address (AC-4)",
  "endpoint": "/api/geo/canonicalize",
  "sdk": "sdk-geo",
  "method": "POST",
  "requiresAuth": true,
  "expectedStatus": 200,
  "taskId": "610809fe-0b1d-44e8-8e63-faa200e605d9",
  "sprintId": "8ef1d09e-dd8e-4daf-8d03-54dcd9f812f8",
  "featureId": "a135ad4d-61af-40c2-ac4d-a5b4f0a6ae55",
  "epicId": "93a549d6-9a93-4d82-86bb-bac5167fa960",
  "priority": 30,
  "dependsOn": [
    "POST /api/auth/register",
    "POST /api/geo-nodes"
  ],
  "testCases": [
    {
      "name": "Canonicalize a US address",
      "headers": {
        "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
      },
      "payload": {
        "raw_input": "123 Main St, Cityville, US",
        "street": "123 Main St",
        "city": "Cityville",
        "region": "CA",
        "postal_code": "94110",
        "country": "US",
        "lat": 37.7749,
        "lng": -122.4194,
        "geo_node_id": "{{cache:geo-nodes.create.response.data.geo_node.geo_node_id}}",
        "provider_refs": { "mapbox": "poi.a1b2c3" }
      },
      "expectedStatus": 200
    }
  ],
  "captureResponse": {
    "geo.canonicalize.response.data.address.address_id": "data.address.address_id"
  }
}
