{
  "name": "GET /api/handoffs - List tenant handoffs",
  "endpoint": "/api/handoffs",
  "sdk": "sdk-handoff",
  "sourceFile": "packages/sdk-handoff/src/server/routes.ts",
  "method": "GET",
  "requiresAuth": true,
  "expectedStatus": 200,
  "taskId": "d2404591-7116-4f3e-94bf-d6490a5947a9",
  "sprintId": "d4876947-8d18-4538-8e9f-51ba3e0735a9",
  "priority": 42,
  "testability": "auto",
  "description": "List handoffs for a tenant, most-recently-updated first. Tenant-scoped via the required tenant_id query param; optionally filtered by status and/or deal_id, with limit/offset paging (defaults 50/0).",
  "dependsOn": [
    "POST /api/auth/signup-tenant"
  ],
  "fieldEnums": {
    "status": ["draft", "pending", "accepted", "rejected", "completed", "cancelled"]
  },
  "testCases": [
    {
      "name": "List handoffs for the signup tenant",
      "headers": { "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}" },
      "queryParams": { "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}" },
      "expectedStatus": 200,
      "expectedResponse": { "data": { "handoffs": [] } }
    }
  ],
  "errorCases": [
    { "status": 400, "code": "ValidationError", "message": "tenant_id query param required", "when": "tenant_id query param missing" }
  ]
}
