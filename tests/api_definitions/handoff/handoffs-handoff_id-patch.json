{
  "name": "PATCH /api/handoffs/:handoff_id - Update editable handoff fields",
  "endpoint": "/api/handoffs/:handoff_id",
  "sdk": "sdk-handoff",
  "sourceFile": "packages/sdk-handoff/src/server/routes.ts",
  "method": "PATCH",
  "requiresAuth": true,
  "expectedStatus": 200,
  "taskId": "d2404591-7116-4f3e-94bf-d6490a5947a9",
  "sprintId": "d4876947-8d18-4538-8e9f-51ba3e0735a9",
  "priority": 45,
  "testability": "auto",
  "description": "Update editable fields (cs_owner/backup personas, kickoff_ref, prework/promises/risks/integrations/milestones, workflow_run_id, approval_id, metadata) while the handoff is still draft or pending. tenant_id is required. Emits handoff.updated.v1. Returns 409 NotEditable once the handoff is accepted/rejected/completed/cancelled, 404 if not found.",
  "dependsOn": [
    "POST /api/auth/signup-tenant",
    "POST /api/handoffs"
  ],
  "testCases": [
    {
      "name": "Enrich the draft handoff (owner + milestones)",
      "headers": { "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}" },
      "pathParams": { "handoff_id": "{{cache:handoff.handoffs.create.response.data.handoff.handoff_id}}" },
      "payload": {
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}",
        "cs_owner_persona_id": "{{cache:auth.signup-tenant.response.data.userId}}",
        "milestones": [{ "name": "Kickoff", "due": "2026-08-01" }],
        "metadata": { "priority": "high" }
      },
      "expectedStatus": 200,
      "expectedResponse": { "data": { "handoff": { "handoff_id": "string", "status": "string" } } }
    }
  ],
  "errorCases": [
    { "status": 400, "code": "ValidationError", "message": "tenant_id is required", "when": "tenant_id missing from body" },
    { "status": 404, "code": "NotFound", "message": "NotFound", "when": "handoff_id not found for the tenant" },
    { "status": 409, "code": "NotEditable", "message": "handoff in status '<status>' is no longer editable", "when": "the handoff is already accepted/rejected/completed/cancelled" }
  ]
}
