{
  "name": "POST /api/connectors/installs/:install_id/sync — sdk-connectors",
  "endpoint": "/api/connectors/installs/:install_id/sync",
  "method": "POST",
  "requiresAuth": true,
  "dependsOn": [
    "POST /api/auth/signup-tenant",
    "POST /api/connectors/installs"
  ],
  "expectedStatus": 200,
  "sdk": "sdk-connectors",
  "sourceFile": "packages/sdk-connectors/src/server/routes.ts",
  "testability": "auto",
  "testCases": [
    {
      "name": "Sync a connector install (slack stub returns 0 records when unconfigured)",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "pathParams": {
        "install_id": "{{cache:connectors.create.response.data.install.install_id}}"
      },
      "payload": {},
      "expectedStatus": 200
    }
  ],
  "captureResponse": {
    "connectors.sync.response.data.records_synced": "data.records_synced",
    "connectors.sync.response.data.conflicts": "data.conflicts"
  }
}
