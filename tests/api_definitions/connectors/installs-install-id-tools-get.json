{
  "name": "GET /api/connectors/installs/:install_id/tools — sdk-connectors",
  "endpoint": "/api/connectors/installs/:install_id/tools",
  "method": "GET",
  "requiresAuth": true,
  "dependsOn": [
    "POST /api/auth/signup-tenant",
    "POST /api/connectors/installs"
  ],
  "expectedStatus": 200,
  "sdk": "sdk-connectors",
  "sourceFile": "packages/sdk-connectors/src/server/routes.ts",
  "testability": "auto",
  "testCases": [
    {
      "name": "List tool manifest for an install",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "pathParams": {
        "install_id": "{{cache:connectors.create.response.data.install.install_id}}"
      },
      "expectedStatus": 200
    }
  ]
}
