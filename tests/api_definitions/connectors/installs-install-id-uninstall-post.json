{
  "name": "POST /api/connectors/installs/:install_id/uninstall — sdk-connectors",
  "endpoint": "/api/connectors/installs/:install_id/uninstall",
  "method": "POST",
  "requiresAuth": true,
  "dependsOn": [
    "POST /api/auth/register",
    "POST /api/connectors/installs"
  ],
  "expectedStatus": 200,
  "sdk": "sdk-connectors",
  "sourceFile": "packages/sdk-connectors/src/server/routes.ts",
  "_generated": true,
  "testability": "manual",
  "skipReason": "install_id FK comes from POST /api/connectors/installs which is itself manual (OAuth vendor creds). Body actor_id is optional (defaults to 'unknown').",
  "testCases": [
    {
      "name": "Uninstall a connector install",
      "headers": {
        "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
      },
      "pathParams": {
        "install_id": "{{cache:connectors.installs.create.response.data.install.install_id}}"
      },
      "payload": {
        "actor_id": "{{cache:auth.register.response.data.userId}}"
      },
      "expectedStatus": 200
    }
  ]
}
