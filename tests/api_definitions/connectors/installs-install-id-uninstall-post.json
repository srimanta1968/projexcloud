{
  "name": "POST /api/connectors/installs/:install_id/uninstall — sdk-connectors",
  "endpoint": "/api/connectors/installs/:install_id/uninstall",
  "method": "POST",
  "requiresAuth": true,
  "dependsOn": [
    "POST /api/auth/signup-tenant",
    "POST /api/connectors/installs"
  ],
  "expectedStatus": 200,
  "sdk": "sdk-connectors",
  "sourceFile": "packages/sdk-connectors/src/server/routes.ts",
  "testability": "auto",
  "statusTransitions": {
    "entity": "connectors.install",
    "field": "status",
    "flow": [
      "pending",
      "active",
      "paused",
      "uninstalled"
    ],
    "transitions": [
      {
        "from": "active",
        "to": "uninstalled",
        "via": "POST /api/connectors/installs/:install_id/uninstall"
      }
    ]
  },
  "testCases": [
    {
      "name": "Uninstall a connector install",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "pathParams": {
        "install_id": "{{cache:connectors.create.response.data.install.install_id}}"
      },
      "payload": {
        "actor_id": "{{cache:auth.signup-tenant.response.data.userId}}"
      },
      "expectedStatus": 200
    }
  ],
  "captureResponse": {
    "connectors.uninstall.response.data.install.install_id": "data.install.install_id",
    "connectors.uninstall.response.data.install.status": "data.install.status"
  }
}
