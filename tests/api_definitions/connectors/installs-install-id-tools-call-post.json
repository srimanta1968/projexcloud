{
  "name": "POST /api/connectors/installs/:install_id/tools/call — sdk-connectors",
  "endpoint": "/api/connectors/installs/:install_id/tools/call",
  "method": "POST",
  "requiresAuth": true,
  "dependsOn": [
    "POST /api/auth/signup-tenant",
    "POST /api/connectors/installs"
  ],
  "expectedStatus": 200,
  "sdk": "sdk-connectors",
  "sourceFile": "packages/sdk-connectors/src/server/routes.ts",
  "testability": "auto",
  "fieldEnums": {
    "tool_name": [
      "slack.message.post",
      "slack.channel.list",
      "slack.user.lookup",
      "slack.thread.reply"
    ]
  },
  "testCases": [
    {
      "name": "Invoke a connector tool by name (slack stub returns NotConfigured payload with 200)",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "pathParams": {
        "install_id": "{{cache:connectors.create.response.data.install.install_id}}"
      },
      "payload": {
        "tool_name": "slack.message.post",
        "args": {
          "channel": "C0DEMO",
          "text": "Hello from ProjexCloud"
        }
      },
      "expectedStatus": 200
    }
  ],
  "captureResponse": {
    "connectors.tools-call.response.data.result.ok": "data.result.ok"
  }
}
