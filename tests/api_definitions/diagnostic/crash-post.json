{
  "name": "POST /api/diagnostic/crash — sdk-diagnostic-telemetry",
  "endpoint": "/api/diagnostic/crash",
  "method": "POST",
  "requiresAuth": true,
  "expectedStatus": 201,
  "sdk": "sdk-diagnostic-telemetry",
  "sourceFile": "packages/sdk-diagnostic-telemetry/src/server/index.ts",
  "_generated": true,
  "testability": "auto",
  "priority": 40,
  "dependsOn": [
    "POST /api/auth/register",
    "POST /api/auth/signup-tenant",
    "POST /api/devices",
    "POST /scim/v2/Users"
  ],
  "testCases": [
    {
      "name": "Record a crash snapshot for a registered device",
      "payload": {
        "device_uuid": "{{cache:devices.create.response.data.device.device_uuid}}",
        "person_id": "{{cache:scim.create.response.data.person_id}}",
        "app_version": "1.2.3",
        "os_version": "17.0",
        "stack_envelope": "eyJzdGFjayI6IFtdfQ==",
        "occurred_at": "{{dynamic:pastdatetime}}",
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}"
      },
      "expectedStatus": 201,
      "expectedResponse": {
        "success": true
      },
      "headers": {
        "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
      }
    }
  ],
  "captureResponse": {
    "diagnostic.crash.response.data.crash_id": "data.crash_id",
    "diagnostic.crash.response.data.device_uuid": "data.device_uuid"
  }
}
