{
 "name": "POST /api/diagnostic/health — sdk-diagnostic-telemetry",
 "endpoint": "/api/diagnostic/health",
 "method": "POST",
 "requiresAuth": false,
 "expectedStatus": 201,
 "sdk": "sdk-diagnostic-telemetry",
 "sourceFile": "packages/sdk-diagnostic-telemetry/src/server/index.ts",
 "_generated": true,
 "testability": "auto",
 "priority": 40,
 "dependsOn": [
  "POST /api/auth/register",
  "POST /api/auth/signup-tenant",
  "POST /api/devices"
 ],
 "testCases": [
  {
   "name": "Record a health snapshot for a registered device",
   "payload": {
    "device_uuid": "{{cache:devices.create.response.data.device.device_uuid}}",
    "permissions": {
     "camera": true,
     "location": false
    },
    "battery_pct": 85,
    "wifi_state": "connected",
    "sensor_state": {
     "accelerometer": "ok"
    },
    "captured_at": "{{dynamic:pastdatetime}}",
    "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}"
   },
   "expectedStatus": 201,
   "expectedResponse": {
    "success": true
   }
  }
 ],
 "captureResponse": {
  "diagnostic.health.response.data.snapshot_id": "data.snapshot_id",
  "diagnostic.health.response.data.device_uuid": "data.device_uuid"
 }
}
