{
  "name": "GET /admin/active-active/profiles/:tenant_id — api-gateway",
  "endpoint": "/admin/active-active/profiles/:tenant_id",
  "method": "GET",
  "requiresAuth": false,
  "expectedStatus": 200,
  "sdk": "api-gateway",
  "sourceFile": "services/api-gateway/src/app.ts",
  "testability": "auto",
  "dependsOn": [
    "POST /api/auth/signup-tenant",
    "POST /admin/active-active/profiles"
  ],
  "testCases": [
    {
      "name": "Fetch a tenant's active-active profile + replication streams",
      "headers": {
        "x-admin-ops-token": "${ADMIN_OPS_TOKEN}"
      },
      "pathParams": {
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}"
      },
      "expectedStatus": 200
    }
  ],
  "expectedResponse": {
    "data": {
      "profile": {
        "profile_id": "string",
        "tenant_id": "string",
        "tier": "string",
        "home_region": "string",
        "paired_regions": "array"
      },
      "replication_streams": "array"
    }
  }
}
