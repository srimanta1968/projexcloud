{
  "name": "POST /admin/meter/pricing-catalogs \u2014 api-gateway",
  "endpoint": "/admin/meter/pricing-catalogs",
  "method": "POST",
  "requiresAuth": false,
  "expectedStatus": 200,
  "sdk": "api-gateway",
  "sourceFile": "services/api-gateway/src/app.ts",
  "_generated": true,
  "testability": "auto",
  "dependsOn": [
    "POST /api/auth/signup-tenant"
  ],
  "captureResponse": {
    "meter-pricing-catalogs.create.response.data.catalog_id": "catalog_id",
    "meter-pricing-catalogs.create.response.data.version": "version"
  },
  "testCases": [
    {
      "name": "Create a new draft pricing-catalog version",
      "headers": {
        "x-admin-ops-token": "{{var:ADMIN_OPS_TOKEN}}"
      },
      "payload": {
        "catalog_id": "qa-pricing-catalog-{{dynamic:slug}}",
        "version": 1,
        "operator_id": "{{var:operator_id}}"
      },
      "expectedStatus": 200
    }
  ]
}