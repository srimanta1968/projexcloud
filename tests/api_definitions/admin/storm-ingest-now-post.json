{
  "name": "POST /admin/storm/ingest-now — api-gateway",
  "endpoint": "/admin/storm/ingest-now",
  "method": "POST",
  "requiresAuth": false,
  "expectedStatus": 200,
  "sdk": "api-gateway",
  "sourceFile": "services/api-gateway/src/app.ts",
  "testability": "auto",
  "testCases": [
    {
      "name": "Trigger a one-shot storm ingest over a trailing window",
      "headers": {
        "x-admin-ops-token": "{{var:ADMIN_OPS_TOKEN}}"
      },
      "payload": {
        "lookback_hours": 1
      },
      "expectedStatus": 200
    }
  ],
  "expectedResponse": {
    "success": "boolean",
    "data": {
      "events_from": "string",
      "events_ingested": "number",
      "cells_ingested": "number",
      "providers_tried": "array"
    }
  },
  "captureResponse": {
    "storm-ingest.run.response.data.events_ingested": "data.events_ingested"
  }
}
