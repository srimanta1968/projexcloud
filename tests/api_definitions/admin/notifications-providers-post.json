  "skipReason": "Gated by the ADMIN_OPS_TOKEN (x-admin-ops-token header). Sets the platform-default email provider with a real credential; verify live with the ops token.",
  "testCases": [
    {
      "name": "Set platform-default SMTP email provider",
      "headers": {
        "content-type": "application/json",
        "x-admin-ops-token": "{{static:ADMIN_OPS_TOKEN}}"
      },
      "payload": {
        "kind": "smtp",
        "from_address": "welcome@projexlight.com",
        "config": { "host": "smtp.zoho.com", "port": 465, "secure": true, "user": "welcome@projexlight.com" },
        "credential": "{{static:REPLACE_WITH_SMTP_PASSWORD}}"
      },
      "expectedStatus": 201
    }
  ]
}
