{
  "name": "POST /admin/sovereign/regions — api-gateway",
  "endpoint": "/admin/sovereign/regions",
  "method": "POST",
  "requiresAuth": false,
  "expectedStatus": 200,
  "sdk": "api-gateway",
  "sourceFile": "services/api-gateway/src/app.ts",
  "_generated": true,
  "testability": "auto",
  "fieldEnums": {
    "regime": ["fedramp-high", "il5", "pipl", "eu-sovereign", "uae-trd"]
  },
  "captureResponse": {
    "sovereign.register.response.data.region_id": "data.region_id",
    "sovereign.register.response.data.regime": "data.regime",
    "sovereign.register.response.data.attestation_state": "data.attestation_state"
  },
  "testCases": [
    {
      "name": "Register a sovereign region config (natural-key region_id)",
      "payload": {
        "region_id": "reg-eu-sov-fra",
        "regime": "eu-sovereign",
        "operator_partner": "T-Systems Sovereign Cloud",
        "terminal_federation": true,
        "kms_provider": "aws-cloudhsm-eu-central-1",
        "operator_id": "{{var:operator_id}}"
      },
      "expectedStatus": 200,
      "headers": {
        "x-admin-ops-token": "${ADMIN_OPS_TOKEN}"
      }
    }
  ]
}
