{
  "name": "POST /admin/onprem/installs/:install_id/billing-reports — api-gateway",
  "endpoint": "/admin/onprem/installs/:install_id/billing-reports",
  "method": "POST",
  "requiresAuth": false,
  "expectedStatus": 201,
  "sdk": "api-gateway",
  "sourceFile": "services/api-gateway/src/app.ts",
  "_generated": true,
  "testability": "auto",
  "captureResponse": {
    "onprem.billing-report.response.data.report_id": "data.report_id"
  },
  "dependsOn": ["POST /admin/onprem/installs"],
  "testCases": [
    {
      "name": "Generate an internal-only billing report for a period",
      "pathParams": {
        "install_id": "{{cache:onprem.register-install.response.data.install_id}}"
      },
      "payload": {
        "period_start": "2026-04-01",
        "period_end": "2026-06-30",
        "artifact_local_path": "/var/onprem/reports/2026-q2.pdf"
      },
      "expectedStatus": 201,
      "headers": {
        "x-admin-ops-token": "{{var:ADMIN_OPS_TOKEN}}"
      }
    }
  ]
}
