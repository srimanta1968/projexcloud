{
  "name": "POST /admin/sovereign/regions/:region_id/leaks — api-gateway",
  "endpoint": "/admin/sovereign/regions/:region_id/leaks",
  "method": "POST",
  "requiresAuth": false,
  "expectedStatus": 201,
  "sdk": "api-gateway",
  "sourceFile": "services/api-gateway/src/app.ts",
  "_generated": true,
  "testability": "auto",
  "fieldEnums": {
    "kind": ["egress-attempt", "cross-region-route", "policy-violation"],
    "severity": ["info", "warn", "critical"]
  },
  "captureResponse": {
    "sovereign.leak-alert.response.data.alert_id": "data.alert_id"
  },
  "dependsOn": ["POST /admin/sovereign/regions"],
  "testCases": [
    {
      "name": "Ingest a leak-monitor alert for a sovereign region",
      "pathParams": {
        "region_id": "{{cache:sovereign.register.response.data.region_id}}"
      },
      "payload": {
        "kind": "egress-attempt",
        "severity": "critical",
        "incident_ref": "INC-2026-0714-eu-sov-fra"
      },
      "expectedStatus": 201,
      "headers": {
        "x-admin-ops-token": "${ADMIN_OPS_TOKEN}"
      }
    }
  ]
}
