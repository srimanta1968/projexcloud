{
  "name": "POST /admin/onprem/installs/:install_id/bundles — api-gateway",
  "endpoint": "/admin/onprem/installs/:install_id/bundles",
  "method": "POST",
  "requiresAuth": false,
  "expectedStatus": 201,
  "sdk": "api-gateway",
  "sourceFile": "services/api-gateway/src/app.ts",
  "_generated": true,
  "testability": "auto",
  "captureResponse": {
    "onprem.apply-bundle.response.data.apply_id": "data.apply_id"
  },
  "dependsOn": ["POST /admin/onprem/installs"],
  "testCases": [
    {
      "name": "Record a quarterly signed-bundle apply on an on-prem install",
      "pathParams": {
        "install_id": "{{cache:onprem.register-install.response.data.install_id}}"
      },
      "payload": {
        "bundle_version": "2026.3.0",
        "signature_verified": true,
        "migrations_applied": [
          { "sdk": "sdk-identity", "filename": "001_init_identity.sql" },
          { "sdk": "sdk-onprem", "filename": "001_init_onprem.sql" }
        ]
      },
      "expectedStatus": 201,
      "headers": {
        "x-admin-ops-token": "${ADMIN_OPS_TOKEN}"
      }
    }
  ]
}
