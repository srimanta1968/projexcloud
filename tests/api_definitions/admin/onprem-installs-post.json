{
  "name": "POST /admin/onprem/installs — api-gateway",
  "endpoint": "/admin/onprem/installs",
  "method": "POST",
  "requiresAuth": false,
  "expectedStatus": 201,
  "sdk": "api-gateway",
  "sourceFile": "services/api-gateway/src/app.ts",
  "_generated": true,
  "testability": "auto",
  "fieldEnums": {
    "k8s_distribution": ["vanilla", "openshift", "rancher", "tanzu"],
    "air_gap_mode": ["strict", "diode-in", "diode-bidi"],
    "billing_mode": ["internal-report-only", "flat-fee", "per-incident"]
  },
  "captureResponse": {
    "onprem.register-install.response.data.install_id": "data.install_id",
    "onprem.register-install.response.data.customer_id": "data.customer_id"
  },
  "testCases": [
    {
      "name": "Register an on-prem install (air-gapped cluster)",
      "payload": {
        "customer_id": "{{var:customer_id}}",
        "cluster_name": "{{dynamic:name}}",
        "k8s_distribution": "openshift",
        "installed_version": "2026.3.0",
        "air_gap_mode": "diode-in",
        "billing_mode": "internal-report-only"
      },
      "expectedStatus": 201,
      "headers": {
        "x-admin-ops-token": "{{var:ADMIN_OPS_TOKEN}}"
      }
    }
  ]
}
