{
  "name": "POST /admin/federation/chaos-drill — api-gateway",
  "endpoint": "/admin/federation/chaos-drill",
  "method": "POST",
  "requiresAuth": false,
  "expectedStatus": 200,
  "sdk": "api-gateway",
  "sourceFile": "services/api-gateway/src/app.ts",
  "_generated": true,
  "testability": "auto",
  "captureResponse": {
    "federation-chaos-drill.run.response.data.event_id": "event_id",
    "federation-chaos-drill.run.response.data.occurred_at": "occurred_at"
  },
  "testCases": [
    {
      "name": "Run a chaos-drill failover for a federation",
      "headers": {
        "x-admin-ops-token": "${ADMIN_OPS_TOKEN}"
      },
      "payload": {
        "federation_id": "{{var:federation_id}}",
        "from_region": "us-east-1",
        "to_region": "us-west-2"
      },
      "expectedStatus": 200
    }
  ]
}
