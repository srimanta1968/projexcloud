{
  "name": "PATCH /admin/pools/:pool_index/status — api-gateway",
  "endpoint": "/admin/pools/:pool_index/status",
  "method": "PATCH",
  "requiresAuth": false,
  "expectedStatus": 200,
  "sdk": "api-gateway",
  "sourceFile": "services/api-gateway/src/app.ts",
  "_generated": true,
  "testability": "auto",
  "fieldEnums": {
    "to_status": ["ACTIVE", "MIGRATING", "DRAINING", "MAINTENANCE", "RETIRED", "QUARANTINE"]
  },
  "statusTransitions": {
    "entity": "pool",
    "field": "status",
    "flow": ["ACTIVE", "MAINTENANCE", "DRAINING", "RETIRED"],
    "transitions": [
      { "from": "ACTIVE", "to": "MAINTENANCE", "via": "PATCH /admin/pools/:pool_index/status" },
      { "from": "MAINTENANCE", "to": "ACTIVE", "via": "PATCH /admin/pools/:pool_index/status" },
      { "from": "ACTIVE", "to": "DRAINING", "via": "PATCH /admin/pools/:pool_index/status" },
      { "from": "DRAINING", "to": "RETIRED", "via": "PATCH /admin/pools/:pool_index/status" }
    ]
  },
  "testCases": [
    {
      "name": "Transition a pool into MAINTENANCE",
      "headers": {
        "x-admin-ops-token": "${ADMIN_OPS_TOKEN}"
      },
      "pathParams": {
        "pool_index": "{{var:pool_index}}"
      },
      "payload": {
        "to_status": "MAINTENANCE",
        "reason": "Scheduled maintenance window for QA",
        "operator_id": "{{var:operator_id}}"
      },
      "expectedStatus": 200
    }
  ]
}
