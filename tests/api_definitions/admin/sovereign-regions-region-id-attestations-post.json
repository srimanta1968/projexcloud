{
  "name": "POST /admin/sovereign/regions/:region_id/attestations — api-gateway",
  "endpoint": "/admin/sovereign/regions/:region_id/attestations",
  "method": "POST",
  "requiresAuth": false,
  "expectedStatus": 201,
  "sdk": "api-gateway",
  "sourceFile": "services/api-gateway/src/app.ts",
  "_generated": true,
  "testability": "auto",
  "fieldEnums": {
    "regime": ["fedramp-high", "il5", "pipl", "eu-sovereign", "uae-trd"]
  },
  "statusTransitions": {
    "entity": "sovereign.region_config",
    "field": "attestation_state",
    "flow": ["in-progress", "attested", "expired"],
    "transitions": [
      { "from": "in-progress", "to": "attested", "via": "POST /admin/sovereign/regions/:region_id/attestations" }
    ]
  },
  "captureResponse": {
    "sovereign.attest.response.data.attestation_id": "data.attestation_id"
  },
  "dependsOn": ["POST /admin/sovereign/regions"],
  "testCases": [
    {
      "name": "Record a regime attestation for a sovereign region",
      "pathParams": {
        "region_id": "{{cache:sovereign.register.response.data.region_id}}"
      },
      "payload": {
        "regime": "eu-sovereign",
        "auditor_id": "{{var:auditor_id}}",
        "issued_at": "{{dynamic:pastdatetime}}",
        "expires_at": "{{dynamic:futuredatetime}}",
        "artifact_ref": "s3://sovereign-attestations/eu-sov-fra-2026Q3.pdf"
      },
      "expectedStatus": 201,
      "headers": {
        "x-admin-ops-token": "{{var:ADMIN_OPS_TOKEN}}"
      }
    }
  ]
}
