{
  "name": "POST /admin/federation/iceberg-bindings — api-gateway",
  "endpoint": "/admin/federation/iceberg-bindings",
  "method": "POST",
  "requiresAuth": false,
  "expectedStatus": 201,
  "sdk": "api-gateway",
  "sourceFile": "services/api-gateway/src/app.ts",
  "_generated": true,
  "testability": "auto",
  "dependsOn": ["POST /admin/federation/iceberg-catalogs"],
  "captureResponse": {
    "federation-iceberg-bindings.create.response.data.binding_id": "binding_id"
  },
  "testCases": [
    {
      "name": "Bind an Iceberg table to a ClickHouse source",
      "headers": {
        "x-admin-ops-token": "{{var:ADMIN_OPS_TOKEN}}"
      },
      "payload": {
        "binding_id": "qa-iceberg-binding-1",
        "catalog_id": "{{cache:federation-iceberg-catalogs.create.response.data.catalog_id}}",
        "table_ref": "warehouse.usage_events",
        "source_clickhouse_table": "meter.usage_ledger",
        "partition_strategy": { "region": "identity", "tenant": "identity", "time": "day" },
        "z_order_cols": ["tenant_id", "sku"]
      },
      "expectedStatus": 201
    }
  ]
}
