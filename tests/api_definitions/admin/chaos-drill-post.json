{
  "name": "POST /admin/chaos-drill — pool-federation-runtime",
  "endpoint": "/admin/chaos-drill",
  "method": "POST",
  "requiresAuth": false,
  "expectedStatus": 201,
  "sdk": "pool-federation-runtime",
  "sourceFile": "services/pool-federation-runtime/src/app.ts",
  "testability": "auto",
  "fieldEnums": {
    "from_region": ["us-east-1", "us-west-2", "eu-west-1", "ap-south-1"],
    "to_region": ["us-east-1", "us-west-2", "eu-west-1", "ap-south-1"]
  },
  "testCases": [
    {
      "name": "Run an operator chaos-drill failover between regions",
      "headers": {
        "x-admin-ops-token": "{{var:ADMIN_OPS_TOKEN}}"
      },
      "payload": {
        "federation_id": "{{var:federation_id}}",
        "from_region": "us-east-1",
        "to_region": "us-west-2"
      },
      "expectedStatus": 201
    }
  ],
  "expectedResponse": {
    "event_id": "string",
    "federation_id": "string",
    "from_region": "string",
    "to_region": "string",
    "trigger": "string",
    "rpo_observed": "number",
    "rto_observed": "number"
  },
  "captureResponse": {
    "chaos-drill.run.response.event_id": "event_id"
  }
}
