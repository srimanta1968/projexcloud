{
  "name": "PUT /admin/meter/pricing-catalogs/:catalog_id/rates/:sku — api-gateway",
  "endpoint": "/admin/meter/pricing-catalogs/:catalog_id/rates/:sku",
  "method": "PUT",
  "requiresAuth": false,
  "expectedStatus": 200,
  "sdk": "api-gateway",
  "sourceFile": "services/api-gateway/src/app.ts",
  "_generated": true,
  "testability": "auto",
  "dependsOn": ["POST /admin/meter/pricing-catalogs"],
  "fieldEnums": {
    "mode": [
      "flat_per_call",
      "tiered_per_call",
      "passthrough_plus_margin",
      "per_unit",
      "bundled_subscription",
      "free_internal"
    ]
  },
  "captureResponse": {
    "meter-pricing-rates.upsert.response.data.rate_id": "rate_id"
  },
  "testCases": [
    {
      "name": "Upsert a rate row for a SKU on a catalog",
      "headers": {
        "x-admin-ops-token": "${ADMIN_OPS_TOKEN}"
      },
      "pathParams": {
        "catalog_id": "{{cache:meter-pricing-catalogs.create.response.data.catalog_id}}",
        "sku": "ai.gateway.tokens.input"
      },
      "payload": {
        "unit": "token",
        "mode": "per_unit",
        "price": 0.0025,
        "margin_pct": 15.0,
        "tiers": [
          { "up_to": 100000, "unit_price": 0.0025 },
          { "up_to": null, "unit_price": 0.002 }
        ],
        "operator_id": "{{var:operator_id}}"
      },
      "expectedStatus": 200
    }
  ]
}
