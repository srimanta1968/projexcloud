{
  "name": "POST /api/admin/voice-agent/eval-runs/:eval_run_id/finish - Record an evaluation run's pass/fail, score and results",
  "endpoint": "/api/admin/voice-agent/eval-runs/:eval_run_id/finish",
  "method": "POST",
  "sdk": "sdk-voice-agent",
  "sourceFile": "services/api-gateway/src/app.ts",
  "requiresAuth": false,
  "expectedStatus": 409,
  "taskId": "abacde8b-7ba1-4c0c-ac4d-f9972f2f51b3",
  "sprintId": "d4876947-8d18-4538-8e9f-51ba3e0735a9",
  "featureId": "c1171be1-c7ce-4c6d-acbc-98ffe825bc53",
  "epicId": "c32d0251-37f1-40d1-88b1-e4004028bfa5",
  "testability": "auto",
  "coversCriterion": [
    "c1171be1-c7ce-4c6d-acbc-98ffe825bc53#AC1"
  ],
  "dependsOn": [
    "POST /api/auth/signup-tenant",
    "POST /api/ai-gateway/tenant-credentials",
    "POST /api/voice-agent/stack-profiles",
    "POST /api/voice-agent/agents",
    "POST /api/voice-agent/agents/:agent_id/versions",
    "POST /api/voice-agent/agents/:agent_id/versions/:version_id/eval-runs/start"
  ],
  "priority": 157,
  "description": "OPERATOR route (x-admin-ops-token = ADMIN_OPS_TOKEN) — the voice runtime's evaluation-run job API, not for apps. Records the outcome of a claimed run and releases it: status completed (passed, score 0-1, metrics, per-scenario results) or error (no verdict, error text) — the run records pass or fail (c1171be1-c7ce-4c6d-acbc-98ffe825bc53#AC1); emits voice.eval_run.completed.v1. Only a completed non-sandbox run can unlock publish. 200 { eval_run }. Errors: bad body 400; unknown run 404; the worker does not hold the run 409; missing ops token 401. The API runner holds no claimed run, so it reaches 409.",
  "testCases": [
    {
      "name": "A worker that did not claim the run cannot finish it -> 409",
      "coversCriterion": [
        "c1171be1-c7ce-4c6d-acbc-98ffe825bc53#AC1"
      ],
      "coversErrorCase": "409|Conflict",
      "headers": {
        "x-admin-ops-token": "{{var:ADMIN_OPS_TOKEN}}"
      },
      "pathParams": {
        "eval_run_id": "{{cache:voice-agent.agents.versions.eval-runs.start.response.data.eval_run.eval_run_id}}"
      },
      "payload": {
        "worker": "{{static:not-the-claimer}}",
        "status": "completed",
        "passed": true,
        "score": 1
      },
      "expectedStatus": 409
    },
    {
      "name": "404 - unknown run",
      "testType": "negative",
      "coversErrorCase": "404|NotFound",
      "headers": {
        "x-admin-ops-token": "{{var:ADMIN_OPS_TOKEN}}"
      },
      "pathParams": {
        "eval_run_id": "{{dynamic:uuid}}"
      },
      "payload": {
        "worker": "{{static:w}}",
        "status": "completed",
        "passed": true
      },
      "expectedStatus": 404
    },
    {
      "name": "401 - no ops token",
      "testType": "negative",
      "coversErrorCase": "401|Unauthorized",
      "headers": {},
      "pathParams": {
        "eval_run_id": "{{cache:voice-agent.agents.versions.eval-runs.start.response.data.eval_run.eval_run_id}}"
      },
      "payload": {
        "worker": "{{static:w}}"
      },
      "expectedStatus": 401
    }
  ],
  "errorCases": [
    {
      "status": 400,
      "code": "ValidationError",
      "message": "passed (boolean) is required for a completed run",
      "when": "bad body"
    },
    {
      "status": 404,
      "code": "NotFound",
      "message": "evaluation run not found",
      "when": "unknown run"
    },
    {
      "status": 409,
      "code": "Conflict",
      "message": "this worker does not hold the evaluation run",
      "when": "not claimed by this worker"
    },
    {
      "status": 401,
      "code": "Unauthorized",
      "message": "admin token required",
      "when": "missing ops token"
    }
  ]
}
