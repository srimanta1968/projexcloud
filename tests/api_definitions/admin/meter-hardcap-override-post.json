{
  "name": "POST /admin/meter/hardcap/override — api-gateway",
  "endpoint": "/admin/meter/hardcap/override",
  "method": "POST",
  "requiresAuth": false,
  "expectedStatus": 200,
  "sdk": "api-gateway",
  "sourceFile": "services/api-gateway/src/app.ts",
  "_generated": true,
  "testability": "auto",
  "dependsOn": ["POST /api/auth/signup-tenant"],
  "captureResponse": {
    "meter-hardcap-override.apply.response.data.updated_rows": "updated_rows",
    "meter-hardcap-override.apply.response.data.until": "until"
  },
  "testCases": [
    {
      "name": "Apply an operator override lifting a denied hard cap",
      "headers": {
        "x-admin-ops-token": "{{var:ADMIN_OPS_TOKEN}}"
      },
      "payload": {
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}",
        "sku": "ai.gateway.tokens.input",
        "until": "{{dynamic:futuredatetime}}",
        "operator_id": "{{var:operator_id}}",
        "reason": "Temporary lift while billing negotiates an upgrade"
      },
      "expectedStatus": 200
    }
  ]
}
