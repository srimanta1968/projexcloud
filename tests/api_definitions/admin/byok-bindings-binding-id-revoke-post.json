{
  "name": "POST /admin/byok/bindings/:binding_id/revoke — api-gateway",
  "endpoint": "/admin/byok/bindings/:binding_id/revoke",
  "method": "POST",
  "requiresAuth": false,
  "expectedStatus": 200,
  "sdk": "api-gateway",
  "sourceFile": "services/api-gateway/src/app.ts",
  "testability": "auto",
  "dependsOn": [
    "POST /api/auth/signup-tenant",
    "POST /admin/byok/bindings"
  ],
  "statusTransitions": {
    "entity": "byok_binding",
    "field": "grant_status",
    "flow": ["active", "revoking", "revoked"],
    "transitions": [
      { "from": "active", "to": "revoking", "via": "POST /admin/byok/bindings/:binding_id/revoke" },
      { "from": "revoking", "to": "revoked", "via": "POST /admin/byok/bindings/:binding_id/revoke" }
    ]
  },
  "testCases": [
    {
      "name": "Revoke a tenant's BYOK CMK binding (renders data undecryptable)",
      "headers": {
        "x-admin-ops-token": "${ADMIN_OPS_TOKEN}"
      },
      "pathParams": {
        "binding_id": "{{cache:byok-bindings.create.response.data.binding_id}}"
      },
      "payload": {
        "reason": "QA automated revoke drill",
        "operator_id": "{{var:operator_id}}"
      },
      "expectedStatus": 200
    }
  ],
  "expectedResponse": {
    "data": {
      "binding_id": "string",
      "tenant_id": "string",
      "grant_status": "string",
      "revoked_at": "string"
    }
  },
  "captureResponse": {
    "byok-bindings.revoke.response.data.binding_id": "data.binding_id"
  }
}
