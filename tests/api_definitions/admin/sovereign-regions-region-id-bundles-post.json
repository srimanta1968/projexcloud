{
  "name": "POST /admin/sovereign/regions/:region_id/bundles — api-gateway",
  "endpoint": "/admin/sovereign/regions/:region_id/bundles",
  "method": "POST",
  "requiresAuth": false,
  "expectedStatus": 201,
  "sdk": "api-gateway",
  "sourceFile": "services/api-gateway/src/app.ts",
  "_generated": true,
  "testability": "auto",
  "captureResponse": {
    "sovereign.ship-bundle.response.data.release_id": "data.release_id",
    "sovereign.ship-bundle.response.data.region_id": "data.region_id"
  },
  "dependsOn": ["POST /admin/sovereign/regions"],
  "testCases": [
    {
      "name": "Ship a signed bundle release to a sovereign region",
      "pathParams": {
        "region_id": "{{cache:sovereign.register.response.data.region_id}}"
      },
      "payload": {
        "version": "2026.3.0",
        "bundle_artifact_ref": "oci://registry.projexlight.com/sovereign/eu-sov-fra:2026.3.0",
        "signature_hex": "deadbeefcafef00dba5eba11c0ffee00"
      },
      "expectedStatus": 201,
      "headers": {
        "x-admin-ops-token": "{{var:ADMIN_OPS_TOKEN}}"
      }
    }
  ]
}
