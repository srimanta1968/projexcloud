{
  "name": "POST /admin/onprem/installs/:install_id/local-llms — api-gateway",
  "endpoint": "/admin/onprem/installs/:install_id/local-llms",
  "method": "POST",
  "requiresAuth": false,
  "expectedStatus": 201,
  "sdk": "api-gateway",
  "sourceFile": "services/api-gateway/src/app.ts",
  "_generated": true,
  "testability": "auto",
  "fieldEnums": {
    "backend": ["ollama", "vllm", "text-generation-inference"],
    "quantization": ["fp16", "int8", "int4", "awq"],
    "status": ["ready", "loading", "disabled"]
  },
  "captureResponse": {
    "onprem.register-llm.response.data.model_id": "data.model_id",
    "onprem.register-llm.response.data.install_id": "data.install_id"
  },
  "dependsOn": ["POST /admin/onprem/installs"],
  "testCases": [
    {
      "name": "Register a local LLM model on an on-prem install",
      "pathParams": {
        "install_id": "{{cache:onprem.register-install.response.data.install_id}}"
      },
      "payload": {
        "model_id": "llama-3.1-8b-instruct",
        "backend": "vllm",
        "endpoint_url": "http://vllm.onprem.svc.cluster.local:8000/v1",
        "quantization": "int8",
        "status": "loading"
      },
      "expectedStatus": 201,
      "headers": {
        "x-admin-ops-token": "{{var:ADMIN_OPS_TOKEN}}"
      }
    }
  ]
}
