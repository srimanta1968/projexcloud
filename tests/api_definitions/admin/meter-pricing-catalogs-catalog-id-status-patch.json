{
  "name": "PATCH /admin/meter/pricing-catalogs/:catalog_id/status — api-gateway",
  "endpoint": "/admin/meter/pricing-catalogs/:catalog_id/status",
  "method": "PATCH",
  "requiresAuth": false,
  "expectedStatus": 200,
  "sdk": "api-gateway",
  "sourceFile": "services/api-gateway/src/app.ts",
  "_generated": true,
  "testability": "auto",
  "dependsOn": ["POST /admin/meter/pricing-catalogs"],
  "fieldEnums": {
    "status": ["draft", "active", "retired"]
  },
  "statusTransitions": {
    "entity": "pricing_catalog",
    "field": "status",
    "flow": ["draft", "active", "retired"],
    "transitions": [
      { "from": "draft", "to": "active", "via": "PATCH /admin/meter/pricing-catalogs/:catalog_id/status" },
      { "from": "active", "to": "retired", "via": "PATCH /admin/meter/pricing-catalogs/:catalog_id/status" }
    ]
  },
  "testCases": [
    {
      "name": "Promote a draft catalog to active",
      "headers": {
        "x-admin-ops-token": "{{var:ADMIN_OPS_TOKEN}}"
      },
      "pathParams": {
        "catalog_id": "{{cache:meter-pricing-catalogs.create.response.data.catalog_id}}"
      },
      "payload": {
        "status": "active",
        "operator_id": "{{var:operator_id}}"
      },
      "expectedStatus": 200
    }
  ]
}
