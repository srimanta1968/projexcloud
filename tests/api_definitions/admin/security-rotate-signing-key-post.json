{
  "name": "POST /admin/security/rotate-signing-key — api-gateway",
  "endpoint": "/admin/security/rotate-signing-key",
  "method": "POST",
  "requiresAuth": false,
  "expectedStatus": 200,
  "sdk": "api-gateway",
  "sourceFile": "services/api-gateway/src/app.ts",
  "testability": "auto",
  "testCases": [
    {
      "name": "Emergency-rotate the capability-token signing key",
      "headers": {
        "x-admin-ops-token": "{{var:ADMIN_OPS_TOKEN}}"
      },
      "payload": {
        "reason": "QA emergency rotation drill",
        "actor_id": "{{var:operator_id}}"
      },
      "expectedStatus": 200
    }
  ],
  "expectedResponse": {
    "data": {
      "rotated_at": "string",
      "fingerprint_current": "string",
      "fingerprint_previous": "string",
      "grace_window_ms": "number",
      "emergency": "boolean"
    }
  },
  "captureResponse": {
    "rotate-signing-key.rotate.response.data.fingerprint_current": "data.fingerprint_current"
  }
}
