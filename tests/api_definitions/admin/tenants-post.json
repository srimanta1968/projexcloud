{
  "name": "POST /admin/tenants — api-gateway",
  "endpoint": "/admin/tenants",
  "method": "POST",
  "requiresAuth": false,
  "expectedStatus": 201,
  "sdk": "api-gateway",
  "sourceFile": "services/api-gateway/src/app.ts",
  "testability": "auto",
  "dependsOn": [
    "POST /admin/apps"
  ],
  "fieldEnums": {
    "isolation_tier": ["S", "P", "G"]
  },
  "testCases": [
    {
      "name": "Create a tenant under a provisioned app",
      "headers": {
        "x-admin-ops-token": "${ADMIN_OPS_TOKEN}"
      },
      "payload": {
        "app_id": "{{cache:apps.create.response.data.app_id}}",
        "display_name": "QA Tenant",
        "region": "us-east-1",
        "isolation_tier": "S",
        "brand_domain": "qa-tenant.example.com",
        "module_subscriptions": ["sdk-billing", "sdk-analytics"]
      },
      "expectedStatus": 201
    }
  ],
  "expectedResponse": {
    "data": {
      "tenant": {
        "tenant_id": "string",
        "app_id": "string",
        "display_name": "string",
        "region": "string",
        "isolation_tier": "string",
        "status": "string"
      }
    }
  },
  "captureResponse": {
    "tenants.create.response.data.tenant_id": "data.tenant.tenant_id"
  }
}
