{
  "name": "POST /api/keys/:key_id/revoke — api-gateway",
  "endpoint": "/api/keys/:key_id/revoke",
  "sdk": "sdk-api-keys",
  "method": "POST",
  "requiresAuth": false,
  "expectedStatus": 200,
  "sourceFile": "services/api-gateway/src/app.ts",
  "testability": "auto",
  "dependsOn": [
    "POST /api/auth/signup-tenant",
    "POST /api/keys"
  ],
  "statusTransitions": {
    "entity": "api-key",
    "field": "status",
    "flow": ["active", "rotating", "revoked", "expired"],
    "transitions": [
      {
        "from": "active",
        "to": "revoked",
        "via": "POST /api/keys/:key_id/revoke"
      }
    ]
  },
  "testCases": [
    {
      "name": "Revoke the freshly-issued key",
      "pathParams": {
        "key_id": "{{cache:keys.create.response.data.key_id}}"
      },
      "payload": {
        "reason": "compromised-credential-rotation"
      },
      "expectedStatus": 200
    }
  ],
  "expectedResponse": {
    "success": "boolean"
  },
  "captureResponse": {
    "keys.revoke.response.success": "success"
  }
}
