{
  "name": "POST /api/keys — api-gateway",
  "endpoint": "/api/keys",
  "sdk": "sdk-api-keys",
  "method": "POST",
  "requiresAuth": false,
  "expectedStatus": 200,
  "sourceFile": "services/api-gateway/src/app.ts",
  "testability": "auto",
  "dependsOn": [
    "POST /api/auth/signup-tenant"
  ],
  "statusTransitions": {
    "entity": "api-key",
    "field": "status",
    "flow": ["active", "rotating", "revoked", "expired"],
    "transitions": [
      {
        "from": "none",
        "to": "active",
        "via": "POST /api/keys"
      }
    ]
  },
  "testCases": [
    {
      "name": "Issue a new API key for the tenant",
      "payload": {
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}",
        "name": "production-integration-key",
        "scope": "crm.contact.read"
      },
      "expectedStatus": 200
    }
  ],
  "expectedResponse": {
    "data": {
      "key_id": "string",
      "plaintext": "string"
    }
  },
  "captureResponse": {
    "keys.create.response.data.key_id": "data.key_id",
    "keys.create.response.data.plaintext": "data.plaintext"
  }
}
