{
  "name": "GET /api/keys — api-gateway",
  "endpoint": "/api/keys",
  "sdk": "sdk-api-keys",
  "method": "GET",
  "requiresAuth": true,
  "expectedStatus": 200,
  "sourceFile": "services/api-gateway/src/app.ts",
  "testability": "auto",
  "dependsOn": [
    "POST /api/auth/register",
    "POST /api/auth/signup-tenant",
    "POST /api/keys"
  ],
  "testCases": [
    {
      "name": "List API keys for the tenant",
      "queryParams": {
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}"
      },
      "expectedStatus": 200,
      "headers": {
        "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
      }
    }
  ],
  "expectedResponse": {
    "data": "array"
  }
}
