{
  "sdk": "sdk-deliverability",
  "sourceFile": "packages/sdk-deliverability/src/server/routes.ts",
  "requiresAuth": true,
  "taskId": "33d1a91f-18cc-410f-bcb4-4e2619e667cb",
  "sprintId": "d4876947-8d18-4538-8e9f-51ba3e0735a9",
  "featureId": "0487e78e-aff4-4a31-9d61-a988dd03f7d7",
  "epicId": "287f42d8-2045-4105-8948-5e1f25fba3ba",
  "testability": "auto",
  "name": "GET /api/deliverability/reputation - Reputation signals",
  "endpoint": "/api/deliverability/reputation",
  "method": "GET",
  "expectedStatus": 200,
  "priority": 41,
  "description": "Expose a tenant's send reputation signals to callers: all channels, or a single channel via ?channel=. Includes sent/bounce/complaint counts, derived rates and the sending status (good/watch/paused). tenant_id query param required.",
  "dependsOn": [
    "POST /api/auth/signup-tenant",
    "POST /api/deliverability/reputation/record"
  ],
  "fieldEnums": {
    "channel": [
      "email",
      "sms"
    ],
    "status": [
      "good",
      "watch",
      "paused"
    ]
  },
  "testCases": [
    {
      "name": "Get email reputation",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "queryParams": {
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}",
        "channel": "email"
      },
      "expectedStatus": 200,
      "expectedResponse": {
        "data": {
          "reputation": {
            "status": "string"
          }
        }
      }
    }
  ],
  "errorCases": [
    {
      "status": 400,
      "code": "ValidationError",
      "message": "tenant_id query param required",
      "when": "tenant_id missing"
    }
  ]
}
