  "testability": "auto",
  "name": "GET /api/deliverability/suppressions - List suppressions",
  "endpoint": "/api/deliverability/suppressions",
  "method": "GET",
  "expectedStatus": 200,
  "priority": 12,
  "description": "List a tenant's suppressions (plus global rows), newest first, optionally filtered by channel. tenant_id query param required.",
  "dependsOn": [
    "POST /api/auth/signup-tenant",
    "POST /api/deliverability/suppressions"
  ],
  "fieldEnums": {
    "channel": [
      "email",
      "sms",
      "all"
    ]
  },
  "testCases": [
    {
      "name": "List suppressions",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "queryParams": {
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}",
        "channel": "email"
      },
      "expectedStatus": 200,
      "expectedResponse": {
        "data": {
          "suppressions": "array"
        }
      }
    }
  ],
  "errorCases": [
    {
      "status": 400,
      "code": "ValidationError",
      "message": "tenant_id query param required",
      "when": "tenant_id missing"
    }
  ]
