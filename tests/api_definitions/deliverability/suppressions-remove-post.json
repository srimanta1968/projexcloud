{
  "sdk": "sdk-deliverability",
  "sourceFile": "packages/sdk-deliverability/src/server/routes.ts",
  "requiresAuth": true,
  "taskId": "299c5b7c-6abb-4fb5-9c09-174d9f607981",
  "sprintId": "d4876947-8d18-4538-8e9f-51ba3e0735a9",
  "featureId": "38948f60-76b4-47b0-9635-8f9dc024f792",
  "epicId": "287f42d8-2045-4105-8948-5e1f25fba3ba",
  "testability": "auto",
  "name": "POST /api/deliverability/suppressions/remove - Remove a suppression",
  "endpoint": "/api/deliverability/suppressions/remove",
  "method": "POST",
  "expectedStatus": 200,
  "priority": 13,
  "description": "Remove (un-suppress) an address for a channel and scope. Idempotent — removing a non-existent suppression still returns 200. tenant_id, channel and address required.",
  "dependsOn": [
    "POST /api/auth/signup-tenant"
  ],
  "fieldEnums": {
    "channel": [
      "email",
      "sms",
      "all"
    ],
    "scope": [
      "tenant",
      "global"
    ]
  },
  "testCases": [
    {
      "name": "Remove a suppression",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "payload": {
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}",
        "channel": "email",
        "address": "{{dynamic:email}}",
        "scope": "tenant"
      },
      "expectedStatus": 200,
      "expectedResponse": {
        "data": {
          "removed": "boolean"
        }
      }
    }
  ],
  "errorCases": [
    {
      "status": 400,
      "code": "ValidationError",
      "message": "tenant_id, channel and address are required",
      "when": "required field missing"
    }
  ]
}
