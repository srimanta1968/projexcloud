{
  "sdk": "sdk-deliverability",
  "sourceFile": "packages/sdk-deliverability/src/server/routes.ts",
  "requiresAuth": true,
  "taskId": "299c5b7c-6abb-4fb5-9c09-174d9f607981",
  "sprintId": "d4876947-8d18-4538-8e9f-51ba3e0735a9",
  "featureId": "38948f60-76b4-47b0-9635-8f9dc024f792",
  "epicId": "287f42d8-2045-4105-8948-5e1f25fba3ba",
  "testability": "auto",
  "name": "POST /api/deliverability/suppressions - Add a suppression",
  "endpoint": "/api/deliverability/suppressions",
  "method": "POST",
  "expectedStatus": 201,
  "priority": 11,
  "description": "Add (or refresh) a suppression for an address on a channel. Idempotent per (scope-bucket, channel, address) — a repeat upserts the reason/detail. Addresses are sha256-hashed server-side (never stored raw). tenant_id, channel and address required.",
  "dependsOn": [
    "POST /api/auth/signup-tenant"
  ],
  "fieldEnums": {
    "channel": [
      "email",
      "sms",
      "all"
    ],
    "reason": [
      "manual",
      "optout",
      "hard_bounce",
      "soft_bounce",
      "complaint",
      "dnc",
      "list_unsubscribe"
    ],
    "scope": [
      "tenant",
      "global"
    ]
  },
  "testCases": [
    {
      "name": "Suppress an email (manual)",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "payload": {
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}",
        "channel": "email",
        "address": "{{dynamic:email}}",
        "reason": "manual",
        "reason_detail": "Requested by customer",
        "source": "support",
        "scope": "tenant"
      },
      "expectedStatus": 201,
      "expectedResponse": {
        "data": {
          "suppression": {
            "suppression_id": "string"
          }
        }
      }
    }
  ],
  "errorCases": [
    {
      "status": 400,
      "code": "ValidationError",
      "message": "tenant_id, channel and address are required",
      "when": "required field missing"
    }
  ]
}
