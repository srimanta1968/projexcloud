{
  "sdk": "sdk-deliverability",
  "sourceFile": "packages/sdk-deliverability/src/server/routes.ts",
  "requiresAuth": true,
  "taskId": "299c5b7c-6abb-4fb5-9c09-174d9f607981",
  "sprintId": "d4876947-8d18-4538-8e9f-51ba3e0735a9",
  "featureId": "38948f60-76b4-47b0-9635-8f9dc024f792",
  "epicId": "287f42d8-2045-4105-8948-5e1f25fba3ba",
  "testability": "auto",
  "name": "POST /api/deliverability/check - Pre-send suppression check",
  "endpoint": "/api/deliverability/check",
  "method": "POST",
  "expectedStatus": 200,
  "priority": 10,
  "description": "Pre-send enforcement: check whether a recipient (single address or batch addresses[]) is suppressed for the tenant or globally, on the given channel, before delivering. Returns {suppressed} for a single address or {results:[{address,suppressed}]} for a batch. Global suppression and channel=\"all\" both match.",
  "dependsOn": [
    "POST /api/auth/signup-tenant"
  ],
  "fieldEnums": {
    "channel": [
      "email",
      "sms",
      "all"
    ]
  },
  "testCases": [
    {
      "name": "Check a fresh address (not suppressed)",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "payload": {
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}",
        "channel": "email",
        "address": "{{dynamic:email}}"
      },
      "expectedStatus": 200,
      "expectedResponse": {
        "data": {
          "suppressed": "boolean"
        }
      }
    }
  ],
  "errorCases": [
    {
      "status": 400,
      "code": "ValidationError",
      "message": "tenant_id and channel are required",
      "when": "tenant_id or channel missing"
    },
    {
      "status": 400,
      "code": "ValidationError",
      "message": "address or addresses[] is required",
      "when": "neither address nor addresses provided"
    }
  ]
}
