{
  "sdk": "sdk-deliverability",
  "sourceFile": "packages/sdk-deliverability/src/server/routes.ts",
  "requiresAuth": true,
  "taskId": "33d1a91f-18cc-410f-bcb4-4e2619e667cb",
  "sprintId": "d4876947-8d18-4538-8e9f-51ba3e0735a9",
  "featureId": "0487e78e-aff4-4a31-9d61-a988dd03f7d7",
  "epicId": "287f42d8-2045-4105-8948-5e1f25fba3ba",
  "testability": "auto",
  "name": "POST /api/deliverability/reputation/resume - Resume a paused channel",
  "endpoint": "/api/deliverability/reputation/resume",
  "method": "POST",
  "expectedStatus": 200,
  "priority": 42,
  "description": "Manually resume a channel that auto-paused for reputation (human override): clears the pause, resets the counter window, and sets status back to good. Returns the reset reputation row; 404 if no reputation row exists for the tenant/channel. tenant_id required.",
  "dependsOn": [
    "POST /api/auth/signup-tenant",
    "POST /api/deliverability/reputation/record"
  ],
  "fieldEnums": {
    "channel": [
      "email",
      "sms"
    ]
  },
  "testCases": [
    {
      "name": "Resume the email channel",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "payload": {
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}",
        "channel": "email"
      },
      "expectedStatus": 200,
      "expectedResponse": {
        "data": {
          "reputation": {
            "status": "string"
          }
        }
      }
    }
  ],
  "errorCases": [
    {
      "status": 400,
      "code": "ValidationError",
      "message": "tenant_id is required",
      "when": "tenant_id missing"
    },
    {
      "status": 404,
      "code": "NotFound",
      "message": "no reputation row for that tenant/channel",
      "when": "nothing to resume"
    }
  ]
}
