{
  "sdk": "sdk-deliverability",
  "sourceFile": "packages/sdk-deliverability/src/server/routes.ts",
  "taskId": "9776c8ed-6c63-4518-bfd6-f9ba50bd389c",
  "sprintId": "d4876947-8d18-4538-8e9f-51ba3e0735a9",
  "featureId": "e205e703-6dfa-4dbb-a281-be5b4512960a",
  "epicId": "287f42d8-2045-4105-8948-5e1f25fba3ba",
  "testability": "auto",
  "name": "POST /api/deliverability/webhook-secrets - Register a webhook HMAC secret",
  "endpoint": "/api/deliverability/webhook-secrets",
  "method": "POST",
  "requiresAuth": true,
  "expectedStatus": 201,
  "priority": 20,
  "description": "Register (or rotate) a tenant's HMAC signing secret for a provider's bounce/complaint webhook. Once set, inbound webhooks for that (tenant, provider) are signature-enforced. tenant_id, provider and signing_secret are required.",
  "dependsOn": [
    "POST /api/auth/signup-tenant"
  ],
  "fieldEnums": {
    "provider": [
      "ses",
      "sendgrid",
      "mailgun",
      "postmark",
      "twilio"
    ],
    "algo": [
      "sha1",
      "sha256"
    ]
  },
  "testCases": [
    {
      "name": "Register a SendGrid signing secret",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "payload": {
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}",
        "provider": "sendgrid",
        "signing_secret": "{{dynamic:uuid}}",
        "algo": "sha256"
      },
      "expectedStatus": 201,
      "expectedResponse": {
        "data": {
          "secret_id": "string",
          "provider": "string"
        }
      }
    }
  ],
  "errorCases": [
    {
      "status": 400,
      "code": "ValidationError",
      "message": "tenant_id, provider and signing_secret are required",
      "when": "required field missing"
    },
    {
      "status": 400,
      "code": "ValidationError",
      "message": "provider must be ses, sendgrid, mailgun, postmark or twilio",
      "when": "invalid provider"
    }
  ]
}
