  "testability": "auto",
  "name": "GET /api/deliverability/bounce-events - List processed bounce/complaint events",
  "endpoint": "/api/deliverability/bounce-events",
  "method": "GET",
  "requiresAuth": true,
  "expectedStatus": 200,
  "priority": 22,
  "description": "List a tenant's processed provider bounce/complaint events (newest first), optionally filtered by classification. tenant_id query param required.",
  "dependsOn": [
    "POST /api/auth/signup-tenant",
    "POST /api/deliverability/webhooks/:provider"
  ],
  "fieldEnums": {
    "classification": [
      "hard_bounce",
      "soft_bounce",
      "complaint",
      "delivered",
      "other"
    ]
  },
  "testCases": [
    {
      "name": "List bounce events",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "queryParams": {
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}",
        "classification": "hard_bounce"
      },
      "expectedStatus": 200,
      "expectedResponse": {
        "data": {
          "events": "array"
        }
      }
    }
  ],
  "errorCases": [
    {
      "status": 400,
      "code": "ValidationError",
      "message": "tenant_id query param required",
      "when": "tenant_id missing"
    }
  ]
}
