{
  "sdk": "sdk-deliverability",
  "sourceFile": "packages/sdk-deliverability/src/server/routes.ts",
  "requiresAuth": true,
  "taskId": "3c5b06a9-c838-459d-a5c9-6f446489293a",
  "sprintId": "d4876947-8d18-4538-8e9f-51ba3e0735a9",
  "featureId": "0d077452-9613-46a5-9709-a9d3f71a8156",
  "epicId": "287f42d8-2045-4105-8948-5e1f25fba3ba",
  "testability": "auto",
  "name": "POST /api/deliverability/mailboxes/:mailbox_id/sync - Poll for replies",
  "endpoint": "/api/deliverability/mailboxes/:mailbox_id/sync",
  "method": "POST",
  "expectedStatus": 200,
  "priority": 32,
  "description": "Poll a mailbox once over IMAP: fetch messages after last_uid via the pluggable fetcher, capture each as a reply_event, and advance the UID cursor. Idempotent (already-captured messages skipped). Returns {fetched, captured, paused}. With no live IMAP client wired it returns zero. tenant_id required.",
  "dependsOn": [
    "POST /api/auth/signup-tenant",
    "POST /api/deliverability/mailboxes"
  ],
  "testCases": [
    {
      "name": "Sync the mailbox",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "pathParams": {
        "mailbox_id": "{{cache:deliverability.mailbox.create.response.data.mailbox.mailbox_id}}"
      },
      "payload": {
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}"
      },
      "expectedStatus": 200,
      "expectedResponse": {
        "data": {
          "fetched": "number",
          "captured": "number",
          "paused": "number"
        }
      }
    }
  ],
  "errorCases": [
    {
      "status": 400,
      "code": "ValidationError",
      "message": "tenant_id is required",
      "when": "tenant_id missing"
    },
    {
      "status": 404,
      "code": "NotFound",
      "message": "mailbox not found",
      "when": "no mailbox for tenant"
    }
  ]
}
