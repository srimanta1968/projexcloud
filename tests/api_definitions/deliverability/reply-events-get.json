  "name": "GET /api/deliverability/reply-events - List captured replies",
  "endpoint": "/api/deliverability/reply-events",
  "method": "GET",
  "expectedStatus": 200,
  "priority": 34,
  "description": "List a tenant's captured inbound reply events (newest first), optionally filtered by classification. tenant_id query param required.",
  "dependsOn": [
    "POST /api/auth/signup-tenant",
    "POST /api/deliverability/mailboxes/:mailbox_id/replies"
  ],
  "fieldEnums": {
    "classification": [
      "human",
      "auto_reply",
      "ooo",
      "bounce",
      "other"
    ]
  },
  "testCases": [
    {
      "name": "List reply events",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "queryParams": {
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}",
        "classification": "human"
      },
      "expectedStatus": 200,
      "expectedResponse": {
        "data": {
          "events": "array"
        }
      }
    }
  ],
  "errorCases": [
    {
      "status": 400,
      "code": "ValidationError",
      "message": "tenant_id query param required",
      "when": "tenant_id missing"
    }
  ]
