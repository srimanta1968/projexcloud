{
  "sdk": "sdk-deliverability",
  "sourceFile": "packages/sdk-deliverability/src/server/routes.ts",
  "requiresAuth": true,
  "taskId": "33d1a91f-18cc-410f-bcb4-4e2619e667cb",
  "sprintId": "d4876947-8d18-4538-8e9f-51ba3e0735a9",
  "featureId": "0487e78e-aff4-4a31-9d61-a988dd03f7d7",
  "epicId": "287f42d8-2045-4105-8948-5e1f25fba3ba",
  "testability": "auto",
  "name": "POST /api/deliverability/reputation/record - Record send outcomes",
  "endpoint": "/api/deliverability/reputation/record",
  "method": "POST",
  "expectedStatus": 200,
  "priority": 40,
  "description": "Increment per-(tenant,channel) send/delivery/bounce/complaint counters and recompute the reputation status. Auto-pauses the channel (status=paused) when the bounce rate >= 5% or complaint rate >= 0.1% over a minimum volume; a paused channel never auto-un-pauses. Returns the fresh reputation row. tenant_id required.",
  "dependsOn": [
    "POST /api/auth/signup-tenant"
  ],
  "fieldEnums": {
    "channel": [
      "email",
      "sms"
    ]
  },
  "testCases": [
    {
      "name": "Record a healthy batch (2% bounce -> good)",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "payload": {
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}",
        "channel": "email",
        "sent": 100,
        "delivered": 96,
        "bounced": 2,
        "complained": 0
      },
      "expectedStatus": 200,
      "expectedResponse": {
        "data": {
          "reputation": {
            "status": "string",
            "bounce_rate": "string"
          }
        }
      }
    }
  ],
  "errorCases": [
    {
      "status": 400,
      "code": "ValidationError",
      "message": "tenant_id is required",
      "when": "tenant_id missing"
    },
    {
      "status": 400,
      "code": "ValidationError",
      "message": "channel must be email or sms",
      "when": "invalid channel"
    }
  ]
}
