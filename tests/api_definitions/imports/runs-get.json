{
  "name": "GET /api/imports/runs - List import runs",
  "endpoint": "/api/imports/runs",
  "sdk": "sdk-import",
  "sourceFile": "packages/sdk-import/src/server/routes.ts",
  "method": "GET",
  "requiresAuth": true,
  "expectedStatus": 200,
  "taskId": "f6e9a813-82ee-4f15-97cf-e4a9a3f8f772",
  "sprintId": "d4876947-8d18-4538-8e9f-51ba3e0735a9",
  "priority": 59,
  "testability": "auto",
  "description": "List a tenant's import runs, newest first, optionally narrowed by status or source kind. limit is clamped to 1..500 (default 50). Returns an empty array rather than a 404 when nothing matches. Required: tenant_id query param.",
  "dependsOn": [
    "POST /api/auth/signup-tenant",
    "POST /api/imports/runs"
  ],
  "fieldEnums": {
    "status": [
      "draft",
      "previewing",
      "mapping",
      "dry_run",
      "committing",
      "complete",
      "quarantined",
      "rolled_back"
    ]
  },
  "testCases": [
    {
      "name": "List runs for the tenant",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "queryParams": {
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}",
        "status": "draft",
        "source_kind": "csv_upload",
        "limit": "50",
        "offset": "0"
      },
      "expectedStatus": 200,
      "expectedResponse": {
        "data": {
          "runs": "array",
          "count": "number"
        }
      }
    }
  ],
  "errorCases": [
    {
      "status": 400,
      "code": "VALIDATION_ERROR",
      "message": "tenant_id query param required",
      "when": "the tenant_id query param is absent"
    },
    {
      "status": 401,
      "code": "Unauthorized",
      "message": "missing or invalid token",
      "when": "no valid tenant Bearer token on the request"
    }
  ]
}
