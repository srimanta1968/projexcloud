{
  "name": "GET /api/imports/mapping-templates - List mapping templates",
  "endpoint": "/api/imports/mapping-templates",
  "sdk": "sdk-import",
  "sourceFile": "packages/sdk-import/src/server/routes.ts",
  "method": "GET",
  "requiresAuth": true,
  "expectedStatus": 200,
  "taskId": "f6e9a813-82ee-4f15-97cf-e4a9a3f8f772",
  "sprintId": "d4876947-8d18-4538-8e9f-51ba3e0735a9",
  "priority": 48,
  "testability": "auto",
  "description": "List a tenant's mapping templates, grouped by slug with the newest version first, optionally narrowed by slug, kind or active flag. limit is clamped to 1..500 (default 50). Required: tenant_id query param.",
  "dependsOn": [
    "POST /api/auth/signup-tenant",
    "POST /api/imports/mapping-templates"
  ],
  "fieldEnums": {
    "kind": [
      "certified",
      "custom"
    ],
    "crosswalk_strategy": [
      "preserve_existing",
      "add_alias",
      "reject_conflict"
    ]
  },
  "testCases": [
    {
      "name": "List the tenant's mapping templates",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "queryParams": {
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}",
        "slug": "{{cache:imports.template.create.response.data.template.slug}}",
        "kind": "custom",
        "is_active": "true",
        "limit": "50",
        "offset": "0"
      },
      "expectedStatus": 200,
      "expectedResponse": {
        "data": {
          "templates": "array",
          "count": "number"
        }
      }
    }
  ],
  "errorCases": [
    {
      "status": 400,
      "code": "VALIDATION_ERROR",
      "message": "tenant_id query param required",
      "when": "the tenant_id query param is absent"
    },
    {
      "status": 401,
      "code": "Unauthorized",
      "message": "missing or invalid token",
      "when": "no valid tenant Bearer token on the request"
    }
  ]
}
