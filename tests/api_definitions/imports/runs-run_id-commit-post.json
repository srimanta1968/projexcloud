{
  "name": "POST /api/imports/runs/:run_id/commit - Land the import, once",
  "endpoint": "/api/imports/runs/:run_id/commit",
  "sdk": "sdk-import",
  "sourceFile": "packages/sdk-import/src/server/routes.ts",
  "method": "POST",
  "requiresAuth": true,
  "expectedStatus": 200,
  "taskId": "f6e9a813-82ee-4f15-97cf-e4a9a3f8f772",
  "sprintId": "d4876947-8d18-4538-8e9f-51ba3e0735a9",
  "priority": 51,
  "testability": "auto",
  "description": "Land every row and mark the run complete. IDEMPOTENT BY CONSTRUCTION: entity keys are derived from run_id + the row's own content fingerprint, lineage is written under UNIQUE(run_id, entity_kind, entity_id, action) with ON CONFLICT DO NOTHING, and a transaction-scoped advisory lock stops two workers committing the same run — so interrupting a commit and retrying it produces an identical entity set, and a commit of an already-complete run returns replayed:true without changing anything. Refuses without a signed source-rights attestation (422). A place is written as its own entity plus a located_at relationship, never as columns on the person. CONSENT IS NEVER FABRICATED: declare the consent columns and a receipt is created ONLY for a recognised affirmative value that also carries a capture date that parses; a blank, a generic placeholder (\"n/a\", \"unknown\", \"-\"), an unrecognised value or a missing date all land the row WITHOUT a receipt and file an explained exception. Returns 200: it moves an existing run. Required: tenant_id, rows[].",
  "dependsOn": [
    "POST /api/auth/signup-tenant",
    "POST /api/imports/runs",
    "POST /api/imports/runs/:run_id/preview",
    "PUT /api/imports/runs/:run_id/mapping",
    "POST /api/imports/runs/:run_id/transform-plan",
    "POST /api/imports/runs/:run_id/dry-run"
  ],
  "statusTransitions": {
    "entity": "import.import_run",
    "field": "status",
    "flow": [
      "draft",
      "previewing",
      "mapping",
      "dry_run",
      "committing",
      "complete",
      "quarantined",
      "rolled_back"
    ],
    "transitions": [
      {
        "from": "draft",
        "to": "previewing",
        "via": "POST /api/imports/runs/:run_id/preview"
      },
      {
        "from": "previewing",
        "to": "mapping",
        "via": "PUT /api/imports/runs/:run_id/mapping"
      },
      {
        "from": "mapping",
        "to": "dry_run",
        "via": "POST /api/imports/runs/:run_id/dry-run"
      },
      {
        "from": "dry_run",
        "to": "committing",
        "via": "POST /api/imports/runs/:run_id/commit (internal)"
      },
      {
        "from": "committing",
        "to": "complete",
        "via": "POST /api/imports/runs/:run_id/commit"
      },
      {
        "from": "complete",
        "to": "rolled_back",
        "via": "POST /api/imports/runs/:run_id/rollback (inside the deadline only)"
      },
      {
        "from": "draft",
        "to": "quarantined",
        "via": "a governance failure parks the run for a human"
      },
      {
        "from": "quarantined",
        "to": "mapping",
        "via": "a human resolves the parked run and re-maps"
      }
    ]
  },
  "fieldEnums": {
    "status": [
      "draft",
      "previewing",
      "mapping",
      "dry_run",
      "committing",
      "complete",
      "quarantined",
      "rolled_back"
    ]
  },
  "testCases": [
    {
      "name": "Commit the dry-run-verified rows",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "pathParams": {
        "run_id": "{{cache:imports.run.create.response.data.run.run_id}}"
      },
      "payload": {
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}",
        "rows": [
          {
            "full_name": "Ada Lovelace",
            "email": "{{dynamic:email}}",
            "street_address": "1 Analytical Way",
            "city": "London",
            "country": "GB",
            "external_id": "CRM-{{dynamic:uuid}}",
            "contact_ok": "yes",
            "consent_date": "2026-01-05T10:00:00Z"
          },
          {
            "full_name": "Alan Turing",
            "email": "{{dynamic:email}}",
            "street_address": "2 Bombe Road",
            "city": "Manchester",
            "country": "GB",
            "external_id": "CRM-{{dynamic:uuid}}",
            "contact_ok": "",
            "consent_date": ""
          }
        ],
        "consent": {
          "value_column": "contact_ok",
          "purpose": "outreach",
          "captured_at_column": "consent_date"
        },
        "actor_id": "qa-runner"
      },
      "expectedStatus": 200,
      "expectedResponse": {
        "data": {
          "run": {
            "status": "string"
          },
          "entities_created": "number",
          "consent_receipts": "number",
          "replayed": "boolean"
        }
      }
    }
  ],
  "captureResponse": {
    "imports.commit.response.data.run.status": "data.run.status",
    "imports.commit.response.data.entities_created": "data.entities_created"
  },
  "errorCases": [
    {
      "status": 400,
      "code": "VALIDATION_ERROR",
      "message": "tenant_id and rows[] are required",
      "when": "either field is missing from the body"
    },
    {
      "status": 404,
      "code": "IMPORT_RUN_NOT_FOUND",
      "message": "import run <id> not found for tenant",
      "when": "the run does not exist, or belongs to another tenant"
    },
    {
      "status": 409,
      "code": "IMPORT_RUN_LOCKED",
      "message": "run <id> is already being committed by another worker",
      "when": "a concurrent commit holds the run lock; retry shortly"
    },
    {
      "status": 409,
      "code": "INVALID_RUN_TRANSITION",
      "message": "run <id> cannot move rolled_back -> committing",
      "when": "the run was already rolled back, or has no confirmed mapping / transform plan"
    },
    {
      "status": 422,
      "code": "ATTESTATION_NOT_SIGNED",
      "message": "run <id> has no signed source-rights attestation — the commit is refused",
      "when": "no attestation covers the source"
    },
    {
      "status": 401,
      "code": "Unauthorized",
      "message": "missing or invalid token",
      "when": "no valid tenant Bearer token on the request"
    }
  ]
}
