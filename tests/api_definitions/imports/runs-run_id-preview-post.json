{
  "name": "POST /api/imports/runs/:run_id/preview - Detect structure and sensitivity",
  "endpoint": "/api/imports/runs/:run_id/preview",
  "sdk": "sdk-import",
  "sourceFile": "packages/sdk-import/src/server/routes.ts",
  "method": "POST",
  "requiresAuth": true,
  "expectedStatus": 200,
  "taskId": "f6e9a813-82ee-4f15-97cf-e4a9a3f8f772",
  "sprintId": "d4876947-8d18-4538-8e9f-51ba3e0735a9",
  "priority": 57,
  "testability": "auto",
  "description": "Detect delimiter, encoding, header row and per-column type, each with a confidence, and move the run to previewing. Delimiter detection scores CONSISTENCY across lines rather than frequency, so a pipe-delimited file full of commas in its free text is read correctly. Columns holding direct identifiers, contact points, locations, government ids or financial data are flagged for tokenization at trusted ingress AND have their sample values REDACTED — a preview travels into UIs, logs and tickets. Source-identifier columns are detected by name and by all-distinct-uuid shape and reported as crosswalks that are never replaced by platform ids. Send either raw `content` or a pre-parsed `rows[]`. Returns 200: it moves an existing run. Required: tenant_id and one of content / rows[].",
  "dependsOn": [
    "POST /api/auth/signup-tenant",
    "POST /api/imports/runs"
  ],
  "statusTransitions": {
    "entity": "import.import_run",
    "field": "status",
    "flow": [
      "draft",
      "previewing",
      "mapping",
      "dry_run",
      "committing",
      "complete",
      "quarantined",
      "rolled_back"
    ],
    "transitions": [
      {
        "from": "draft",
        "to": "previewing",
        "via": "POST /api/imports/runs/:run_id/preview"
      },
      {
        "from": "previewing",
        "to": "mapping",
        "via": "PUT /api/imports/runs/:run_id/mapping"
      },
      {
        "from": "mapping",
        "to": "dry_run",
        "via": "POST /api/imports/runs/:run_id/dry-run"
      },
      {
        "from": "dry_run",
        "to": "committing",
        "via": "POST /api/imports/runs/:run_id/commit (internal)"
      },
      {
        "from": "committing",
        "to": "complete",
        "via": "POST /api/imports/runs/:run_id/commit"
      },
      {
        "from": "complete",
        "to": "rolled_back",
        "via": "POST /api/imports/runs/:run_id/rollback (inside the deadline only)"
      },
      {
        "from": "draft",
        "to": "quarantined",
        "via": "a governance failure parks the run for a human"
      },
      {
        "from": "quarantined",
        "to": "mapping",
        "via": "a human resolves the parked run and re-maps"
      }
    ]
  },
  "fieldEnums": {
    "status": [
      "draft",
      "previewing",
      "mapping",
      "dry_run",
      "committing",
      "complete",
      "quarantined",
      "rolled_back"
    ]
  },
  "testCases": [
    {
      "name": "Preview the uploaded delimited content",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "pathParams": {
        "run_id": "{{cache:imports.run.create.response.data.run.run_id}}"
      },
      "payload": {
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}",
        "content": "full_name,email,street_address,city,country,external_id,contact_ok,consent_date\\nAda Lovelace,{{dynamic:email}},1 Analytical Way,London,GB,CRM-{{dynamic:uuid}},yes,2026-01-05T10:00:00Z\\nAlan Turing,{{dynamic:email}},2 Bombe Road,Manchester,GB,CRM-{{dynamic:uuid}},,",
        "delimiter": ",",
        "has_header_row": true,
        "encoding": "utf-8",
        "sample_size": 200
      },
      "expectedStatus": 200,
      "expectedResponse": {
        "data": {
          "run": {
            "status": "string"
          },
          "preview": {
            "delimiter": "string",
            "columns": "array"
          }
        }
      }
    }
  ],
  "captureResponse": {
    "imports.preview.response.data.run.status": "data.run.status"
  },
  "errorCases": [
    {
      "status": 400,
      "code": "VALIDATION_ERROR",
      "message": "either content or a non-empty rows[] is required",
      "when": "neither content nor rows[] was supplied"
    },
    {
      "status": 404,
      "code": "IMPORT_RUN_NOT_FOUND",
      "message": "import run <id> not found for tenant",
      "when": "the run does not exist, or belongs to another tenant"
    },
    {
      "status": 409,
      "code": "INVALID_RUN_TRANSITION",
      "message": "run <id> cannot move <from> -> previewing",
      "when": "the run has already moved past the preview stage (e.g. it is complete)"
    },
    {
      "status": 401,
      "code": "Unauthorized",
      "message": "missing or invalid token",
      "when": "no valid tenant Bearer token on the request"
    }
  ]
}
