{
  "name": "POST /api/personas/:persona_id/bu — api-gateway",
  "endpoint": "/api/personas/:persona_id/bu",
  "sdk": "sdk-persona",
  "method": "POST",
  "requiresAuth": true,
  "expectedStatus": 200,
  "sourceFile": "services/api-gateway/src/app.ts",
  "testability": "auto",
  "dependsOn": [
    "POST /api/auth/register",
    "POST /api/app-identities",
    "POST /api/memberships",
    "POST /api/personas"
  ],
  "testCases": [
    {
      "name": "Set persona business unit",
      "pathParams": {
        "persona_id": "{{cache:personas.create.response.data.persona.persona_id}}"
      },
      "payload": {
        "bu_id": "{{var:bu_id}}"
      },
      "expectedStatus": 200,
      "headers": {
        "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
      }
    }
  ],
  "captureResponse": {
    "personas.set-bu.response.success": "success"
  }
}
