{
  "name": "POST /api/personas/:persona_id/shred - Shred persona (FR-PSN-7, AC-2)",
  "endpoint": "/api/personas/:persona_id/shred",
  "sdk": "sdk-persona",
  "method": "POST",
  "requiresAuth": true,
  "expectedStatus": 200,
  "taskId": "c0fb5ae9-73b6-498e-9f9e-426edd3d9755",
  "sprintId": "8ef1d09e-dd8e-4daf-8d03-54dcd9f812f8",
  "featureId": "b04da8c5-aa75-47ec-9bd6-63df4200a351",
  "epicId": "93a549d6-9a93-4d82-86bb-bac5167fa960",
  "priority": 90,
  "testability": "auto",
  "sourceFile": "packages/sdk-persona/src/server/routes.ts",
  "dependsOn": [
    "POST /api/auth/register",
    "POST /api/app-identities",
    "POST /api/memberships",
    "POST /api/personas"
  ],
  "testCases": [
    {
      "name": "Shred persona independent of person",
      "headers": {
        "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
      },
      "pathParams": {
        "persona_id": "{{cache:personas.create.response.data.persona.persona_id}}"
      },
      "payload": {},
      "expectedStatus": 200
    }
  ],
  "captureResponse": {
    "personas.shred.response.data.persona.persona_id": "data.persona.persona_id",
    "personas.shred.response.data.persona.status": "data.persona.status"
  },
  "statusTransitions": {
    "entity": "persona.persona",
    "field": "status",
    "flow": [
      "active",
      "suspended",
      "shredded"
    ],
    "transitions": [
      {
        "from": "active",
        "to": "shredded",
        "via": "POST /api/personas/:persona_id/shred"
      },
      {
        "from": "suspended",
        "to": "shredded",
        "via": "POST /api/personas/:persona_id/shred"
      }
    ]
  },
  "description": "Crypto-shreds a persona (GDPR erasure): destroys the persona key reference so persona-scoped ciphertext becomes unreadable, returning the resulting persona row. Edge cases: an unknown :persona_id returns 404; a non-UUID :persona_id fails in Postgres as a 500; shredding is destructive and NOT reversible, yet the route has no already-shredded guard, so a repeat call still returns 200 with the row (idempotent in effect, not by check); the persona row itself is retained — only the key material is destroyed.",
  "errorCases": [
    {
      "status": 401,
      "code": "Unauthorized",
      "message": "Missing bearer token",
      "when": "Authorization header absent or not in 'Bearer <jwt>' form (requireAuth preHandler)"
    },
    {
      "status": 401,
      "code": "Unauthorized",
      "message": "Invalid or expired token",
      "when": "JWT signature invalid, malformed, or exp has elapsed"
    },
    {
      "status": 404,
      "code": "NotFound",
      "message": "NotFound",
      "when": "no persona row exists for :persona_id"
    },
    {
      "status": 500,
      "code": "Internal Server Error",
      "message": "Internal Server Error",
      "when": ":persona_id is not a valid UUID — the route has no try/catch, so the rejection surfaces as Fastify's default 500"
    }
  ]
}
