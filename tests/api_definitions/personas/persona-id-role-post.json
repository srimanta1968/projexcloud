{
  "name": "POST /api/personas/:persona_id/role \u2014 api-gateway",
  "endpoint": "/api/personas/:persona_id/role",
  "sdk": "sdk-persona",
  "method": "POST",
  "requiresAuth": false,
  "expectedStatus": 200,
  "sourceFile": "services/api-gateway/src/app.ts",
  "testability": "auto",
  "dependsOn": [
    "POST /api/auth/register",
    "POST /api/app-identities",
    "POST /api/memberships",
    "POST /api/personas",
    "POST /api/role-templates"
  ],
  "testCases": [
    {
      "name": "Set persona role label",
      "pathParams": {
        "persona_id": "{{cache:personas.create.response.data.persona.persona_id}}"
      },
      "payload": {
        "role": "{{cache:role-templates.create.response.data.role_template.role_template_id}}"
      },
      "expectedStatus": 200
    }
  ],
  "captureResponse": {
    "personas.set-role.response.success": "success"
  }
}