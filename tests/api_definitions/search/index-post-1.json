{
  "name": "POST /api/search - ABAC-filtered DSL/free-text search",
  "endpoint": "/api/search",
  "method": "POST",
  "requiresAuth": true,
  "dependsOn": [
    "POST /api/auth/signup-tenant",
    "POST /api/search/index"
  ],
  "expectedStatus": 200,
  "sdk": "sdk-search",
  "sourceFile": "packages/sdk-search/src/server/routes.ts",
  "_generated": true,
  "testability": "auto",
  "testCases": [
    {
      "name": "Query encounter entities",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "payload": {
        "entity_kind": "encounter",
        "q": "open",
        "dsl": {
          "query": {
            "term": {
              "status": "open"
            }
          }
        },
        "size": 10,
        "from": 0
      },
      "expectedStatus": 200
    }
  ],
  "expectedResponse": {
    "data": {
      "hits": "array",
      "total": "number",
      "took_ms": "number",
      "index_used": "string"
    }
  },
  "captureResponse": {
    "search.query.response.data.index_used": "data.index_used",
    "search.query.response.data.total": "data.total"
  }
}
