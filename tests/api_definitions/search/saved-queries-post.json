{
  "name": "POST /api/search/saved-queries - Persist a named DSL query",
  "endpoint": "/api/search/saved-queries",
  "sdk": "sdk-search",
  "sourceFile": "packages/sdk-search/src/server/routes.ts",
  "method": "POST",
  "requiresAuth": true,
  "expectedStatus": 201,
  "taskId": "172643e9-507b-48df-b52b-1cad6f74db4f",
  "sprintId": "8ef1d09e-dd8e-4daf-8d03-54dcd9f812f8",
  "featureId": "02447110-6a41-4546-8d10-2107aa023f3a",
  "epicId": "d83f7b6e-821c-4fe1-96e6-910eca8fbbfc",
  "priority": 40,
  "testability": "auto",
  "dependsOn": [
    "POST /api/auth/signup-tenant"
  ],
  "testCases": [
    {
      "name": "Save my-open-encounters query",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "payload": {
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}",
        "persona_id": "{{cache:auth.signup-tenant.response.data.userId}}",
        "name": "my-open-encounters",
        "dsl": {
          "query": {
            "term": {
              "status": "open"
            }
          },
          "size": 50
        }
      },
      "expectedStatus": 201
    }
  ],
  "expectedResponse": {
    "data": {
      "saved_query": {
        "query_id": "string",
        "tenant_id": "string",
        "persona_id": "string",
        "name": "string",
        "dsl": "object",
        "created_at": "string"
      }
    }
  },
  "captureResponse": {
    "search.saved-queries.create.response.data.saved_query.query_id": "data.saved_query.query_id",
    "search.saved-queries.create.response.data.saved_query.persona_id": "data.saved_query.persona_id"
  }
}
