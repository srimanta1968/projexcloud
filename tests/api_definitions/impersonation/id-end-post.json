{
  "name": "POST /api/impersonation/:grant_id/end - End impersonation",
  "endpoint": "/api/impersonation/:grant_id/end",
  "sdk": "sdk-identity",
  "method": "POST",
  "requiresAuth": true,
  "expectedStatus": 200,
  "taskId": "1a913a0e-cd3e-42a5-b879-f21b41e24780",
  "sprintId": "8ef1d09e-dd8e-4daf-8d03-54dcd9f812f8",
