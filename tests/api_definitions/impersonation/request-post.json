{
  "name": "POST /api/impersonation/request - Support requests impersonation",
  "endpoint": "/api/impersonation/request",
  "sdk": "sdk-identity",
  "method": "POST",
  "requiresAuth": true,
  "expectedStatus": 201,
  "taskId": "fbcd8222-760d-445d-97d7-762c8709ccdd",
  "sprintId": "8ef1d09e-dd8e-4daf-8d03-54dcd9f812f8",
  "featureId": "f493450e-8ed8-425c-b905-f8a76a70bdcc",
  "epicId": "00996d23-f667-4a82-9285-7728ba357e7b",
  "priority": 30,
  "testability": "auto",
  "dependsOn": [
    "POST /api/auth/signup-tenant"
  ],
  "testCases": [
    {
      "name": "Support engineer requests 30min impersonation",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "payload": {
        "support_user_id": "{{cache:auth.signup-tenant.response.data.userId}}",
        "target_tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}",
        "ticket_ref": "SUP-998",
        "duration_minutes": 30
      },
      "expectedStatus": 201
    }
  ],
  "expectedResponse": {
    "data": {
      "grant": {
        "grant_id": "string",
        "support_user_id": "string",
        "target_tenant_id": "string",
        "ticket_ref": "string",
        "manager_approval_id": "string",
        "customer_consent_ref": "string",
        "expires_at": "string",
        "certificate_audit_id": "string",
        "status": "string"
      }
    }
  },
  "statusTransitions": {
    "entity": "impersonation_grant",
    "field": "status",
    "flow": ["pending_approval", "active", "ended"],
    "transitions": [
      { "from": null, "to": "pending_approval", "via": "POST /api/impersonation/request" },
      { "from": "pending_approval", "to": "active", "via": "POST /api/impersonation/:grant_id/approve" },
      { "from": "active", "to": "ended", "via": "POST /api/impersonation/:grant_id/end" }
    ]
  },
  "captureResponse": {
    "impersonation.request.response.data.grant.grant_id": "data.grant.grant_id",
    "impersonation.request.response.data.grant.status": "data.grant.status"
  }
}
