{
  "endpoint": "/api/agent-runtime/tokens/:token_id/validate",
  "sdk": "sdk-agent-runtime",
  "method": "POST",
  "taskId": "f83bc787-e516-4ee9-9a86-3a3aa9c2bad9",
  "description": "Validate a capability token against the args the caller intends to invoke. Checks expiry, single-use, revocation, args binding, signature. Returns valid:true|false with reason. Always HTTP 200 (validity is in the body).",
  "requiresAuth": true,
  "priority": 110,
  "dependsOn": [
    "POST /api/auth/register",
    "POST /api/agent-runtime/agents",
    "POST /api/agent-runtime/runs",
    "POST /api/agent-runtime/tokens"
  ],
  "captureResponse": {
    "agent-runtime-tokens.validate.response.data.valid": "data.valid"
  },
  "testCases": [
    {
      "name": "Validate freshly-minted token",
      "headers": {
        "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
      },
      "pathParams": {
        "token_id": "{{cache:agent-runtime-tokens.mint.response.data.token_id}}"
      },
      "payload": {
        "args": {
          "first_name": "Ada"
        }
      },
      "expectedStatus": 200,
      "expectedResponse": {
        "success": true
      }
    }
  ],
  "errorCases": [
    {
      "status": 401,
      "code": "Unauthorized",
      "message": "Missing bearer token",
      "when": "Authorization header absent or not in Bearer form (requireAuth)"
    },
    {
      "status": 401,
      "code": "Unauthorized",
      "message": "Invalid or expired token",
      "when": "Bearer token fails JWT verification (requireAuth)"
    },
    {
      "status": 400,
      "code": "MissingPathParam",
      "message": "Missing path param: token_id",
      "when": "token_id resolves falsy (defensive - an empty path segment normally route-misses to 404 first)"
    },
    {
      "status": 400,
      "code": "MissingRequiredField",
      "message": "Missing required field: args",
      "when": "body.args is undefined (absent body, or a body with no args key); args:null passes the check"
    },
    {
      "status": 500,
      "code": "ValidateFailed",
      "message": "Validate failed",
      "when": "validateToken throws - a non-UUID token_id failing the uuid cast, or any DB error"
    },
    {
      "status": 500,
      "code": "InternalError",
      "message": "InternalError",
      "when": "the handler throws outside its own try/catch and the route wrapper catch fires"
    }
  ]
}
