{
  "endpoint": "/api/agent-runtime/tokens/:token_id/revoke",
  "sdk": "sdk-agent-runtime",
  "method": "POST",
  "taskId": "f83bc787-e516-4ee9-9a86-3a3aa9c2bad9",
  "description": "Revoke a capability token. Idempotent. Mid-flight tools polling isRevoked() observe the new state and self-cancel. FR-ART-4 / AC-3.",
  "requiresAuth": true,
  "priority": 120,
  "dependsOn": [
    "POST /api/auth/register",
    "POST /api/agent-runtime/agents",
    "POST /api/agent-runtime/runs",
    "POST /api/agent-runtime/tokens"
  ],
  "fieldEnums": {
    "actor_kind": [
      "human",
      "service",
      "agent"
    ]
  },
  "statusTransitions": {
    "entity": "agents.capability_token",
    "field": "status",
    "flow": [
      "active",
      "revoked"
    ],
    "transitions": [
      {
        "from": "active",
        "to": "revoked",
        "via": "POST /api/agent-runtime/tokens/:token_id/revoke"
      }
    ]
  },
  "captureResponse": {
    "agent-runtime-tokens.revoke.response.data.token_id": "data.token_id"
  },
  "testCases": [
    {
      "name": "Revoke a capability token",
      "headers": {
        "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
      },
      "pathParams": {
        "token_id": "{{cache:agent-runtime-tokens.mint.response.data.token_id}}"
      },
      "payload": {
        "reason": "Operator-initiated revoke for testing",
        "actor_id": "{{var:operator_id}}",
        "actor_kind": "human"
      },
      "expectedStatus": 200,
      "expectedResponse": {
        "success": true
      }
    }
  ],
  "errorCases": [
    {
      "status": 401,
      "code": "Unauthorized",
      "message": "Missing bearer token",
      "when": "Authorization header absent or not in Bearer form (requireAuth)"
    },
    {
      "status": 401,
      "code": "Unauthorized",
      "message": "Invalid or expired token",
      "when": "Bearer token fails JWT verification (requireAuth)"
    },
    {
      "status": 400,
      "code": "MissingPathParam",
      "message": "Missing path param: token_id",
      "when": "token_id resolves falsy (defensive - an empty path segment normally route-misses to 404 first)"
    },
    {
      "status": 400,
      "code": "MissingRequiredField",
      "message": "Missing required field: reason",
      "when": "body.reason is absent, an empty string, or not a string"
    },
    {
      "status": 500,
      "code": "RevokeFailed",
      "message": "Revoke failed",
      "when": "revokeToken throws - a non-UUID token_id failing the uuid cast, audit-emit failure, or any DB error"
    },
    {
      "status": 500,
      "code": "InternalError",
      "message": "InternalError",
      "when": "the handler throws outside its own try/catch and the route wrapper catch fires"
    }
  ]
}
