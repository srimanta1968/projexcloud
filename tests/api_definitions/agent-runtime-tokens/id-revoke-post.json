{
  "endpoint": "/api/agent-runtime/tokens/:token_id/revoke",
  "sdk": "sdk-agent-runtime",
  "method": "POST",
  "taskId": "f83bc787-e516-4ee9-9a86-3a3aa9c2bad9",
  "description": "Revoke a capability token. Idempotent. Mid-flight tools polling isRevoked() observe the new state and self-cancel. FR-ART-4 / AC-3.",
  "requiresAuth": true,
  "priority": 120,
  "dependsOn": [
    "POST /api/auth/register",
    "POST /api/agent-runtime/tokens"
  ],
  "testCases": [
    {
      "name": "Revoke a capability token",
      "headers": {
        "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
      },
      "pathParams": {
        "token_id": "{{cache:agent-runtime-tokens.mint.response.data.token_id}}"
      },
      "payload": {
        "reason": "{{static:Operator-initiated revoke for testing}}",
        "actor_kind": "{{static:human}}"
      },
      "expectedStatus": 200,
      "expectedResponse": {
        "success": true
      }
    }
  ]
}
