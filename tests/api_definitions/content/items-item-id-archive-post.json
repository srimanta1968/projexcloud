{
  "name": "POST /api/content/items/:item_id/archive — sdk-content",
  "endpoint": "/api/content/items/:item_id/archive",
  "method": "POST",
  "requiresAuth": true,
  "dependsOn": [
    "POST /api/auth/signup-tenant",
    "POST /api/content/items"
  ],
  "expectedStatus": 200,
  "sdk": "sdk-content",
  "sourceFile": "packages/sdk-content/src/server/routes.ts",
  "_generated": true,
  "testability": "auto",
  "fieldEnums": {
    "status": [
      "draft",
      "published",
      "archived"
    ]
  },
  "statusTransitions": {
    "entity": "content.item",
    "field": "status",
    "flow": [
      "draft",
      "published",
      "archived"
    ],
    "transitions": [
      {
        "from": "draft",
        "to": "archived",
        "via": "POST /api/content/items/:item_id/archive"
      },
      {
        "from": "published",
        "to": "archived",
        "via": "POST /api/content/items/:item_id/archive"
      }
    ]
  },
  "captureResponse": {
    "content.item.archive.response.data.item.item_id": "data.item.item_id",
    "content.item.archive.response.data.item.status": "data.item.status"
  },
  "testCases": [
    {
      "name": "Archive a draft content item",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "pathParams": {
        "item_id": "{{cache:content.item.create.response.data.item.item_id}}"
      },
      "payload": {},
      "expectedStatus": 200
    }
  ],
  "description": "Archives a content item (a soft state change; the row and its versions are retained and still readable via GET). Takes no body. Edge cases: an unknown :item_id returns 404; a non-UUID :item_id fails in Postgres as a 500; there is no already-archived guard, so repeating the call returns 200 with the same row (idempotent in effect, not by check); archiving does not unpublish a previously published version, and there is no un-archive counterpart on this route.",
  "errorCases": [
    {
      "status": 401,
      "code": "Unauthorized",
      "message": "Missing bearer token",
      "when": "Authorization header absent or not in 'Bearer <jwt>' form (requireAuth preHandler)"
    },
    {
      "status": 401,
      "code": "Unauthorized",
      "message": "Invalid or expired token",
      "when": "JWT signature invalid, malformed, or exp has elapsed"
    },
    {
      "status": 404,
      "code": "NotFound",
      "message": "NotFound",
      "when": "no content item exists for :item_id"
    },
    {
      "status": 500,
      "code": "Internal Server Error",
      "message": "Internal Server Error",
      "when": ":item_id is not a valid UUID — the route has no try/catch, so the rejection surfaces as Fastify's default 500"
    }
  ]
}
