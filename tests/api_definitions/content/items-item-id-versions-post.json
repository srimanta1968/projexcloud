{
  "name": "POST /api/content/items/:item_id/versions — sdk-content",
  "endpoint": "/api/content/items/:item_id/versions",
  "method": "POST",
  "requiresAuth": true,
  "dependsOn": [
    "POST /api/auth/signup-tenant",
    "POST /api/content/items"
  ],
  "expectedStatus": 201,
  "sdk": "sdk-content",
  "sourceFile": "packages/sdk-content/src/server/routes.ts",
  "_generated": true,
  "testability": "auto",
  "captureResponse": {
    "content.version.create.response.data.version.version_id": "data.version.version_id"
  },
  "testCases": [
    {
      "name": "Create a content version with body, media and tags",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "pathParams": {
        "item_id": "{{cache:content.item.create.response.data.item.item_id}}"
      },
      "payload": {
        "payload": {
          "title": "{{dynamic:name}}",
          "body": "Draft body copy for the first version."
        },
        "media_refs": ["media://hero-image"],
        "taxonomy_tags": ["news", "featured"]
      },
      "expectedStatus": 201
    }
  ]
}
