{
  "name": "POST /api/content/items — sdk-content",
  "endpoint": "/api/content/items",
  "method": "POST",
  "requiresAuth": true,
  "dependsOn": [
    "POST /api/auth/signup-tenant"
  ],
  "expectedStatus": 201,
  "sdk": "sdk-content",
  "sourceFile": "packages/sdk-content/src/server/routes.ts",
  "_generated": true,
  "testability": "auto",
  "fieldEnums": {
    "status": ["draft", "published", "archived"]
  },
  "captureResponse": {
    "content.item.create.response.data.item.item_id": "data.item.item_id"
  },
  "testCases": [
    {
      "name": "Create a draft article content item",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "payload": {
        "tenant_id": "{{cache:auth.signup-tenant.response.data.tenant_id}}",
        "type_code": "article",
        "slug": "{{dynamic:name}}",
        "owner_persona_id": "{{cache:auth.signup-tenant.response.data.userId}}"
      },
      "expectedStatus": 201
    }
  ]
}
