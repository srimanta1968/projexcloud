{
  "name": "POST /api/content/items/:item_id/versions/:version_id/publish — sdk-content",
  "endpoint": "/api/content/items/:item_id/versions/:version_id/publish",
  "method": "POST",
  "requiresAuth": true,
  "dependsOn": [
    "POST /api/auth/signup-tenant",
    "POST /api/content/items",
    "POST /api/content/items/:item_id/versions"
  ],
  "expectedStatus": 200,
  "sdk": "sdk-content",
  "sourceFile": "packages/sdk-content/src/server/routes.ts",
  "_generated": true,
  "testability": "auto",
  "fieldEnums": {
    "status": ["draft", "published", "archived"]
  },
  "statusTransitions": {
    "entity": "content.item",
    "field": "status",
    "flow": ["draft", "published", "archived"],
    "transitions": [
      { "from": "draft", "to": "published", "via": "POST /api/content/items/:item_id/versions/:version_id/publish" }
    ]
  },
  "captureResponse": {
    "content.item.publish.response.data.item.item_id": "data.item.item_id",
    "content.item.publish.response.data.item.status": "data.item.status"
  },
  "testCases": [
    {
      "name": "Publish a version on behalf of the signed-up user",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "pathParams": {
        "item_id": "{{cache:content.item.create.response.data.item.item_id}}",
        "version_id": "{{cache:content.version.create.response.data.version.version_id}}"
      },
      "payload": {
        "published_by": "{{cache:auth.signup-tenant.response.data.userId}}"
      },
      "expectedStatus": 200
    }
  ]
}
