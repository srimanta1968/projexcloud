{
  "name": "POST /api/webhooks/deliveries/:delivery_id/replay - Manual DLQ replay",
  "endpoint": "/api/webhooks/deliveries/:delivery_id/replay",
  "sdk": "sdk-webhook",
  "method": "POST",
  "requiresAuth": true,
  "expectedStatus": 200,
  "sourceFile": "packages/sdk-webhook/src/server/routes.ts",
  "taskId": "b73a3d18-b3de-479a-adc1-17f142980204",
  "sprintId": "8ef1d09e-dd8e-4daf-8d03-54dcd9f812f8",
  "featureId": "edce9080-4593-4e84-a4c6-54309b62e01e",
  "epicId": "d83f7b6e-821c-4fe1-96e6-910eca8fbbfc",
  "priority": 50,
  "testability": "auto",
  "dependsOn": [
    "POST /api/auth/signup-tenant"
  ],
  "statusTransitions": {
    "entity": "webhook.delivery",
    "field": "status",
    "flow": ["pending", "delivering", "succeeded", "failed", "dlq"],
    "transitions": [
      { "from": "dlq", "to": "pending", "via": "POST /api/webhooks/deliveries/:delivery_id/replay" }
    ]
  },
  "testCases": [
    {
      "name": "Replay a single DLQ delivery",
      "headers": {
        "Authorization": "Bearer {{cache:auth.signup-tenant.response.data.token}}"
      },
      "pathParams": {
        "delivery_id": "{{var:dlq_delivery_id}}"
      },
      "expectedStatus": 200
    }
  ],
  "expectedResponse": {
    "data": {
      "delivery": {
        "delivery_id": "string",
        "status": "string"
      }
    }
  },
  "captureResponse": {
    "webhooks.replay.response.data.delivery.delivery_id": "data.delivery.delivery_id"
  }
}
