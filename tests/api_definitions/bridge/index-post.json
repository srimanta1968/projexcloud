{
  "name": "POST /bridge — semantic-service",
  "endpoint": "/bridge",
  "method": "POST",
  "requiresAuth": true,
  "expectedStatus": 200,
  "sdk": "semantic-service",
  "sourceFile": "services/semantic-service/src/routes.ts",
  "_generated": true,
  "testability": "auto",
  "fieldEnums": {
    "access_mode": [
      "read-only",
      "read-write"
    ]
  },
  "dependsOn": [
    "POST /api/auth/register",
    "POST /ontology/register"
  ],
  "captureResponse": {
    "bridge.create.response.data.bridge_id": "data.bridge_id",
    "bridge.create.response.data.from_object_type_id": "data.from_object_type_id",
