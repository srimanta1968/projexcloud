{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": "1.0.0",
  "description": "Test configuration for UI and API testing with projex_test_mcp",
  "_instructions": {
    "activeEnvironment": "Set to 'development' for local testing, 'staging' or 'production' for remote environments",
    "urlNote": "URLs are automatically translated: localhost -> host.docker.internal when running in Docker containers",
    "usage": "1. Update baseUrl/apiUrl to match your app ports, 2. Set activeEnvironment, 3. Run ./run-all-tests.sh"
  },
  "environments": {
    "development": {
      "baseUrl": "http://localhost:3000",
      "apiUrl": "http://localhost:4000",
      "description": "Local development. api-gateway :4000 (apiUrl). UI portals: workspace :3000, tenant-admin :3200, console :3100. NOTE: deploy/nginx and lib/portalLinks.ts describe workspace on :3300 for PROD; dev runs it on :3000 because apps/tenant-workspace/package.json uses a bare `next dev`. The values here match what actually runs locally. In prod all portals are ONE origin behind nginx under /workspace, /tenant, /console. localhost auto-translates to host.docker.internal inside Docker (skipped on ECS/Cloud Run).",
      "variables": {
        "SMOKE_API_TOKEN": "",
        "smoke_widget_id": "",
        "geo_winner_address_id": "",
        "ADMIN_OPS_TOKEN": "dev-admin-token-please-change",
        "scim_bearer_token": "test-scim-bearer-token",
        "data_credits_capability_key": "validate.phone-smoke",
        "lead_form_secret": "local-dev-lead-form-secret"
      },
      "portals": {
        "workspace": {
          "url": "http://localhost:3000",
          "authRealm": "projexlight"
        },
        "tenantAdmin": {
          "url": "http://localhost:3200",
          "authRealm": "projexlight"
        },
        "console": {
          "url": "http://localhost:3100",
          "authRealm": "projexlight"
        }
      }
    },
    "staging": {
      "baseUrl": "https://cloud.projexlight.com",
      "apiUrl": "https://cloud.projexlight.com",
      "description": "ProjexCloud EC2 deployment (cloud.projexlight.com) — staging/QA target",
      "variables": {
        "SMOKE_API_TOKEN": "",
        "smoke_widget_id": "",
        "geo_winner_address_id": "",
        "ADMIN_OPS_TOKEN": "f12009e1b54c717c8ffc7fbd359ca896b6f5f9d5ed36adf330fc551612871968",
        "scim_bearer_token": "<CHANGE_ME>",
        "data_credits_capability_key": "validate.phone-smoke",
        "lead_form_secret": ""
      },
      "portals": {
        "workspace": {
          "url": "https://cloud.projexlight.com/workspace",
          "authRealm": "projexlight"
        },
        "tenantAdmin": {
          "url": "https://cloud.projexlight.com/tenant",
          "authRealm": "projexlight"
        },
        "console": {
          "url": "https://cloud.projexlight.com/console",
          "authRealm": "projexlight"
        }
      },
      "_status": "NEEDS INPUT: set scim_bearer_token for staging"
    },
    "production": {
      "baseUrl": "https://www.example.com",
      "apiUrl": "https://api.example.com",
      "description": "Production environment (read-only tests only)",
      "variables": {
        "SMOKE_API_TOKEN": "",
        "smoke_widget_id": "",
        "geo_winner_address_id": "",
        "ADMIN_OPS_TOKEN": "<CHANGE_ME>",
        "scim_bearer_token": "<CHANGE_ME>",
        "data_credits_capability_key": "<CHANGE_ME>",
        "lead_form_secret": ""
      },
      "portals": {
        "workspace": {
          "url": "https://cloud.projexlight.com/workspace",
          "authRealm": "projexlight"
        },
        "tenantAdmin": {
          "url": "https://cloud.projexlight.com/tenant",
          "authRealm": "projexlight"
        },
        "console": {
          "url": "https://cloud.projexlight.com/console",
          "authRealm": "projexlight"
        }
      },
      "_status": "NEEDS INPUT: set ADMIN_OPS_TOKEN for production; NEEDS INPUT: set scim_bearer_token for production; NEEDS INPUT: set data_credits_capability_key for production — it names a row in data_credits.capability seeded by tests/setup_scripts/data_credits_catalog.sql, which is a QA fixture and is deliberately NOT applied to a real production stack, so there is no correct value to inherit here"
    }
  },
  "activeEnvironment": "development",
  "_variablesNote": "MUST-35: shared cross-endpoint values with no create-endpoint producer. Used as {{var:name}} in api_definitions for logical (non-FK-constrained) ids that the reviewer flags but that have no producing API. Prefer {{cache:...}} whenever a producer exists.",
  "variables": {
    "person_id": "00000000-0000-4000-8000-000000000001",
    "operator_id": "00000000-0000-4000-8000-0000000000a1",
    "contact_id": "contact-smoke-0001",
    "trace_id": "trace-smoke-0001",
    "capture_id": "capture-smoke-0001",
    "variant_id": "variant-smoke-0001",
    "approval_ref": "approval-smoke-0001",
    "audit_entry_id": "00000000-0000-4000-8000-0000000000b1",
    "signed_by_audit_entry_id": "00000000-0000-4000-8000-0000000000b2",
    "role_template_id": "00000000-0000-4000-8000-0000000000c1",
    "bu_id": "00000000-0000-4000-8000-0000000000c2",
    "persona_key_ref": "00000000-0000-4000-8000-0000000000c3",
    "rebac_counterparty_persona_id": "00000000-0000-4000-8000-0000000000c4",
    "signing_key_ref": "vault-key-webhook-001",
    "mtls_client_cert_ref": "vault-mtls-cert-webhook-001",
    "event_id": "evt-billing-inv-0001",
    "dlq_delivery_id": "00000000-0000-0000-0000-0000000d1000",
    "dlq_delivery_id_2": "00000000-0000-0000-0000-0000000d1001",
    "link_id": "11111111-1111-1111-1111-111111111111",
    "geo_loser_address_id": "22222222-2222-2222-2222-222222222222",
    "component_id": "33333333-3333-3333-3333-333333333333",
    "secure_data_field_ref": "sdf_test_ref_0001",
    "encounter_id": "00000000-0000-0000-0000-0000000000e5",
    "target_id": "44444444-4444-4444-4444-444444444444",
    "taxonomy_version_id": "55555555-5555-5555-5555-555555555555",
    "acting_persona_id": "11111111-1111-4111-8111-111111111111",
    "customer_consent_ref": "00000000-0000-0000-0000-000000000200",
    "subject_id": "11111111-1111-1111-1111-111111111112",
    "resource_id": "22222222-2222-2222-2222-222222222223",
    "persona_id": "33333333-3333-3333-3333-333333333333",
    "dispatch_task_id": "tsk_0000000000000000000000",
    "active_ontology_name": "sdk-semantic-smoke",
    "federation_id": "fed-us-east-1",
    "failover_event_id": "fov-test-0001",
    "pool_index": "admin-us-east-1",
    "auditor_id": "auditor-ext-001",
    "customer_id": "cust-acme-001",
    "tenant_key_id": "vk-qa-tenant-current",
    "customer_kms_key_arn": "arn:aws:kms:us-east-1:111122223333:key/1234abcd-12ab-34cd-56ef-1234567890ab",
    "new_tenant_key_id": "vk-qa-tenant-rotated",
    "sensor_id": "66666666-6666-6666-6666-666666666666",
    "invoice_id": "",
    "smoke_global_v88": "",
    "smoke_prod_id": "",
    "retire_fixture_model_id": "qa-retire-fixture-model-0001",
    "data_credits_persona_id": "00000000-0000-4000-8000-00000000dc02",
    "absent_uuid": "00000000-0000-4000-8000-0000000000ff",
    "coverage_backup_persona_id": "00000000-0000-4000-8000-00000000cb01",
    "assignment_manager_persona_id": "00000000-0000-4000-8000-00000000ab01",
    "crm_subject_ref": "lead:crm-smoke-0001"
  },
  "browser": {
    "headless": true,
    "timeout": 30000,
    "viewport": {
      "width": 1280,
      "height": 720
    },
    "slowMo": 0
  },
  "dynamicFields": {
    "enabled": true,
    "description": "Enable dynamic field detection and value generation",
    "patterns": {
      "email": "${random_email}",
      "phone": "${random_phone}",
      "password": "${random_password}",
      "date_past": "${date_past}",
      "date_future": "${date_future}"
    }
  },
  "testCredentials": {
    "default": {
      "email": "qa-tenant-admin@projexcloud.test",
      "password": "QaTenantAdmin!2026",
      "_status": "Created via POST /api/auth/signup-tenant and verified with POST /api/auth/login -> 200 on 2026-08-03. Dev environment only; never copy to staging or production."
    },
    "registered": null,
    "_usage": {
      "${registered:email}": "Email from last successful registration",
      "${registered:password}": "Password from last successful registration",
      "${default:email}": "Default email from this config",
      "${default:password}": "Default password from this config",
      "${login:email}": "Uses registered if available, else default",
      "${login:password}": "Uses registered if available, else default"
    }
  },
  "featureValidation": {
    "enabled": true,
    "autoRegenerate": true,
    "syncToDatabase": true,
    "validateOnUpload": true,
    "retryFailedTests": true,
    "maxRetries": 3
  },
  "selectors": {
    "healingStrategy": "local_first",
    "fallbackOrder": [
      "exact_match",
      "healing_registry",
      "bdd_pattern",
      "llm_generation"
    ],
    "registryPath": "tests/selectors/healing-registry.json"
  },
  "reporting": {
    "outputDir": "tests/reports",
    "formats": [
      "html",
      "json"
    ],
    "screenshots": {
      "onFailure": true,
      "onSuccess": false
    }
  },
  "authentication": {
    "enabled": false,
    "method": "cookie",
    "loginUrl": "/login",
    "credentials": {
      "username": "${login:email}",
      "password": "${login:password}"
    },
    "sessionStorage": "tests/config/.auth-session.json",
    "_instructions": "Set 'method' to 'oauth_bypass' to skip OAuth flow and use tokens directly",
    "oauth": {
      "bypassEnabled": false,
      "provider": "google",
      "_supportedProviders": [
        "google",
        "github",
        "microsoft",
        "okta",
        "auth0",
        "custom"
      ],
      "tokens": {
        "accessToken": "",
        "refreshToken": "",
        "idToken": "",
        "expiresAt": null,
        "_note": "Set these tokens to bypass OAuth. Get them from browser DevTools after manual login.",
        "_expiresAtFormats": "Unix timestamp (seconds/ms) or ISO string. Token refreshed 5 min before expiry."
      },
      "tokenRefresh": {
        "endpoint": "",
        "clientId": "",
        "clientSecret": "",
        "method": "POST",
        "bodyFormat": "form",
        "_supportedFormats": [
          "form",
          "json"
        ],
        "_note": "Configure to auto-refresh tokens when expired. Leave empty to skip auto-refresh.",
        "_example": {
          "endpoint": "https://oauth2.googleapis.com/token",
          "clientId": "your-client-id.apps.googleusercontent.com",
          "clientSecret": "your-client-secret"
        }
      },
      "apiHeaders": {
        "Authorization": "Bearer ${oauth:accessToken}",
        "_customHeaders": "Add any custom headers needed for your API"
      },
      "browserStorage": {
        "type": "localStorage",
        "_supportedTypes": [
          "localStorage",
          "sessionStorage",
          "cookie"
        ],
        "keys": {
          "accessToken": "access_token",
          "refreshToken": "refresh_token",
          "idToken": "id_token",
          "user": "user_info"
        },
        "_note": "Maps config tokens to browser storage keys your app expects"
      },
      "mockUser": {
        "id": "test-user-123",
        "email": "testuser@example.com",
        "name": "Test User",
        "picture": "https://example.com/avatar.png",
        "roles": [
          "user",
          "tester"
        ],
        "_note": "Mock user object to inject into storage if your app needs it"
      },
      "callbackMocking": {
        "enabled": false,
        "callbackUrl": "/auth/callback",
        "mockResponse": {
          "code": "mock_auth_code_12345",
          "state": "${oauth:state}"
        },
        "_note": "Enable to intercept OAuth callback and return mock tokens"
      }
    }
  },
  "projexlight": {
    "syncEnabled": true,
    "apiUrl": "${PROJEXLIGHT_API_URL}",
    "projectId": "${PROJEXLIGHT_PROJECT_ID}",
    "featureUpdateOnFix": true
  },
  "_variable_meta": {
    "crm_subject_ref": {
      "type": "string",
      "scope": "global",
      "source": "authored",
      "needs_llm_review": false,
      "note": "A subject reference (`<kind>:<id>`), not a row id. sdk-crm's next-action and save-gate are subject-generic and address leads, tickets and contacts that no endpoint in this repo creates, so there is no producer to {{cache:...}} from."
    },
    "invoice_id": {
      "type": "uuid",
      "scope": "global",
      "pending_rewrite": "cache",
      "producer": "POST /api/billing/invoices/generate - Trigger month-close invoice generation",
      "source": "auto-scanned",
      "needs_llm_review": true,
      "scope_hint": "cache",
      "referenced_by_count": 1
    },
    "SMOKE_API_TOKEN": {
      "type": "string",
      "scope": "env",
      "source": "auto-scanned",
      "referenced_by_count": 1,
      "needs_llm_review": true,
      "scope_hint": "env"
    },
    "smoke_global_v88": {
      "type": "string",
      "scope": "global",
      "source": "auto-scanned",
      "referenced_by_count": 1,
      "needs_llm_review": true,
      "scope_hint": "global"
    },
    "smoke_prod_id": {
      "type": "uuid",
      "scope": "global",
      "pending_rewrite": "cache",
      "producer": "POST /api/smoke/var-extraction-v88 - Var extraction smoke test",
      "source": "auto-scanned",
      "needs_llm_review": true,
      "scope_hint": "cache",
      "referenced_by_count": 1
    },
    "smoke_widget_id": {
      "type": "uuid",
      "scope": "env",
      "source": "auto-scanned",
      "referenced_by_count": 1,
      "needs_llm_review": true,
      "scope_hint": "env"
    },
    "geo_winner_address_id": {
      "type": "uuid",
      "scope": "env",
      "source": "auto-scanned",
      "referenced_by_count": 1,
      "needs_llm_review": true,
      "scope_hint": "env"
    },
    "lead_form_secret": {
      "type": "string",
      "scope": "environment",
      "sensitive": true,
      "reason": "HMAC secret for all 5 connector webhook signatures in computedHeaders (x-hub-signature-256, x-li-signature, x-tt-signature, x-goog-signature, x-projex-signature).",
      "action": "SET PER ENVIRONMENT. It is referenced ONLY from computedHeaders, never from an api_definition, so it was invisible to the incremental import and staging/production did not even list the name. Unset, the signature is skipped and the connector endpoints reject the request - which reads as a broken endpoint."
    }
  },
  "authRealms": {
    "projexlight": {
      "loginUrl": "/login",
      "emailField": "login-email",
      "passwordField": "login-password",
      "canSelfRegister": true,
      "registerUrl": "/register",
      "signupUrl": "/signup",
      "selfRegisterPortal": "workspace",
      "roles": [
        "user",
        "tenantAdmin",
        "platformAdmin"
      ],
      "_status": "Field ids verified against packages/design-system login form (id=login-email / id=login-password), shared by workspace, tenantAdmin and console."
    }
  },
  "computedHeaders": {
    "x-hub-signature-256": {
      "algorithm": "hmac-sha256",
      "secret": "{{var:lead_form_secret}}",
      "over": "raw_body",
      "encoding": "hex",
      "prefix": "sha256=",
      "match": "/api/connectors/lead-forms"
    },
    "x-li-signature": {
      "algorithm": "hmac-sha256",
      "secret": "{{var:lead_form_secret}}",
      "over": "raw_body",
      "encoding": "hex",
      "prefix": "",
      "match": "/api/connectors/lead-forms"
    },
    "x-tt-signature": {
      "algorithm": "hmac-sha256",
      "secret": "{{var:lead_form_secret}}",
      "over": "raw_body",
      "encoding": "hex",
      "prefix": "",
      "match": "/api/connectors/lead-forms"
    },
    "x-goog-signature": {
      "algorithm": "hmac-sha256",
      "secret": "{{var:lead_form_secret}}",
      "over": "raw_body",
      "encoding": "hex",
      "prefix": "",
      "match": "/api/connectors/lead-forms"
    },
    "x-projex-signature": {
      "algorithm": "hmac-sha256",
      "secret": "{{var:lead_form_secret}}",
      "over": "raw_body",
      "encoding": "hex",
      "prefix": "",
      "match": "/api/connectors/lead-forms"
    }
  }
}
