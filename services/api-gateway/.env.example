# Environment Configuration for FASTIFY
# Generated for ProjexCloud
# Copy this file to .env and configure your values

# ============================================
# APPLICATION CONFIGURATION
# ============================================

NODE_ENV=development
PORT=3000
APP_NAME=ProjexCloud
API_PREFIX=/api
API_VERSION=v1

# ============================================
# DATABASE CONFIGURATION (POSTGRESQL)
# ============================================
# These defaults work with docker-compose.yml
DB_HOST=localhost
DB_PORT=5432
DB_NAME=projexcloud_db
DB_USER=postgres
DB_PASSWORD=postgres

# Connection string (alternative to individual vars)
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# ============================================
# FASTIFY SPECIFIC
# ============================================
# Fastify Settings
FASTIFY_BODY_LIMIT=10485760
FASTIFY_TRUST_PROXY=false
FASTIFY_LOGGER=true

# ============================================
# SECURITY & AUTHENTICATION
# ============================================

JWT_SECRET=your_jwt_secret_key_change_this_in_production
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# ============================================
# CORS CONFIGURATION
# ============================================
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
CORS_METHODS=GET,POST,PUT,DELETE,PATCH
CORS_CREDENTIALS=true

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=debug
LOG_FORMAT=dev

# ============================================
# OPTIONAL SERVICES (uncomment if needed)
# ============================================

# Email Configuration
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=your_email@gmail.com
# EMAIL_PASSWORD=your_email_password

# AWS S3 Storage
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# S3_BUCKET=your_bucket_name

# ============================================
# REDIS (route cache + pool:status-flip pub/sub for AC-6 fanout)
# ============================================
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=
REDIS_DB=0
ROUTE_CACHE_TTL_MS=300000

# ============================================
# BACKGROUND WORKERS
# ============================================
AUDIT_VERIFIER_ENABLED=true
AUDIT_VERIFIER_INTERVAL_MS=86400000
AUDIT_RETENTION_ENABLED=true
AUDIT_RETENTION_INTERVAL_MS=3600000
AUDIT_RETENTION_BATCH_SIZE=1000
VAULT_ROTATION_ENABLED=false
VAULT_ROTATION_INTERVAL_MS=3600000
VAULT_ROTATION_MAX_AGE_DAYS=90

# ============================================
# IMPORTANT NOTES
# ============================================

# 1. NEVER commit the .env file to version control
# 2. Add .env to your .gitignore file
# 3. Use strong, unique passwords for production
# 4. Update JWT_SECRET with a secure random string
# 5. Configure database credentials before running the application
