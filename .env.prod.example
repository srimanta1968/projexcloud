# =============================================================================
# ProjexCloud — PRODUCTION / STAGING / QA deployment settings
# =============================================================================
# Copy this file to `.env.prod` (the api-gateway loads it via env_file in
# scripts/setup/docker-compose.prod.yml) and fill in real values.
#
# WHY THIS FILE EXISTS
#   When NODE_ENV=production, the app REFUSES to start (or 500s at runtime) if
#   the security secrets below are missing — in dev/test it silently falls back
#   to synthetic/insecure defaults, so these gaps only surface in prod/staging.
#   This file lists every setting a deployer must provide.
#
# ENVIRONMENT MODEL
#   NODE_ENV=production           → all secrets below are REQUIRED (hard fail).
#   ALLOW_SYNTHETIC_* = true      → use built-in fake providers instead of real
#                                   ones (fine for STAGING/QA smoke-testing;
#                                   NEVER for a customer-facing prod).
#   So a STAGING/QA box = real security secrets + ALLOW_SYNTHETIC_*=true.
#   A real PROD box     = real security secrets + real provider creds (no
#                         ALLOW_SYNTHETIC_*), see each section.
# =============================================================================

NODE_ENV=production

# -----------------------------------------------------------------------------
# 1) CORE SECURITY SECRETS — ALWAYS REQUIRED in production (generate fresh, keep
#    stable across restarts; changing them invalidates data signed/wrapped with
#    the old value). Generate with the exact command shown.
# -----------------------------------------------------------------------------
# Admin ops token — gates every /admin/* route (x-admin-ops-token header).
#   generate: openssl rand -hex 32
ADMIN_OPS_TOKEN=

# Wraps notification destinations (sdk-notification). Any strong secret string.
#   generate: openssl rand -hex 32
NOTIFICATION_MASTER_KEY=

# Wraps notification PROVIDER credentials (email/SMS/push). base64, 32 bytes.
#   generate: openssl rand -base64 32
NOTIFICATION_PROVIDER_WRAP_KEY=

# Signs agent-runtime capability tokens. hex-encoded, EXACTLY 32 bytes.
#   generate: openssl rand -hex 32
CAPABILITY_TOKEN_SIGNING_KEY=
# Optional previous key for a rotation grace window (same format).
# CAPABILITY_TOKEN_SIGNING_KEY_PREV=

# Wraps principal tokens (sdk-principal-token). base64, EXACTLY 32 bytes.
#   generate: openssl rand -base64 32
PRINCIPAL_TOKEN_WRAP_KEY=

# Signs legal/evidence export bundles (sdk-evidence). 32-byte secret.
#   generate: openssl rand -hex 32
EVIDENCE_LEGAL_EXPORT_SIGNING_KEY=

# -----------------------------------------------------------------------------
# 2) DATABASE / INFRA (required)
# -----------------------------------------------------------------------------
DB_HOST=postgres
DB_PORT=5432
DB_NAME=projexcloud_db
DB_USER=postgres
DB_PASSWORD=
REDIS_HOST=redis
REDIS_ENABLED=true

# -----------------------------------------------------------------------------
# 3) AI GATEWAY (sdk-ai-gateway)
#    Which providers the gateway requires at boot (comma-separated). Set to the
#    providers you actually have keys for.
# -----------------------------------------------------------------------------
AI_GATEWAY_REQUIRED_PROVIDERS=openai
# Real provider keys — set the one(s) matching AI_GATEWAY_REQUIRED_PROVIDERS:
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# AWS_BEDROCK_ACCESS_KEY=
# STAGING/QA only: register a built-in synthetic LLM instead of calling a real
# provider (returns deterministic fake completions). Leave UNSET in real prod.
# ALLOW_SYNTHETIC_AI_PROVIDERS=true

# -----------------------------------------------------------------------------
# 4) OBJECT STORAGE / MEDIA (sdk-media, S3 signer) — needed for upload/playback.
#    Real prod: AWS creds + bucket. STAGING/QA: ALLOW_SYNTHETIC_S3=true.
# -----------------------------------------------------------------------------
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# MEDIA_S3_BUCKET=
# ALLOW_SYNTHETIC_S3=true

# -----------------------------------------------------------------------------
# 5) VAULT / BYOK / KMS (sdk-vault, BYOK)
#    Real prod: KMS/vault refs. STAGING/QA: ALLOW_SYNTHETIC_BYOK=true.
# -----------------------------------------------------------------------------
# AI_GATEWAY_BYOK_KMS_KEY_ID=
# AI_GATEWAY_BYOK_VAULT_REF=
# VAULT_ROTATION_ENABLED=false
# ALLOW_SYNTHETIC_BYOK=true

# -----------------------------------------------------------------------------
# 6) NOTIFICATION PROVIDERS (email/SMS/push)
#    Real prod: provider creds below. STAGING/QA: ALLOW_SYNTHETIC_NOTIFICATION_PROVIDERS=true.
# -----------------------------------------------------------------------------
# TWILIO_AUTH_TOKEN=
# SLACK_BOT_TOKEN=
# SLACK_CLIENT_ID=
# FCM_PROJECT_ID=
# APNS_TEAM_ID=          APNS_KEY_ID=          APNS_BUNDLE_ID=          APNS_PRIVATE_KEY=
# ALLOW_SYNTHETIC_NOTIFICATION_PROVIDERS=true

# -----------------------------------------------------------------------------
# 7) OTHER SYNTHETIC-GATED SUBSYSTEMS
#    Set =true on STAGING/QA to use built-in fakes; provide real config in prod.
# -----------------------------------------------------------------------------
# ALLOW_SYNTHETIC_PAYMENT_PROVIDERS=true   # sdk-payment
# ALLOW_SYNTHETIC_SEARCH_CLIENT=true       # sdk-search (opensearch/elastic)
# ALLOW_SYNTHETIC_STORM=true               # storm ingest
# ALLOW_SYNTHETIC_LEAK_DETECTOR=true

# =============================================================================
# QUICK-GENERATE ALL CORE SECRETS (copy/paste, then paste values above):
#   echo "ADMIN_OPS_TOKEN=$(openssl rand -hex 32)"
#   echo "NOTIFICATION_MASTER_KEY=$(openssl rand -hex 32)"
#   echo "NOTIFICATION_PROVIDER_WRAP_KEY=$(openssl rand -base64 32)"
#   echo "CAPABILITY_TOKEN_SIGNING_KEY=$(openssl rand -hex 32)"
#   echo "PRINCIPAL_TOKEN_WRAP_KEY=$(openssl rand -base64 32)"
#   echo "EVIDENCE_LEGAL_EXPORT_SIGNING_KEY=$(openssl rand -hex 32)"
# =============================================================================

# =============================================================================
# Voice agents (sdk-voice-agent) — platform LiveKit for voice media
# =============================================================================
# Browser test sessions and the voice runtime join rooms on this LiveKit. Unset =
# POST /api/voice-agent/test-sessions answers 503 VoiceRuntimeUnavailable.
# Tenants bring their OWN STT/LLM/TTS/carrier keys (stack profiles); these are platform keys.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# agent_name the voice-runtime worker registers with (default projex-voice)
VOICE_AGENT_DISPATCH_NAME=projex-voice
# SIP URI of this LiveKit's SIP service; tenant carrier trunks send inbound calls here
# (POST /api/voice-agent/trunks answers 503 TelephonyNotConfigured while unset).
LIVEKIT_SIP_URI=
# Server API root when it differs from LIVEKIT_URL with ws->http (optional).
LIVEKIT_API_URL=
#
# Self-hosted voice media plane (scripts/setup/docker-compose.voice.yml, TK-4454).
# VOICE_ENABLED=true makes deploy.sh add LiveKit SFU + LiveKit SIP to the main stack.
# Then set: LIVEKIT_URL=wss://<VOICE_PUBLIC_HOST>  (nginx: scripts/setup/nginx-voice.conf)
#           LIVEKIT_API_URL=http://livekit:7880    (gateway -> LiveKit over the compose network)
#           LIVEKIT_SIP_URI=sip:<VOICE_PUBLIC_HOST>:5061;transport=tls
# LIVEKIT_API_SECRET must be at least 32 characters. Open the security group with
# scripts/setup/voice-security-group.sh (SIP/RTP to carrier ranges only).
VOICE_ENABLED=false
VOICE_PUBLIC_HOST=
# Directory with fullchain.pem + privkey.pem for SIP-over-TLS on 5061 (e.g. a certbot copy).
VOICE_SIP_TLS_DIR=/etc/projexcloud/sip-tls
# Public IP of this host (EC2 Elastic IP); empty = discover via STUN.
LIVEKIT_NODE_IP=
LIVEKIT_USE_EXTERNAL_IP=true
# Published UDP ranges: WebRTC media (~1 port per participant) and SIP RTP (2 per call).
LIVEKIT_UDP_PORT_START=50000
LIVEKIT_UDP_PORT_END=50199
SIP_RTP_PORT_START=10000
SIP_RTP_PORT_END=10199
# Carrier SIP signaling allow-lists default to packages/sdk-voice-agent/carrier-signaling.json;
# override one carrier with comma-separated IPs/CIDRs (every inbound trunk is created with it).
# VOICE_SIP_ALLOWED_ADDRESSES_TWILIO=
# VOICE_SIP_ALLOWED_ADDRESSES_TELNYX=
# voice-runtime agent workers (services/voice-runtime): calls per worker, drain window on
# deploy (SIGTERM waits this long for live calls), compose stop grace (must exceed it).
VOICE_RUNTIME_MAX_JOBS=20
VOICE_RUNTIME_DRAIN_TIMEOUT_MS=7200000
VOICE_RUNTIME_STOP_GRACE=2h5m
# Telnyx account public key (base64, Portal > Keys & Credentials > Public Key). Signed status
# webhooks to /api/voice/webhooks/telnyx/status are refused in production while unset.
TELNYX_PUBLIC_KEY=
# Status webhook URL configured on connections the platform creates (optional).
TELNYX_WEBHOOK_URL=

# LLM adapters (sdk-ai-gateway): real vendor adapters are ON in production; set
# AI_GATEWAY_PROVIDER_MODE=synthetic to force the in-process test adapter. The openai
# provider accepts any OpenAI-compatible root (Azure: also set AI_GATEWAY_OPENAI_AUTH=api-key).
AI_GATEWAY_PROVIDER_MODE=real
AI_GATEWAY_OPENAI_BASE_URL=
AI_GATEWAY_BEDROCK_REGION=us-east-1

# Dialer (sdk-dialer): background fair-share dispatch of queued outbound AI calls.
# Dispatched calls are originated over the tenant's SIP trunk (POST /api/voice-agent/trunks);
# a tenant without a trunk is left 'dialing', so enable once tenants have trunks.
# Plan concurrency default and the inbound headroom share:
DIALER_SCHEDULER_ENABLED=false
DIALER_DEFAULT_PLAN_CONCURRENCY=10
DIALER_INBOUND_RESERVE_PCT=10
