# Frontend Environment Configuration
# Generated for ProjexCloud
# Framework: nextjs

# ============================================
# API CONFIGURATION
# ============================================
# Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:3000/api
NEXT_PUBLIC_API_VERSION=v1

# ============================================
# APPLICATION
# ============================================
NEXT_PUBLIC_APP_NAME=ProjexCloud
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_APP_ENV=development

# ============================================
# NEXTJS SPECIFIC
# ============================================
# Next.js
# Server-side env vars (no NEXT_PUBLIC_ prefix) are not exposed to browser
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ============================================
# AUTHENTICATION
# ============================================
NEXT_PUBLIC_AUTH_STORAGE_KEY=auth_token
NEXT_PUBLIC_REFRESH_TOKEN_KEY=refresh_token

# ============================================
# FEATURE FLAGS
# ============================================
NEXT_PUBLIC_ENABLE_DARK_MODE=true
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_DEBUG=true

# ============================================
# OPTIONAL SERVICES (uncomment if needed)
# ============================================
# Analytics
# NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# Error Tracking
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@sentry.io/xxx

# Payment
# NEXT_PUBLIC_STRIPE_PUBLIC_KEY=pk_test_xxxxx

# ============================================
# IMPORTANT NOTES
# ============================================
# 1. NEVER commit .env to version control
# 2. Only NEXT_PUBLIC_ prefixed vars are exposed to client
# 3. Never put secrets in client-side env vars
# 4. Copy this file to .env and configure values
