{
  "$schema_version": "1.0",
  "catalog_id": "analytics-sdks",
  "version": 1,
  "description": "Pricing for the analytics tier (sdk-analytics / sdk-lineage / sdk-semantic). Backs the b2b-analytics pilot. Iceberg lakehouse storage billed by GB extracted; federated queries priced per-query with per-pool fan-out billed separately.",
  "currency": "USD",
  "created_by_operator_id": "seed:analytics-sdks-v1",
  "rates": [
    { "sku": "analytics.rollup.refresh",       "unit": "refresh", "mode": "metered", "price": 0.01,    "notes": "Per rollup-spec refresh (cadence-driven)." },
    { "sku": "analytics.kpi.publish",          "unit": "publish", "mode": "flat",    "price": 0.10,    "notes": "Per canonical KPI value published." },
    { "sku": "analytics.federation.query",     "unit": "query",   "mode": "metered", "price": 0.05,    "notes": "Per federated query; per-pool fan-out billed separately." },
    { "sku": "analytics.lakehouse.extract.gb", "unit": "gb",      "mode": "metered", "price": 0.05,    "notes": "Per GB extracted into the Iceberg lakehouse." },

    { "sku": "lineage.node.record",            "unit": "node",    "mode": "metered", "price": 0.00005, "notes": "Per node recorded; most are background." },
    { "sku": "lineage.query",                  "unit": "walk",    "mode": "metered", "price": 0.001,   "notes": "Per upstream/downstream graph walk (depth-bounded)." },
    { "sku": "lineage.backfill",               "unit": "pool",    "mode": "metered", "price": 5.00,    "notes": "Per pool backfilled (heavy operation)." },

    { "sku": "semantic.ontology.publish",      "unit": "version", "mode": "flat",    "price": 0.50,    "notes": "Per ontology version published." },
    { "sku": "semantic.intent.resolve",        "unit": "intent",  "mode": "metered", "price": 0.005,   "notes": "Per intent resolved (cached intents billed at lower rate)." },
    { "sku": "semantic.policy.evaluate",       "unit": "call",    "mode": "metered", "price": 0.0001,  "notes": "Per standalone policy evaluation." }
  ]
}
