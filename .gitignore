# =====================================================
# Root .gitignore - ProjexCloud
# Generated by ProjexLight CLI Export
# =====================================================

# Environment files (NEVER commit these!)
.env
.env.local
.env.*.local
*.env

# IDE and editors
.idea/
.vscode/
*.swp
*.swo
*~
.project
.classpath
.settings/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Dependencies (installed locally)
node_modules/
vendor/
__pycache__/
*.pyc
venv/
.venv/

# Build outputs
dist/
build/
out/
target/
bin/
obj/
.next/

# Test coverage
coverage/
.nyc_output/
htmlcov/

# Docker
docker-compose.override.yml

# Database files (local)
*.sqlite
*.sqlite3
*.db
data/

# Temporary files
tmp/
temp/
*.tmp

# Package manager locks (optional - uncomment if not using)
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# Generated documentation
docs/_build/

# Secrets and keys
*.pem
*.key
credentials.json
serviceAccount.json

# Archives (zip bundles are generated artifacts, not source)
*.zip

# Turborepo local cache (machine-local, regenerated each run)
.turbo/

# ProjexLight generated QA/test reports
.projexlight/reports/

# MCP local cache (regenerated each run)
.mcp-cache/

# PostgreSQL upgrade backups (local dumps, not source)
.pg-upgrade-backup/

# v3.1 gap-analysis working notes (not source)
docs/v3.1/gaps/
