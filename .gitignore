# =====================================================
# Root .gitignore - ProjexCloud
# Generated by ProjexLight CLI Export
# =====================================================

# Environment files (NEVER commit these!)
.env
.env.local
.env.*.local
*.env

# IDE and editors
.idea/
.vscode/
*.swp
*.swo
*~
.project
.classpath
.settings/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Dependencies (installed locally)
node_modules/
vendor/
__pycache__/
*.pyc
venv/
.venv/

# Build outputs
dist/
build/
out/
target/
bin/
obj/

# Test coverage
coverage/
.nyc_output/
htmlcov/

# Docker
docker-compose.override.yml

# Database files (local)
*.sqlite
*.sqlite3
*.db
data/

# Temporary files
tmp/
temp/
*.tmp

# Package manager locks (optional - uncomment if not using)
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# Generated documentation
docs/_build/

# Secrets and keys
*.pem
*.key
credentials.json
serviceAccount.json

# ProjexLight session credentials (sessionToken etc. — never commit)
.projexlight/config.json
.projexlight/feedback/
.projexlight/sprint-progress/
.projexlight/tmp_*.json
mcp-server/config.json
mcp-server/mcp-config.json
mcp-server/storage/

# Per-user Claude Code local settings (machine-specific tool allowlists)
.claude/settings.local.json

# Per-user npm overrides (auth tokens) — never commit
.npmrc.local

# Build & tool caches
.turbo/
.next/
.cache/
.mcp-cache/
.mcp-logs/
.parcel-cache/

# Next.js artifacts
apps/*/.next/

# pnpm/turbo per-package
**/.turbo/
**/.next/

# Test outputs
test-results/
playwright-report/

# Changeset working files are tracked, but never commit a published artifact
.changeset/*.md
!.changeset/README.md
!.changeset/config.json

# Local-only docker overrides
docker-compose.local.yml

# Generated archives — never commit zips
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar
