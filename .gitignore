# =====================================================
# Root .gitignore - ProjexCloud
# Generated by ProjexLight CLI Export
# =====================================================

# Environment files (NEVER commit these!)
.env
.env.local
.env.*.local
*.env

# IDE and editors
.idea/
.vscode/
*.swp
*.swo
*~
.project
.classpath
.settings/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Dependencies (installed locally)
node_modules/
vendor/
__pycache__/
*.pyc
venv/
.venv/

# Build outputs
dist/
build/
out/
target/
bin/
obj/

# Next.js build output & cache (regenerated on every build)
.next/
**/.next/

# Turborepo local cache (machine-specific, regenerated on every build)
.turbo/
**/.turbo/

# TypeScript incremental build info
*.tsbuildinfo

# Test coverage
coverage/
.nyc_output/
htmlcov/

# Docker
docker-compose.override.yml

# Database files (local)
*.sqlite
*.sqlite3
*.db
data/

# Temporary files
tmp/
temp/
*.tmp

# Package manager locks (optional - uncomment if not using)
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# Generated documentation
docs/_build/

# Secrets and keys
*.pem
*.key
credentials.json
serviceAccount.json

# ProjexLight per-developer session/token files — NEVER commit these.
# Each developer has their OWN session token; committing them causes merge
# conflicts across developers and leaks the token into the shared repo/history.
# They are regenerated locally on every CLI export.
.projexlight/config.json
mcp-server/mcp-config.json
mcp-server/.env
.projexlight/context/task-list.json
.projexlight/reports/
.projexlight/sprint-progress/
.claude/logs/
.claude/cache/
.claude/.session/

# Dev MCP schema mirror (per-developer, re-mirrored from ProjexLight every session).
# Local READ-ONLY snapshot, NOT the committed source of truth (.projexlight/schemas/).
# Trailing slash ignores the singular schema/ mirror only, never plural schemas/.
.projexlight/schema/
.projexlight/context/schema_sync_state_*.json

# MCP local cache (regenerated at runtime)
.mcp-cache/

# Test results (regenerated on every run)
test-results/

# MCP feedback history (regenerated locally)
mcp-server/feedback/history/

# Deployment / packaging artifacts (regenerated, can be large)
deploy.zip
*.zip

# Database dump backups (may contain data; regenerated by upgrade scripts)
.pg-upgrade-backup/
*-dumpall.sql
