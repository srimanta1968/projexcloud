# =====================================================
# Root .gitignore - ProjexCloud
# Generated by ProjexLight CLI Export
# =====================================================

# Environment files (NEVER commit these!)
.env
.env.local
.env.*.local
*.env

# IDE and editors
.idea/
.vscode/
*.swp
*.swo
*~
.project
.classpath
.settings/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Dependencies (installed locally)
node_modules/
vendor/
__pycache__/
*.pyc
venv/
.venv/

# Build outputs
dist/
out/
target/
bin/
obj/
# Note: do NOT add a bare `build/` line — it greedily matches real source
# directories named `build` (e.g. apps/tenant-workspace/app/build for the
# Build-with-AI UI, apps/*/api/build, and lib/build). Use specific paths
# if you need to ignore an actual build output.

# Test coverage
coverage/
.nyc_output/
htmlcov/

# Docker
docker-compose.override.yml

# Database files (local)
*.sqlite
*.sqlite3
*.db
data/

# Temporary files
tmp/
temp/
*.tmp

# Package manager locks (optional - uncomment if not using)
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# Generated documentation
docs/_build/

# Secrets and keys
*.pem
*.key
credentials.json
serviceAccount.json

# ProjexLight session credentials (sessionToken etc. — never commit)
.projexlight/config.json
.projexlight/config/
.projexlight/context/
.projexlight/scripts/
.projexlight/feedback/
.projexlight/sprint-progress/
.projexlight/tmp_*.json
# Test-run HTML reports embed real JWT bearer tokens in curl examples.
.projexlight/reports/
mcp-server/config.json
mcp-server/mcp-config.json
mcp-server/storage/
mcp-server/registered_projects/
mcp-server/feedback/

# Test runner's per-session auth cache (plaintext password + userId).
tests/config/.auth-session.json

# Verdaccio data: storage holds published private @projexlight tarballs,
# htpasswd holds bcrypt hashes of dev publish credentials. Never commit.
infra/verdaccio/storage/
infra/verdaccio/conf/htpasswd

# Local DB dumps (e.g. PG15→PG18 upgrade backup containing every sibling
# project's data — keep on disk for rollback but NEVER commit to git).
.pg-upgrade-backup/
*.dump
*.dumpall.sql

# Per-user Claude Code local settings (machine-specific tool allowlists)
.claude/settings.local.json

# Per-user npm overrides (auth tokens) — never commit
.npmrc.local

# Build & tool caches
.turbo/
.next/
.cache/
.mcp-cache/
.mcp-logs/
.parcel-cache/

# Next.js artifacts
apps/*/.next/

# pnpm/turbo per-package
**/.turbo/
**/.next/

# Test outputs
test-results/
playwright-report/

# Changeset working files are tracked, but never commit a published artifact
.changeset/*.md
!.changeset/README.md
!.changeset/config.json

# Local-only docker overrides
docker-compose.local.yml

# Generated archives — never commit zips
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar
