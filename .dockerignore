**/node_modules
**/.next
**/.turbo
.git
**/*.log
**/coverage
test-results
*.pem
**/*.pem

# Secrets — never bake into images. Runtime injects config via --env-file at
# `docker run`, so excluding these from the build context changes nothing about
# the resulting image, but prevents a stray .env/key from ever being COPYed in.
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
*.key
**/*.key
*.p12
**/*.p12
id_rsa
id_rsa.*
