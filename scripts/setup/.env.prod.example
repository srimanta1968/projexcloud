# ProjexCloud — PRODUCTION environment template.
# Copy to the repo root as .env.prod and fill in real values:
#   cp scripts/setup/.env.prod.example .env.prod
# NEVER commit .env.prod. Use a secrets manager (AWS Secrets Manager / DO
# secrets / Vault) to inject these in real deployments.

# ============================================================
# APPLICATION
# ============================================================
NODE_ENV=production
PORT=3000
APP_NAME=projex-api-gateway
GATEWAY_PORT=3000            # host port the compose stack publishes
IMAGE_TAG=local             # tag for the built api-gateway image

# ============================================================
# DATABASE (required)  — managed Postgres in prod (RDS / DO Managed DB)
# ============================================================
# Self-hosted compose profile: leave DB_HOST=postgres.
# Managed profile: set DB_HOST to the managed endpoint and DB_SSL=true.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=projexcloud_db
DB_USER=projex
DB_PASSWORD=CHANGE_ME_strong_db_password
DB_SSL=true                 # true for managed Postgres (RDS/DO require TLS)
DB_POOL_MIN=2
DB_POOL_MAX=20

# ============================================================
# REDIS (recommended) — route cache + soft-cap usage counter
# Gateway degrades to in-memory cache if unreachable. Set REDIS_ENABLED=false
# to skip it entirely.
# ============================================================
REDIS_ENABLED=true
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_redis_password
REDIS_DB=0
ROUTE_CACHE_TTL_MS=300000

# ============================================================
# KAFKA (optional) — usage event stream. Off by default in prod compose.
# Set KAFKA_ENABLED=true and the brokers to enable; otherwise the gateway
# uses its in-process emitter.
# ============================================================
KAFKA_ENABLED=false
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=projex-api-gateway
USAGE_EVENTS_TOPIC=usage.events.v1

# ============================================================
# CLICKHOUSE (optional) — OLAP trace / telemetry rollups. Off by default.
# ============================================================
CLICKHOUSE_ENABLED=false
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=meter

# ============================================================
# SECURITY (required)
# ============================================================
# Break-glass shared secret for /admin/* operator endpoints (tenant create, key
# rotation, seeding). Generate: openssl rand -hex 32
# NOTE: additional /admin/* tokens can now be minted/revoked at runtime from the
# projexcloud-admin console (Ops Tokens page) and are stored in admin.ops_token —
# no redeploy needed. This env value is kept as a permanent break-glass fallback
# so a DB outage or empty table can never lock operators out.
ADMIN_OPS_TOKEN=CHANGE_ME_admin_ops_token
# How long (ms) the gateway caches the active DB token set before re-reading.
# Bounds how quickly a mint/revoke propagates across gateway replicas. Default 30000.
# ADMIN_OPS_TOKEN_CACHE_TTL_MS=30000
JWT_EXPIRES_IN=7d
CORS_ORIGIN=https://app.yourdomain.com

# ------------------------------------------------------------
# projexcloud-admin console — who may view/mint/revoke ops tokens.
# The /security/* routes are PLATFORM-OPERATOR-ONLY and FAIL-CLOSED: set at
# least one of these on the projexcloud-admin portal, or NO ONE can access them.
#   PLATFORM_OPERATOR_EMAILS — comma-separated allowlist of operator emails
#     (bootstrap until the platform-operator role/persona is provisioned).
#   PLATFORM_OPERATOR_ROLE   — role name that grants operator access (default
#     'platform-operator'); a session carrying it is authorized without the list.
# PLATFORM_OPERATOR_EMAILS=ops@yourdomain.com
# PLATFORM_OPERATOR_ROLE=platform-operator

# ------------------------------------------------------------
# Secrets KMS — the ONE root you must provide. Every other platform secret is
# sealed under it. Pick one:
#   SECRETS_MASTER_KEY        32 random bytes (hex or base64): durable software KMS.
#                             prod-setup.sh generates it here on first run if no KMS
#                             below is configured. BACK IT UP: lose it and every
#                             sealed secret is unrecoverable.
#   SECRETS_KMS_PROVIDER=aws-kms (+ AWS_ROLE_ARN / instance role), gcp-kms
#                             (+ GOOGLE_APPLICATION_CREDENTIALS) or hsm-pkcs11
#                             (+ HSM_PKCS11_LIB, HSM_PKCS11_PIN).
# SECRETS_MASTER_KEY=

# ------------------------------------------------------------
# Platform secrets GENERATED ON FIRST BOOT (TK-4156). Leave these unset: the
# gateway generates each one, stores it envelope-encrypted in
# vault.bootstrap_secret under the KMS above, and reads the same value back on
# every restart and replica. The boot log lists each as present / generated.
#   JWT_SECRET, API_KEY_PEPPER, CAPABILITY_TOKEN_SIGNING_KEY,
#   SOURCE_RECORD_MASTER_KEY, SOURCE_RECORD_ATTESTATION_KEY,
#   EVIDENCE_LEGAL_EXPORT_SIGNING_KEY, NOTIFICATION_MASTER_KEY,
#   NOTIFICATION_PROVIDER_WRAP_KEY (base64), PRINCIPAL_TOKEN_WRAP_KEY (base64)
# To supply one yourself instead (e.g. from a secret manager), set it here BEFORE
# the first boot and never change or remove it afterwards — data is encrypted under
# it. The boot refuses if a supplied key later changes (BOOTSTRAP_SECRETS_ACCEPT_CHANGE=<NAME>
# acknowledges an intended change) or disappears.
# BOOTSTRAP_SECRETS=off   # supply every one of them yourself; boot fails on any missing

# ============================================================
# BACKGROUND WORKERS / SCHEDULERS (sensible prod defaults shown)
# Set any of these to false to disable a scheduler.
# ============================================================
VAULT_ROTATION_ENABLED=true
VAULT_ROTATION_MAX_AGE_DAYS=90
AUDIT_VERIFIER_ENABLED=true
WEBHOOK_DELIVERY_WORKER_ENABLED=true
WORKFLOW_DURABLE_WORKER_ENABLED=true
MEDIA_TRANSCODE_WORKER_ENABLED=true

# ============================================================
# OPTIONAL REAL VENDOR ADAPTERS (left blank = synthetic stubs, refused in prod
# unless ALLOW_SYNTHETIC_*=true). Fill in to wire real providers.
# ============================================================
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_BUCKET=
# STRIPE_SECRET_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
